# Зразок для .github/workflows/deploy.yml (сам по собі не діє). Скопіювати його туди - рішення людини.
#
# Дві роботи:
#   deploy-staging - після зеленого `tests` на main, через середовище staging;
#   deploy-prod    - на тег v*, через середовище production з обов'язковим ручним підтвердженням.
#
# Staging і prod не ділять ані хоста, ані користувача, ані ключа (аудит безпеки 2026-10): код з main
# потрапляє на staging без погодження, тож він не має дістати секретів, копій і контейнерів prod.
# Користувач у групі docker на хості - фактично root, тому окремий користувач на тому самому хості
# не захищає: staging - на окремому сервері (або rootless Docker для його користувача).
#
# Секрети середовища staging (Settings > Environments > staging):
#   DEPLOY_HOST, DEPLOY_USER, DEPLOY_SSH_KEY, DEPLOY_PORT (необов'язково), DEPLOY_KNOWN_HOSTS
# Секрети середовища production (Settings > Environments > production, Required reviewers):
#   ті самі імена, інші значення: свій хост, свій користувач, свій ключ.
# На рівні репозиторію секретів DEPLOY_* не тримайте: їх бачила б будь-яка робота.
# Ключі в authorized_keys обмежте командою: command="cd ~/odoo-live && ./deploy/deploy.sh <env> $SSH_ORIGINAL_COMMAND",no-pty,no-port-forwarding
#
# Сервер сам тягне код (deploy.sh робить git fetch + checkout), тому артефакти
# нікуди не передаються, а Actions лише смикає одну команду по ssh.
name: deploy
on:
  workflow_run:
    workflows: ["tests"]
    types: [completed]
    branches: [main]
  push:
    tags: ["v*"]
  workflow_dispatch:
    inputs:
      ref:
        description: "git-ref для prod (тег vX.Y.Z)"
        required: true

concurrency:
  group: "deploy-${{ github.ref }}"
  cancel-in-progress: false

jobs:
  deploy-staging:
    if: github.event_name == 'workflow_run' && github.event.workflow_run.conclusion == 'success'
    environment: staging          # секрети staging живуть тут, prod їх не бачить і навпаки
    runs-on: ubuntu-latest
    timeout-minutes: 45
    steps:
      - name: "staging: свіже демо з main"
        uses: appleboy/ssh-action@v1
        with:
          host: ${{ secrets.DEPLOY_HOST }}
          username: ${{ secrets.DEPLOY_USER }}
          key: ${{ secrets.DEPLOY_SSH_KEY }}
          port: ${{ secrets.DEPLOY_PORT || 22 }}
          fingerprint: ${{ secrets.DEPLOY_KNOWN_HOSTS }}
          command_timeout: 40m
          script: |
            cd ~/odoo-live
            ./deploy/deploy.sh staging ${{ github.event.workflow_run.head_sha }}

  deploy-prod:
    if: startsWith(github.ref, 'refs/tags/v') || github.event_name == 'workflow_dispatch'
    runs-on: ubuntu-latest
    timeout-minutes: 45
    environment:
      name: production
      url: https://app.<домен>
    steps:
      - name: "prod: викочування тега"
        uses: appleboy/ssh-action@v1
        with:
          host: ${{ secrets.DEPLOY_HOST }}
          username: ${{ secrets.DEPLOY_USER }}
          key: ${{ secrets.DEPLOY_SSH_KEY }}
          port: ${{ secrets.DEPLOY_PORT || 22 }}
          fingerprint: ${{ secrets.DEPLOY_KNOWN_HOSTS }}
          command_timeout: 40m
          script: |
            cd ~/odoo-live
            ./deploy/deploy.sh prod ${{ inputs.ref || github.ref_name }}
