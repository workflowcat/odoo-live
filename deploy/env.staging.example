# Скопіювати на сервері в deploy/env.staging і заповнити значення.
# Значення - лише на сервері і в менеджері паролів. У репозиторії - ніколи.
# Файл читає docker compose (--env-file) і deploy/deploy.sh.

COMPOSE_PROJECT_NAME=odoo-stage
ENV_NAME=staging

# --- Postgres ---
PG_USER=odoo
# На staging пароль саме odoo, і це свідомо: scripts/demo_hire.py зашиває --db_password=odoo,
# коли будує демо-справи через разовий контейнер. Порт Postgres назовні не публікується,
# база одноразова. На prod пароль звичайний, сильний. Коли demo_hire.py навчиться брати
# пароль зі змінної, тут теж стане сильний.
PG_PASSWORD=odoo

# --- Odoo ---
ODOO_DB=stage                 # база перезбирається з нуля на кожен деплой
ODOO_DB_FILTER=^stage$        # щоб дивитися копію prod, поставити ^(stage|stage_prodcopy)$ і відкрити /web?db=stage_prodcopy
ODOO_HTTP_PORT=8140           # лише 127.0.0.1, назовні пускає тільки тунель
ODOO_WORKERS=2
ODOO_ADMIN_PASSWD=            # майстер-пароль менеджера баз (менеджер вимкнено, пароль лишається запасним ключем)
ODOO_ADMIN_USER_LOGIN=admin
ODOO_ADMIN_USER_PASSWORD=     # пароль користувача admin на staging; його ж читають scripts/demo_*.py

# --- міст назовні (Worker odoo-live) ---
BP_BRIDGE_URL=https://odoo-live.botpartners.workers.dev
# Worker приймає один токен, тож staging і prod ділять його: хто має доступ до staging,
# той має і доступ до мосту prod. Окремий токен для staging - у docs/open-source-plan.md, фаза 2.
BP_BRIDGE_TOKEN=

# --- мережа для тунелю ---
EDGE_NETWORK=odoo-edge        # спільна зовнішня мережа docker, створює server-setup.sh
EDGE_ALIAS=odoo-staging       # це ім'я вписується в маршрут тунелю для staging.<домен>

# --- образ ---
ODOO_IMAGE=odoo-live-server
IMAGE_TAG=current             # deploy.sh підставляє короткий sha коміту; current - останній вдалий
