# Скопіювати на сервері в deploy/env.prod і заповнити значення.
# Значення - лише на сервері і в 1Password > ToolKit > odoo-live. У репозиторії - ніколи.
# Це жива база: паролі тут інші, ніж на staging.

COMPOSE_PROJECT_NAME=odoo-prod
ENV_NAME=prod

# --- Postgres ---
PG_USER=odoo
PG_PASSWORD=                  # пароль Postgres живої бази

# --- Odoo ---
ODOO_DB=odoo                  # жива база; deploy.sh її ніколи не перезбирає, лише оновлює модулі
ODOO_DB_FILTER=^odoo$
ODOO_HTTP_PORT=8150           # лише 127.0.0.1
ODOO_WORKERS=2
ODOO_ADMIN_PASSWD=            # майстер-пароль менеджера баз
ODOO_ADMIN_USER_LOGIN=admin
ODOO_ADMIN_USER_PASSWORD=     # пароль користувача admin на prod

# --- міст назовні (Worker odoo-live) ---
BP_BRIDGE_URL=https://odoo-live.botpartners.workers.dev
BP_BRIDGE_TOKEN=

# --- мережа для тунелю ---
EDGE_NETWORK=odoo-edge
EDGE_ALIAS=odoo-prod          # це ім'я вписується в маршрут тунелю для app.<домен>

# --- образ ---
ODOO_IMAGE=odoo-live-server
IMAGE_TAG=current             # для відкату поставити тег попереднього образу і запустити deploy.sh prod --no-pull

# --- резервні копії (deploy/backup.sh) ---
BACKUP_KEEP_DAILY=14          # скільки денних копій prod тримати
BACKUP_KEEP_WEEKLY=4          # скільки тижневих копій staging тримати
RCLONE_REMOTE=                # напр. b2:bp-odoo-backups; порожньо - копії лишаються лише на сервері
