# Copy to .env and fill in. .env is ignored by git. Keep comments on their own lines:
# the scripts read values literally, so "x=1  # note" would make the value "1  # note".

# Containers and volumes are created under this name; scripts/test.sh checks it.
COMPOSE_PROJECT_NAME=odoo-live-base
# Development stack port; the demo from scripts/demo_server.sh uses 8131.
ODOO_PORT=8130

# Odoo database manager master password (any value for local use).
ODOO_ADMIN_PASSWD=
# The admin user of the dev and demo databases.
ODOO_ADMIN_USER_LOGIN=admin
ODOO_ADMIN_USER_PASSWORD=

# Optional reviewer account used by some check scripts.
LANA_LOGIN=lana
LANA_PASSWORD=

# --- Optional services: leave empty and the features that need them stay off ---
# Integration bridge (registry lookups, KYC register); see worker/ and docs/ARCHITECTURE.md.
BP_BRIDGE_URL=
BP_BRIDGE_TOKEN=
# Profession code (KP) suggestion service; without it the KP directory works offline.
UA_KP_URL=
ODOO_DEMO_LINK_TOKEN=
