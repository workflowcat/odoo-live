# скопіювати в .env і заповнити; .env не в репозиторії (значення - 1Password > ToolKit > odoo-live)
COMPOSE_PROJECT_NAME=odoo-live-base   # томи і контейнери стенду створені під цією назвою
ODOO_PORT=8130                        # стенд розробки; демо - 8131 через scripts/demo_server.sh
ODOO_ADMIN_PASSWD=                    # майстер-пароль менеджера баз Odoo
ODOO_ADMIN_USER_LOGIN=admin
ODOO_ADMIN_USER_PASSWORD=             # пароль користувача admin (стенд і демо)
LANA_LOGIN=lana                       # користувач-рецензент для payroll-review
LANA_PASSWORD=
BP_BRIDGE_TOKEN=                      # той самий, що секрет BRIDGE_TOKEN Worker-а odoo-live
ODOO_DEMO_LINK_TOKEN=
