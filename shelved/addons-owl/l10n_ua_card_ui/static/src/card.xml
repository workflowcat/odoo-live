<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
  <div t-name="l10n_ua_card_ui.EmployeeCard" class="o_ua_employee_card">
    <div t-if="state.loading" class="o_ua_card_loading">Завантаження…</div>
    <div t-elif="!state.data" class="o_ua_card_empty text-muted">Немає даних.</div>
    <t t-else="">
      <div class="o_ua_card_header o_ua_head">
        <div class="o_ua_card_avatar">
          <img t-if="!state.avatarFailed" t-att-src="state.data.header.avatar_url" t-on-error="onAvatarError" alt=""/>
          <div t-else="" class="o_ua_card_initials" t-esc="state.data.header.initials"/>
        </div>
        <div class="o_ua_card_identity o_ua_head_title">
          <div class="o_ua_card_name_row">
            <span class="o_ua_card_name" t-esc="state.data.header.name"/>
            <span t-if="statusPill" t-att-class="'o_ua_pill ' + statusPill.css" t-esc="statusPill.label"/>
            <span t-foreach="extraBadges" t-as="badge" t-key="badge.label"
                  t-att-class="'o_ua_pill ' + badge.css" t-esc="badge.label"/>
          </div>
          <div class="o_ua_head_subtitle" t-esc="contextLine"/>
          <div t-if="state.data.header.previous_employee" class="o_ua_head_subtitle">
            Попередня картка:
            <a href="#" t-on-click.prevent="() => this.openRecord('hr.employee', state.data.header.previous_employee.id)"
               t-esc="state.data.header.previous_employee.name + (state.data.header.previous_employee.dates ? ' (' + state.data.header.previous_employee.dates + ')' : '')"/>
          </div>
        </div>
        <div class="o_ua_card_print_buttons o_ua_head_actions">
          <t t-foreach="primaryActions" t-as="act" t-key="act.key">
            <button type="button" class="btn btn-primary btn-sm" t-on-click="() => this.onActionClick(act)" t-esc="act.label"/>
          </t>
          <t t-foreach="secondaryActions" t-as="act" t-key="act.key">
            <button type="button" class="btn btn-secondary btn-sm" t-on-click="() => this.onActionClick(act)" t-esc="act.label"/>
          </t>
          <Dropdown t-if="moreActions.length">
            <button class="btn btn-sm btn-outline-secondary">Ще</button>
            <t t-set-slot="content">
              <DropdownItem t-foreach="moreActions" t-as="act" t-key="act.key"
                            onSelected="() => this.onActionClick(act)" t-esc="act.label"/>
            </t>
          </Dropdown>
        </div>
      </div>

      <div class="o_ua_card_body">
        <div class="o_ua_card_column">
          <div class="o_ua_card_section">
            <div class="o_ua_sec_head">
              <h6>Особа</h6>
              <a href="#" class="o_ua_card_show_all" t-on-click.prevent="() => this.toggleShowAll('person')"
                 t-esc="state.showAll.person ? 'Приховати порожні' : 'Показати всі'"/>
            </div>
            <table t-if="sectionHasValues('person') or state.showAll.person" class="o_ua_card_table">
              <tr t-foreach="sectionRows('person')" t-as="row" t-key="row.label">
                <td class="o_ua_card_label" t-esc="row.label"/>
                <td t-att-class="'o_ua_card_value' + (row.numeric ? ' o_ua_card_numeric' : '') + (row.empty ? ' text-muted' : '')" t-esc="row.value"/>
              </tr>
            </table>
            <p t-else="" class="o_ua_card_nodata text-muted">немає даних</p>
          </div>

          <div class="o_ua_card_section">
            <div class="o_ua_sec_head">
              <h6>Відпустка</h6>
              <a href="#" class="o_ua_card_show_all" t-on-click.prevent="() => this.toggleShowAll('vacation')"
                 t-esc="state.showAll.vacation ? 'Приховати порожні' : 'Показати всі'"/>
            </div>
            <table t-if="sectionHasValues('vacation') or state.showAll.vacation" class="o_ua_card_table">
              <tr t-foreach="sectionRows('vacation')" t-as="row" t-key="row.label">
                <td class="o_ua_card_label" t-esc="row.label"/>
                <td t-att-class="'o_ua_card_value' + (row.numeric ? ' o_ua_card_numeric' : '') + (row.empty ? ' text-muted' : '')" t-esc="row.value"/>
              </tr>
            </table>
            <p t-else="" class="o_ua_card_nodata text-muted">немає даних</p>
          </div>
        </div>

        <div class="o_ua_card_column">
          <div class="o_ua_card_section">
            <div class="o_ua_sec_head">
              <h6>Оплата</h6>
              <a href="#" class="o_ua_card_show_all" t-on-click.prevent="() => this.toggleShowAll('pay')"
                 t-esc="state.showAll.pay ? 'Приховати порожні' : 'Показати всі'"/>
            </div>
            <table t-if="sectionHasValues('pay') or state.showAll.pay" class="o_ua_card_table">
              <tr t-foreach="sectionRows('pay')" t-as="row" t-key="row.label">
                <td class="o_ua_card_label" t-esc="row.label"/>
                <td t-att-class="'o_ua_card_value' + (row.numeric ? ' o_ua_card_numeric' : '') + (row.empty ? ' text-muted' : '')" t-esc="row.value"/>
              </tr>
            </table>
            <p t-else="" class="o_ua_card_nodata text-muted">немає даних</p>
          </div>

          <div class="o_ua_card_section">
            <div class="o_ua_sec_head">
              <h6>Військовий облік</h6>
              <a href="#" class="o_ua_card_show_all" t-on-click.prevent="() => this.toggleShowAll('military')"
                 t-esc="state.showAll.military ? 'Приховати порожні' : 'Показати всі'"/>
            </div>
            <table t-if="sectionHasValues('military') or state.showAll.military" class="o_ua_card_table">
              <tr t-foreach="sectionRows('military')" t-as="row" t-key="row.label">
                <td class="o_ua_card_label" t-esc="row.label"/>
                <td t-att-class="'o_ua_card_value' + (row.numeric ? ' o_ua_card_numeric' : '') + (row.empty ? ' text-muted' : '')" t-esc="row.value"/>
              </tr>
            </table>
            <p t-else="" class="o_ua_card_nodata text-muted">немає даних</p>
          </div>
        </div>

        <div class="o_ua_card_column o_ua_card_side">
          <div class="o_ua_card_section">
            <div class="o_ua_sec_head">
              <h6>
                Документи
                <t t-if="documentsToSignCount"> · <t t-esc="documentsToSignCount"/> на підпис</t>
              </h6>
            </div>
            <ul t-if="state.documents.length" class="o_ua_card_doclist">
              <li t-foreach="state.documents" t-as="doc" t-key="doc.id" class="o_ua_card_docrow">
                <div class="o_ua_card_docrow_main">
                  <span class="o_ua_card_doctype" t-esc="doc.type"/>
                  <span t-att-class="'o_ua_pill ' + doc.pill_css" t-esc="doc.pill_label"/>
                </div>
                <div class="o_ua_card_docrow_meta text-muted">
                  <span t-if="doc.signed_date">Підписано <t t-esc="doc.signed_date"/></span>
                  <span t-else="">Діє до <t t-esc="doc.valid_until"/></span>
                </div>
                <div class="o_ua_card_doc_actions">
                  <a t-if="doc.can_sign" href="#" class="o_ua_card_doc_link" t-on-click.prevent="(ev) => this.onDocumentSign(doc, ev)">Підписано</a>
                  <a t-if="doc.can_print" href="#" class="o_ua_card_doc_link" t-on-click.prevent="() => this.onDocumentPrint(doc)">Друк</a>
                </div>
              </li>
            </ul>
            <p t-else="" class="o_ua_card_nodata text-muted">Документів немає</p>
          </div>

          <div class="o_ua_card_section">
            <div class="o_ua_sec_head">
              <h6>Хроніка</h6>
              <a t-if="hasMoreTimeline" href="#" class="o_ua_card_show_all" t-on-click.prevent="() => this.toggleShowAll('timeline')"
                 t-esc="state.showAll.timeline ? 'Приховати' : 'Показати всі'"/>
            </div>
            <ul t-if="visibleTimeline.length" class="o_ua_card_timeline_list">
              <li t-foreach="visibleTimeline" t-as="ev" t-key="ev_index" class="o_ua_card_timeline_row">
                <a href="#" t-on-click.prevent="() => this.openRecord(ev.res_model, ev.res_id)">
                  <span class="o_ua_card_numeric" t-esc="ev.date"/>
                  <span class="o_ua_card_timeline_label" t-esc="ev.label"/>
                  <span class="text-muted" t-esc="ev.detail"/>
                </a>
              </li>
            </ul>
            <p t-else="" class="o_ua_card_nodata text-muted">немає даних</p>
          </div>
        </div>
      </div>
    </t>
  </div>
</templates>
