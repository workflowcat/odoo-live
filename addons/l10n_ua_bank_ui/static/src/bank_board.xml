<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
  <t t-name="l10n_ua_bank_ui.BankBoard" owl="1">
    <div class="o_ua_bank">
      <t t-if="state.loading">
        <div class="text-muted p-4">Завантаження…</div>
      </t>
      <t t-elif="state.data">
        <t t-set="data" t-value="state.data"/>

        <div class="o_ua_bank_left">
          <div class="o_ua_bank_period">
            <button class="btn btn-sm btn-link" t-on-click="() => this.shiftPeriod(-1)">◀</button>
            <span t-esc="this.periodLabel"/>
            <button class="btn btn-sm btn-link" t-on-click="() => this.shiftPeriod(1)">▶</button>
          </div>
          <button t-if="this.connectedCount > 1" class="btn btn-sm btn-outline-secondary"
                  t-att-disabled="state.busy" t-on-click="pullAll">Завантажити всі рахунки</button>
          <div t-if="data.accounts.length > 1" class="o_ua_bank_total">
            <span t-esc="this.money(data.totals.balance)"/>
            <span class="o_ua_lbl">разом на рахунках</span>
            <span t-if="data.totals.unreconciled" class="o_ua_lbl">
              незвірених за місяць: <t t-esc="data.totals.unreconciled"/>
            </span>
          </div>
          <div t-foreach="data.accounts" t-as="a" t-key="a.journal_id"
               t-attf-class="o_ua_bank_account #{a.journal_id === state.journalId ? 'active' : ''}"
               t-on-click="() => this.select(a.journal_id)">
            <div class="o_ua_bank_account_name" t-esc="a.name"/>
            <div t-if="a.iban" class="o_ua_bank_account_iban" t-esc="a.iban"/>
            <div class="o_ua_bank_account_balance">
              <span t-esc="this.money(a.balance)"/>
              <span class="text-muted ms-1" t-esc="a.currency"/>
            </div>
            <div class="o_ua_bank_account_state">
              <span t-if="a.demo" class="o_ua_pill o_ua_pill_warn">демо</span>
              <span t-elif="a.provider_id" class="o_ua_pill o_ua_pill_ok" t-esc="a.service_label"/>
              <span t-else="" class="o_ua_pill" t-esc="a.connect.label"/>
              <span t-if="a.unreconciled" class="o_ua_pill o_ua_pill_crit">
                незвірених <t t-esc="a.unreconciled"/>
              </span>
            </div>
          </div>
        </div>

        <div class="o_ua_bank_right" t-if="this.account">
          <div class="o_ua_bank_header o_ua_head">
            <div class="o_ua_head_title">
              <h4 t-esc="this.account.name"/>
              <div class="o_ua_head_subtitle">
                <span t-esc="this.account.iban || 'рахунок у з\'єднанні не вказано'"/>
                <span t-if="!this.account.provider_id"> · підключення: <t t-esc="this.account.connect.label"/></span>
              </div>
            </div>
            <!-- одна головна кнопка: наступний крок. Решта - у «Ще». -->
            <div class="o_ua_bank_actions o_ua_head_actions">
              <t t-if="this.account.provider_id">
                <button class="btn btn-sm btn-primary" t-att-disabled="state.busy" t-on-click="pullMonth">Завантажити за місяць</button>
              </t>
              <t t-else="">
                <button class="btn btn-sm btn-primary" t-on-click="openConnect">Підготовка до підключення</button>
              </t>
              <button class="btn btn-sm btn-secondary" t-on-click="reconcile">Звірити</button>
              <Dropdown>
                <button class="btn btn-sm btn-outline-secondary">Ще</button>
                <t t-set-slot="content">
                  <t t-if="this.account.provider_id">
                    <DropdownItem onSelected="() => this.pullToday()">З початку місяця по сьогодні</DropdownItem>
                    <DropdownItem onSelected="() => this.test()">Перевірити зв'язок</DropdownItem>
                    <DropdownItem onSelected="() => this.openProvider()">З'єднання</DropdownItem>
                  </t>
                  <t t-else="">
                    <DropdownItem onSelected="() => this.createProvider('ua_privat')">Створити з'єднання ПриватБанк</DropdownItem>
                    <DropdownItem onSelected="() => this.createProvider('ua_mono')">Створити з'єднання Monobank</DropdownItem>
                  </t>
                  <DropdownItem onSelected="() => this.importFile()">Виписка файлом</DropdownItem>
                  <DropdownItem onSelected="() => this.applyRules()">Застосувати правила</DropdownItem>
                  <DropdownItem onSelected="() => this.openStatements()">Виписки</DropdownItem>
                </t>
              </Dropdown>
            </div>
          </div>

          <div class="o_ua_numbers">
            <div><span class="o_ua_num" t-esc="this.money(this.account.balance)"/><span class="o_ua_lbl">залишок за рахунком</span></div>
            <div><span class="o_ua_num" t-esc="this.money(this.account.amount_in)"/><span class="o_ua_lbl">надходження за місяць</span></div>
            <div><span class="o_ua_num" t-esc="this.money(this.account.amount_out)"/><span class="o_ua_lbl">списання за місяць</span></div>
            <div><span class="o_ua_num" t-esc="this.account.lines_month"/><span class="o_ua_lbl">рядків виписки</span></div>
            <div t-if="this.account.last_run"><span class="o_ua_num o_ua_num_sm" t-esc="this.account.last_run"/><span class="o_ua_lbl">останнє завантаження<t t-if="this.account.schedule"> · розклад <t t-esc="this.account.schedule"/></t></span></div>
            <div><span t-attf-class="o_ua_num #{this.account.unreconciled ? 'text-danger' : ''}" t-esc="this.account.unreconciled"/><span class="o_ua_lbl">не звірено за місяць</span></div>
          </div>

          <div class="o_ua_bank_section">
            <h5>Зарплатні платежі періоду</h5>
            <table class="o_ua_table">
              <thead><tr><th>Дата</th><th>Платіж</th><th class="text-end">Сума</th><th>Стан</th></tr></thead>
              <tbody>
                <tr t-foreach="data.payments" t-as="p" t-key="p_index">
                  <td t-esc="p.date || '—'"/>
                  <td><div t-esc="p.label"/><div t-if="p.detail" class="text-muted small" t-esc="p.detail"/></td>
                  <td class="text-end" t-esc="this.money(p.amount)"/>
                  <td><span t-attf-class="o_ua_pill o_ua_bank_state_#{p.state_class}" t-esc="p.state"/></td>
                </tr>
                <tr t-if="!data.payments.length"><td colspan="4" class="text-muted">За цей місяць платежів немає.</td></tr>
              </tbody>
            </table>
          </div>

          <div class="o_ua_bank_section">
            <h5>Незвірені рядки, усі періоди</h5>
            <table class="o_ua_table">
              <thead><tr><th>Дата</th><th>Призначення</th><th>Контрагент</th><th class="text-end">Сума</th><th>Платіж</th></tr></thead>
              <tbody>
                <tr t-foreach="this.unreconciled" t-as="l" t-key="l.id" class="o_ua_bank_clickable"
                    t-on-click="() => this.openLine(l)">
                  <td t-esc="l.date"/>
                  <td t-esc="l.ref"/>
                  <td t-esc="l.partner || '—'"/>
                  <td class="text-end" t-esc="this.money(l.amount)"/>
                  <td t-on-click.stop="() => this.matchPayment(l)">
                    <button t-if="l.payment_id" class="btn btn-sm btn-link p-0" t-att-disabled="state.busy">
                      <span class="o_ua_pill o_ua_pill_ok">платіж знайдено</span>
                    </button>
                  </td>
                </tr>
                <tr t-if="!this.unreconciled.length"><td colspan="5" class="text-muted">Незвірених рядків немає.</td></tr>
              </tbody>
            </table>
          </div>

          <div class="o_ua_bank_section" t-if="this.statements.length">
            <h5>Виписки періоду</h5>
            <table class="o_ua_table">
              <thead><tr><th>Дата</th><th>Виписка</th><th class="text-end">Рядків</th><th class="text-end">Сума рядків</th></tr></thead>
              <tbody>
                <tr t-foreach="this.statements" t-as="s" t-key="s.id">
                  <td t-esc="s.date"/>
                  <td t-esc="s.name"/>
                  <td class="text-end" t-esc="s.lines"/>
                  <td class="text-end" t-esc="this.money(s.amount)"/>
                </tr>
              </tbody>
            </table>
          </div>
        </div>

        <div class="o_ua_bank_right" t-else="">
          <div class="text-muted p-4">У компанії немає банківського журналу.</div>
        </div>
      </t>
    </div>
  </t>
</templates>
