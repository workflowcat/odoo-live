<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <!-- Клієнтська дія «Прийняття» і її пункт меню живуть у l10n_ua_hire_ui: тут лишається
       лише те, що стосується самих даних. -->

  <!-- «Новий працівник» зі списку працівників веде повз перевірки справи прийняття (обов'язкові
       поля, документи, наказ). Поки немає клієнтського редиректу на список - ховаємо кнопку
       створення і показуємо, де оформити прийняття. -->
  <record id="hr_employee_view_list_no_create" model="ir.ui.view">
    <field name="name">hr.employee.list.ua.hire.no.create</field>
    <field name="model">hr.employee</field>
    <field name="inherit_id" ref="hr.view_employee_tree"/>
    <field name="arch" type="xml">
      <xpath expr="//list" position="attributes">
        <attribute name="create">false</attribute>
      </xpath>
    </field>
  </record>
</odoo>
