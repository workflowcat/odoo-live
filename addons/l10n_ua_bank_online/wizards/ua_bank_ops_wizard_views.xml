<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="view_ua_bank_ops_wizard_form" model="ir.ui.view">
    <field name="name">ua.bank.ops.wizard.form</field>
    <field name="model">ua.bank.ops.wizard</field>
    <field name="arch" type="xml">
      <form string="Операції банку">
        <group>
          <field name="operation"/>
          <field name="journal_id"/>
          <field name="year" invisible="operation not in ('pull_month', 'pull_all')"/>
          <field name="month" invisible="operation not in ('pull_month', 'pull_all')"/>
          <field name="service" invisible="operation != 'open_provider'"/>
        </group>
        <field name="result_message" invisible="not result_message" readonly="1"/>
        <footer>
          <button name="action_run" type="object" string="Виконати" class="btn-primary"/>
          <button string="Закрити" class="btn-secondary" special="cancel"/>
        </footer>
      </form>
    </field>
  </record>

  <record id="action_ua_bank_ops" model="ir.actions.act_window">
    <field name="name">Операції банку</field>
    <field name="res_model">ua.bank.ops.wizard</field>
    <field name="view_mode">form</field>
    <field name="target">new</field>
  </record>
</odoo>
