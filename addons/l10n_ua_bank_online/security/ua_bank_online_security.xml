<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <!-- Правила компанії: записи однієї компанії не видно з іншої. Той самий домен,
       що в нативних документах Odoo; рядок бере компанію в документа, на якому висить,
       а довідник із порожньою компанією спільний для всіх. -->
  <record id="rule_ua_bank_connect_company" model="ir.rule">
    <field name="name">Підключення банку: лише свої компанії</field>
    <field name="model_id" ref="model_ua_bank_connect"/>
    <field name="domain_force">[('company_id', 'in', company_ids)]</field>
  </record>

  <record id="rule_ua_bank_connect_step_company" model="ir.rule">
    <field name="name">Крок підключення банку: лише свої компанії</field>
    <field name="model_id" ref="model_ua_bank_connect_step"/>
    <field name="domain_force">[('connect_id.company_id', 'in', company_ids)]</field>
  </record>
</odoo>
