<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <data noupdate="1">
    <!-- Калькуляції і акти приймання: власні реєстри, нумерація з початку року. -->
    <record id="seq_ua_defense_calculation" model="ir.sequence">
      <field name="name">Калькуляція ціни (постанова № 309)</field>
      <field name="code">l10n_ua_defense.calculation</field>
      <field name="prefix">КЛК-%(range_year)s-</field>
      <field name="padding">4</field>
      <field name="use_date_range" eval="True"/>
      <field name="company_id" eval="False"/>
    </record>
    <record id="seq_ua_defense_acceptance" model="ir.sequence">
      <field name="name">Акт приймання продукції</field>
      <field name="code">l10n_ua_defense.acceptance</field>
      <field name="prefix">АП-%(range_year)s-</field>
      <field name="padding">4</field>
      <field name="use_date_range" eval="True"/>
      <field name="company_id" eval="False"/>
    </record>
  </data>
</odoo>
