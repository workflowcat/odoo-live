<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="mrp_production_form_view_ua_defense" model="ir.ui.view">
    <field name="name">mrp.production.form.ua.defense</field>
    <field name="model">mrp.production</field>
    <field name="inherit_id" ref="mrp.mrp_production_form_view"/>
    <field name="arch" type="xml">
      <field name="user_id" position="after">
        <field name="ua_contract_id" readonly="state in ['cancel', 'done']" options="{'no_create': True}"/>
      </field>
    </field>
  </record>

  <record id="mrp_workcenter_view_ua_defense" model="ir.ui.view">
    <field name="name">mrp.workcenter.form.ua.defense</field>
    <field name="model">mrp.workcenter</field>
    <field name="inherit_id" ref="mrp.mrp_workcenter_view"/>
    <field name="arch" type="xml">
      <xpath expr="//group[@name='costing']" position="inside">
        <field name="ua_wage_hour"/>
        <field name="ua_energy_hour"/>
      </xpath>
    </field>
  </record>

  <record id="product_template_form_view_ua_defense" model="ir.ui.view">
    <field name="name">product.template.form.ua.defense</field>
    <field name="model">product.template</field>
    <field name="inherit_id" ref="product.product_template_form_view"/>
    <field name="arch" type="xml">
      <xpath expr="//field[@name='categ_id']" position="after">
        <field name="ua_cost_item"/>
        <field name="ua_warranty_months"/>
      </xpath>
    </field>
  </record>
</odoo>
