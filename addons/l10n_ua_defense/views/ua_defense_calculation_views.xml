<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="view_ua_defense_calculation_list" model="ir.ui.view">
    <field name="name">ua.defense.calculation.list</field>
    <field name="model">ua.defense.calculation</field>
    <field name="arch" type="xml">
      <list string="Калькуляції ціни">
        <field name="name"/>
        <field name="contract_id"/>
        <field name="product_id"/>
        <field name="kind"/>
        <field name="date"/>
        <field name="quantity" optional="hide"/>
        <field name="price_unit"/>
        <field name="price_unit_vat"/>
        <field name="state" widget="badge" decoration-success="state == 'approved'"/>
        <field name="currency_id" column_invisible="1"/>
      </list>
    </field>
  </record>

  <record id="view_ua_defense_calculation_form" model="ir.ui.view">
    <field name="name">ua.defense.calculation.form</field>
    <field name="model">ua.defense.calculation</field>
    <field name="arch" type="xml">
      <form string="Калькуляція ціни">
        <header>
          <button name="action_compute" type="object" string="Перерахувати" class="oe_highlight"
                  invisible="state == 'approved'"/>
          <button name="action_approve" type="object" string="Затвердити" invisible="state == 'approved'"/>
          <button name="action_reset_draft" type="object" string="У чернетку" invisible="state != 'approved'"/>
          <button name="action_print" type="object" string="Друк"/>
          <field name="state" widget="statusbar"/>
        </header>
        <sheet>
          <div class="oe_title"><h1><field name="name" readonly="1"/></h1></div>
          <group>
            <group>
              <field name="contract_id" readonly="state == 'approved'"/>
              <field name="kind" readonly="state == 'approved'"/>
              <field name="product_id" readonly="state == 'approved'"/>
              <field name="bom_id" invisible="kind != 'plan'" readonly="state == 'approved'"/>
              <field name="plan_id" invisible="kind != 'actual'" readonly="state == 'approved'"/>
            </group>
            <group>
              <field name="date" readonly="state == 'approved'"/>
              <field name="quantity" invisible="kind != 'actual'"/>
              <field name="hours"/>
              <field name="price_unit"/>
              <field name="price_unit_vat"/>
              <field name="company_id" invisible="1"/>
              <field name="currency_id" invisible="1"/>
            </group>
          </group>
          <notebook>
            <page string="Статті" name="items">
              <field name="line_ids" readonly="1">
                <list decoration-bf="is_total">
                  <field name="code"/>
                  <field name="name"/>
                  <field name="amount"/>
                  <field name="amount_total" optional="show"/>
                  <field name="plan_amount" column_invisible="parent.kind != 'actual'"/>
                  <field name="difference" column_invisible="parent.kind != 'actual'"
                         decoration-danger="difference &gt; 0" decoration-success="difference &lt; 0"/>
                  <field name="is_total" column_invisible="1"/>
                  <field name="currency_id" column_invisible="1"/>
                </list>
              </field>
            </page>
            <page string="Розшифровка матеріалів" name="components">
              <field name="component_ids" readonly="1">
                <list>
                  <field name="item"/>
                  <field name="product_id"/>
                  <field name="quantity"/>
                  <field name="uom_id"/>
                  <field name="price"/>
                  <field name="amount" sum="Разом"/>
                  <field name="currency_id" column_invisible="1"/>
                </list>
              </field>
            </page>
            <page string="Замовлення на виробництво" name="productions" invisible="kind != 'actual'">
              <field name="production_ids" readonly="1"/>
            </page>
            <page string="Примітки" name="note">
              <field name="note"/>
            </page>
          </notebook>
        </sheet>
        <chatter/>
      </form>
    </field>
  </record>

  <record id="view_ua_defense_calculation_search" model="ir.ui.view">
    <field name="name">ua.defense.calculation.search</field>
    <field name="model">ua.defense.calculation</field>
    <field name="arch" type="xml">
      <search string="Калькуляції ціни">
        <field name="name"/>
        <field name="contract_id"/>
        <field name="product_id"/>
        <filter name="plan" string="Планові" domain="[('kind', '=', 'plan')]"/>
        <filter name="actual" string="Фактичні" domain="[('kind', '=', 'actual')]"/>
        <group>
          <filter name="by_contract" string="Контракт" context="{'group_by': 'contract_id'}"/>
          <filter name="by_product" string="Виріб" context="{'group_by': 'product_id'}"/>
        </group>
      </search>
    </field>
  </record>

  <record id="action_ua_defense_calculation" model="ir.actions.act_window">
    <field name="name">Калькуляції ціни</field>
    <field name="res_model">ua.defense.calculation</field>
    <field name="view_mode">list,form</field>
    <field name="help" type="html">
      <p class="o_view_nocontent_smiling_face">Калькуляцій ще немає</p>
      <p>Планова калькуляція будується зі специфікації і маршруту, фактична - із закритих замовлень на виробництво за контрактом.</p>
    </field>
  </record>
</odoo>
