<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <record id="view_ua_stock_inventory_list" model="ir.ui.view">
    <field name="name">ua.stock.inventory.list</field>
    <field name="model">ua.stock.inventory</field>
    <field name="arch" type="xml">
      <list string="Інвентаризація">
        <field name="name"/>
        <field name="date"/>
        <field name="location_id"/>
        <field name="basis"/>
        <field name="amount_surplus" sum="Лишки"/>
        <field name="amount_shortage" sum="Нестачі"/>
        <field name="state" widget="badge"/>
        <field name="currency_id" column_invisible="1"/>
      </list>
    </field>
  </record>

  <record id="view_ua_stock_inventory_form" model="ir.ui.view">
    <field name="name">ua.stock.inventory.form</field>
    <field name="model">ua.stock.inventory</field>
    <field name="arch" type="xml">
      <form string="Інвентаризація">
        <header>
          <button name="action_fill" type="object" string="Заповнити залишками"
                  invisible="state == 'done'"/>
          <button name="action_apply" type="object" string="Провести"
                  class="oe_highlight" invisible="state != 'counting'"/>
          <button name="action_open_moves" type="object" string="Коригування"
                  invisible="not move_ids"/>
          <field name="state" widget="statusbar" statusbar_visible="draft,counting,done"/>
        </header>
        <sheet>
          <div class="oe_title">
            <h1><field name="name" readonly="1"/></h1>
          </div>
          <group>
            <group string="Підстава">
              <field name="date" readonly="state == 'done'"/>
              <field name="location_id" readonly="state == 'done'"/>
              <field name="basis" readonly="state == 'done'"/>
              <field name="company_id" groups="base.group_multi_company"/>
            </group>
            <group string="Комісія">
              <field name="chair" readonly="state == 'done'"/>
              <field name="members" readonly="state == 'done'"/>
              <field name="keeper" readonly="state == 'done'"/>
            </group>
          </group>
          <group>
            <group string="Результат">
              <field name="amount_surplus"/>
              <field name="amount_shortage"/>
              <field name="surplus_move_id"/>
              <field name="currency_id" invisible="1"/>
              <field name="move_ids" invisible="1" widget="many2many_tags"/>
            </group>
          </group>
          <notebook>
            <page string="Опис">
              <field name="line_ids" readonly="state == 'done'">
                <list editable="bottom">
                  <field name="product_id"/>
                  <field name="uom_id"/>
                  <field name="qty_book"/>
                  <field name="qty_fact"/>
                  <field name="qty_diff"/>
                  <field name="cost"/>
                  <field name="amount_diff" sum="Різниця"/>
                  <field name="currency_id" column_invisible="1"/>
                </list>
              </field>
            </page>
          </notebook>
        </sheet>
      </form>
    </field>
  </record>

  <record id="action_ua_stock_inventory" model="ir.actions.act_window">
    <field name="name">Інвентаризація</field>
    <field name="res_model">ua.stock.inventory</field>
    <field name="view_mode">list,form</field>
  </record>

  <record id="view_picking_form_ua_act" model="ir.ui.view">
    <field name="name">stock.picking.form.ua.act</field>
    <field name="model">stock.picking</field>
    <field name="inherit_id" ref="l10n_ua_docs_stock.view_picking_form_ua_docs"/>
    <field name="arch" type="xml">
      <xpath expr="//field[@name='ua_proxy_person']" position="after">
        <field name="ua_act_handover"/>
        <field name="ua_act_receiver"/>
        <field name="ua_act_condition"/>
      </xpath>
    </field>
  </record>

</odoo>
