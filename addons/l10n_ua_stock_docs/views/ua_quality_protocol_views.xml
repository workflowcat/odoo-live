<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <record id="view_ua_quality_protocol_list" model="ir.ui.view">
    <field name="name">ua.quality.protocol.list</field>
    <field name="model">ua.quality.protocol</field>
    <field name="arch" type="xml">
      <list string="Перевірка якості">
        <field name="name"/>
        <field name="date"/>
        <field name="product_id"/>
        <field name="lot_id"/>
        <field name="quantity"/>
        <field name="inspector"/>
        <field name="state" widget="badge"/>
      </list>
    </field>
  </record>

  <record id="view_ua_quality_protocol_form" model="ir.ui.view">
    <field name="name">ua.quality.protocol.form</field>
    <field name="model">ua.quality.protocol</field>
    <field name="arch" type="xml">
      <form string="Перевірка якості">
        <header>
          <button name="action_fill_checklist" type="object" string="Типовий перелік"
                  invisible="state != 'draft'"/>
          <button name="action_pass" type="object" string="Придатний"
                  class="oe_highlight" invisible="state == 'passed'"/>
          <button name="action_fail" type="object" string="Не придатний"
                  invisible="state == 'failed'"/>
          <field name="state" widget="statusbar" statusbar_visible="draft,passed,failed"/>
        </header>
        <sheet>
          <div class="oe_title">
            <h1><field name="name" readonly="1"/></h1>
          </div>
          <group>
            <group string="Об'єкт">
              <field name="product_id"/>
              <field name="lot_id"/>
              <field name="quantity"/>
              <field name="uom_id"/>
            </group>
            <group string="Перевірка">
              <field name="date"/>
              <field name="inspector"/>
              <field name="move_id"/>
              <field name="picking_id"/>
              <field name="company_id" groups="base.group_multi_company"/>
            </group>
          </group>
          <notebook>
            <page string="Параметри">
              <field name="line_ids">
                <list editable="bottom">
                  <field name="sequence" widget="handle"/>
                  <field name="name"/>
                  <field name="uom"/>
                  <field name="norm"/>
                  <field name="value"/>
                  <field name="result"/>
                </list>
              </field>
            </page>
            <page string="Примітки">
              <field name="note"/>
            </page>
          </notebook>
        </sheet>
      </form>
    </field>
  </record>

  <record id="action_ua_quality_protocol" model="ir.actions.act_window">
    <field name="name">Перевірка якості</field>
    <field name="res_model">ua.quality.protocol</field>
    <field name="view_mode">list,form</field>
  </record>

</odoo>
