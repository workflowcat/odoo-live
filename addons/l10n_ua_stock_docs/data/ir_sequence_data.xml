<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <data noupdate="1">

    <record id="seq_ua_stock_inventory" model="ir.sequence">
      <field name="name">Інвентаризація запасів</field>
      <field name="code">ua.stock.inventory</field>
      <field name="prefix">ІНВ/%(year)s/</field>
      <field name="padding">4</field>
      <field name="company_id" eval="False"/>
    </record>

    <record id="seq_ua_quality_protocol" model="ir.sequence">
      <field name="name">Протокол перевірки якості</field>
      <field name="code">ua.quality.protocol</field>
      <field name="prefix">ЯК/%(year)s/</field>
      <field name="padding">4</field>
      <field name="company_id" eval="False"/>
    </record>

  </data>
</odoo>
