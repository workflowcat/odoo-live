<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="product_template_form_view_ua_precious" model="ir.ui.view">
    <field name="name">product.template.form.ua.precious</field>
    <field name="model">product.template</field>
    <field name="inherit_id" ref="product.product_template_form_view"/>
    <field name="arch" type="xml">
      <xpath expr="//notebook" position="inside">
        <page string="Дорогоцінні метали" name="ua_precious">
          <group>
            <field name="ua_precious_summary"/>
          </group>
          <field name="ua_precious_ids">
            <list editable="bottom">
              <field name="metal_id" options="{'no_create': True}"/>
              <field name="grams"/>
              <field name="source"/>
            </list>
          </field>
          <div class="text-muted">Власний вміст товару: для купованого компонента - з довідкових даних
            виробника; для виробу - лише те, чого немає в складових специфікації (покриття, припій).</div>
        </page>
      </xpath>
    </field>
  </record>

  <record id="product_template_list_view_ua_precious" model="ir.ui.view">
    <field name="name">product.template.list.ua.precious</field>
    <field name="model">product.template</field>
    <field name="inherit_id" ref="product.product_template_tree_view"/>
    <field name="arch" type="xml">
      <xpath expr="//field[@name='name']" position="after">
        <field name="ua_precious_summary" optional="hide"/>
      </xpath>
    </field>
  </record>

  <record id="view_ua_precious_metal_list" model="ir.ui.view">
    <field name="name">ua.precious.metal.list</field>
    <field name="model">ua.precious.metal</field>
    <field name="arch" type="xml">
      <list editable="bottom">
        <field name="sequence" widget="handle"/>
        <field name="name"/>
        <field name="code"/>
        <field name="active" widget="boolean_toggle"/>
      </list>
    </field>
  </record>

  <record id="action_ua_precious_metal" model="ir.actions.act_window">
    <field name="name">Дорогоцінні метали</field>
    <field name="res_model">ua.precious.metal</field>
    <field name="view_mode">list</field>
    <field name="context">{'active_test': False}</field>
  </record>

  <record id="action_ua_precious_products" model="ir.actions.act_window">
    <field name="name">Товари з дорогоцінними металами</field>
    <field name="res_model">product.template</field>
    <field name="view_mode">list,form</field>
    <field name="domain">[('ua_precious_ids', '!=', False)]</field>
  </record>

  <record id="view_ua_precious_report_form" model="ir.ui.view">
    <field name="name">ua.precious.report.form</field>
    <field name="model">ua.precious.report</field>
    <field name="arch" type="xml">
      <form>
        <group>
          <group>
            <field name="date_from"/>
            <field name="date_to"/>
          </group>
          <group>
            <field name="company_id" groups="base.group_multi_company"/>
          </group>
        </group>
        <div class="text-muted">Вміст рахується за чинними даними товарів і специфікацій.</div>
        <footer>
          <button name="action_print" string="Друкувати" type="object" class="oe_highlight"/>
          <button string="Скасувати" special="cancel"/>
        </footer>
      </form>
    </field>
  </record>

  <record id="action_ua_precious_report" model="ir.actions.act_window">
    <field name="name">Відомість дорогоцінних металів</field>
    <field name="res_model">ua.precious.report</field>
    <field name="view_mode">form</field>
    <field name="target">new</field>
  </record>
</odoo>
