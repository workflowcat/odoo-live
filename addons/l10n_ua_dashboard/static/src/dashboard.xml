<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
  <t t-name="l10n_ua_dashboard.Dashboard" owl="1">
    <div class="o_ua_dashboard">
      <t t-if="state.loading">
        <div class="o_ua_dashboard_loading text-muted p-4">Завантаження…</div>
      </t>
      <t t-elif="state.data">
        <t t-set="data" t-value="state.data"/>

        <!-- Заголовок -->
        <div class="o_ua_dashboard_header o_ua_head">
          <div class="o_ua_dashboard_title o_ua_head_title">
            <h3 t-esc="data.company.name"/>
            <span class="o_ua_head_subtitle" t-if="data.company.edrpou">ЄДРПОУ <t t-esc="data.company.edrpou"/> · <t t-esc="data.company.employee_count"/> активних працівників</span>
            <span class="o_ua_head_subtitle" t-else=""><t t-esc="data.company.employee_count"/> активних працівників</span>
          </div>
          <div class="o_ua_months">
            <t t-foreach="data.periods" t-as="period" t-key="period.year + '-' + period.month">
              <span t-attf-class="o_ua_month #{period.month === data.company.month and period.year === data.company.year ? 'active' : ''}"
                    t-on-click="() => this.onSelectPeriod(period)" t-esc="period.label"/>
            </t>
          </div>
        </div>

        <!-- Нарахування по підрозділах -->
        <div class="o_ua_dashboard_section">
          <h5><t t-esc="data.company.month_label"/> <t t-esc="data.company.year"/>: нарахування по підрозділах</h5>
          <t t-if="!data.payroll_by_department.rows.length">
            <div class="o_ua_dashboard_empty text-muted">
              Листків за цей місяць немає.
              <button type="button" class="btn btn-sm btn-link p-0"
                      t-if="data.payroll_by_department.run_action"
                      t-on-click="() => this.openActionXmlid(data.payroll_by_department.run_action)">
                Відкрити пакети листків
              </button>
            </div>
          </t>
          <div t-else="" class="o_ua_wide">
          <table class="o_ua_table">
            <thead>
              <tr>
                <th>Підрозділ</th>
                <th class="text-end">Працівників</th>
                <th class="text-end">Нараховано</th>
                <th class="text-end">ПДФО</th>
                <th class="text-end">ВЗ</th>
                <th class="text-end">ЄСВ</th>
                <th class="text-end">До виплати</th>
              </tr>
            </thead>
            <tbody>
              <tr t-foreach="data.payroll_by_department.rows" t-as="row" t-key="row.department"
                  t-attf-class="#{this.hasTarget(row) ? 'o_ua_clickable' : ''}"
                  t-on-click="() => this.openRow(row)">
                <td t-esc="row.department"/>
                <td class="text-end" t-esc="row.employees"/>
                <td class="text-end tabular-nums" t-esc="this.fmt(row.gross)"/>
                <td class="text-end tabular-nums" t-esc="this.fmt(row.pdfo)"/>
                <td class="text-end tabular-nums" t-esc="this.fmt(row.vz)"/>
                <td class="text-end tabular-nums" t-esc="this.fmt(row.esv)"/>
                <td class="text-end tabular-nums" t-esc="this.fmt(row.net)"/>
              </tr>
            </tbody>
            <tfoot>
              <tr class="o_ua_total o_ua_clickable"
                  t-on-click="() => this.openRow(data.payroll_by_department.total)">
                <td>Разом</td>
                <td class="text-end" t-esc="data.payroll_by_department.total.employees"/>
                <td class="text-end tabular-nums" t-esc="this.fmt(data.payroll_by_department.total.gross)"/>
                <td class="text-end tabular-nums" t-esc="this.fmt(data.payroll_by_department.total.pdfo)"/>
                <td class="text-end tabular-nums" t-esc="this.fmt(data.payroll_by_department.total.vz)"/>
                <td class="text-end tabular-nums" t-esc="this.fmt(data.payroll_by_department.total.esv)"/>
                <td class="text-end tabular-nums" t-esc="this.fmt(data.payroll_by_department.total.net)"/>
              </tr>
            </tfoot>
          </table>
          </div>
        </div>

        <!-- Обороти за період: рахунки зарплати, податків і виплат -->
        <div class="o_ua_dashboard_section" t-if="data.turnover.length">
          <h5>Обороти за період</h5>
          <div class="o_ua_wide">
            <table class="o_ua_table">
              <thead>
                <tr><th>Рахунок</th><th></th><th class="text-end">Дебет</th><th class="text-end">Кредит</th>
                    <th class="text-end">Сальдо Дт</th><th class="text-end">Сальдо Кт</th></tr>
              </thead>
              <tbody>
                <tr t-foreach="data.turnover" t-as="row" t-key="row.code"
                    class="o_ua_clickable" t-on-click="() => this.openRow(row)">
                  <td t-esc="row.code"/>
                  <td t-esc="row.name"/>
                  <td class="text-end tabular-nums" t-esc="row.debit"/>
                  <td class="text-end tabular-nums" t-esc="row.credit"/>
                  <td class="text-end tabular-nums" t-esc="row.saldo_debit"/>
                  <td class="text-end tabular-nums" t-esc="row.saldo_credit"/>
                </tr>
              </tbody>
            </table>
          </div>
        </div>

        <!-- Документи періоду -->
        <div class="o_ua_dashboard_section">
          <h5>Документи</h5>
          <table t-if="data.documents.length" class="o_ua_table">
            <thead>
              <tr>
                <th>Назва</th>
                <th>Період</th>
                <th>Стан</th>
              </tr>
            </thead>
            <tbody>
              <tr t-foreach="data.documents" t-as="doc" t-key="doc.res_model + '-' + doc.res_id"
                  class="o_ua_clickable" t-on-click="() => this.openRow(doc)">
                <td t-esc="doc.name"/>
                <td t-esc="doc.period"/>
                <td><span t-attf-class="o_ua_pill #{this.docPill(doc.state)}" t-esc="doc.state"/></td>
              </tr>
            </tbody>
          </table>
          <div t-else="" class="o_ua_dashboard_empty text-muted">Документів немає.</div>
        </div>

      </t>
    </div>
  </t>
</templates>
