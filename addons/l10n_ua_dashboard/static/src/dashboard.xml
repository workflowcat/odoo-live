<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
  <t t-name="l10n_ua_dashboard.Dashboard" owl="1">
    <div class="o_ua_dashboard">
      <t t-if="state.loading">
        <div class="o_ua_dashboard_loading text-muted p-4">Завантаження…</div>
      </t>
      <t t-elif="state.data">
        <t t-set="data" t-value="state.data"/>

        <!-- Заголовок -->
        <div class="o_ua_dashboard_header">
          <div class="o_ua_dashboard_title">
            <h3 t-esc="data.company.name"/>
            <span class="text-muted" t-if="data.company.edrpou">ЄДРПОУ <t t-esc="data.company.edrpou"/></span>
            <span class="text-muted"><t t-esc="data.company.employee_count"/> активних працівників</span>
          </div>
          <div class="o_ua_dashboard_periods">
            <t t-foreach="data.periods" t-as="period" t-key="period.year + '-' + period.month">
              <button
                type="button"
                t-attf-class="btn btn-sm #{period.month === data.company.month and period.year === data.company.year ? 'btn-primary' : (period.has_run ? 'btn-outline-secondary' : 'btn-outline-secondary text-muted')}"
                t-on-click="() => this.onSelectPeriod(period)">
                <t t-esc="period.label"/>
              </button>
            </t>
          </div>
        </div>

        <!-- Нарахування по підрозділах -->
        <div class="o_ua_dashboard_section">
          <h5><t t-esc="data.company.month_label"/> <t t-esc="data.company.year"/>: нарахування по підрозділах</h5>
          <t t-if="!data.payroll_by_department.rows.length">
            <div class="o_ua_dashboard_empty text-muted">
              Листків за цей місяць немає.
              <button type="button" class="btn btn-sm btn-link p-0"
                      t-if="data.payroll_by_department.run_action"
                      t-on-click="() => this.openHubItem(data.payroll_by_department.run_action)">
                Відкрити пакети листків
              </button>
            </div>
          </t>
          <table t-else="" class="o_ua_dashboard_table table table-sm">
            <thead>
              <tr>
                <th>Підрозділ</th>
                <th class="text-end">Працівників</th>
                <th class="text-end">Нараховано</th>
                <th class="text-end">ПДФО</th>
                <th class="text-end">ВЗ</th>
                <th class="text-end">ЄСВ</th>
                <th class="text-end">До виплати</th>
              </tr>
            </thead>
            <tbody>
              <tr t-foreach="data.payroll_by_department.rows" t-as="row" t-key="row.department">
                <td t-esc="row.department"/>
                <td class="text-end" t-esc="row.employees"/>
                <td class="text-end tabular-nums" t-esc="this.fmt(row.gross)"/>
                <td class="text-end tabular-nums" t-esc="this.fmt(row.pdfo)"/>
                <td class="text-end tabular-nums" t-esc="this.fmt(row.vz)"/>
                <td class="text-end tabular-nums" t-esc="this.fmt(row.esv)"/>
                <td class="text-end tabular-nums" t-esc="this.fmt(row.net)"/>
              </tr>
            </tbody>
            <tfoot>
              <tr class="o_ua_dashboard_total">
                <td>Разом</td>
                <td class="text-end" t-esc="data.payroll_by_department.total.employees"/>
                <td class="text-end tabular-nums" t-esc="this.fmt(data.payroll_by_department.total.gross)"/>
                <td class="text-end tabular-nums" t-esc="this.fmt(data.payroll_by_department.total.pdfo)"/>
                <td class="text-end tabular-nums" t-esc="this.fmt(data.payroll_by_department.total.vz)"/>
                <td class="text-end tabular-nums" t-esc="this.fmt(data.payroll_by_department.total.esv)"/>
                <td class="text-end tabular-nums" t-esc="this.fmt(data.payroll_by_department.total.net)"/>
              </tr>
            </tfoot>
          </table>
        </div>

        <div class="o_ua_dashboard_row">
          <!-- Платежі і строки -->
          <div class="o_ua_dashboard_section o_ua_dashboard_col">
            <h5>Платежі і строки</h5>
            <table class="o_ua_dashboard_table table table-sm">
              <thead>
                <tr>
                  <th>Дата</th>
                  <th>Платіж</th>
                  <th class="text-end">Сума</th>
                  <th>Стан</th>
                </tr>
              </thead>
              <tbody>
                <tr t-foreach="data.payments" t-as="p" t-key="p_index">
                  <td t-esc="p.date or '-'"/>
                  <td t-esc="p.label"/>
                  <td class="text-end tabular-nums" t-esc="this.fmt(p.amount)"/>
                  <td t-attf-class="o_ua_state #{this.stateColor(p.state_class)}" t-esc="p.state"/>
                </tr>
              </tbody>
            </table>
          </div>

          <!-- Потребує уваги -->
          <div class="o_ua_dashboard_section o_ua_dashboard_col">
            <h5>Потребує уваги</h5>
            <table t-if="data.attention.length" class="o_ua_dashboard_table table table-sm">
              <tbody>
                <tr t-foreach="data.attention" t-as="a" t-key="a_index"
                    class="o_ua_dashboard_clickable" t-on-click="() => this.openRow(a)">
                  <td t-attf-class="o_ua_level #{this.levelColor(a.level)}" t-esc="a.count"/>
                  <td>
                    <div t-esc="a.title"/>
                    <div class="text-muted small" t-esc="a.detail"/>
                  </td>
                </tr>
              </tbody>
            </table>
            <div t-else="" class="o_ua_dashboard_empty text-muted">Немає зауважень.</div>
          </div>
        </div>

        <!-- Документи періоду -->
        <div class="o_ua_dashboard_section">
          <h5>Документи</h5>
          <table t-if="data.documents.length" class="o_ua_dashboard_table table table-sm">
            <thead>
              <tr>
                <th>Назва</th>
                <th>Період</th>
                <th>Стан</th>
              </tr>
            </thead>
            <tbody>
              <tr t-foreach="data.documents" t-as="doc" t-key="doc.res_model + '-' + doc.res_id"
                  class="o_ua_dashboard_clickable" t-on-click="() => this.openRow(doc)">
                <td t-esc="doc.name"/>
                <td t-esc="doc.period"/>
                <td t-esc="doc.state"/>
              </tr>
            </tbody>
          </table>
          <div t-else="" class="o_ua_dashboard_empty text-muted">Документів немає.</div>
        </div>

        <!-- Пульт команд -->
        <div class="o_ua_dashboard_section">
          <h5>Пульт команд</h5>
          <div class="o_ua_dashboard_hub">
            <div t-foreach="data.hub" t-as="section" t-key="section.section" class="o_ua_dashboard_hub_section">
              <div class="o_ua_dashboard_hub_title" t-esc="section.section"/>
              <ul>
                <li t-foreach="section.items" t-as="item" t-key="item.id">
                  <a href="#" t-on-click.prevent="() => this.openHubItem(item.id)" t-esc="item.name"/>
                </li>
              </ul>
            </div>
          </div>
        </div>
      </t>
    </div>
  </t>
</templates>
