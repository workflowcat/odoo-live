<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="view_company_form_ua_purchase" model="ir.ui.view">
    <field name="name">res.company.form.ua.purchase</field>
    <field name="model">res.company</field>
    <field name="inherit_id" ref="base.view_company_form"/>
    <field name="arch" type="xml">
      <xpath expr="//notebook" position="inside">
        <page string="Закупівлі" name="ua_purchase">
          <group>
            <field name="ua_purchase_approval_limit"/>
            <field name="currency_id" invisible="1"/>
          </group>
        </page>
      </xpath>
    </field>
  </record>
</odoo>
