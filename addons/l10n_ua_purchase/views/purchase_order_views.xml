<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="view_purchase_order_form_ua" model="ir.ui.view">
    <field name="name">purchase.order.form.ua</field>
    <field name="model">purchase.order</field>
    <field name="inherit_id" ref="purchase.purchase_order_form"/>
    <field name="arch" type="xml">
      <field name="partner_ref" position="after">
        <field name="ua_request_id" readonly="1"/>
        <field name="ua_department_id"/>
        <field name="ua_expense_account_id"/>
      </field>
    </field>
  </record>

  <record id="view_purchase_order_search_ua" model="ir.ui.view">
    <field name="name">purchase.order.search.ua</field>
    <field name="model">purchase.order</field>
    <field name="inherit_id" ref="purchase.view_purchase_order_filter"/>
    <field name="arch" type="xml">
      <field name="origin" position="after">
        <field name="ua_request_id"/>
        <field name="ua_department_id"/>
      </field>
      <xpath expr="//search/group" position="inside">
        <filter name="group_ua_request" string="Запит на закупівлю" domain="[]"
                context="{'group_by': 'ua_request_id'}"/>
        <filter name="group_ua_department" string="Підрозділ" domain="[]"
                context="{'group_by': 'ua_department_id'}"/>
      </xpath>
    </field>
  </record>

  <record id="action_ua_purchase_order_by_request" model="ir.actions.act_window">
    <field name="name">Замовлення за запитами</field>
    <field name="res_model">purchase.order</field>
    <field name="view_mode">list,form</field>
    <field name="domain">[('ua_request_id', '!=', False)]</field>
    <field name="context">{'search_default_group_ua_request': 1}</field>
  </record>
</odoo>
