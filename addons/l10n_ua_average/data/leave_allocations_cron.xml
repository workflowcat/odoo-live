<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <data noupdate="1">
    <!-- Новий запис, а не переписаний старий: попередня задача (ir_cron_ua_leave_allocations)
         нараховувала раз на рік лише соціальну відпустку на дітей. Оновлення модуля не міняє
         записів у noupdate-блоці, а писати в ir.cron поля, делеговані на ir.actions.server,
         під час міграції не виходить. Тому стару задачу вимикає end-migrate, а працює ця. -->
    <record id="ir_cron_ua_leave_days" model="ir.cron">
      <field name="name">Відпустки: нарахування днів за Законом «Про відпустки»</field>
      <field name="model_id" ref="hr.model_hr_employee"/>
      <field name="state">code</field>
      <field name="code">model.search([("active", "=", True)]).ua_ensure_leave_allocations()</field>
      <field name="interval_number">1</field>
      <field name="interval_type">days</field>
      <!-- щодня: щорічна відпустка накопичується пропорційно відпрацьованому часу, тож
           залишок росте кожного дня; відпустки за календарний рік відкриваються 1 січня
           тим самим проходом -->
      <field name="nextcall" eval="'2026-09-22 02:00:00'"/>
      <field name="active">True</field>
    </record>
  </data>
</odoo>
