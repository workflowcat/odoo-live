<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <data noupdate="1">
    <record id="wet_vac" model="hr.work.entry.type"><field name="name">Щорічна відпустка</field><field name="code">VAC</field><field name="is_leave">True</field><field name="sequence">20</field></record>
    <record id="wet_sick" model="hr.work.entry.type"><field name="name">Тимчасова непрацездатність</field><field name="code">SICK</field><field name="is_leave">True</field><field name="sequence">21</field></record>
    <record id="wet_unpaid" model="hr.work.entry.type"><field name="name">Відпустка без збереження зарплати</field><field name="code">UNPAID</field><field name="is_leave">True</field><field name="sequence">22</field></record>
    <record id="lt_vac" model="hr.leave.type"><field name="name">Щорічна відпустка</field><field name="work_entry_type_id" ref="wet_vac"/><field name="requires_allocation">False</field><field name="request_unit">day</field><field name="time_type">leave</field></record>
    <record id="lt_sick" model="hr.leave.type"><field name="name">Тимчасова непрацездатність</field><field name="work_entry_type_id" ref="wet_sick"/><field name="requires_allocation">False</field><field name="request_unit">day</field><field name="time_type">leave</field></record>
    <record id="lt_unpaid" model="hr.leave.type"><field name="name">Відпустка без збереження зарплати</field><field name="work_entry_type_id" ref="wet_unpaid"/><field name="requires_allocation">False</field><field name="request_unit">day</field><field name="time_type">leave</field><field name="unpaid">True</field></record>
    <!-- інші види відсутності: навчальна, додаткова на дітей, відрядження, догляд за дитиною до 3 років, догляд за хворим -->
    <record id="wet_study" model="hr.work.entry.type"><field name="name">Навчальна відпустка</field><field name="code">STUDY</field><field name="is_leave">True</field><field name="sequence">24</field></record>
    <record id="lt_study" model="hr.leave.type"><field name="name">Навчальна відпустка</field><field name="work_entry_type_id" ref="wet_study"/><field name="requires_allocation">False</field><field name="request_unit">day</field><field name="time_type">leave</field></record>
    <record id="wet_child_vac" model="hr.work.entry.type"><field name="name">Додаткова відпустка на дітей</field><field name="code">CHILD_VAC</field><field name="is_leave">True</field><field name="sequence">25</field></record>
    <record id="lt_child_vac" model="hr.leave.type"><field name="name">Додаткова відпустка на дітей</field><field name="work_entry_type_id" ref="wet_child_vac"/><field name="requires_allocation">False</field><field name="request_unit">day</field><field name="time_type">leave</field></record>
    <record id="wet_trip" model="hr.work.entry.type"><field name="name">Відрядження</field><field name="code">TRIP</field><field name="is_leave">True</field><field name="sequence">26</field></record>
    <record id="lt_trip" model="hr.leave.type"><field name="name">Відрядження</field><field name="work_entry_type_id" ref="wet_trip"/><field name="requires_allocation">False</field><field name="request_unit">day</field><field name="time_type">leave</field></record>
    <record id="wet_child3" model="hr.work.entry.type"><field name="name">Відпустка для догляду за дитиною до 3 років</field><field name="code">CHILD3</field><field name="is_leave">True</field><field name="sequence">27</field></record>
    <record id="lt_child3" model="hr.leave.type"><field name="name">Відпустка для догляду за дитиною до 3 років</field><field name="work_entry_type_id" ref="wet_child3"/><field name="requires_allocation">False</field><field name="request_unit">day</field><field name="time_type">leave</field><field name="unpaid">True</field></record>
    <record id="wet_sick_care" model="hr.work.entry.type"><field name="name">Догляд за хворою дитиною або членом сім'ї</field><field name="code">SICK_CARE</field><field name="is_leave">True</field><field name="sequence">28</field></record>
    <record id="lt_sick_care" model="hr.leave.type"><field name="name">Догляд за хворою дитиною або членом сім'ї</field><field name="work_entry_type_id" ref="wet_sick_care"/><field name="requires_allocation">False</field><field name="request_unit">day</field><field name="time_type">leave</field></record>
    <record id="wet_mat" model="hr.work.entry.type"><field name="name">Відпустка у зв'язку з вагітністю та пологами</field><field name="code">MAT</field><field name="is_leave">True</field><field name="sequence">23</field></record>
    <record id="lt_mat" model="hr.leave.type"><field name="name">Відпустка у зв'язку з вагітністю та пологами</field><field name="work_entry_type_id" ref="wet_mat"/><field name="requires_allocation">False</field><field name="request_unit">day</field><field name="leave_validation_type">hr</field></record>

    <!-- Закон «Про відпустки»: додаткова УБД (ст. 16-2), соціальна на дітей (ст. 19), за особливий характер праці -->
    <record id="wet_vac_ubd" model="hr.work.entry.type"><field name="name">Додаткова відпустка УБД / осіб з інвалідністю внаслідок війни</field><field name="code">VAC_UBD</field><field name="is_leave">True</field><field name="sequence">29</field></record>
    <record id="lt_vac_ubd" model="hr.leave.type"><field name="name">Додаткова відпустка УБД (ст. 16-2)</field><field name="work_entry_type_id" ref="wet_vac_ubd"/><field name="requires_allocation">False</field><field name="request_unit">day</field><field name="time_type">leave</field></record>

    <record id="wet_soc_child" model="hr.work.entry.type"><field name="name">Соціальна відпустка працівникам з дітьми</field><field name="code">SOC_CHILD</field><field name="is_leave">True</field><field name="sequence">30</field></record>
    <record id="lt_soc_child" model="hr.leave.type"><field name="name">Соціальна відпустка на дітей (ст. 19)</field><field name="work_entry_type_id" ref="wet_soc_child"/><field name="requires_allocation">False</field><field name="request_unit">day</field><field name="time_type">leave</field></record>

    <record id="wet_vac_special" model="hr.work.entry.type"><field name="name">Додаткова відпустка за особливий характер праці</field><field name="code">VAC_SPECIAL</field><field name="is_leave">True</field><field name="sequence">31</field></record>
    <record id="lt_vac_special" model="hr.leave.type"><field name="name">Додаткова відпустка за особливий характер праці (ст. 8)</field><field name="work_entry_type_id" ref="wet_vac_special"/><field name="requires_allocation">False</field><field name="request_unit">day</field><field name="time_type">leave</field></record>
  </data>
</odoo>
