<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <data noupdate="0">
    <record id="cat_avg" model="hr.salary.rule.category"><field name="name">Середній заробіток</field><field name="code">AVG</field></record>
    <record id="rule_vac" model="hr.salary.rule">
      <field name="name">Відпускні</field><field name="code">VAC</field><field name="sequence">20</field>
      <field name="category_id" ref="cat_avg"/><field name="condition_select">python</field>
      <field name="condition_python">result = payroll.ua.vac_days &gt; 0</field>
      <field name="amount_select">code</field><field name="amount_python_compute">result = round(payroll.ua.vac_days * payroll.ua.avg100_day, 2)</field>
    </record>
    <record id="rule_sick_emp" model="hr.salary.rule">
      <field name="name">Лікарняні за рахунок підприємства, перші 5 днів</field><field name="code">SICK_EMP</field><field name="sequence">22</field>
      <field name="category_id" ref="cat_avg"/><field name="condition_select">python</field>
      <field name="condition_python">result = payroll.ua.sick_emp_days &gt; 0</field>
      <field name="amount_select">code</field><field name="amount_python_compute">result = round(payroll.ua.sick_emp_days * payroll.ua.avg1266_day * payroll.ua.sick_percent / 100.0, 2)</field>
    </record>
    <record id="rule_sick_pfu" model="hr.salary.rule">
      <field name="name">Лікарняні за рахунок ПФУ, з 6-го дня</field><field name="code">SICK_PFU</field><field name="sequence">23</field>
      <field name="category_id" ref="cat_avg"/><field name="condition_select">python</field>
      <field name="condition_python">result = payroll.ua.sick_pfu_days &gt; 0</field>
      <field name="amount_select">code</field><field name="amount_python_compute">result = round(payroll.ua.sick_pfu_days * payroll.ua.avg1266_day * payroll.ua.sick_percent / 100.0, 2)</field>
    </record>
    <record id="rule_mat" model="hr.salary.rule">
      <field name="name">Допомога по вагітності та пологах</field><field name="code">MAT</field><field name="sequence">25</field>
      <field name="category_id" ref="l10n_ua_payroll_rules.cat_mat"/><field name="condition_select">python</field>
      <field name="condition_python">result = payroll.ua.mat_days &gt; 0</field>
      <field name="amount_select">code</field><field name="amount_python_compute">result = round(payroll.ua.mat_days * payroll.ua.avg1266_day, 2)</field>
    </record>
    <record id="rule_comp_vac" model="hr.salary.rule">
      <field name="name">Компенсація за невикористану відпустку</field><field name="code">COMP_VAC</field><field name="sequence">24</field>
      <field name="category_id" ref="cat_avg"/><field name="condition_select">python</field>
      <field name="condition_python">result = bool(inputs.COMP_DAYS and inputs.COMP_DAYS.amount)</field>
      <field name="amount_select">code</field><field name="amount_python_compute">result = round(inputs.COMP_DAYS.amount * payroll.ua.avg100_day, 2)</field>
    </record>
    <record id="rule_study" model="hr.salary.rule">
      <field name="name">Оплата навчальної відпустки</field><field name="code">STUDY_PAY</field><field name="sequence">26</field>
      <field name="category_id" ref="cat_avg"/><field name="condition_select">python</field>
      <field name="condition_python">result = payroll.ua.study_days &gt; 0</field>
      <field name="amount_select">code</field><field name="amount_python_compute">result = round(payroll.ua.study_days * payroll.ua.avg100_day, 2)</field>
    </record>
    <record id="rule_child_vac" model="hr.salary.rule">
      <field name="name">Оплата додаткової відпустки на дітей</field><field name="code">CHILD_VAC_PAY</field><field name="sequence">27</field>
      <field name="category_id" ref="cat_avg"/><field name="condition_select">python</field>
      <field name="condition_python">result = payroll.ua.child_vac_days &gt; 0</field>
      <field name="amount_select">code</field><field name="amount_python_compute">result = round(payroll.ua.child_vac_days * payroll.ua.avg100_day, 2)</field>
    </record>
    <record id="rule_trip" model="hr.salary.rule">
      <field name="name">Середній заробіток за час відрядження</field><field name="code">TRIP_PAY</field><field name="sequence">28</field>
      <field name="category_id" ref="cat_avg"/><field name="condition_select">python</field>
      <field name="condition_python">result = payroll.ua.trip_work_days &gt; 0</field>
      <field name="amount_select">code</field>
      <field name="amount_python_compute">day_wage = (contract.wage * payroll.ua.fte / payroll.ua.month_workdays) if payroll.ua.month_workdays else 0.0
result = round(payroll.ua.trip_work_days * max(payroll.ua.avg100_work_day, day_wage), 2)</field>
    </record>
    <record id="rule_sick_care" model="hr.salary.rule">
      <field name="name">Допомога по догляду за хворим (ПФУ, з першого дня)</field><field name="code">SICK_CARE_PAY</field><field name="sequence">29</field>
      <field name="category_id" ref="cat_avg"/><field name="condition_select">python</field>
      <field name="condition_python">result = payroll.ua.sick_care_days &gt; 0</field>
      <field name="amount_select">code</field><field name="amount_python_compute">result = round(payroll.ua.sick_care_days * payroll.ua.avg1266_day * payroll.ua.sick_percent / 100.0, 2)</field>
    </record>
    <record id="rule_daily" model="hr.salary.rule">
      <field name="name">Добові за відрядження (не оподатковуються)</field><field name="code">DAILY</field><field name="sequence">30</field>
      <field name="category_id" ref="l10n_ua_payroll_rules.cat_notax"/><field name="condition_select">python</field>
      <field name="condition_python">result = bool(inputs.DAILY and inputs.DAILY.amount)</field>
      <field name="amount_select">code</field><field name="amount_python_compute">result = round(inputs.DAILY.amount, 2)</field>
    </record>
    <record id="input_daily" model="hr.rule.input"><field name="name">Добові за відрядження</field><field name="code">DAILY</field><field name="input_id" ref="rule_daily"/></record>
    <record id="input_comp_days" model="hr.rule.input"><field name="name">Невикористані дні відпустки</field><field name="code">COMP_DAYS</field><field name="input_id" ref="rule_comp_vac"/></record>
    <record id="l10n_ua_payroll_rules.struct_ua_salary" model="hr.payroll.structure">
      <field name="rule_ids" eval="[(4, ref('rule_vac')), (4, ref('rule_sick_emp')), (4, ref('rule_sick_pfu')), (4, ref('rule_comp_vac')), (4, ref('rule_mat')),
                                    (4, ref('rule_study')), (4, ref('rule_child_vac')), (4, ref('rule_trip')), (4, ref('rule_sick_care')), (4, ref('rule_daily'))]"/>
    </record>
  </data>
</odoo>
