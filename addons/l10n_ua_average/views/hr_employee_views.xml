<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="view_employee_form_ua_average" model="ir.ui.view">
    <field name="name">hr.employee.form.ua.average</field><field name="model">hr.employee</field>
    <field name="inherit_id" ref="l10n_ua_payroll_rules.view_employee_form_ua"/>
    <field name="arch" type="xml">
      <group name="ua" position="inside">
        <group string="Лікарняні">
          <field name="ua_insurance_years"/><field name="ua_sick_full"/><field name="ua_sick_percent"/>
        </group>
        <group name="ua_extra_leaves" string="Додаткові відпустки">
          <field name="ua_war_disability"/>
          <field name="ua_vac_ubd_days_year"/><field name="ua_vac_ubd_used"/><field name="ua_vac_ubd_balance"/>
          <field name="ua_soc_child_disabled_child"/>
          <field name="ua_soc_child_days_year"/><field name="ua_soc_child_allocated"/><field name="ua_soc_child_used"/><field name="ua_soc_child_balance"/>
          <field name="ua_special_leave_days"/><field name="ua_special_allocated"/><field name="ua_special_used"/><field name="ua_special_balance"/>
        </group>
      </group>
    </field>
  </record>
</odoo>
