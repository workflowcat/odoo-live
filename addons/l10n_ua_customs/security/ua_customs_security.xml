<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
  <record id="rule_ua_customs_declaration_company" model="ir.rule">
    <field name="name">Митна декларація: лише свої компанії</field>
    <field name="model_id" ref="model_ua_customs_declaration"/>
    <field name="domain_force">[('company_id', 'in', company_ids)]</field>
  </record>
  <record id="rule_ua_customs_declaration_line_company" model="ir.rule">
    <field name="name">Товар митної декларації: лише свої компанії</field>
    <field name="model_id" ref="model_ua_customs_declaration_line"/>
    <field name="domain_force">[('declaration_id.company_id', 'in', company_ids)]</field>
  </record>
</odoo>
