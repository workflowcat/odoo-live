    <field name="model_id" ref="model_ua_disability_quota"/>
    <field name="domain_force">[('company_id', 'in', company_ids)]</field>
  </record>
  <record id="rule_ua_disability_quota_line_company" model="ir.rule">
    <field name="name">Рядок нормативу для осіб з інвалідністю: лише свої компанії</field>
    <field name="model_id" ref="model_ua_disability_quota_line"/>
    <field name="domain_force">[('company_id', 'in', company_ids)]</field>
  </record>
</odoo>
