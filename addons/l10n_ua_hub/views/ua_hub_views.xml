<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="view_ua_hub_item_kanban" model="ir.ui.view">
    <field name="name">ua.hub.item.kanban</field>
    <field name="model">ua.hub.item</field>
    <field name="arch" type="xml">
      <kanban default_group_by="section_id" records_draggable="false" group_create="false" class="o_kanban_dashboard">
        <field name="name"/>
        <field name="description"/>
        <field name="action_xmlid"/>
        <field name="available"/>
        <templates>
          <t t-name="card">
            <div class="oe_kanban_global_click p-2">
              <a name="action_open" type="object" t-attf-class="text-decoration-none #{record.available.raw_value ? '' : 'text-muted'}">
                <strong><field name="name"/></strong>
                <div t-if="record.description.raw_value" class="text-muted small">
                  <field name="description"/>
                </div>
              </a>
            </div>
          </t>
        </templates>
      </kanban>
    </field>
  </record>

  <record id="view_ua_hub_item_search" model="ir.ui.view">
    <field name="name">ua.hub.item.search</field>
    <field name="model">ua.hub.item</field>
    <field name="arch" type="xml">
      <search>
        <field name="name"/>
        <field name="section_id"/>
        <group>
          <filter name="group_section" string="Розділ" context="{'group_by': 'section_id'}"/>
        </group>
      </search>
    </field>
  </record>

  <record id="action_ua_hub_item" model="ir.actions.act_window">
    <field name="name">Головна</field>
    <field name="res_model">ua.hub.item</field>
    <field name="view_mode">kanban</field>
    <field name="search_view_id" ref="view_ua_hub_item_search"/>
    <field name="context">{"search_default_group_section": 1}</field>
  </record>

  <menuitem id="menu_ua_hub_root" name="Головна" sequence="1" action="action_ua_hub_item"/>
</odoo>
