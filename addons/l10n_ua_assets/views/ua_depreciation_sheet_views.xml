<?xml version="1.0" encoding="utf-8"?>
<!-- Пункт меню відкриває список складених відомостей; «Сформувати» в шапці списку
     питає місяць діалогом, результат відкривається сторінкою. -->
<odoo>

  <record id="view_ua_depreciation_sheet_ask" model="ir.ui.view">
    <field name="name">ua.depreciation.sheet.ask</field>
    <field name="model">ua.depreciation.sheet</field>
    <field name="arch" type="xml">
      <form string="Відомість нарахування амортизації">
        <group>
          <group>
            <field name="year" options="{'enable_formatting': False}"/>
            <field name="month"/>
          </group>
          <group>
            <field name="only_posted"/>
            <field name="company_id" groups="base.group_multi_company"/>
          </group>
        </group>
        <footer>
          <button name="action_compose" type="object" string="Скласти" class="btn-primary"/>
          <button special="cancel" string="Закрити" class="btn-secondary"/>
        </footer>
      </form>
    </field>
  </record>

  <record id="view_ua_depreciation_sheet_form" model="ir.ui.view">
    <field name="name">ua.depreciation.sheet.form</field>
    <field name="model">ua.depreciation.sheet</field>
    <field name="arch" type="xml">
      <form string="Відомість нарахування амортизації">
        <header>
          <button name="action_compute" type="object" string="Перерахувати" class="oe_highlight"/>
          <button name="%(action_report_ua_depreciation_sheet)d" type="action" string="Друк"/>
        </header>
        <sheet>
          <div class="oe_title"><h1><field name="name" readonly="1"/></h1></div>
          <group>
            <group>
              <field name="year" options="{'enable_formatting': False}"/>
              <field name="month"/>
              <field name="only_posted"/>
            </group>
            <group>
              <field name="date_from"/>
              <field name="date_to"/>
              <field name="line_count"/>
              <field name="total_amount"/>
              <field name="company_id" groups="base.group_multi_company"/>
            </group>
          </group>
        </sheet>
      </form>
    </field>
  </record>

  <record id="view_ua_depreciation_sheet_list" model="ir.ui.view">
    <field name="name">ua.depreciation.sheet.list</field>
    <field name="model">ua.depreciation.sheet</field>
    <field name="arch" type="xml">
      <list create="0">
        <header>
          <button name="action_ask" type="object" display="always"
                  string="Сформувати" class="btn-primary"/>
        </header>
        <field name="name"/>
        <field name="year"/>
        <field name="month"/>
        <field name="only_posted"/>
        <field name="line_count"/>
        <field name="total_amount" sum="Разом"/>
      </list>
    </field>
  </record>

  <record id="action_ua_depreciation_sheet" model="ir.actions.act_window">
    <field name="name">Відомості нарахування амортизації</field>
    <field name="res_model">ua.depreciation.sheet</field>
    <field name="view_mode">list,form</field>
    <field name="target">current</field>
  </record>

  <record id="action_ua_depreciation_sheet_list_view" model="ir.actions.act_window.view">
    <field name="sequence">1</field><field name="view_mode">list</field>
    <field name="view_id" ref="view_ua_depreciation_sheet_list"/>
    <field name="act_window_id" ref="action_ua_depreciation_sheet"/>
  </record>
  <record id="action_ua_depreciation_sheet_form_view" model="ir.actions.act_window.view">
    <field name="sequence">2</field><field name="view_mode">form</field>
    <field name="view_id" ref="view_ua_depreciation_sheet_form"/>
    <field name="act_window_id" ref="action_ua_depreciation_sheet"/>
  </record>

  <menuitem
      id="menu_ua_depreciation_sheet"
      name="Відомості нарахування амортизації"
      action="action_ua_depreciation_sheet"
      parent="account_asset_management.menu_finance_assets"
      sequence="120"/>

</odoo>
