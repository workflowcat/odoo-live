<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="view_ua_hr_order_register_wizard_form" model="ir.ui.view">
    <field name="name">ua.hr.order.register.wizard.form</field>
    <field name="model">ua.hr.order.register.wizard</field>
    <field name="arch" type="xml">
      <form string="Журнал реєстрації наказів">
        <group>
          <field name="year" options="{'enable_formatting': False}"/>
          <field name="register"/>
          <field name="company_id" groups="base.group_multi_company"/>
        </group>
        <footer>
          <button name="action_print" type="object" string="Друк" class="oe_highlight"/>
          <button special="cancel" string="Закрити"/>
        </footer>
      </form>
    </field>
  </record>

  <record id="action_ua_hr_order_register_wizard" model="ir.actions.act_window">
    <field name="name">Журнал реєстрації наказів</field>
    <field name="res_model">ua.hr.order.register.wizard</field>
    <field name="view_mode">form</field>
    <field name="target">new</field>
  </record>

  <record id="view_ua_hr_doc_pack_wizard_form" model="ir.ui.view">
    <field name="name">ua.hr.doc.pack.wizard.form</field>
    <field name="model">ua.hr.doc.pack.wizard</field>
    <field name="arch" type="xml">
      <form string="Пакет документів">
        <group>
          <field name="company_id" groups="base.group_multi_company"/>
          <field name="employee_ids" widget="many2many_tags"/>
        </group>
        <footer>
          <button name="action_print" type="object" string="Друк" class="oe_highlight"/>
          <button special="cancel" string="Закрити"/>
        </footer>
      </form>
    </field>
  </record>

  <record id="action_ua_hr_doc_pack_wizard" model="ir.actions.act_window">
    <field name="name">Пакет документів</field>
    <field name="res_model">ua.hr.doc.pack.wizard</field>
    <field name="view_mode">form</field>
    <field name="target">new</field>
  </record>
</odoo>
