<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="action_report_ua_hr_order" model="ir.actions.report">
    <field name="name">Наказ</field>
    <field name="model">ua.hr.order</field>
    <field name="report_type">qweb-pdf</field>
    <field name="report_name">l10n_ua_hr_orders.report_ua_hr_order</field>
    <field name="report_file">l10n_ua_hr_orders.report_ua_hr_order</field>
    <field name="print_report_name">'Наказ %s %s' % (object.name or '', object.employee_id.name)</field>
    <field name="binding_model_id" ref="model_ua_hr_order"/>
    <field name="binding_type">report</field>
    <field name="paperformat_id" ref="l10n_ua_payroll_reports.paperformat_ua_a4"/>
  </record>

  <template id="report_ua_hr_order">
    <t t-call="web.basic_layout">
      <t t-foreach="docs" t-as="o">
        <t t-set="company" t-value="o.company_id"/>
        <t t-set="employee" t-value="o.employee_id"/>
        <t t-set="order_ref" t-value="'№ %s від %s' % (o.name or '____', o.date and o.date.strftime('%d.%m.%Y') or '____________')"/>
        <div class="page" style="font-family: DejaVu Sans, sans-serif; font-size: 11px;">
          <t t-call="l10n_ua_hr_docs.ua_order_head"/>

          <t t-if="o.order_type == 'hire'">
            <p style="text-align:center;"><b>Про прийняття на роботу</b></p>
            <p>ПРИЙНЯТИ на роботу <b><t t-out="employee.name"/></b> з <b><t t-out="o.date_from and o.date_from.strftime('%d.%m.%Y')"/></b>
              до підрозділу <b><t t-out="o.department_id.name or '-'"/></b> на посаду <b><t t-out="o.prof_name or o.job_title or '-'"/></b>
              <t t-if="o.kp_code">(код КП <t t-out="o.kp_code"/>)</t>
              з окладом <b><t t-out="'{:,.2f}'.format(o.wage).replace(',', '&#160;').replace('.', ',')"/> грн</b> на місяць<t t-if="o.fte != '1'">, <t t-out="o.fte.replace('.', ',')"/> ставки</t>.</p>
            <p>Умови роботи: <t t-out="'основне місце роботи' if o.main_job else 'за сумісництвом'"/>;
              <t t-out="o.contract_type_id.name or 'безстроковий трудовий договір'"/>;
              <t t-if="o.trial_date_end">випробувальний строк до <t t-out="o.trial_date_end.strftime('%d.%m.%Y')"/>;</t> нормальна тривалість робочого часу.</p>
            <p>Оплата праці: аванс - <b><t t-out="o.pay_advance_percent"/>%</b> окладу до <b><t t-out="o.pay_advance_day"/></b> числа,
              остаточний розрахунок - до <b><t t-out="o.pay_final_day"/></b> числа наступного місяця.</p>
            <p>Підстава: <t t-out="o.basis or 'заява %s, трудовий договір' % employee.name"/>.</p>
          </t>

          <t t-if="o.order_type == 'wage'">
            <p style="text-align:center;"><b>Про зміну умов оплати праці</b></p>
            <p>ВСТАНОВИТИ <b><t t-out="employee.name"/></b> з <b><t t-out="o.date_from and o.date_from.strftime('%d.%m.%Y')"/></b>
              оклад <b><t t-out="'{:,.2f}'.format(o.wage).replace(',', '&#160;').replace('.', ',')"/> грн</b> на місяць
              (замість <t t-out="'{:,.2f}'.format(o.wage_old).replace(',', '&#160;').replace('.', ',')"/> грн).</p>
            <p>Підстава: <t t-out="o.basis or 'штатний розпис'"/>.</p>
          </t>

          <t t-if="o.order_type == 'transfer'">
            <p style="text-align:center;"><b>Про переведення</b></p>
            <p>ПЕРЕВЕСТИ <b><t t-out="employee.name"/></b> з <b><t t-out="o.date_from and o.date_from.strftime('%d.%m.%Y')"/></b>
              до підрозділу <b><t t-out="o.department_id.name or '-'"/></b> на посаду <b><t t-out="o.prof_name or o.job_title or '-'"/></b>
              <t t-if="o.kp_code">(код КП <t t-out="o.kp_code"/>)</t>
              <t t-if="o.wage">з окладом <b><t t-out="'{:,.2f}'.format(o.wage).replace(',', '&#160;').replace('.', ',')"/> грн</b> на місяць</t>.</p>
            <p>Підстава: <t t-out="o.basis or 'заява %s' % employee.name"/>.</p>
          </t>

          <t t-if="o.order_type == 'leave'">
            <p style="text-align:center;"><b>Про надання відпустки</b></p>
            <p>НАДАТИ <b><t t-out="employee.name"/></b>, <t t-out="employee.job_title or '-'"/> підрозділу <t t-out="employee.department_id.name or '-'"/>,
              <b><t t-out="o.leave_type_id.name or '-'"/></b>
              тривалістю <b><t t-out="o.days"/> календарних днів</b> з <b><t t-out="o.date_from and o.date_from.strftime('%d.%m.%Y')"/></b>
              по <b><t t-out="o.date_to and o.date_to.strftime('%d.%m.%Y')"/></b>.</p>
            <p>Підстава: <t t-out="o.basis or 'заява %s' % employee.name"/><t t-if="o.sick_number">, листок непрацездатності <t t-out="o.sick_number"/></t>.</p>
          </t>

          <t t-if="o.order_type == 'dismissal'">
            <p style="text-align:center;"><b>Про припинення трудового договору</b></p>
            <p>ЗВІЛЬНИТИ <b><t t-out="employee.name"/></b>, <t t-out="employee.job_title or '-'"/> підрозділу <t t-out="employee.department_id.name or '-'"/>,
              <b><t t-out="o.date_to and o.date_to.strftime('%d.%m.%Y')"/></b> на підставі <b><t t-out="o.dismissal_basis or '________________________'"/></b>.</p>
            <p>Бухгалтерії провести повний розрахунок у день звільнення<t t-if="o.comp_days"> і виплатити компенсацію за <t t-out="('%g' % o.comp_days).replace('.', ',')"/> днів невикористаної щорічної відпустки</t>.</p>
            <p>Підстава: <t t-out="o.basis or ('заява працівника' if 'ст. 38' in (o.dismissal_basis or '') else 'угода сторін' if 'ст. 36' in (o.dismissal_basis or '') else '________________')"/>.</p>
          </t>

          <t t-if="o.order_type == 'trip'">
            <p style="text-align:center;"><b>Про відрядження</b></p>
            <p>НАПРАВИТИ <b><t t-out="employee.name"/></b> у відрядження до <b><t t-out="o.destination or '-'"/></b>
              з <b><t t-out="o.date_from and o.date_from.strftime('%d.%m.%Y')"/></b> по <b><t t-out="o.date_to and o.date_to.strftime('%d.%m.%Y')"/></b>
              (<t t-out="o.days"/> дн.)<t t-if="o.purpose"> з метою: <t t-out="o.purpose"/></t>.</p>
            <p>Підстава: <t t-out="o.basis or 'службова записка'"/>.</p>
          </t>

          <t t-call="l10n_ua_hr_docs.ua_order_foot"/>
        </div>
      </t>
    </t>
  </template>
</odoo>
