<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="view_ua_hr_order_form" model="ir.ui.view">
    <field name="name">ua.hr.order.form</field>
    <field name="model">ua.hr.order</field>
    <field name="arch" type="xml">
      <form string="Кадровий наказ">
        <header>
          <button name="action_post" type="object" string="Провести" invisible="state != 'draft'" class="oe_highlight"/>
          <button name="action_acknowledge" type="object" string="Ознайомити" invisible="state != 'posted'" class="oe_highlight"/>
          <button name="action_cancel" type="object" string="Скасувати наказ" invisible="state not in ('posted', 'acknowledged')"
                  confirm="Скасувати наказ? Якщо дані після проведення не змінювали - зміну буде прибрано."/>
          <button name="%(l10n_ua_hr_orders.action_report_ua_hr_order)d" type="action" string="Друк" invisible="state == 'draft'"/>
          <field name="state" widget="statusbar" statusbar_visible="draft,posted,acknowledged"/>
        </header>
        <sheet>
          <div class="oe_button_box" name="button_box" invisible="state == 'draft'">
            <button name="action_ua_open_version" type="object" class="oe_stat_button" icon="fa-file-text-o"
                    invisible="not version_id">
              <div class="o_stat_info"><span class="o_stat_text">Версія</span><span class="o_stat_text">договору</span></div>
            </button>
            <button name="action_ua_open_leave" type="object" class="oe_stat_button" icon="fa-calendar"
                    invisible="not leave_id">
              <div class="o_stat_info"><span class="o_stat_text">Відсутність</span></div>
            </button>
            <button name="action_ua_open_slips" type="object" class="oe_stat_button" icon="fa-calculator"
                    invisible="ua_effect_slip_count == 0">
              <field name="ua_effect_slip_count" widget="statinfo" string="Листки"/>
            </button>
            <button name="action_ua_open_payments" type="object" class="oe_stat_button" icon="fa-money"
                    invisible="ua_effect_payment_count == 0">
              <field name="ua_effect_payment_count" widget="statinfo" string="Виплата"/>
            </button>
          </div>
          <div class="oe_title">
            <h1><field name="name" readonly="1" placeholder="Новий"/></h1>
          </div>
          <group>
            <group>
              <field name="order_type" readonly="state != 'draft'"/>
              <field name="register" readonly="1"/>
              <field name="date" readonly="state != 'draft'"/>
              <field name="employee_id" readonly="state != 'draft'"/>
              <field name="company_id" groups="base.group_multi_company" readonly="state != 'draft'"/>
            </group>
            <group>
              <field name="basis" readonly="state != 'draft'"/>
              <field name="ack_date" invisible="not ack_date"/>
              <field name="ack_user_id" invisible="not ack_user_id"/>
            </group>
          </group>

          <group string="Прийняття на роботу" invisible="order_type != 'hire'">
            <group>
              <field name="date_from" readonly="state != 'draft'"/>
              <field name="department_id" readonly="state != 'draft'"/>
              <field name="job_title" readonly="state != 'draft'"/>
              <field name="prof_name" readonly="state != 'draft'"/>
              <field name="kp_code" readonly="state != 'draft'"/>
            </group>
            <group>
              <field name="wage" readonly="state != 'draft'"/>
              <field name="fte" readonly="state != 'draft'"/>
              <field name="main_job" readonly="state != 'draft'"/>
              <field name="contract_kind" readonly="state != 'draft'"/>
              <field name="contract_type_id" readonly="state != 'draft'"/>
              <field name="trial_date_end" readonly="state != 'draft'"/>
            </group>
            <group string="Умови оплати">
              <field name="pay_advance_percent" readonly="state != 'draft'"/>
              <field name="pay_advance_day" readonly="state != 'draft'"/>
              <field name="pay_final_day" readonly="state != 'draft'"/>
            </group>
          </group>

          <group string="Зміна окладу" invisible="order_type != 'wage'">
            <group>
              <field name="date_from" readonly="state != 'draft'"/>
            </group>
            <group>
              <field name="wage_old"/>
              <field name="wage" readonly="state != 'draft'"/>
            </group>
          </group>

          <group string="Переведення" invisible="order_type != 'transfer'">
            <group>
              <field name="department_id_old" readonly="1"/>
              <field name="job_title_old" readonly="1"/>
            </group>
            <group>
              <field name="date_from" readonly="state != 'draft'"/>
              <field name="department_id" readonly="state != 'draft'" string="Новий підрозділ"/>
              <field name="job_title" readonly="state != 'draft'" string="Нова посада"/>
              <field name="prof_name" readonly="state != 'draft'"/>
              <field name="kp_code" readonly="state != 'draft'"/>
              <field name="wage" readonly="state != 'draft'"/>
            </group>
          </group>

          <group string="Відпустка" invisible="order_type != 'leave'">
            <group>
              <field name="leave_type_id" readonly="state != 'draft'"/>
              <field name="date_from" readonly="state != 'draft'"/>
              <field name="date_to" readonly="state != 'draft'"/>
              <field name="days"/>
            </group>
            <group>
              <field name="sick_number" readonly="state != 'draft'"/>
            </group>
          </group>

          <group string="Звільнення" invisible="order_type != 'dismissal'">
            <group>
              <field name="date_to" readonly="state != 'draft'"/>
              <field name="dismissal_basis" readonly="state != 'draft'"/>
            </group>
            <group>
              <field name="comp_days" readonly="state != 'draft'"/>
            </group>
          </group>

          <group string="Відрядження" invisible="order_type != 'trip'">
            <group>
              <field name="date_from" readonly="state != 'draft'"/>
              <field name="date_to" readonly="state != 'draft'"/>
              <field name="days"/>
            </group>
            <group>
              <field name="destination" readonly="state != 'draft'"/>
              <field name="purpose" readonly="state != 'draft'"/>
            </group>
          </group>

          <group>
            <field name="note" readonly="state != 'draft'"/>
            <field name="signed_file" filename="signed_filename"/>
            <field name="signed_filename" invisible="1"/>
          </group>
        </sheet>
        <chatter/>
      </form>
    </field>
  </record>

  <record id="view_ua_hr_order_list" model="ir.ui.view">
    <field name="name">ua.hr.order.list</field>
    <field name="model">ua.hr.order</field>
    <field name="arch" type="xml">
      <list>
        <field name="name"/>
        <field name="date" options="{'numeric': True}"/>
        <field name="order_type"/>
        <field name="register"/>
        <field name="employee_id"/>
        <field name="state" widget="badge" decoration-success="state == 'acknowledged'" decoration-info="state == 'posted'" decoration-danger="state == 'cancelled'"/>
      </list>
    </field>
  </record>

  <record id="view_ua_hr_order_search" model="ir.ui.view">
    <field name="name">ua.hr.order.search</field>
    <field name="model">ua.hr.order</field>
    <field name="arch" type="xml">
      <search>
        <field name="name"/>
        <field name="employee_id"/>
        <filter name="draft" string="Чернетка" domain="[('state', '=', 'draft')]"/>
        <filter name="posted" string="Проведено" domain="[('state', '=', 'posted')]"/>
        <separator/>
        <filter name="k1" string="К-1" domain="[('register', '=', 'k1')]"/>
        <filter name="v2" string="В-2" domain="[('register', '=', 'v2')]"/>
        <separator/>
        <filter name="this_year" string="Цей рік"
                domain="[('date', '&gt;=', (context_today() + relativedelta(month=1, day=1)).strftime('%Y-%m-%d')),
                         ('date', '&lt;=', (context_today() + relativedelta(month=12, day=31)).strftime('%Y-%m-%d'))]"/>
        <group>
          <filter name="group_register" string="Реєстр" context="{'group_by': 'register'}"/>
          <filter name="group_type" string="Вид наказу" context="{'group_by': 'order_type'}"/>
          <filter name="group_state" string="Стан" context="{'group_by': 'state'}"/>
          <filter name="group_employee" string="Працівник" context="{'group_by': 'employee_id'}"/>
        </group>
      </search>
    </field>
  </record>

  <record id="action_ua_hr_order" model="ir.actions.act_window">
    <field name="name">Накази</field>
    <field name="res_model">ua.hr.order</field>
    <field name="view_mode">list,form</field>
    <field name="search_view_id" ref="view_ua_hr_order_search"/>
    <field name="context">{}</field>
  </record>

  <!-- Журнал реєстрації наказів. Не окремий документ, а той самий перелік наказів:
       реєстр і рік обирає пошук, «Друк журналу» друкує те, що на екрані. -->
  <record id="view_ua_hr_order_register_list" model="ir.ui.view">
    <field name="name">ua.hr.order.register.list</field>
    <field name="model">ua.hr.order</field>
    <field name="priority">32</field>
    <field name="arch" type="xml">
      <list create="0" edit="0" default_order="date, name">
        <header>
          <button name="action_print_register" type="object" display="always"
                  string="Друк журналу" class="btn-primary"/>
        </header>
        <field name="name"/>
        <field name="date" options="{'numeric': True}"/>
        <field name="order_type"/>
        <field name="register"/>
        <field name="employee_id"/>
        <field name="state" widget="badge" decoration-success="state == 'acknowledged'" decoration-info="state == 'posted'" decoration-danger="state == 'cancelled'"/>
        <field name="ack_date" options="{'numeric': True}"/>
      </list>
    </field>
  </record>

  <record id="action_ua_hr_order_register" model="ir.actions.act_window">
    <field name="name">Журнал реєстрації наказів</field>
    <field name="res_model">ua.hr.order</field>
    <field name="view_mode">list,form</field>
    <field name="search_view_id" ref="view_ua_hr_order_search"/>
    <field name="context">{'search_default_this_year': 1, 'search_default_group_register': 1}</field>
  </record>

  <record id="action_ua_hr_order_register_list_view" model="ir.actions.act_window.view">
    <field name="sequence">1</field>
    <field name="view_mode">list</field>
    <field name="view_id" ref="view_ua_hr_order_register_list"/>
    <field name="act_window_id" ref="action_ua_hr_order_register"/>
  </record>

  <record id="action_ua_hr_order_register_form_view" model="ir.actions.act_window.view">
    <field name="sequence">2</field>
    <field name="view_mode">form</field>
    <field name="view_id" ref="view_ua_hr_order_form"/>
    <field name="act_window_id" ref="action_ua_hr_order_register"/>
  </record>
</odoo>
