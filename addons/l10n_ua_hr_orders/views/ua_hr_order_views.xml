<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="view_ua_hr_order_form" model="ir.ui.view">
    <field name="name">ua.hr.order.form</field>
    <field name="model">ua.hr.order</field>
    <field name="arch" type="xml">
      <form string="Кадровий наказ">
        <header>
          <button name="action_post" type="object" string="Провести" invisible="state != 'draft'" class="oe_highlight"/>
          <button name="action_acknowledge" type="object" string="Ознайомити" invisible="state != 'posted'" class="oe_highlight"/>
          <button name="action_cancel" type="object" string="Скасувати" invisible="state not in ('posted', 'acknowledged')"
                  confirm="Скасувати наказ? Якщо дані після проведення не змінювали - зміну буде прибрано."/>
          <button name="%(l10n_ua_hr_orders.action_report_ua_hr_order)d" type="action" string="Друк" invisible="state == 'draft'"/>
          <field name="state" widget="statusbar" statusbar_visible="draft,posted,acknowledged"/>
        </header>
        <sheet>
          <div class="oe_title">
            <h1><field name="name" readonly="1" placeholder="Новий"/></h1>
          </div>
          <group>
            <group>
              <field name="order_type" readonly="state != 'draft'"/>
              <field name="register" readonly="state != 'draft'"/>
              <field name="date" readonly="state != 'draft'"/>
              <field name="employee_id" readonly="state != 'draft'"/>
              <field name="company_id" groups="base.group_multi_company" readonly="state != 'draft'"/>
            </group>
            <group>
              <field name="basis" readonly="state != 'draft'"/>
              <field name="ack_date" invisible="not ack_date"/>
              <field name="ack_user_id" invisible="not ack_user_id"/>
            </group>
          </group>

          <group string="Прийняття на роботу" invisible="order_type != 'hire'">
            <group>
              <field name="date_from" readonly="state != 'draft'"/>
              <field name="department_id" readonly="state != 'draft'"/>
              <field name="job_title" readonly="state != 'draft'"/>
              <field name="prof_name" readonly="state != 'draft'"/>
              <field name="kp_code" readonly="state != 'draft'"/>
            </group>
            <group>
              <field name="wage" readonly="state != 'draft'"/>
              <field name="fte" readonly="state != 'draft'"/>
              <field name="main_job" readonly="state != 'draft'"/>
              <field name="contract_kind" readonly="state != 'draft'"/>
              <field name="contract_type_id" readonly="state != 'draft'"/>
              <field name="trial_date_end" readonly="state != 'draft'"/>
            </group>
          </group>

          <group string="Зміна окладу" invisible="order_type != 'wage'">
            <group>
              <field name="date_from" readonly="state != 'draft'"/>
            </group>
            <group>
              <field name="wage_old"/>
              <field name="wage" readonly="state != 'draft'"/>
            </group>
          </group>

          <group string="Переведення" invisible="order_type != 'transfer'">
            <group>
              <field name="date_from" readonly="state != 'draft'"/>
              <field name="department_id" readonly="state != 'draft'"/>
              <field name="job_title" readonly="state != 'draft'"/>
              <field name="prof_name" readonly="state != 'draft'"/>
              <field name="kp_code" readonly="state != 'draft'"/>
            </group>
            <group>
              <field name="wage" readonly="state != 'draft'"/>
            </group>
          </group>

          <group string="Відпустка" invisible="order_type != 'leave'">
            <group>
              <field name="leave_type_id" readonly="state != 'draft'"/>
              <field name="date_from" readonly="state != 'draft'"/>
              <field name="date_to" readonly="state != 'draft'"/>
              <field name="days"/>
            </group>
            <group>
              <field name="sick_number" readonly="state != 'draft'"/>
            </group>
          </group>

          <group string="Звільнення" invisible="order_type != 'dismissal'">
            <group>
              <field name="date_to" readonly="state != 'draft'"/>
              <field name="dismissal_basis" readonly="state != 'draft'"/>
            </group>
            <group>
              <field name="comp_days" readonly="state != 'draft'"/>
            </group>
          </group>

          <group string="Відрядження" invisible="order_type != 'trip'">
            <group>
              <field name="date_from" readonly="state != 'draft'"/>
              <field name="date_to" readonly="state != 'draft'"/>
              <field name="days"/>
            </group>
            <group>
              <field name="destination" readonly="state != 'draft'"/>
              <field name="purpose" readonly="state != 'draft'"/>
            </group>
          </group>

          <group>
            <field name="note" readonly="state != 'draft'"/>
            <field name="signed_file" filename="signed_filename"/>
            <field name="signed_filename" invisible="1"/>
          </group>
        </sheet>
        <chatter/>
      </form>
    </field>
  </record>

  <record id="view_ua_hr_order_list" model="ir.ui.view">
    <field name="name">ua.hr.order.list</field>
    <field name="model">ua.hr.order</field>
    <field name="arch" type="xml">
      <list>
        <field name="name"/>
        <field name="date"/>
        <field name="order_type"/>
        <field name="register"/>
        <field name="employee_id"/>
        <field name="state" widget="badge" decoration-success="state == 'acknowledged'" decoration-info="state == 'posted'" decoration-danger="state == 'cancelled'"/>
      </list>
    </field>
  </record>

  <record id="view_ua_hr_order_search" model="ir.ui.view">
    <field name="name">ua.hr.order.search</field>
    <field name="model">ua.hr.order</field>
    <field name="arch" type="xml">
      <search>
        <field name="name"/>
        <field name="employee_id"/>
        <filter name="draft" string="Чернетка" domain="[('state', '=', 'draft')]"/>
        <filter name="posted" string="Проведено" domain="[('state', '=', 'posted')]"/>
        <separator/>
        <filter name="k1" string="К-1" domain="[('register', '=', 'k1')]"/>
        <filter name="v2" string="В-2" domain="[('register', '=', 'v2')]"/>
        <group>
          <filter name="group_type" string="Вид наказу" context="{'group_by': 'order_type'}"/>
          <filter name="group_state" string="Стан" context="{'group_by': 'state'}"/>
          <filter name="group_employee" string="Працівник" context="{'group_by': 'employee_id'}"/>
        </group>
      </search>
    </field>
  </record>

  <record id="action_ua_hr_order" model="ir.actions.act_window">
    <field name="name">Накази</field>
    <field name="res_model">ua.hr.order</field>
    <field name="view_mode">list,form</field>
    <field name="search_view_id" ref="view_ua_hr_order_search"/>
    <field name="context">{}</field>
  </record>
</odoo>
