<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="rule_ua_vacation_plan_company" model="ir.rule">
    <field name="name">Графік відпусток: лише свої компанії</field>
    <field name="model_id" ref="model_ua_vacation_plan"/>
    <field name="domain_force">[('company_id', 'in', company_ids)]</field>
  </record>
  <record id="rule_ua_vacation_plan_line_company" model="ir.rule">
    <field name="name">Рядок графіка відпусток: лише свої компанії</field>
    <field name="model_id" ref="model_ua_vacation_plan_line"/>
    <field name="domain_force">[('company_id', 'in', company_ids)]</field>
  </record>
</odoo>
