<?xml version="1.0" encoding="utf-8"?>
<!-- «25 вер.» проти «2 жовт. 2023 р.»: без options numeric Odoo сам обирає формат
     і ховає рік у поточному році - в одному списку виходить різнобій.
     dd.mm.yyyy завжди, узгоджено з форматом мови uk_UA. -->
<odoo>
  <record id="hr_leave_view_tree_ua_dates" model="ir.ui.view">
    <field name="name">hr.leave.list.ua.dates</field>
    <field name="model">hr.leave</field>
    <field name="inherit_id" ref="hr_holidays.hr_leave_view_tree"/>
    <field name="arch" type="xml">
      <field name="date_from" position="attributes">
        <attribute name="options">{'numeric': True}</attribute>
      </field>
      <field name="date_to" position="attributes">
        <attribute name="options">{'numeric': True}</attribute>
      </field>
    </field>
  </record>
</odoo>
