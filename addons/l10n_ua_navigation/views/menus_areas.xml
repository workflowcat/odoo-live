  <menuitem id="l10n_ua_payroll_account.menu_ua_payroll_account_map" name="Проводки зарплати"
            parent="menu_ua_payroll_params" sequence="30"/>
  <menuitem id="l10n_ua_average.menu_ua_earnings_history" name="Історія заробітку"
            parent="menu_ua_payroll_params" sequence="40"/>
  <menuitem id="menu_ua_setup_profile" name="Анкета компанії" parent="menu_ua_payroll_params"
            action="l10n_ua_setup.action_ua_setup_profile" sequence="50"/>
  <menuitem id="l10n_ua_changes.menu_ua_changes_root" name="Журнал змін"
            parent="menu_ua_payroll_params" sequence="60"/>
  <menuitem id="l10n_ua_kp.menu_ua_kp_code" name="Коди професій"
            parent="menu_ua_payroll_params" sequence="70"/>

  <!-- Технічні таблиці: лише в режимі розробника. Бухгалтер їх не редагує. -->
  <menuitem id="menu_ua_setup_questions" name="Питання анкети" parent="menu_ua_payroll_params"
            action="l10n_ua_setup.action_ua_setup_question" sequence="90"/>
  <menuitem id="payroll.payroll_menu_configuration" name="Довідники payroll"
            parent="menu_ua_payroll_params" sequence="95"/>
  <menuitem id="payroll.hr_payroll_structure_menu" name="Структури зарплати"
            parent="payroll.payroll_menu_configuration" sequence="10"/>
  <menuitem id="payroll.menu_hr_salary_rule_category" name="Категорії правил"
            parent="payroll.payroll_menu_configuration" sequence="20"/>
  <menuitem id="payroll.menu_action_hr_salary_rule_form" name="Правила розрахунку"
            parent="payroll.payroll_menu_configuration" sequence="30"/>
  <menuitem id="payroll.hr_contribution_register_menu" name="Реєстри внесків"
            parent="payroll.payroll_menu_configuration" sequence="40"/>
  <menuitem id="payroll.menu_payroll_global_settings" name="Налаштування payroll"
            parent="payroll.payroll_menu_configuration" sequence="50"/>
  <!-- Атрибут groups у menuitem додає групу до наявних, а меню видно за будь-якою з них.
       Тому перелік груп технічних пунктів перезаписуємо записом. -->
  <record id="menu_ua_setup_questions" model="ir.ui.menu">
    <field name="group_ids" eval="[(6, 0, [ref('base.group_no_one')])]"/>
  </record>
  <record id="payroll.payroll_menu_configuration" model="ir.ui.menu">
    <field name="group_ids" eval="[(6, 0, [ref('base.group_no_one')])]"/>
  </record>

  <!-- ================================================================= 2. Кадри -->
  <menuitem id="menu_ua_hr_employees" name="Картки працівників" parent="menu_ua_hr_root"
            action="hr.open_view_employee_list_my" sequence="10"/>
  <menuitem id="menu_ua_hr_hire" name="Прийняття" parent="menu_ua_hr_root"
