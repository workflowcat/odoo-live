            action="hr.hr_department_kanban_action" sequence="40"/>
  <menuitem id="menu_ua_hr_org_chart" name="Оргструктура" parent="menu_ua_hr_refs"
            action="hr_org_chart.action_hr_employee_org_chart" sequence="50"/>
  <menuitem id="l10n_ua_onboarding.menu_ua_employee_import" name="Перенесення працівників"
