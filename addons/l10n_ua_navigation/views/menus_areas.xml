  <!-- ================================================================= 3. Звітність -->
  <menuitem id="menu_ua_reporting_tax" name="ДПС" parent="menu_ua_reporting_root" sequence="10"/>
  <menuitem id="menu_ua_report_runs" name="Звіти періоду" parent="menu_ua_reporting_tax"
