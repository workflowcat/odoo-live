<?xml version="1.0" encoding="utf-8"?>
<!-- Три власні розділи меню: «Зарплата», «Кадри», «Звітність». Один власник меню на
     весь продукт: пункти оголошують логічні модулі своїми ідентифікаторами, місце їм
     ставить цей файл.

     Рідні розділи Odoo (Співробітники, Бухоблік, Продажі, Склад, Виробництво, CRM,
     Контакти, Дискусії, Календар) лишаються на місці й видимими: продукт іде голим
     Odoo. Нічого не вимикається через active="False".

     Банківські і облікові пункти стоять у рідному «Бухобліку», бо там же живуть
     журнали, виписки і звірка OCA. -->
<odoo>
  <!-- Назва дії стоїть у стежці навігації, тому вирівнюємо її зі своїм словом:
       у системі людина - «працівник», не «співробітник». -->
  <!-- Виконавці за договором ЦПХ/ФОП - контрагенти, не працівники: у кадровий облік не входять
       (правило бухгалтера Лани, 2026-09-16). Прибираємо їх з карток і оргструктури; свій перелік -
       «Договори ЦПХ» - у модулі l10n_ua_gph. -->
  <record id="hr.open_view_employee_list_my" model="ir.actions.act_window">
    <field name="name">Картки працівників</field>
    <field name="domain">[("ua_contract_kind", "not in", ["gph", "fop"])]</field>
  </record>
  <record id="hr_org_chart.action_hr_employee_org_chart" model="ir.actions.act_window">
    <field name="name">Оргструктура</field>
    <field name="domain">[("ua_contract_kind", "not in", ["gph", "fop"])]</field>
  </record>

  <!-- «Відсутності» зі стандартною дією hr_holidays відкривались з фільтром «Очікує на мене»:
       записів не видно, а Odoo малює на їхньому місці приклад з вигаданими людьми. -->
  <record id="action_ua_leaves" model="ir.actions.act_window">
    <field name="name">Відсутності</field>
    <field name="res_model">hr.leave</field>
    <field name="view_mode">list,calendar,form</field>
    <field name="domain">[]</field>
    <field name="context">{}</field>
  </record>

  <!-- ================================================================= розділи -->
  <menuitem id="menu_ua_payroll_root" name="Зарплата" sequence="1"
            groups="hr.group_hr_user,account.group_account_user"/>
  <menuitem id="menu_ua_hr_root" name="Кадри" sequence="2" groups="hr.group_hr_user"/>
  <menuitem id="menu_ua_reporting_root" name="Звітність" sequence="4"
            groups="hr.group_hr_user,account.group_account_user"/>

  <!-- ================================================================= 1. Зарплата -->
  <menuitem id="menu_ua_months" name="Місяці" parent="menu_ua_payroll_root"
            action="l10n_ua_changes.action_ua_period_close" sequence="10"/>

  <menuitem id="menu_ua_payslips" name="Листки" parent="menu_ua_payroll_root" sequence="20"/>
  <menuitem id="payroll.hr_payslip_menu" name="Розрахункові листки"
            parent="menu_ua_payslips" sequence="10"/>
  <menuitem id="payroll.hr_payslip_run_menu" name="Пакети листків"
            parent="menu_ua_payslips" sequence="20"/>
  <menuitem id="l10n_ua_payroll_rules.menu_ua_advance" name="Аванс за місяць"
            parent="menu_ua_payslips" sequence="30"/>

  <menuitem id="menu_ua_payroll_docs" name="Документи" parent="menu_ua_payroll_root" sequence="30"/>
  <menuitem id="menu_ua_advance_sheets" name="Авансові відомості" parent="menu_ua_payroll_docs"
            action="l10n_ua_payroll_rules.action_ua_advance_sheet" sequence="10"/>
