  <menuitem id="menu_ua_payment_orders" name="Відомості на перерахування" parent="menu_ua_payouts"
            action="l10n_ua_payments.action_ua_payment_order" sequence="10"/>
  <menuitem id="menu_ua_bank_ops_payroll" name="Операції банку" parent="menu_ua_payouts"
            action="l10n_ua_bank_online.action_ua_bank_ops" sequence="20"/>
  <menuitem id="l10n_ua_gph.menu_ua_gph" name="Договори ЦПХ"
            parent="menu_ua_payouts" sequence="30"/>

  <menuitem id="menu_ua_payroll_params" name="Параметри" parent="menu_ua_payroll_root" sequence="50"/>
  <menuitem id="l10n_ua_payroll_rules.menu_ua_payroll_param" name="Параметри зарплати"
            parent="menu_ua_payroll_params" sequence="10"/>
  <menuitem id="l10n_ua_index.menu_ua_cpi_index" name="Індекси споживчих цін"
