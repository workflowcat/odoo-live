<?xml version="1.0" encoding="utf-8"?>
<!-- Мова uk_UA мала б dd.mm.yyyy від ядра, але про всяк випадок фіксуємо явно -
     список «Відсутності» і «Накази» показували різні формати дати в одному
     списку («25 вер.» проти «2 жовт. 2023 р.»), бо поля без options numeric
     самі обирають короткий/довгий формат. noupdate="0", щоб застосовувалось і
     при оновленні модуля, якщо хтось інший це коли-небудь зіб'є. -->
<odoo noupdate="0">
  <record id="base.lang_uk_UA" model="res.lang">
    <field name="date_format">%d.%m.%Y</field>
  </record>
</odoo>
