<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="view_ua_cashflow_budget_line_list" model="ir.ui.view">
    <field name="name">ua.cashflow.budget.line.list</field>
    <field name="model">ua.cashflow.budget.line</field>
    <field name="arch" type="xml">
      <list string="Рядки бюджету" editable="bottom">
        <field name="item_id" options="{'no_create': True}"/>
        <field name="month"/>
        <field name="kind" optional="hide"/>
        <field name="currency_id" column_invisible="1"/>
        <field name="plan" sum="Разом"/>
        <field name="fact" sum="Разом"/>
        <field name="committed" sum="Разом" optional="show"/>
        <field name="remaining" sum="Разом" decoration-danger="remaining &lt; 0"/>
      </list>
    </field>
  </record>

  <record id="view_ua_cashflow_budget_line_pivot" model="ir.ui.view">
    <field name="name">ua.cashflow.budget.line.pivot</field>
    <field name="model">ua.cashflow.budget.line</field>
    <field name="arch" type="xml">
      <pivot string="Виконання бюджету руху коштів">
        <field name="section" type="row"/>
        <field name="item_id" type="row"/>
        <field name="month_num" type="col"/>
        <field name="plan" type="measure"/>
        <field name="fact" type="measure"/>
        <field name="remaining" type="measure"/>
      </pivot>
    </field>
  </record>

  <record id="view_ua_cashflow_budget_line_search" model="ir.ui.view">
    <field name="name">ua.cashflow.budget.line.search</field>
    <field name="model">ua.cashflow.budget.line</field>
    <field name="arch" type="xml">
      <search>
        <field name="item_id"/>
        <field name="budget_id"/>
        <filter name="f_out" string="Витрачання" domain="[('kind', '=', 'out')]"/>
        <filter name="f_in" string="Надходження" domain="[('kind', '=', 'in')]"/>
        <filter name="f_over" string="Понад план" domain="[('remaining', '&lt;', 0)]"/>
        <filter name="g_item" string="Стаття" context="{'group_by': 'item_id'}"/>
        <filter name="g_month" string="Місяць" context="{'group_by': 'month'}"/>
      </search>
    </field>
  </record>

  <record id="view_ua_cashflow_budget_list" model="ir.ui.view">
    <field name="name">ua.cashflow.budget.list</field>
    <field name="model">ua.cashflow.budget</field>
    <field name="arch" type="xml">
      <list string="Бюджети руху коштів">
        <field name="name"/>
        <field name="year"/>
        <field name="company_id" groups="base.group_multi_company"/>
        <field name="control"/>
        <field name="currency_id" column_invisible="1"/>
        <field name="plan_out"/>
        <field name="fact_out"/>
        <field name="state" widget="badge" decoration-success="state == 'approved'"/>
      </list>
    </field>
  </record>

  <record id="view_ua_cashflow_budget_form" model="ir.ui.view">
    <field name="name">ua.cashflow.budget.form</field>
    <field name="model">ua.cashflow.budget</field>
    <field name="arch" type="xml">
      <form string="Бюджет руху коштів">
        <header>
          <button name="action_approve" type="object" string="Затвердити" class="btn-primary"
                  invisible="state != 'draft'"/>
          <button name="action_refresh_fact" type="object" string="Оновити факт"/>
          <button name="action_open_analysis" type="object" string="Виконання"/>
          <button name="action_print" type="object" string="Друк"/>
          <button name="action_close" type="object" string="Закрити" invisible="state != 'approved'"/>
          <button name="action_draft" type="object" string="У чернетку" invisible="state == 'draft'"/>
          <field name="state" widget="statusbar"/>
        </header>
        <sheet>
          <div class="oe_title"><h1><field name="name" readonly="state != 'draft'"/></h1></div>
          <group>
            <group>
              <field name="year" readonly="state != 'draft'"/>
              <field name="control"/>
              <field name="company_id" groups="base.group_multi_company" readonly="state != 'draft'"/>
              <field name="fact_at"/>
            </group>
            <group>
              <field name="currency_id" invisible="1"/>
              <field name="plan_in"/>
              <field name="fact_in"/>
              <field name="plan_out"/>
              <field name="fact_out"/>
            </group>
          </group>
          <group string="Заповнити план фактом" invisible="state != 'draft'">
            <group>
              <field name="fill_year" placeholder="попередній рік"/>
              <field name="fill_percent"/>
            </group>
            <group>
              <button name="action_fill_from_fact" type="object" string="Заповнити" class="btn-secondary"/>
            </group>
          </group>
          <notebook>
            <page string="План і факт" name="lines">
              <field name="line_ids" context="{'default_budget_id': id}">
                <list editable="bottom">
                  <field name="item_id" options="{'no_create': True}" readonly="parent.state != 'draft'"/>
                  <field name="month" readonly="parent.state != 'draft'"/>
                  <field name="currency_id" column_invisible="1"/>
                  <field name="plan" sum="Разом" readonly="parent.state != 'draft'"/>
                  <field name="fact" sum="Разом"/>
                  <field name="committed" sum="Разом" optional="show"/>
                  <field name="remaining" sum="Разом" decoration-danger="remaining &lt; 0"/>
                </list>
              </field>
            </page>
          </notebook>
        </sheet>
        <chatter/>
      </form>
    </field>
  </record>

  <record id="action_ua_cashflow_budget" model="ir.actions.act_window">
    <field name="name">Бюджет руху коштів</field>
    <field name="res_model">ua.cashflow.budget</field>
    <field name="view_mode">list,form</field>
    <field name="help" type="html">
      <p>План надходжень і витрачань за статтями форми № 3 на кожен місяць року. Факт - з проводок за
        тими самими статтями, що й у звіті про рух коштів. Затверджений бюджет перевіряє заявки на
        оплату.</p>
    </field>
  </record>

  <record id="action_ua_cashflow_budget_analysis" model="ir.actions.act_window">
    <field name="name">Виконання бюджету</field>
    <field name="res_model">ua.cashflow.budget.line</field>
    <field name="view_mode">pivot,list</field>
    <field name="domain">[('budget_id.state', '=', 'approved')]</field>
  </record>

  <!-- Заявка на оплату -->
  <record id="view_ua_payment_request_form_budget" model="ir.ui.view">
    <field name="name">ua.payment.request.form.budget</field>
    <field name="model">ua.payment.request</field>
    <field name="inherit_id" ref="l10n_ua_payment_request.view_ua_payment_request_form"/>
    <field name="arch" type="xml">
      <field name="contract_id" position="after">
        <field name="ua_cashflow_item_id" options="{'no_create': True}" readonly="state != 'draft'"
               required="ua_budget_has and state == 'draft'"/>
        <field name="ua_budget_has" invisible="1"/>
        <field name="ua_budget_remaining" invisible="not ua_budget_has or not ua_cashflow_item_id"
               decoration-danger="ua_budget_remaining &lt; amount_company"/>
        <field name="ua_budget_over" invisible="not ua_budget_over"/>
      </field>
    </field>
  </record>

  <record id="view_ua_payment_request_list_budget" model="ir.ui.view">
    <field name="name">ua.payment.request.list.budget</field>
    <field name="model">ua.payment.request</field>
    <field name="inherit_id" ref="l10n_ua_payment_request.view_ua_payment_request_list"/>
    <field name="arch" type="xml">
      <field name="amount" position="before">
        <field name="ua_cashflow_item_id" optional="show"/>
        <field name="ua_budget_over" optional="hide"/>
      </field>
    </field>
  </record>
</odoo>
