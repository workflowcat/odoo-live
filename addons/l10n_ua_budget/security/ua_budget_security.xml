<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="rule_ua_cashflow_budget_company" model="ir.rule">
    <field name="name">Бюджет руху коштів: лише свої компанії</field>
    <field name="model_id" ref="model_ua_cashflow_budget"/>
    <field name="domain_force">[('company_id', 'in', company_ids)]</field>
  </record>
  <record id="rule_ua_cashflow_budget_line_company" model="ir.rule">
    <field name="name">Рядок бюджету руху коштів: лише свої компанії</field>
    <field name="model_id" ref="model_ua_cashflow_budget_line"/>
    <field name="domain_force">[('company_id', 'in', company_ids)]</field>
  </record>
</odoo>
