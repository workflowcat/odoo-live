<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="action_report_ua_cashflow" model="ir.actions.report">
    <field name="name">Звіт про рух грошових коштів (форма № 3)</field>
    <field name="model">ua.cashflow.statement</field>
    <field name="report_type">qweb-pdf</field>
    <field name="report_name">l10n_ua_cashflow.report_ua_cashflow</field>
    <field name="report_file">l10n_ua_cashflow.report_ua_cashflow</field>
    <field name="binding_model_id" ref="model_ua_cashflow_statement"/>
    <field name="binding_type">report</field>
    <field name="print_report_name">object.name</field>
  </record>

  <template id="report_ua_cashflow">
    <t t-call="web.html_container">
      <t t-foreach="docs" t-as="doc">
        <t t-call="web.basic_layout">
          <style>
            .ua-doc { font-size: 10px; color: #000; }
            .ua-doc h3 { font-size: 12px; text-align: center; margin: 4px 0; }
            .ua-doc .ua-sub { text-align: center; margin-bottom: 8px; }
            .ua-doc .ua-grid { width: 100%; border-collapse: collapse; }
            .ua-doc .ua-grid th, .ua-doc .ua-grid td { border: 1px solid #000; padding: 2px 3px; vertical-align: top; }
            .ua-doc .ua-grid th { font-weight: normal; text-align: center; }
            .ua-doc .ua-num { text-align: right; white-space: nowrap; width: 18%; }
            .ua-doc .ua-code { text-align: center; width: 8%; }
            .ua-doc .ua-bold td { font-weight: bold; }
            .ua-doc .ua-subrow td:first-child { padding-left: 16px; }
            .ua-doc .ua-sign { width: 100%; margin-top: 18px; }
          </style>
          <div class="ua-doc">
            <div>Підприємство: <t t-out="doc.company_id.name"/></div>
            <div t-if="doc.company_id.company_registry">за ЄДРПОУ: <t t-out="doc.company_id.company_registry"/></div>
            <div>Одиниця виміру: грн</div>
            <h3>Звіт про рух грошових коштів (за прямим методом)</h3>
            <div class="ua-sub">за період з <t t-out="doc.date_from.strftime('%d.%m.%Y')"/> по
              <t t-out="doc.date_to.strftime('%d.%m.%Y')"/>. Форма № 3, код за ДКУД 1801004</div>
            <table class="ua-grid">
              <thead><tr><th>Стаття</th><th>Код рядка</th><th>За звітний період</th>
                <th>За аналогічний період попереднього року</th></tr>
                <tr><th>1</th><th>2</th><th>3</th><th>4</th></tr></thead>
              <tbody>
                <t t-foreach="doc.ua_rows()" t-as="row">
                  <tr t-if="row[4] == 'section'" class="ua-bold"><td colspan="4" t-out="row[0]"/></tr>
                  <tr t-else="" t-att-class="'ua-bold' if row[4] == 'total' else ('ua-subrow' if row[4] == 'sub' else '')">
                    <td t-out="row[0]"/>
                    <td class="ua-code" t-out="row[1]"/>
                    <td class="ua-num" t-out="doc.ua_money(row[2])"/>
                    <td class="ua-num" t-out="doc.ua_money(row[3])"/>
                  </tr>
                </t>
              </tbody>
            </table>
            <table class="ua-sign">
              <tr><td>Керівник ____________________</td><td>Головний бухгалтер ____________________</td></tr>
            </table>
          </div>
        </t>
      </t>
    </t>
  </template>
</odoo>
