<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="action_report_ua_product_test" model="ir.actions.report">
    <field name="name">Протокол випробувань</field>
    <field name="model">ua.product.test</field>
    <field name="report_type">qweb-pdf</field>
    <field name="report_name">l10n_ua_product_tests.report_ua_product_test</field>
    <field name="report_file">l10n_ua_product_tests.report_ua_product_test</field>
    <field name="binding_model_id" ref="model_ua_product_test"/>
    <field name="binding_type">report</field>
    <field name="print_report_name">'Протокол випробувань %s' % (object.name or '')</field>
  </record>

  <template id="report_ua_product_test">
    <t t-call="web.html_container">
      <t t-foreach="docs" t-as="doc">
        <t t-call="web.basic_layout">
          <style>
            .ua-doc { font-size: 10.5px; color: #000; }
            .ua-doc h3 { font-size: 13px; text-align: center; margin: 4px 0; }
            .ua-doc .ua-sub { text-align: center; margin-bottom: 8px; }
            .ua-doc .ua-grid { width: 100%; border-collapse: collapse; margin: 6px 0; }
            .ua-doc .ua-grid td { border: 1px solid #000; padding: 2px 4px; vertical-align: top; }
            .ua-doc .ua-sign { width: 100%; margin-top: 18px; }
            .ua-doc .ua-sign td { width: 50%; vertical-align: top; padding: 12px 12px 0 0; }
          </style>
          <div class="ua-doc">
            <div><t t-out="doc.company_id.name"/></div>
            <h3>ПРОТОКОЛ ВИПРОБУВАНЬ № <t t-out="doc.name"/></h3>
            <div class="ua-sub"><t t-out="doc.ua_kind_label()"/> випробування, <t t-out="doc.ua_date(doc.date)"/></div>
            <table class="ua-grid">
              <tr><td style="width: 30%;">Виріб</td><td><t t-out="doc.product_tmpl_id.display_name"/></td></tr>
              <tr><td>Зразки (серійні номери)</td><td><t t-out="', '.join(doc.lot_ids.mapped('name')) or '-'"/></td></tr>
              <tr t-if="doc.program"><td>Програма і методика</td><td><t t-out="doc.program"/></td></tr>
              <tr t-if="doc.eco_id"><td>Зміна конструкції</td><td><t t-out="doc.eco_id.name"/></td></tr>
              <tr t-if="doc.basis"><td>Підстава</td><td><t t-out="doc.basis"/></td></tr>
              <tr t-if="doc.place"><td>Де випробовували</td><td><t t-out="doc.place"/></td></tr>
              <tr t-if="doc.findings"><td>Результати і висновки</td><td><t t-out="doc.findings"/></td></tr>
              <tr><td>Результат</td><td><strong><t t-out="'витримано' if doc.result == 'passed' else 'не витримано'"/></strong>
                <t t-if="doc.valid_until">; наступні - до <t t-out="doc.ua_date(doc.valid_until)"/></t></td></tr>
            </table>
            <p t-if="doc.result == 'failed'">Приймання і відвантаження виробів призупинено до усунення причин і
              повторних випробувань з позитивним результатом.</p>
            <table class="ua-sign"><tr>
              <td>Голова комісії (керівник випробувань)<br/><br/>______________ / ______________________</td>
              <td>Представник замовника<t t-if="doc.representative"> <t t-out="doc.representative"/></t><br/><br/>______________ / ______________________</td>
            </tr></table>
          </div>
        </t>
      </t>
    </t>
  </template>
</odoo>
