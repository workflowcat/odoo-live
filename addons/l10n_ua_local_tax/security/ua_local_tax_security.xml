<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="rule_ua_local_tax_object_company" model="ir.rule">
    <field name="name">Об'єкт місцевих податків: лише свої компанії</field>
    <field name="model_id" ref="model_ua_local_tax_object"/>
    <field name="domain_force">[('company_id', 'in', company_ids)]</field>
  </record>
  <record id="rule_ua_local_tax_return_company" model="ir.rule">
    <field name="name">Розрахунок місцевого податку: лише свої компанії</field>
    <field name="model_id" ref="model_ua_local_tax_return"/>
    <field name="domain_force">[('company_id', 'in', company_ids)]</field>
  </record>
  <record id="rule_ua_local_tax_line_company" model="ir.rule">
    <field name="name">Рядок розрахунку місцевого податку: лише свої компанії</field>
    <field name="model_id" ref="model_ua_local_tax_line"/>
    <field name="domain_force">[('return_id.company_id', 'in', company_ids)]</field>
  </record>
</odoo>
