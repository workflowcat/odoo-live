<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <!-- Правила компанії: записи однієї компанії не видно з іншої. Той самий домен,
       що в нативних документах Odoo; рядок бере компанію в документа, на якому висить,
       а довідник із порожньою компанією спільний для всіх. -->
  <record id="rule_ua_fop_income_company" model="ir.rule">
    <field name="name">Книга обліку доходів ФОП: лише свої компанії</field>
    <field name="model_id" ref="model_ua_fop_income"/>
    <field name="domain_force">[('company_id', 'in', company_ids)]</field>
  </record>

  <record id="rule_ua_fop_quarter_company" model="ir.rule">
    <field name="name">ФОП 3 група: квартальний розрахунок: лише свої компанії</field>
    <field name="model_id" ref="model_ua_fop_quarter"/>
    <field name="domain_force">[('company_id', 'in', company_ids)]</field>
  </record>

  <record id="rule_ua_fop_param_company" model="ir.rule">
    <field name="name">Параметр ФОП (Україна): лише свої компанії</field>
    <field name="model_id" ref="model_ua_fop_param"/>
    <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
  </record>
</odoo>
