<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="view_company_form_ua_fop" model="ir.ui.view">
    <field name="name">res.company.form.ua.fop</field>
    <field name="model">res.company</field>
    <field name="inherit_id" ref="base.view_company_form"/>
    <field name="arch" type="xml">
      <sheet position="inside">
        <group string="ФОП на єдиному податку">
          <field name="ua_fop"/>
          <field name="ua_fop_group" invisible="not ua_fop"/>
          <field name="ua_fop_vat_payer" invisible="not ua_fop"/>
        </group>
      </sheet>
    </field>
  </record>
</odoo>
