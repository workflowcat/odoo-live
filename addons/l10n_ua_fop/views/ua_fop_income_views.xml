<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <!-- Книга обліку доходів - це і є цей список: дати, суми, підсумок. -->
  <record id="view_ua_fop_income_list" model="ir.ui.view">
    <field name="name">ua.fop.income.list</field>
    <field name="model">ua.fop.income</field>
    <field name="arch" type="xml">
      <list string="Книга обліку доходів" default_order="date, id">
        <field name="date"/>
        <field name="name"/>
        <field name="partner_id" optional="show"/>
        <field name="kind"/>
        <field name="source" optional="hide"/>
        <field name="amount_foreign" optional="hide"/>
        <field name="currency_foreign_id" optional="hide"/>
        <field name="rate" optional="hide"/>
        <field name="amount" sum="Разом"/>
        <field name="currency_id" column_invisible="1"/>
        <field name="payment_id" optional="hide"/>
        <field name="company_id" column_invisible="1"/>
      </list>
    </field>
  </record>

  <record id="view_ua_fop_income_form" model="ir.ui.view">
    <field name="name">ua.fop.income.form</field>
    <field name="model">ua.fop.income</field>
    <field name="arch" type="xml">
      <form string="Рядок книги доходів">
        <sheet>
          <group>
            <group>
              <field name="date"/>
              <field name="name"/>
              <field name="partner_id"/>
              <field name="kind"/>
              <field name="source"/>
            </group>
            <group>
              <field name="amount"/>
              <field name="currency_id" invisible="1"/>
              <field name="currency_foreign_id"/>
              <field name="amount_foreign" invisible="not currency_foreign_id"/>
              <field name="rate" invisible="not currency_foreign_id"/>
              <field name="payment_id" readonly="1"/>
              <field name="company_id" groups="base.group_multi_company"/>
            </group>
          </group>
        </sheet>
      </form>
    </field>
  </record>

  <record id="view_ua_fop_income_search" model="ir.ui.view">
    <field name="name">ua.fop.income.search</field>
    <field name="model">ua.fop.income</field>
    <field name="arch" type="xml">
      <search string="Книга доходів">
        <field name="name"/>
        <field name="partner_id"/>
        <filter name="f_income" string="Тільки дохід" domain="[('kind','!=','not_income')]"/>
        <filter name="f_not_income" string="Не дохід" domain="[('kind','=','not_income')]"/>
        <separator/>
        <filter name="g_month" string="Місяць" domain="[]" context="{'group_by': 'date:month'}"/>
        <filter name="g_kind" string="Вид" domain="[]" context="{'group_by': 'kind'}"/>
        <filter name="g_partner" string="Платник" domain="[]" context="{'group_by': 'partner_id'}"/>
      </search>
    </field>
  </record>

  <record id="action_ua_fop_income" model="ir.actions.act_window">
    <field name="name">Книга обліку доходів</field>
    <field name="res_model">ua.fop.income</field>
    <field name="view_mode">list,form</field>
    <field name="context">{'search_default_f_income': 1, 'search_default_g_month': 1}</field>
  </record>

  <record id="action_ua_fop_income_sync" model="ir.actions.server">
    <field name="name">Оновити книгу з платежів</field>
    <field name="model_id" ref="model_ua_fop_income"/>
    <field name="state">code</field>
    <field name="code">model._ua_fop_sync()</field>
  </record>
</odoo>
