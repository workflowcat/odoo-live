<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <!-- Правила компанії: записи однієї компанії не видно з іншої. Той самий домен,
       що в нативних документах Odoo; рядок бере компанію в документа, на якому висить,
       а довідник із порожньою компанією спільний для всіх. -->
  <record id="rule_ua_advance_report_company" model="ir.rule">
    <field name="name">Авансовий звіт: лише свої компанії</field>
    <field name="model_id" ref="model_ua_advance_report"/>
    <field name="domain_force">[('company_id', 'in', company_ids)]</field>
  </record>

  <record id="rule_ua_advance_report_line_company" model="ir.rule">
    <field name="name">Рядок авансового звіту: лише свої компанії</field>
    <field name="model_id" ref="model_ua_advance_report_line"/>
    <field name="domain_force">[('report_id.company_id', 'in', company_ids)]</field>
  </record>

  <record id="rule_ua_cash_book_company" model="ir.rule">
    <field name="name">Касова книга (КО-4): лише свої компанії</field>
    <field name="model_id" ref="model_ua_cash_book"/>
    <field name="domain_force">[('company_id', 'in', company_ids)]</field>
  </record>

  <record id="rule_ua_cash_book_line_company" model="ir.rule">
    <field name="name">Аркуш касової книги за день: лише свої компанії</field>
    <field name="model_id" ref="model_ua_cash_book_line"/>
    <field name="domain_force">[('book_id.company_id', 'in', company_ids)]</field>
  </record>

  <record id="rule_ua_cash_book_entry_company" model="ir.rule">
    <field name="name">Рядок аркуша касової книги: лише свої компанії</field>
    <field name="model_id" ref="model_ua_cash_book_entry"/>
    <field name="domain_force">[('line_id.book_id.company_id', 'in', company_ids)]</field>
  </record>
</odoo>
