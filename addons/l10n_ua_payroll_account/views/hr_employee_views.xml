<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="view_employee_form_ua_account_alimony" model="ir.ui.view">
    <field name="name">hr.employee.form.ua.account.alimony</field><field name="model">hr.employee</field>
    <field name="inherit_id" ref="l10n_ua_payroll_rules.view_employee_form_ua"/>
    <field name="arch" type="xml">
      <field name="ua_psp_children" position="after"><field name="ua_alimony_partner_id"/></field>
    </field>
  </record>
  <record id="view_company_form_ua_account" model="ir.ui.view">
    <field name="name">res.company.form.ua.account</field><field name="model">res.company</field>
    <field name="inherit_id" ref="base.view_company_form"/>
    <field name="arch" type="xml">
      <xpath expr="//notebook" position="inside">
        <page string="Зарплата (проводки)" name="ua_payroll_account"><group><field name="ua_dps_partner_id"/><field name="ua_pfu_partner_id"/></group></page>
      </xpath>
    </field>
  </record>
</odoo>
