<?xml version="1.0" encoding="utf-8"?>
<!--
  Що потрапляє в журнал змін: одне правило OCA auditlog на модель.

  Пишемо тільки поля, які змінюють гроші, час, стан документа або законодавчий
  параметр. Решти полів правило не бачить взагалі - ні обчислюваних збережених, ні
  підписників, ні технічних міток. Через це в чергу бухгалтера не потрапляє тріска,
  хоч би хто писав: людина, крон чи OdooBot.

  Поля правила, яких немає в самому auditlog, описані в
  models/ua_change_source.py: ua_area, ua_field_ids, ua_period_ym, ua_period_date,
  ua_company, ua_label.

  noupdate="1": правила лишаються такими, якими їх поставили, і оновлення модуля
  не затирає того, що бухгалтер виправив руками.
-->
<odoo noupdate="1">

  <!-- ============================================================ кадри -->
  <record id="rule_ua_hr_order" model="auditlog.rule">
    <field name="name">Журнал змін: накази</field>
    <field name="model_id" search="[('model', '=', 'ua.hr.order')]"/>
    <field name="log_type">full</field>
    <field name="log_read" eval="False"/>
    <field name="log_create" eval="False"/>
    <field name="log_write" eval="True"/>
    <field name="log_unlink" eval="True"/>
    <field name="log_export_data" eval="False"/>
    <field name="state">confirmed</field>
    <field name="ua_area">hr</field>
    <field name="ua_period_date">date</field>
    <field name="ua_field_ids" eval="[
      Command.create({'field_name': 'state', 'label': 'Стан наказу'}),
      Command.create({'field_name': 'date', 'label': 'Дата наказу'}),
      Command.create({'field_name': 'employee_id', 'label': 'Працівник'}),
      Command.create({'field_name': 'wage', 'label': 'Оклад'}),
      Command.create({'field_name': 'date_from', 'label': 'З дати'}),
      Command.create({'field_name': 'date_to', 'label': 'По дату'}),
      Command.create({'field_name': 'order_type', 'label': 'Вид наказу'}),
      Command.create({'field_name': 'fte', 'label': 'Ставка'}),
    ]"/>
  </record>

