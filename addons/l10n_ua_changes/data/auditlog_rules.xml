    <field name="ua_area">hr</field>
    <field name="ua_label">employee_id.name|name</field>
    <field name="ua_field_ids" eval="[
      Command.create({'field_name': 'wage', 'label': 'Оклад'}),
      Command.create({'field_name': 'contract_date_start', 'label': 'Діє з'}),
      Command.create({'field_name': 'contract_date_end', 'label': 'Діє по'}),
      Command.create({'field_name': 'struct_id', 'label': 'Структура нарахування'}),
