<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="view_ua_change_log_list" model="ir.ui.view">
    <field name="name">ua.change.log.list</field>
    <field name="model">ua.change.log</field>
    <field name="arch" type="xml">
      <list string="Журнал змін" create="false" delete="false" default_order="date desc"
            decoration-warning="state == 'new'" decoration-muted="state == 'accepted'">
        <field name="date" widget="datetime"/>
        <field name="period_label"/>
        <field name="area"/>
        <field name="operation"/>
        <field name="res_name"/>
        <field name="what"/>
        <field name="old_value"/>
        <field name="new_value"/>
        <field name="amount" sum="Різниця"/>
        <field name="user_id" widget="many2one_avatar_user"/>
        <field name="state"/>
        <field name="note" optional="show"/>
        <button name="action_accept" type="object" string="Прийняти" icon="fa-check"
                invisible="state == 'accepted'"/>
        <button name="action_open_record" type="object" string="Відкрити" icon="fa-external-link"/>
        <field name="company_id" column_invisible="1"/>
      </list>
    </field>
  </record>

  <record id="view_ua_change_log_form" model="ir.ui.view">
    <field name="name">ua.change.log.form</field>
    <field name="model">ua.change.log</field>
    <field name="arch" type="xml">
      <form string="Зміна" create="false">
        <header>
          <button name="action_accept" type="object" string="Прийняти" class="btn-primary"
                  invisible="state == 'accepted'"/>
          <button name="action_reset" type="object" string="Повернути на перегляд"
                  invisible="state != 'accepted'"/>
          <button name="action_open_record" type="object" string="Відкрити запис"/>
          <field name="state" widget="statusbar"/>
        </header>
        <sheet>
          <group>
            <group>
              <field name="date"/>
              <field name="user_id"/>
              <field name="area"/>
              <field name="operation"/>
              <field name="period_label"/>
            </group>
            <group>
              <field name="res_name"/>
              <field name="what"/>
              <field name="old_value"/>
              <field name="new_value"/>
              <field name="amount"/>
              <field name="accepted_user_id"/>
              <field name="accepted_date"/>
            </group>
          </group>
          <group>
            <field name="note" placeholder="Чому змінили"/>
          </group>
        </sheet>
      </form>
    </field>
  </record>

  <record id="view_ua_change_log_search" model="ir.ui.view">
    <field name="name">ua.change.log.search</field>
    <field name="model">ua.change.log</field>
    <field name="arch" type="xml">
      <search string="Журнал змін">
        <field name="res_name" string="Запис"/>
        <field name="user_id"/>
        <field name="what"/>
        <filter name="f_new" string="Нові" domain="[('state','=','new')]"/>
        <filter name="f_accepted" string="Прийняті" domain="[('state','=','accepted')]"/>
        <separator/>
        <filter name="f_hr" string="Кадри" domain="[('area','=','hr')]"/>
        <filter name="f_time" string="Табель" domain="[('area','=','time')]"/>
        <filter name="f_payroll" string="Зарплата" domain="[('area','=','payroll')]"/>
        <filter name="f_account" string="Облік" domain="[('area','=','account')]"/>
        <filter name="f_bank" string="Банк" domain="[('area','=','bank')]"/>
        <filter name="f_report" string="Звітність" domain="[('area','=','report')]"/>
        <filter name="f_setup" string="Налаштування" domain="[('area','=','setup')]"/>
        <separator/>
        <filter name="f_unlink" string="Видалення" domain="[('operation','=','unlink')]"/>
        <filter name="f_money" string="Зі зміною суми" domain="[('amount','!=',0)]"/>
        <separator/>
        <filter name="f_week" string="За 7 днів"
                domain="[('date','&gt;=', (context_today() - relativedelta(days=7)).strftime('%Y-%m-%d'))]"/>
        <group>
          <filter name="g_area" string="Ділянка" context="{'group_by': 'area'}"/>
          <filter name="g_period" string="Період" context="{'group_by': 'period_label'}"/>
          <filter name="g_user" string="Користувач" context="{'group_by': 'user_id'}"/>
          <filter name="g_op" string="Дія" context="{'group_by': 'operation'}"/>
          <filter name="g_model" string="Модель" context="{'group_by': 'model_name'}"/>
          <filter name="g_state" string="Стан" context="{'group_by': 'state'}"/>
        </group>
      </search>
    </field>
  </record>

  <record id="action_ua_change_log" model="ir.actions.act_window">
    <field name="name">Журнал змін</field>
    <field name="res_model">ua.change.log</field>
    <field name="view_mode">list,form</field>
    <field name="search_view_id" ref="view_ua_change_log_search"/>
    <field name="context">{'search_default_f_new': 1, 'search_default_g_area': 1}</field>
    <field name="help" type="html">
      <p class="o_view_nocontent_smiling_face">Журнал порожній</p>
      <p>Тут з'являється кожна зміна суми, часу або стану документа.</p>
    </field>
  </record>

  <menuitem id="menu_ua_changes_root" name="Журнал змін" sequence="5" action="action_ua_change_log"/>
</odoo>
