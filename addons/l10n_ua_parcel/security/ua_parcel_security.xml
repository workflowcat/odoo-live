<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="rule_ua_parcel_carrier_company" model="ir.rule">
    <field name="name">Перевізники: спільні і своєї компанії</field>
    <field name="model_id" ref="model_ua_parcel_carrier"/>
    <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
  </record>
  <record id="rule_ua_parcel_company" model="ir.rule">
    <field name="name">Відправлення: своя компанія</field>
    <field name="model_id" ref="model_ua_parcel"/>
    <field name="domain_force">[('company_id', 'in', company_ids)]</field>
  </record>
  <record id="rule_ua_parcel_event_company" model="ir.rule">
    <field name="name">Події відправлень: своя компанія</field>
    <field name="model_id" ref="model_ua_parcel_event"/>
    <field name="domain_force">[('company_id', 'in', company_ids)]</field>
  </record>
</odoo>
