<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="action_ua_home" model="ir.actions.client">
    <field name="name">Домівка</field>
    <field name="tag">ua_home</field>
  </record>

  <!-- Корінь без власної дії, дитина відкриває екран - як «Працівники» і «Налаштування зарплати».
       Низька послідовність ставить розділ першим, перед «Зарплата» (sequence=1). -->
  <menuitem id="menu_ua_home_root" name="Домівка" sequence="0"/>
  <menuitem id="menu_ua_home_screen" name="Домівка" parent="menu_ua_home_root"
            action="action_ua_home" sequence="1"/>
</odoo>
