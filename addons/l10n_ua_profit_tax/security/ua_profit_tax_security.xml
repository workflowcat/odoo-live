<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <!-- Правила компанії: записи однієї компанії не видно з іншої. Той самий домен,
       що в нативних документах Odoo; рядок бере компанію в документа, на якому висить,
       а довідник із порожньою компанією спільний для всіх. -->
  <record id="rule_ua_profit_declaration_company" model="ir.rule">
    <field name="name">Декларація з податку на прибуток: лише свої компанії</field>
    <field name="model_id" ref="model_ua_profit_declaration"/>
    <field name="domain_force">[('company_id', 'in', company_ids)]</field>
  </record>

  <record id="rule_ua_profit_declaration_line_company" model="ir.rule">
    <field name="name">Рядок декларації з податку на прибуток: лише свої компанії</field>
    <field name="model_id" ref="model_ua_profit_declaration_line"/>
    <field name="domain_force">[('declaration_id.company_id', 'in', company_ids)]</field>
  </record>

  <record id="rule_ua_profit_param_company" model="ir.rule">
    <field name="name">Параметр податку на прибуток (Україна): лише свої компанії</field>
    <field name="model_id" ref="model_ua_profit_param"/>
    <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
  </record>
</odoo>
