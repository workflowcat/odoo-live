<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <data noupdate="0">
    <!-- Ставка податку на прибуток. Основна ставка не змінювалась з 2014 року,
         але запис однаково датований: новий закон - новий рядок, код не чіпаємо. -->
    <record id="p_rate_2014" model="ua.profit.param">
      <field name="key">profit_tax_rate</field>
      <field name="name">Ставка податку на прибуток, %</field>
      <field name="valid_from">2014-01-01</field>
      <field name="value">18</field>
      <field name="source">п. 136.1 ПКУ</field>
    </record>

    <!-- Поріг малодохідника: до нього різниці можна не застосовувати
         (крім збитків минулих років) і звітувати раз на рік. -->
    <record id="p_low_income_2017" model="ua.profit.param">
      <field name="key">profit_low_income_limit</field>
      <field name="name">Поріг малодохідника, грн річного доходу</field>
      <field name="valid_from">2017-01-01</field>
      <field name="value">20000000</field>
      <field name="source">пп. 134.1.1 ПКУ у редакції до 2018 року</field>
    </record>
    <record id="p_low_income_2018" model="ua.profit.param">
      <field name="key">profit_low_income_limit</field>
      <field name="name">Поріг малодохідника, грн річного доходу</field>
      <field name="valid_from">2018-01-01</field>
      <field name="value">40000000</field>
      <field name="source">пп. 134.1.1 ПКУ</field>
    </record>

    <!-- Від'ємне значення минулих років у великого платника (пп. 140.4.4 ПКУ): зменшує
         результат лише на частку непогашеного залишку, а якщо залишок не більший за частку
         додатного об'єкта - на весь. Дату і частки звірте з чинною редакцією ПКУ. -->
    <record id="p_loss_share_2021" model="ua.profit.param">
      <field name="key">profit_loss_share_large</field>
      <field name="name">Великий платник: частка від'ємного значення минулих років, %</field>
      <field name="valid_from">2021-01-01</field>
      <field name="value">50</field>
      <field name="source">пп. 140.4.4 ПКУ (Закон № 466-IX); перевірте чинну редакцію</field>
    </record>
    <record id="p_loss_full_2021" model="ua.profit.param">
      <field name="key">profit_loss_full_if_large</field>
      <field name="name">Великий платник: увесь залишок, якщо він не більший за цю частку об'єкта, %</field>
      <field name="valid_from">2021-01-01</field>
      <field name="value">10</field>
      <field name="source">пп. 140.4.4 ПКУ, абзац п'ятий; перевірте чинну редакцію</field>
    </record>
  </data>
</odoo>
