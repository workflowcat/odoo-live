<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="rule_ua_piecework_company" model="ir.rule">
    <field name="name">Виробіток: своя компанія</field>
    <field name="model_id" ref="model_ua_piecework"/>
    <field name="domain_force">[('company_id', 'in', company_ids)]</field>
  </record>
  <record id="rule_ua_piecework_line_company" model="ir.rule">
    <field name="name">Рядок виробітку: своя компанія</field>
    <field name="model_id" ref="model_ua_piecework_line"/>
    <field name="domain_force">[('company_id', 'in', company_ids)]</field>
  </record>
  <record id="rule_ua_piecework_plan_company" model="ir.rule">
    <field name="name">План виробітку: своя компанія</field>
    <field name="model_id" ref="model_ua_piecework_plan"/>
    <field name="domain_force">[('company_id', 'in', company_ids)]</field>
  </record>
</odoo>
