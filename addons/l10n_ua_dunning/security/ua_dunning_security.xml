<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="rule_ua_dunning_level_company" model="ir.rule">
    <field name="name">Рівні нагадувань: своя компанія або спільні</field>
    <field name="model_id" ref="model_ua_dunning_level"/>
    <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
  </record>
  <record id="rule_ua_dunning_letter_company" model="ir.rule">
    <field name="name">Нагадування про борг: своя компанія</field>
    <field name="model_id" ref="model_ua_dunning_letter"/>
    <field name="domain_force">[('company_id', 'in', company_ids)]</field>
  </record>
</odoo>
