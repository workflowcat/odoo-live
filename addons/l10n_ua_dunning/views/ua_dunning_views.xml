<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <!-- ======================================================= рівні -->
  <record id="view_ua_dunning_level_list" model="ir.ui.view">
    <field name="name">ua.dunning.level.list</field><field name="model">ua.dunning.level</field>
    <field name="arch" type="xml">
      <list string="Рівні нагадувань">
        <field name="days"/>
        <field name="name"/>
        <field name="subject"/>
        <field name="auto_send"/>
        <field name="company_id" groups="base.group_multi_company" optional="hide"/>
      </list>
    </field>
  </record>

  <record id="view_ua_dunning_level_form" model="ir.ui.view">
    <field name="name">ua.dunning.level.form</field><field name="model">ua.dunning.level</field>
    <field name="arch" type="xml">
      <form string="Рівень нагадування">
        <sheet>
          <group>
            <group>
              <field name="name"/>
              <field name="days"/>
              <field name="auto_send"/>
            </group>
            <group>
              <field name="company_id" groups="base.group_multi_company"/>
              <field name="active" invisible="1"/>
            </group>
          </group>
          <group>
            <field name="subject"/>
            <field name="intro"/>
          </group>
        </sheet>
      </form>
    </field>
  </record>

  <record id="action_ua_dunning_level" model="ir.actions.act_window">
    <field name="name">Рівні нагадувань</field>
    <field name="res_model">ua.dunning.level</field>
    <field name="view_mode">list,form</field>
  </record>

  <!-- ======================================================= листи -->
  <record id="view_ua_dunning_letter_form" model="ir.ui.view">
    <field name="name">ua.dunning.letter.form</field><field name="model">ua.dunning.letter</field>
    <field name="arch" type="xml">
      <form string="Нагадування про борг">
        <header>
          <button name="action_send" type="object" string="Надіслати" class="btn-primary" invisible="state != 'draft'"/>
          <button name="action_print" type="object" string="Друк"/>
          <button name="action_refresh" type="object" string="Оновити" invisible="state != 'draft'"/>
          <button name="action_mark_sent" type="object" string="Передано інакше" invisible="state != 'draft'"
                  help="Лист надруковано або передано месенджером: позначити рахунки як нагадані."/>
          <button name="action_cancel" type="object" string="Скасувати" invisible="state != 'draft'"/>
          <field name="state" widget="statusbar" statusbar_visible="draft,sent"/>
        </header>
        <sheet>
          <div class="oe_title"><h1><field name="name" readonly="1"/></h1></div>
          <group>
            <group>
              <field name="partner_id" readonly="state != 'draft'"/>
              <field name="email_to"/>
              <field name="contract_id" readonly="state != 'draft'"/>
              <field name="level_id" readonly="state != 'draft'"/>
            </group>
            <group>
              <field name="date" readonly="state != 'draft'"/>
              <field name="sent_date" invisible="not sent_date"/>
              <field name="currency_id" invisible="1"/>
              <field name="amount_total"/>
              <field name="company_id" groups="base.group_multi_company" readonly="state != 'draft'"/>
            </group>
          </group>
          <notebook>
            <page string="Рахунки" name="lines">
              <field name="line_ids" readonly="1">
                <list>
                  <field name="move_id"/>
                  <field name="invoice_date"/>
                  <field name="invoice_date_due"/>
                  <field name="days_overdue"/>
                  <field name="level_id"/>
                  <field name="currency_id" column_invisible="1"/>
                  <field name="amount_residual" sum="Разом"/>
                </list>
              </field>
            </page>
            <page string="Лист" name="body">
              <group><field name="subject" readonly="state != 'draft'"/></group>
              <field name="body_html" readonly="state != 'draft'"/>
            </page>
          </notebook>
        </sheet>
        <chatter/>
      </form>
    </field>
  </record>

  <record id="view_ua_dunning_letter_list" model="ir.ui.view">
    <field name="name">ua.dunning.letter.list</field><field name="model">ua.dunning.letter</field>
    <field name="arch" type="xml">
      <list string="Нагадування про борг">
        <field name="date"/>
        <field name="name"/>
        <field name="partner_id"/>
        <field name="contract_id" optional="show"/>
        <field name="level_id"/>
        <field name="email_to" optional="hide"/>
        <field name="currency_id" column_invisible="1"/>
        <field name="amount_total" sum="Разом"/>
        <field name="state" widget="badge" decoration-info="state == 'draft'" decoration-success="state == 'sent'"/>
      </list>
    </field>
  </record>

  <record id="view_ua_dunning_letter_search" model="ir.ui.view">
    <field name="name">ua.dunning.letter.search</field><field name="model">ua.dunning.letter</field>
    <field name="arch" type="xml">
      <search>
        <field name="name"/>
        <field name="partner_id"/>
        <field name="contract_id"/>
        <filter name="draft" string="Чекають перегляду" domain="[('state', '=', 'draft')]"/>
        <filter name="sent" string="Надіслані" domain="[('state', '=', 'sent')]"/>
        <filter name="no_email" string="Без пошти" domain="[('email_to', '=', False)]"/>
        <group>
          <filter name="by_level" string="Рівень" context="{'group_by': 'level_id'}"/>
          <filter name="by_partner" string="Контрагент" context="{'group_by': 'partner_id'}"/>
        </group>
      </search>
    </field>
  </record>

  <record id="action_ua_dunning_letter" model="ir.actions.act_window">
    <field name="name">Нагадування про борг</field>
    <field name="res_model">ua.dunning.letter</field>
    <field name="view_mode">list,form</field>
    <field name="context">{'search_default_draft': 1}</field>
  </record>

  <record id="action_ua_dunning_generate" model="ir.actions.server">
    <field name="name">Підготувати нагадування</field>
    <field name="model_id" ref="model_ua_dunning_letter"/>
    <field name="state">code</field>
    <field name="code">model._ua_generate(company=env.company)
action = env["ir.actions.actions"]._for_xml_id("l10n_ua_dunning.action_ua_dunning_letter")</field>
  </record>

  <!-- ======================================================= рахунок, контрагент, договір -->
  <record id="view_move_form_ua_dunning" model="ir.ui.view">
    <field name="name">account.move.form.ua.dunning</field>
    <field name="model">account.move</field>
    <field name="inherit_id" ref="account.view_move_form"/>
    <field name="arch" type="xml">
      <xpath expr="//group[@id='header_left_group']" position="inside">
        <field name="ua_dunning_hold" invisible="move_type != 'out_invoice'"/>
        <field name="ua_dunning_level_id" invisible="not ua_dunning_level_id"/>
        <field name="ua_dunning_date" invisible="not ua_dunning_date"/>
      </xpath>
    </field>
  </record>

  <record id="view_partner_form_ua_dunning" model="ir.ui.view">
    <field name="name">res.partner.form.ua.dunning</field>
    <field name="model">res.partner</field>
    <field name="inherit_id" ref="base.view_partner_form"/>
    <field name="arch" type="xml">
      <field name="vat" position="after">
        <field name="ua_dunning_excluded" invisible="parent_id"/>
      </field>
    </field>
  </record>

  <record id="view_ua_contract_form_dunning" model="ir.ui.view">
    <field name="name">ua.contract.form.dunning</field>
    <field name="model">ua.contract</field>
    <field name="inherit_id" ref="l10n_ua_contract.view_ua_contract_form"/>
    <field name="arch" type="xml">
      <button name="action_new_reconciliation_act" position="after">
        <button name="action_ua_dunning_letter" type="object" string="Нагадування про борг"
                invisible="not id or kind != 'sale'" groups="account.group_account_invoice"/>
      </button>
    </field>
  </record>
</odoo>
