<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="view_company_form_ua_payment_request" model="ir.ui.view">
    <field name="name">res.company.form.ua.payment.request</field>
    <field name="model">res.company</field>
    <field name="inherit_id" ref="base.view_company_form"/>
    <field name="arch" type="xml">
      <xpath expr="//notebook" position="inside">
        <page string="Заявки на оплату" name="ua_payment_request">
          <group>
            <field name="ua_payment_request_limit"/>
            <field name="currency_id" invisible="1"/>
          </group>
        </page>
      </xpath>
    </field>
  </record>
</odoo>
