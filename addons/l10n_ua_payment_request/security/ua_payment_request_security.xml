<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="privilege_ua_payment_request" model="res.groups.privilege">
    <field name="name">Заявки на оплату</field>
    <field name="sequence">40</field>
    <field name="category_id" ref="base.module_category_accounting"/>
  </record>
  <record id="group_ua_payment_request_user" model="res.groups">
    <field name="name">Ініціатор</field>
    <field name="privilege_id" ref="privilege_ua_payment_request"/>
    <field name="sequence">10</field>
    <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
  </record>
  <record id="group_ua_payment_request_approver" model="res.groups">
    <field name="name">Фінансист (погоджує)</field>
    <field name="privilege_id" ref="privilege_ua_payment_request"/>
    <field name="sequence">20</field>
    <field name="implied_ids" eval="[(4, ref('group_ua_payment_request_user'))]"/>
  </record>
  <record id="group_ua_payment_request_director" model="res.groups">
    <field name="name">Директор (затверджує понад ліміт)</field>
    <field name="privilege_id" ref="privilege_ua_payment_request"/>
    <field name="sequence">30</field>
    <field name="implied_ids" eval="[(4, ref('group_ua_payment_request_approver'))]"/>
    <field name="user_ids" eval="[(4, ref('base.user_admin'))]"/>
  </record>

  <record id="rule_ua_payment_request_company" model="ir.rule">
    <field name="name">Заявка на оплату: лише свої компанії</field>
    <field name="model_id" ref="model_ua_payment_request"/>
    <field name="domain_force">[('company_id', 'in', company_ids)]</field>
  </record>
  <record id="rule_ua_payment_request_approval_company" model="ir.rule">
    <field name="name">Погодження заявки: лише свої компанії</field>
    <field name="model_id" ref="model_ua_payment_request_approval"/>
    <field name="domain_force">[('request_id.company_id', 'in', company_ids)]</field>
  </record>
</odoo>
