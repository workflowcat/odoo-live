<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="privilege_kyc" model="res.groups.privilege">
    <field name="name">KYC</field>
    <field name="sequence">50</field>
    <field name="category_id" ref="base.module_category_services"/>
  </record>
  <record id="group_kyc_user" model="res.groups">
    <field name="name">Аналітик</field>
    <field name="privilege_id" ref="privilege_kyc"/>
    <field name="sequence">10</field>
    <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
  </record>
  <record id="group_kyc_manager" model="res.groups">
    <field name="name">Менеджер</field>
    <field name="privilege_id" ref="privilege_kyc"/>
    <field name="sequence">20</field>
    <field name="implied_ids" eval="[(4, ref('group_kyc_user'))]"/>
    <field name="user_ids" eval="[(4, ref('base.user_admin'))]"/>
  </record>

  <!-- Правила компанії: записи однієї компанії не видно з іншої. -->
  <record id="rule_kyc_case_company" model="ir.rule">
    <field name="name">Справа KYC: лише свої компанії</field>
    <field name="model_id" ref="model_kyc_case"/>
    <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
  </record>

  <record id="rule_kyc_screening_company" model="ir.rule">
    <field name="name">Перевірка KYC: лише свої компанії</field>
    <field name="model_id" ref="model_kyc_screening"/>
    <field name="domain_force">['|', ('case_id.company_id', '=', False), ('case_id.company_id', 'in', company_ids)]</field>
  </record>
</odoo>
