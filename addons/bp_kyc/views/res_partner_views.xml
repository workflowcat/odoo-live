<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="view_partner_form_kyc" model="ir.ui.view">
    <field name="name">res.partner.form.kyc</field>
    <field name="model">res.partner</field>
    <field name="inherit_id" ref="base.view_partner_form"/>
    <field name="arch" type="xml">
      <div name="button_box" position="inside">
        <button name="action_open_kyc_cases" type="object" class="oe_stat_button" icon="fa-shield" groups="bp_kyc.group_kyc_user">
          <div class="o_stat_info"><span class="o_stat_value"><field name="kyc_case_count"/></span><span class="o_stat_text">KYC</span></div>
        </button>
      </div>
      <notebook position="inside">
        <page string="KYC" name="kyc" groups="bp_kyc.group_kyc_user">
          <group>
            <group>
              <field name="company_registry" string="ЄДРПОУ / РНОКПП"/>
              <field name="kyc_decision"/>
              <field name="kyc_risk"/>
            </group>
            <group>
              <button name="action_new_kyc_case" type="object" string="Нова справа KYC" class="btn-primary"/>
            </group>
          </group>
          <field name="kyc_case_ids" readonly="1">
            <list><field name="name"/><field name="stage"/><field name="risk"/><field name="decision"/><field name="decided_on"/></list>
          </field>
        </page>
      </notebook>
    </field>
  </record>
</odoo>
