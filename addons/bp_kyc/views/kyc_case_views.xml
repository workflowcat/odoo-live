<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="view_kyc_case_form" model="ir.ui.view">
    <field name="name">kyc.case.form</field>
    <field name="model">kyc.case</field>
    <field name="arch" type="xml">
      <form string="Справа KYC">
        <header>
          <button name="action_screen_odb" type="object" string="Скринінг ЄДР" class="btn-primary" invisible="stage == 'done'"/>
          <button name="action_search_courts" type="object" string="Судові рішення" invisible="stage == 'done'"/>
          <button name="action_request_documents" type="object" string="Запит документів" invisible="stage == 'done'"/>
          <button name="action_decide_cleared" type="object" string="Погодити" class="btn-success" invisible="stage in ('new', 'done')"/>
          <button name="action_decide_flagged" type="object" string="Погодити з умовами" class="btn-warning" invisible="stage in ('new', 'done')"/>
          <button name="action_decide_rejected" type="object" string="Відхилити" class="btn-danger" invisible="stage in ('new', 'done')"/>
          <button name="action_sync_register" type="object" string="Синхронізувати реєстр" invisible="stage != 'done'"/>
          <button name="action_stage" type="object" string="Наступний етап" invisible="stage in ('assess', 'done')"/>
          <field name="stage" widget="statusbar" options="{'clickable': '1'}"/>
        </header>
        <sheet>
          <div class="oe_button_box" name="button_box">
            <button name="action_open_register" type="object" class="oe_stat_button" icon="fa-database" invisible="not register_id">
              <div class="o_stat_info"><span class="o_stat_text">Реєстр KYC</span><span class="o_stat_value"><field name="register_id"/></span></div>
            </button>
          </div>
          <div class="oe_title">
            <h1><field name="name" readonly="1"/></h1>
          </div>
          <group>
            <group string="Суб'єкт">
              <field name="partner_id"/>
              <field name="code" placeholder="8 цифр ЄДРПОУ або 10 цифр РНОКПП"/>
              <field name="kind"/>
              <field name="subject_group"/>
              <field name="role"/>
              <field name="introduced_by"/>
            </group>
            <group string="Оцінка">
              <field name="user_id"/>
              <field name="risk"/>
              <field name="decision" readonly="1"/>
              <field name="decided_by" invisible="not decided_by"/>
              <field name="decided_on" invisible="not decided_on"/>
              <field name="high_count"/>
              <field name="warn_count"/>
              <field name="register_synced_at" invisible="not register_synced_at"/>
            </group>
          </group>
          <notebook>
            <page string="ЄДР" name="registry">
              <group>
                <group>
                  <field name="registry_name"/>
                  <field name="registry_status"/>
                  <field name="registry_date"/>
                  <field name="registry_kved"/>
                  <field name="registry_vat"/>
                </group>
                <group>
                  <field name="registry_head"/>
                  <field name="registry_address"/>
                  <field name="registry_capital"/>
                  <field name="screened_at"/>
                </group>
              </group>
              <field name="registry_beneficiaries" nolabel="1" placeholder="Бенефіціари з'являться після скринінгу"/>
            </page>
            <page string="Перевірки" name="screenings">
              <field name="screening_ids">
                <list decoration-danger="severity == 'high'" decoration-warning="severity == 'warn'" editable="bottom">
                  <field name="severity"/>
                  <field name="source"/>
                  <field name="title"/>
                  <field name="detail"/>
                  <field name="fetched_at"/>
                  <field name="pushed" optional="hide"/>
                </list>
              </field>
            </page>
            <page string="Чек-лист" name="checklist">
              <group>
                <field name="check_registry"/>
                <field name="check_ubo"/>
                <field name="check_sanctions"/>
                <field name="check_courts"/>
                <field name="check_docs"/>
                <field name="docs_requested_at"/>
              </group>
            </page>
            <page string="Висновок" name="summary">
              <field name="summary" nolabel="1" placeholder="Коротко: що перевірено, що знайдено, чому таке рішення."/>
            </page>
          </notebook>
        </sheet>
        <chatter/>
      </form>
    </field>
  </record>

  <record id="view_kyc_case_list" model="ir.ui.view">
    <field name="name">kyc.case.list</field>
    <field name="model">kyc.case</field>
    <field name="arch" type="xml">
      <list decoration-danger="risk in ('high', 'critical')" decoration-success="decision == 'cleared'">
        <field name="name"/>
        <field name="partner_id"/>
        <field name="code"/>
        <field name="subject_group"/>
        <field name="stage"/>
        <field name="risk"/>
        <field name="decision"/>
        <field name="high_count"/>
        <field name="user_id"/>
        <field name="create_date"/>
      </list>
    </field>
  </record>

  <record id="view_kyc_case_kanban" model="ir.ui.view">
    <field name="name">kyc.case.kanban</field>
    <field name="model">kyc.case</field>
    <field name="arch" type="xml">
      <kanban default_group_by="stage" quick_create="false">
        <field name="name"/><field name="partner_id"/><field name="risk"/><field name="decision"/><field name="high_count"/><field name="warn_count"/>
        <templates>
          <t t-name="card">
            <div class="d-flex flex-column">
              <strong><field name="partner_id"/></strong>
              <div class="text-muted"><field name="name"/> · <field name="code"/></div>
              <div class="mt-1">
                <span t-if="record.risk.raw_value" t-att-class="'badge rounded-pill ' + (record.risk.raw_value == 'low' ? 'text-bg-success' : record.risk.raw_value == 'medium' ? 'text-bg-warning' : record.risk.raw_value == 'high' ? 'text-bg-danger' : 'text-bg-dark')"><field name="risk"/></span>
                <span t-if="record.high_count.raw_value" class="badge text-bg-danger ms-1"><t t-out="record.high_count.raw_value"/> ●</span>
                <span t-if="record.warn_count.raw_value" class="badge text-bg-warning ms-1"><t t-out="record.warn_count.raw_value"/> ●</span>
                <span t-if="record.decision.raw_value" class="ms-1"><field name="decision"/></span>
              </div>
            </div>
          </t>
        </templates>
      </kanban>
    </field>
  </record>

  <record id="view_kyc_case_search" model="ir.ui.view">
    <field name="name">kyc.case.search</field>
    <field name="model">kyc.case</field>
    <field name="arch" type="xml">
      <search>
        <field name="name"/><field name="partner_id"/><field name="code"/>
        <filter name="open" string="Відкриті" domain="[('stage', '!=', 'done')]"/>
        <filter name="mine" string="Мої" domain="[('user_id', '=', uid)]"/>
        <filter name="red" string="З червоними маркерами" domain="[('high_count', '>', 0)]"/>
        <separator/>
        <filter name="cleared" string="Погоджені" domain="[('decision', '=', 'cleared')]"/>
        <filter name="rejected" string="Відхилені" domain="[('decision', '=', 'rejected')]"/>
        <group>
          <filter name="g_stage" string="Етап" context="{'group_by': 'stage'}"/>
          <filter name="g_risk" string="Ризик" context="{'group_by': 'risk'}"/>
          <filter name="g_group" string="Група" context="{'group_by': 'subject_group'}"/>
        </group>
      </search>
    </field>
  </record>

  <record id="action_kyc_case" model="ir.actions.act_window">
    <field name="name">Справи KYC</field>
    <field name="res_model">kyc.case</field>
    <field name="view_mode">kanban,list,form</field>
    <field name="context">{'search_default_open': 1}</field>
    <field name="help" type="html">
      <p class="o_view_nocontent_smiling_face">Створіть першу справу KYC</p>
      <p>Оберіть контрагента, вкажіть ЄДРПОУ і натисніть «Скринінг ЄДР».</p>
    </field>
  </record>
</odoo>
