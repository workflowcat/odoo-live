<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="rule_ua_export_permit_company" model="ir.rule">
    <field name="name">Дозвіл на передачу: лише свої компанії</field>
    <field name="model_id" ref="model_ua_export_permit"/>
    <field name="domain_force">[('company_id', 'in', company_ids)]</field>
  </record>
  <record id="rule_ua_export_permit_line_company" model="ir.rule">
    <field name="name">Рядок дозволу: лише свої компанії</field>
    <field name="model_id" ref="model_ua_export_permit_line"/>
    <field name="domain_force">[('permit_id.company_id', 'in', company_ids)]</field>
  </record>
</odoo>
