<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="action_report_ua_export_permit" model="ir.actions.report">
    <field name="name">Звіт про використання дозволу</field>
    <field name="model">ua.export.permit</field>
    <field name="report_type">qweb-pdf</field>
    <field name="report_name">l10n_ua_export_control.report_ua_export_permit</field>
    <field name="report_file">l10n_ua_export_control.report_ua_export_permit</field>
    <field name="binding_model_id" ref="model_ua_export_permit"/>
    <field name="binding_type">report</field>
    <field name="print_report_name">'Використання дозволу %s' % (object.name or '')</field>
  </record>

  <template id="report_ua_export_permit">
    <t t-call="web.html_container">
      <t t-foreach="docs" t-as="doc">
        <t t-call="web.basic_layout">
          <style>
            .ua-doc { font-size: 10.5px; color: #000; }
            .ua-doc h3 { font-size: 13px; text-align: center; margin: 4px 0; }
            .ua-doc .ua-sub { text-align: center; margin-bottom: 8px; }
            .ua-doc .ua-grid { width: 100%; border-collapse: collapse; margin: 6px 0; }
            .ua-doc .ua-grid th, .ua-doc .ua-grid td { border: 1px solid #000; padding: 2px 4px; }
            .ua-doc .ua-grid th { font-weight: normal; text-align: center; }
            .ua-doc .ua-num { text-align: right; white-space: nowrap; }
            .ua-doc .ua-sign { width: 100%; margin-top: 18px; }
            .ua-doc .ua-sign td { width: 50%; vertical-align: top; padding: 12px 12px 0 0; }
          </style>
          <div class="ua-doc">
            <div><t t-out="doc.company_id.name"/></div>
            <h3>ЗВІТ ПРО ВИКОРИСТАННЯ ДОЗВОЛУ НА МІЖНАРОДНУ ПЕРЕДАЧУ</h3>
            <div class="ua-sub">дозвіл № <t t-out="doc.name"/> від <t t-out="doc.ua_date(doc.date_issue)"/>,
              діє до <t t-out="doc.ua_date(doc.date_expiry)"/></div>
            <table class="ua-grid">
              <tr><td style="width: 30%;">Вид</td><td><t t-out="doc.ua_kind_label()"/></td></tr>
              <tr><td>Хто видав</td><td><t t-out="doc.authority"/></td></tr>
              <tr><td>Імпортер</td><td><t t-out="doc.partner_id.name"/></td></tr>
              <tr><td>Кінцевий користувач</td><td><t t-out="doc.end_user_id.name or doc.partner_id.name"/></td></tr>
              <tr><td>Країна призначення</td><td><t t-out="doc.country_id.name"/></td></tr>
              <tr t-if="doc.end_use"><td>Кінцеве використання</td><td><t t-out="doc.end_use"/></td></tr>
            </table>
            <table class="ua-grid">
              <thead><tr><th style="width: 5%;">№</th><th>Товар</th><th style="width: 14%;">Позиція списку</th>
                <th style="width: 12%;">За дозволом</th><th style="width: 12%;">Відвантажено</th>
                <th style="width: 12%;">Залишок</th></tr></thead>
              <tbody>
                <tr t-foreach="doc.line_ids" t-as="line">
                  <td style="text-align: center;"><t t-out="line_index + 1"/></td>
                  <td><t t-out="line.product_id.display_name"/></td>
                  <td><t t-out="line.control_ref or ''"/></td>
                  <td class="ua-num"><t t-out="'%g' % line.quantity"/> <t t-out="line.uom_id.name"/></td>
                  <td class="ua-num"><t t-out="'%g' % line.used_qty"/></td>
                  <td class="ua-num"><t t-out="'%g' % line.remaining_qty"/></td>
                </tr>
              </tbody>
            </table>
            <t t-set="rows" t-value="doc.ua_shipments()"/>
            <div>Відвантаження за дозволом</div>
            <table class="ua-grid">
              <thead><tr><th style="width: 14%;">Дата</th><th style="width: 22%;">Документ</th><th>Товар</th>
                <th style="width: 14%;">Кількість</th></tr></thead>
              <tbody>
                <tr t-if="not rows"><td colspan="4" style="text-align: center;">відвантажень не було</td></tr>
                <tr t-foreach="rows" t-as="row">
                  <td><t t-out="row['date']"/></td>
                  <td><t t-out="row['picking']"/></td>
                  <td><t t-out="row['product']"/></td>
                  <td class="ua-num"><t t-out="row['quantity']"/> <t t-out="row['uom']"/></td>
                </tr>
              </tbody>
            </table>
            <table class="ua-sign"><tr>
              <td>Керівник<br/><br/>______________ / ______________________</td>
              <td>Відповідальний за внутрішньофірмову систему експортного контролю<br/><br/>______________ / ______________________</td>
            </tr></table>
          </div>
        </t>
      </t>
    </t>
  </template>
</odoo>
