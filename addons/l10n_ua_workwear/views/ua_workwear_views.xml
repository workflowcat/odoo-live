<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <!-- Відомість видачі -->
  <record id="view_ua_workwear_issue_list" model="ir.ui.view">
    <field name="name">ua.workwear.issue.list</field>
    <field name="model">ua.workwear.issue</field>
    <field name="arch" type="xml">
      <list string="Відомості видачі" decoration-muted="state == 'cancel'">
        <field name="name"/>
        <field name="date"/>
        <field name="location_id" optional="show"/>
        <field name="expense_account_id" optional="show"/>
        <field name="amount_total" sum="Разом"/>
        <field name="company_currency_id" column_invisible="1"/>
        <field name="state" widget="badge" decoration-success="state == 'done'"/>
        <field name="company_id" groups="base.group_multi_company" optional="hide"/>
      </list>
    </field>
  </record>

  <record id="view_ua_workwear_issue_form" model="ir.ui.view">
    <field name="name">ua.workwear.issue.form</field>
    <field name="model">ua.workwear.issue</field>
    <field name="arch" type="xml">
      <form string="Відомість видачі">
        <header>
          <button name="action_fill" type="object" string="Заповнити за нормами" invisible="state != 'draft'"/>
          <button name="action_done" type="object" string="Видати" class="btn-primary" invisible="state != 'draft'"/>
          <button name="action_print" type="object" string="Друк" invisible="state == 'cancel'"/>
          <button name="action_cancel" type="object" string="Скасувати" invisible="state != 'draft'"/>
          <button name="action_draft" type="object" string="У чернетку" invisible="state != 'cancel'"/>
          <field name="state" widget="statusbar" statusbar_visible="draft,done"/>
        </header>
        <sheet>
          <div class="oe_title"><h1><field name="name" readonly="1"/></h1></div>
          <group>
            <group>
              <field name="date" readonly="state != 'draft'"/>
              <field name="location_id" readonly="state != 'draft'"/>
              <field name="expense_account_id" readonly="state != 'draft'"/>
            </group>
            <group>
              <field name="employee_ids" widget="many2many_tags" readonly="state != 'draft'"/>
              <field name="amount_total" invisible="state != 'done'"/>
              <field name="company_currency_id" invisible="1"/>
              <field name="company_id" groups="base.group_multi_company" readonly="state != 'draft'"/>
            </group>
          </group>
          <field name="line_ids" readonly="state != 'draft'">
            <list editable="bottom">
              <field name="employee_id"/>
              <field name="job_id" optional="show"/>
              <field name="product_id"/>
              <field name="quantity"/>
              <field name="uom_id" optional="show"/>
              <field name="wear_months"/>
              <field name="date_until" optional="show"/>
              <field name="amount" optional="show" sum="Разом"/>
              <field name="company_currency_id" column_invisible="1"/>
              <field name="state" widget="badge" optional="show"/>
            </list>
          </field>
          <field name="note" placeholder="Підстава видачі, примітки"/>
        </sheet>
        <chatter/>
      </form>
    </field>
  </record>

  <record id="view_ua_workwear_issue_search" model="ir.ui.view">
    <field name="name">ua.workwear.issue.search</field>
    <field name="model">ua.workwear.issue</field>
    <field name="arch" type="xml">
      <search string="Відомості видачі">
        <field name="name"/>
        <field name="employee_ids"/>
        <filter name="draft" string="Чернетки" domain="[('state', '=', 'draft')]"/>
        <filter name="done" string="Видано" domain="[('state', '=', 'done')]"/>
        <group>
          <filter name="by_month" string="Місяць" context="{'group_by': 'date:month'}"/>
          <filter name="by_account" string="Рахунок витрат" context="{'group_by': 'expense_account_id'}"/>
        </group>
      </search>
    </field>
  </record>

  <record id="action_ua_workwear_issue" model="ir.actions.act_window">
    <field name="name">Відомості видачі</field>
    <field name="res_model">ua.workwear.issue</field>
    <field name="view_mode">list,form</field>
    <field name="help" type="html">
      <p class="o_view_nocontent_smiling_face">Відомостей ще немає</p>
      <p>Оберіть працівників і натисніть «Заповнити за нормами»: відомість візьме те, чого їм бракує за нормами посад.</p>
    </field>
  </record>

  <!-- Предмети в експлуатації -->
  <record id="view_ua_workwear_line_list" model="ir.ui.view">
    <field name="name">ua.workwear.line.list</field>
    <field name="model">ua.workwear.line</field>
    <field name="arch" type="xml">
      <list string="Предмети в експлуатації" create="0" decoration-muted="state in ('returned', 'written_off', 'cancel')"
            decoration-warning="state == 'in_use' and date_until and date_until &lt; current_date">
        <header>
          <button name="action_print_write_off" type="object" string="Акт списання"/>
        </header>
        <field name="employee_id"/>
        <field name="job_id" optional="hide"/>
        <field name="product_id"/>
        <field name="quantity"/>
        <field name="uom_id" optional="hide"/>
        <field name="date"/>
        <field name="date_until"/>
        <field name="amount" optional="show" sum="Разом"/>
        <field name="company_currency_id" column_invisible="1"/>
        <field name="issue_id" optional="show"/>
        <field name="date_closed" optional="hide"/>
        <field name="close_reason" optional="hide"/>
        <field name="state" widget="badge" decoration-success="state == 'in_use'"/>
        <button name="action_return" type="object" string="Повернути" invisible="state != 'in_use'"/>
        <button name="action_write_off" type="object" string="Списати" invisible="state != 'in_use'"/>
      </list>
    </field>
  </record>

  <record id="view_ua_workwear_line_search" model="ir.ui.view">
    <field name="name">ua.workwear.line.search</field>
    <field name="model">ua.workwear.line</field>
    <field name="arch" type="xml">
      <search string="Предмети в експлуатації">
        <field name="employee_id"/>
        <field name="product_id"/>
        <field name="issue_id"/>
        <filter name="in_use" string="В експлуатації" domain="[('state', '=', 'in_use')]"/>
        <filter name="worn" string="Строк носіння минув"
                domain="[('state', '=', 'in_use'), ('date_until', '&lt;', context_today().strftime('%Y-%m-%d'))]"/>
        <filter name="departed" string="У звільнених"
                domain="[('state', '=', 'in_use'), ('employee_id.active', '=', False)]"/>
        <filter name="written_off" string="Списано" domain="[('state', '=', 'written_off')]"/>
        <group>
          <filter name="by_employee" string="Працівник" context="{'group_by': 'employee_id'}"/>
          <filter name="by_product" string="Предмет" context="{'group_by': 'product_id'}"/>
          <filter name="by_until" string="Місяць кінця носіння" context="{'group_by': 'date_until:month'}"/>
        </group>
      </search>
    </field>
  </record>

  <record id="action_ua_workwear_line" model="ir.actions.act_window">
    <field name="name">Предмети в експлуатації</field>
    <field name="res_model">ua.workwear.line</field>
    <field name="view_mode">list</field>
    <field name="domain">[('state', '!=', 'draft')]</field>
    <field name="context">{'search_default_in_use': 1, 'active_test': False}</field>
  </record>

  <!-- Норми на посаді -->
  <record id="view_hr_job_form_ua_workwear" model="ir.ui.view">
    <field name="name">hr.job.form.ua.workwear</field>
    <field name="model">hr.job</field>
    <field name="inherit_id" ref="hr.view_hr_job_form"/>
    <field name="arch" type="xml">
      <xpath expr="//notebook" position="inside">
        <page string="Спецодяг" name="ua_workwear">
          <field name="ua_workwear_norm_ids">
            <list editable="bottom">
              <field name="sequence" widget="handle"/>
              <field name="product_id"/>
              <field name="quantity"/>
              <field name="wear_months"/>
              <field name="reference"/>
            </list>
          </field>
          <div class="text-muted">
            Норми безоплатної видачі для професії. Нуль у строку - до зносу. Перевірте чинну редакцію норм.
          </div>
        </page>
      </xpath>
    </field>
  </record>

  <!-- Працівник -->
  <record id="view_employee_form_ua_workwear" model="ir.ui.view">
    <field name="name">hr.employee.form.ua.workwear</field>
    <field name="model">hr.employee</field>
    <field name="inherit_id" ref="hr.view_employee_form"/>
    <field name="arch" type="xml">
      <div name="button_box" position="inside">
        <button name="action_ua_workwear" type="object" class="oe_stat_button" icon="fa-shield"
                groups="stock.group_stock_user,hr.group_hr_user">
          <field name="ua_workwear_count" widget="statinfo" string="Спецодяг"/>
        </button>
      </div>
    </field>
  </record>

  <record id="view_product_template_form_ua_workwear" model="ir.ui.view">
    <field name="name">product.template.form.ua.workwear</field>
    <field name="model">product.template</field>
    <field name="inherit_id" ref="stock.view_template_property_form"/>
    <field name="arch" type="xml">
      <xpath expr="//group[@name='group_lots_and_weight']" position="inside">
        <field name="ua_wear_auto_write_off"/>
      </xpath>
    </field>
  </record>
</odoo>
