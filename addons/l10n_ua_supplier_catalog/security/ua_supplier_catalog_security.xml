<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="rule_ua_supplier_price_profile_company" model="ir.rule">
    <field name="name">Профілі прайсів: своя компанія</field>
    <field name="model_id" ref="model_ua_supplier_price_profile"/>
    <field name="domain_force">[('company_id', 'in', company_ids)]</field>
  </record>
  <record id="rule_ua_supplier_price_import_company" model="ir.rule">
    <field name="name">Прайси постачальників: своя компанія</field>
    <field name="model_id" ref="model_ua_supplier_price_import"/>
    <field name="domain_force">[('company_id', 'in', company_ids)]</field>
  </record>
  <record id="rule_ua_supplier_price_import_line_company" model="ir.rule">
    <field name="name">Рядки прайсів: своя компанія</field>
    <field name="model_id" ref="model_ua_supplier_price_import_line"/>
    <field name="domain_force">[('import_id.company_id', 'in', company_ids)]</field>
  </record>
</odoo>
