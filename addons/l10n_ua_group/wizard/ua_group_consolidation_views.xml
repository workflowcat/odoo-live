<?xml version="1.0" encoding="UTF-8" ?>
<!-- Пункт меню відкриває СПИСОК зібраних консолідованих звітів; «Сформувати» в шапці
     списку питає параметри діалогом, а результат, як і раніше, відкривається
     сторінкою звіту mis_builder (рішення 2026-09-22: меню не відкриває діалог). -->
<odoo>
    <!-- Стандартна форма чарівника: жодного власного віджета. Результат
         відкривається у звичайному перегляді звіту mis_builder. -->
    <record id="ua_group_consolidation_view_form" model="ir.ui.view">
        <field name="name">ua.group.consolidation.form</field>
        <field name="model">ua.group.consolidation</field>
        <field name="arch" type="xml">
            <form string="Консолідація групи">
                <sheet>
                    <group>
                        <group string="Що зводимо">
                            <field name="form" />
                            <field name="company_ids" widget="many2many_tags" />
                        </group>
                        <group string="Період">
                            <field name="date_from" />
                            <field name="date_to" />
                            <field name="currency_id" groups="base.group_multi_currency" />
                        </group>
                    </group>
                </sheet>
                <footer>
                    <button
                        name="action_build"
                        type="object"
                        string="Зібрати звіт"
                        class="btn-primary"
                    />
                    <button string="Скасувати" class="btn-secondary" special="cancel" />
                </footer>
            </form>
        </field>
    </record>

    <record id="view_mis_report_instance_group_list" model="ir.ui.view">
        <field name="name">mis.report.instance.list.ua.group</field>
        <field name="model">mis.report.instance</field>
        <field name="inherit_id" ref="mis_builder.mis_report_instance_view_list" />
        <field name="mode">primary</field>
        <field name="arch" type="xml">
            <list position="inside">
                <header>
                    <button
                        name="action_ua_group_consolidation"
                        type="object"
                        display="always"
                        string="Сформувати"
                        class="btn-primary"
                    />
                </header>
            </list>
        </field>
    </record>

    <record id="action_ua_group_consolidation" model="ir.actions.act_window">
        <field name="name">Консолідація групи</field>
        <field name="res_model">mis.report.instance</field>
        <field name="view_mode">list,form</field>
        <field name="target">current</field>
        <field name="domain">[('ua_group_consolidation', '=', True)]</field>
        <field name="context">{'default_ua_group_consolidation': True}</field>
    </record>

    <record id="action_ua_group_consolidation_list_view" model="ir.actions.act_window.view">
        <field name="sequence">1</field>
        <field name="view_mode">list</field>
        <field name="view_id" ref="view_mis_report_instance_group_list" />
        <field name="act_window_id" ref="action_ua_group_consolidation" />
    </record>

    <menuitem
        id="menu_ua_group_consolidation"
        parent="l10n_ua_finrep.menu_ua_finrep_root"
        name="Консолідація групи"
        action="action_ua_group_consolidation"
        sequence="50"
    />
</odoo>
