<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="privilege_ua_correspondence" model="res.groups.privilege">
    <field name="name">Канцелярія</field>
    <field name="sequence">50</field>
  </record>
  <record id="group_ua_correspondence_user" model="res.groups">
    <field name="name">Кореспонденція</field>
    <field name="privilege_id" ref="privilege_ua_correspondence"/>
    <field name="sequence">10</field>
    <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
  </record>
  <record id="group_ua_correspondence_restricted" model="res.groups">
    <field name="name">Кореспонденція з допуском до ДСК</field>
    <field name="privilege_id" ref="privilege_ua_correspondence"/>
    <field name="sequence">20</field>
    <field name="implied_ids" eval="[(4, ref('group_ua_correspondence_user'))]"/>
    <field name="user_ids" eval="[(4, ref('base.user_admin'))]"/>
  </record>

  <record id="rule_ua_correspondence_company" model="ir.rule">
    <field name="name">Кореспонденція: своя компанія</field>
    <field name="model_id" ref="model_ua_correspondence"/>
    <field name="domain_force">[('company_id', 'in', company_ids)]</field>
  </record>
  <!-- Правила груп складаються через «або»: без допуску видно лише документи без грифа,
       з допуском - усі. -->
  <record id="rule_ua_correspondence_open" model="ir.rule">
    <field name="name">Кореспонденція: без грифа ДСК</field>
    <field name="model_id" ref="model_ua_correspondence"/>
    <field name="domain_force">[('restricted', '=', False)]</field>
    <field name="groups" eval="[(4, ref('group_ua_correspondence_user'))]"/>
  </record>
  <record id="rule_ua_correspondence_restricted" model="ir.rule">
    <field name="name">Кореспонденція: усі, з допуском до ДСК</field>
    <field name="model_id" ref="model_ua_correspondence"/>
    <field name="domain_force">[(1, '=', 1)]</field>
    <field name="groups" eval="[(4, ref('group_ua_correspondence_restricted'))]"/>
  </record>
</odoo>
