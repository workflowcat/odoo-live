<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="view_move_form_ua_contract" model="ir.ui.view">
    <field name="name">account.move.form.ua.contract</field>
    <field name="model">account.move</field>
    <field name="inherit_id" ref="account.view_move_form"/>
    <field name="arch" type="xml">
      <xpath expr="//group[@id='header_left_group']" position="inside">
        <field name="ua_contract_id" readonly="state != 'draft'"
               invisible="move_type == 'entry' and not ua_contract_id"
               options="{'no_create': True}"/>
      </xpath>
      <xpath expr="//field[@name='line_ids']/list/field[@name='partner_id']" position="after">
        <field name="ua_contract_id" optional="hide"/>
      </xpath>
    </field>
  </record>

  <record id="view_move_line_list_ua_contract" model="ir.ui.view">
    <field name="name">account.move.line.list.ua.contract</field>
    <field name="model">account.move.line</field>
    <field name="inherit_id" ref="account.view_move_line_tree"/>
    <field name="arch" type="xml">
      <field name="partner_id" position="after">
        <field name="ua_contract_id" optional="hide"/>
      </field>
    </field>
  </record>

  <record id="view_account_move_line_filter_ua_contract" model="ir.ui.view">
    <field name="name">account.move.line.search.ua.contract</field>
    <field name="model">account.move.line</field>
    <field name="inherit_id" ref="account.view_account_move_line_filter"/>
    <field name="arch" type="xml">
      <field name="partner_id" position="after">
        <field name="ua_contract_id"/>
      </field>
    </field>
  </record>
</odoo>
