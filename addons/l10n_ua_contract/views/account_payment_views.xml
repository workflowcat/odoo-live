<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="view_account_payment_form_ua_contract" model="ir.ui.view">
    <field name="name">account.payment.form.ua.contract</field>
    <field name="model">account.payment</field>
    <field name="inherit_id" ref="account.view_account_payment_form"/>
    <field name="arch" type="xml">
      <field name="memo" position="after">
        <field name="ua_contract_id" options="{'no_create': True}" invisible="not partner_id"/>
      </field>
    </field>
  </record>

  <record id="view_account_payment_register_form_ua_contract" model="ir.ui.view">
    <field name="name">account.payment.register.form.ua.contract</field>
    <field name="model">account.payment.register</field>
    <field name="inherit_id" ref="account.view_account_payment_register_form"/>
    <field name="arch" type="xml">
      <field name="communication" position="after">
        <field name="ua_contract_id" options="{'no_create': True}"
               invisible="not can_edit_wizard or (can_group_payments and not group_payment)"/>
      </field>
    </field>
  </record>
</odoo>
