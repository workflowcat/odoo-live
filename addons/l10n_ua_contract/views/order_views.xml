<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="view_order_form_ua_contract" model="ir.ui.view">
    <field name="name">sale.order.form.ua.contract</field>
    <field name="model">sale.order</field>
    <field name="inherit_id" ref="sale.view_order_form"/>
    <field name="arch" type="xml">
      <xpath expr="//group[@name='partner_details']" position="inside">
        <field name="ua_contract_id" readonly="state in ['cancel', 'sale']" options="{'no_create': True}"/>
      </xpath>
    </field>
  </record>

  <record id="purchase_order_form_ua_contract" model="ir.ui.view">
    <field name="name">purchase.order.form.ua.contract</field>
    <field name="model">purchase.order</field>
    <field name="inherit_id" ref="purchase.purchase_order_form"/>
    <field name="arch" type="xml">
      <field name="partner_ref" position="after">
        <field name="ua_contract_id" readonly="state in ['cancel', 'purchase']" options="{'no_create': True}"/>
        <field name="ua_sale_contract_id" readonly="state in ['cancel', 'purchase']" options="{'no_create': True}"/>
      </field>
    </field>
  </record>
</odoo>
