    <record id="seq_ua_reconciliation_act" model="ir.sequence">
      <field name="name">Акт звірки взаєморозрахунків</field>
      <field name="code">l10n_ua_contract.reconciliation.act</field>
      <field name="prefix">АЗВ-%(range_year)s-</field>
      <field name="padding">4</field>
      <field name="use_date_range" eval="True"/>
