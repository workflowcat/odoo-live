<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="rule_ua_finrep_filing_company" model="ir.rule">
    <field name="name">Фінзвітність до ДПС: лише свої компанії</field>
    <field name="model_id" ref="model_ua_finrep_filing"/>
    <field name="domain_force">[('company_id', 'in', company_ids)]</field>
  </record>
  <record id="rule_ua_finrep_filing_line_company" model="ir.rule">
    <field name="name">Рядок фінзвітності до ДПС: лише свої компанії</field>
    <field name="model_id" ref="model_ua_finrep_filing_line"/>
    <field name="domain_force">[('company_id', 'in', company_ids)]</field>
  </record>
</odoo>
