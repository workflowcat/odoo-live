<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="view_ua_military_reserved_form" model="ir.ui.view">
    <field name="name">ua.military.reserved.form</field>
    <field name="model">ua.military.reserved</field>
    <field name="arch" type="xml">
      <form string="Список заброньованих">
        <header>
          <button name="action_refill" type="object" string="Перерахувати" invisible="state != 'draft'"/>
          <button name="action_confirm" type="object" string="Затвердити" invisible="state != 'draft'" class="oe_highlight"/>
          <button name="action_draft" type="object" string="Повернути в чернетку" invisible="state != 'confirmed'"/>
          <button name="%(action_report_ua_military_reserved)d" type="action" string="Друк"/>
          <field name="state" widget="statusbar"/>
        </header>
        <sheet>
          <div class="oe_title"><h1><field name="name" readonly="1"/></h1></div>
          <group>
            <group>
              <field name="date" readonly="state != 'draft'"/>
              <field name="company_id" groups="base.group_multi_company" readonly="state != 'draft'"/>
            </group>
          </group>
          <notebook>
            <page string="Рядки" name="lines">
              <field name="line_ids" readonly="state != 'draft'">
                <list editable="bottom" readonly="parent.state != 'draft'">
                  <field name="full_name"/>
                  <field name="job_title"/>
                  <field name="reserve_order"/>
                  <field name="reserve_until"/>
                  <field name="days_left"/>
                </list>
              </field>
            </page>
            <page string="Примітка" name="note">
              <field name="note"/>
            </page>
            <page string="Перевірки" name="ua_checks">
              <field name="checks_text" readonly="1" nolabel="1"/>
            </page>
          </notebook>
        </sheet>
        <chatter/>
      </form>
    </field>
  </record>

  <record id="view_ua_military_reserved_list" model="ir.ui.view">
    <field name="name">ua.military.reserved.list</field>
    <field name="model">ua.military.reserved</field>
    <field name="arch" type="xml">
      <list>
        <field name="name"/>
        <field name="date" options="{'numeric': True}"/>
        <field name="state"/>
      </list>
    </field>
  </record>

  <record id="action_ua_military_reserved" model="ir.actions.act_window">
    <field name="name">Списки заброньованих</field>
    <field name="res_model">ua.military.reserved</field>
    <field name="view_mode">list,form</field>
  </record>
</odoo>
