<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="action_report_ua_military_notice" model="ir.actions.report">
    <field name="name">Повідомлення про зміну облікових даних</field><field name="model">ua.military.notice</field><field name="report_type">qweb-pdf</field>
    <field name="report_name">l10n_ua_military.report_ua_military_notice</field><field name="report_file">l10n_ua_military.report_ua_military_notice</field>
    <field name="print_report_name">'Повідомлення ТЦК %s - %s' % (object.date_from.strftime('%d.%m.%Y'), object.date_to.strftime('%d.%m.%Y'))</field>
    <field name="paperformat_id" ref="l10n_ua_payroll_reports.paperformat_ua_a4_landscape"/>
    <field name="binding_model_id" ref="model_ua_military_notice"/><field name="binding_type">report</field>
  </record>
  <template id="report_ua_military_notice">
    <t t-call="web.basic_layout"><t t-foreach="docs" t-as="doc">
      <div class="page" style="font-family: DejaVu Sans, sans-serif; font-size: 9px;">
        <div style="font-size:11px; font-weight:bold;">Повідомлення про зміну облікових даних військовозобов'язаних</div>
        <div><t t-out="doc.company_id.name"/> · за період <t t-out="doc.date_from.strftime('%d.%m.%Y')"/> - <t t-out="doc.date_to.strftime('%d.%m.%Y')"/></div>
        <table class="table table-sm" style="border-collapse:collapse; width:100%; margin-top:6px;">
          <thead><tr style="border-bottom:1px solid #999;">
            <th>№</th><th>ПІБ</th><th>Дата нар.</th><th>РНОКПП</th><th>ТЦК</th><th>Вид зміни</th><th>Дата</th><th>Посада</th><th>Підстава</th>
          </tr></thead>
          <tbody>
            <t t-foreach="doc.line_ids" t-as="r">
              <tr style="border-bottom:1px solid #ddd;">
                <td><t t-out="r_index + 1"/></td>
                <td><t t-out="r.full_name"/></td>
                <td><t t-out="r.birthday.strftime('%d.%m.%Y') if r.birthday else ''"/></td>
                <td><t t-out="r.rnokpp"/></td>
                <td><t t-out="r.tcc"/></td>
                <td><t t-out="{'hire': 'Прийняття', 'dismiss': 'Звільнення', 'change': 'Зміна даних'}.get(r.change_kind, '')"/></td>
                <td><t t-out="r.date.strftime('%d.%m.%Y') if r.date else ''"/></td>
                <td><t t-out="r.job_title"/></td>
                <td><t t-out="r.reason"/></td>
              </tr>
            </t>
          </tbody>
        </table>
        <p style="font-size:9px; color:#555; margin-top:8px;">Повідомлення про прийняття/звільнення подається до ТЦК та СП протягом 7 днів.</p>
      </div>
    </t></t>
  </template>
</odoo>
