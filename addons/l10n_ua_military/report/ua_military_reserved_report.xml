<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="action_report_ua_military_reserved" model="ir.actions.report">
    <field name="name">Список заброньованих</field><field name="model">ua.military.reserved</field><field name="report_type">qweb-pdf</field>
    <field name="report_name">l10n_ua_military.report_ua_military_reserved</field><field name="report_file">l10n_ua_military.report_ua_military_reserved</field>
    <field name="print_report_name">'Список заброньованих %s' % object.date.strftime('%d.%m.%Y')</field>
    <field name="paperformat_id" ref="l10n_ua_payroll_reports.paperformat_ua_a4_landscape"/>
    <field name="binding_model_id" ref="model_ua_military_reserved"/><field name="binding_type">report</field>
  </record>
  <template id="report_ua_military_reserved">
    <t t-call="web.basic_layout"><t t-foreach="docs" t-as="doc">
      <div class="page" style="font-family: DejaVu Sans, sans-serif; font-size: 10px;">
        <div style="font-size:11px; font-weight:bold;">Список заброньованих працівників</div>
        <div><t t-out="doc.company_id.name"/> станом на <t t-out="doc.date.strftime('%d.%m.%Y')"/></div>
        <table class="table table-sm" style="border-collapse:collapse; width:100%; margin-top:6px;">
          <thead><tr style="border-bottom:1px solid #999;">
            <th>№</th><th>ПІБ</th><th>Посада</th><th>Підстава</th><th>До дати</th><th class="text-end">Днів до закінчення</th>
          </tr></thead>
          <tbody>
            <t t-foreach="doc.line_ids" t-as="r">
              <tr style="border-bottom:1px solid #ddd;">
                <td><t t-out="r_index + 1"/></td>
                <td><t t-out="r.full_name"/></td>
                <td><t t-out="r.job_title"/></td>
                <td><t t-out="r.reserve_order"/></td>
                <td><t t-out="r.reserve_until.strftime('%d.%m.%Y') if r.reserve_until else ''"/></td>
                <td class="text-end"><t t-out="r.days_left"/></td>
              </tr>
            </t>
          </tbody>
        </table>
      </div>
    </t></t>
  </template>
</odoo>
