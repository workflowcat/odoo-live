<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="action_report_ua_military_list" model="ir.actions.report">
    <field name="name">Список персонального військового обліку</field><field name="model">ua.military.list</field><field name="report_type">qweb-pdf</field>
    <field name="report_name">l10n_ua_military.report_ua_military_list</field><field name="report_file">l10n_ua_military.report_ua_military_list</field>
    <field name="print_report_name">'Список персонального обліку %s' % object.date.strftime('%d.%m.%Y')</field>
    <field name="paperformat_id" ref="l10n_ua_payroll_reports.paperformat_ua_a4_landscape"/>
    <field name="binding_model_id" ref="model_ua_military_list"/><field name="binding_type">report</field>
  </record>
  <template id="report_ua_military_list">
    <t t-call="web.basic_layout"><t t-foreach="docs" t-as="doc">
      <div class="page" style="font-family: DejaVu Sans, sans-serif; font-size: 7px;">
        <div style="font-size:11px; font-weight:bold;">Список персонального військового обліку</div>
        <div><t t-out="doc.company_id.name"/> · ТЦК та СП: <t t-out="doc.tcc"/> · станом на <t t-out="doc.date.strftime('%d.%m.%Y')"/></div>
        <t t-foreach="doc.line_ids.mapped('section_label')" t-as="sec_label" t-key="sec_label">
          <t t-set="sec_lines" t-value="doc.line_ids.filtered(lambda l: l.section_label == sec_label)"/>
          <div style="font-size:9px; font-weight:bold; margin-top:8px;"><t t-out="sec_label"/></div>
          <table class="table table-sm" style="border-collapse:collapse; width:100%; margin-top:2px;">
            <thead><tr style="border-bottom:1px solid #999;">
              <th>№</th><th>ПІБ</th><th>Дата нар.</th><th>РНОКПП</th><th>Адреса</th><th>Посада</th><th>Звання</th><th>ВОС</th>
              <th>Категорія</th><th>ТЦК</th><th>Документ</th><th>Дата звірки</th>
            </tr></thead>
            <tbody>
              <t t-foreach="sec_lines" t-as="r">
                <tr style="border-bottom:1px solid #ddd;">
                  <td><t t-out="r_index + 1"/></td>
                  <td><t t-out="r.full_name"/></td>
                  <td><t t-out="r.birthday.strftime('%d.%m.%Y') if r.birthday else ''"/></td>
                  <td><t t-out="r.rnokpp"/></td>
                  <td><t t-out="r.reg_address"/></td>
                  <td><t t-out="r.job_title"/></td>
                  <td><t t-out="r.rank"/></td>
                  <td><t t-out="r.vos"/></td>
                  <td><t t-out="r.category"/></td>
                  <td><t t-out="r.tcc"/></td>
                  <td><t t-out="r.doc_info"/></td>
                  <td><t t-out="r.last_check.strftime('%d.%m.%Y') if r.last_check else ''"/></td>
                </tr>
              </t>
            </tbody>
          </table>
        </t>
      </div>
    </t></t>
  </template>
</odoo>
