<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="view_ua_payroll_report_wizard" model="ir.ui.view">
    <field name="name">ua.payroll.report.wizard.form</field><field name="model">ua.payroll.report.wizard</field>
    <field name="arch" type="xml">
      <form string="Об'єднана звітність (XML для ДПС)">
        <group>
          <group><field name="company_id"/><field name="year" options="{'enable_formatting': False}"/><field name="month"/><field name="doc_type"/><field name="number"/></group>
          <group><field name="with_d1"/><field name="with_4df"/><field name="with_d5"/><field name="fill_date"/></group>
        </group>
        <field name="log" invisible="not log"/>
        <field name="result_ids" invisible="not result_ids" widget="many2many_binary" readonly="1"/>
        <footer>
          <button name="action_generate" type="object" string="Сформувати XML" class="btn-primary"/>
          <button string="Закрити" class="btn-secondary" special="cancel"/>
        </footer>
      </form>
    </field>
  </record>
  <record id="action_ua_payroll_report_wizard" model="ir.actions.act_window">
    <field name="name">Об'єднана звітність (XML)</field><field name="res_model">ua.payroll.report.wizard</field><field name="view_mode">form</field><field name="target">new</field>
  </record>
  <menuitem id="menu_ua_payroll_report" name="Об'єднана звітність (XML)" parent="hr.menu_hr_root" action="action_ua_payroll_report_wizard" sequence="50" groups="hr.group_hr_user"/>
</odoo>
