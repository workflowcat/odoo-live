<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="view_ua_income_certificate_form" model="ir.ui.view">
    <field name="name">ua.income.certificate.wizard.form</field>
    <field name="model">ua.income.certificate.wizard</field>
    <field name="arch" type="xml">
      <form string="Довідка про доходи">
        <group>
          <field name="employee_id"/>
          <field name="date_from"/>
          <field name="date_to"/>
          <field name="purpose" placeholder="для подання до банку"/>
          <field name="show_net"/>
          <field name="cert_number" invisible="not cert_number"/>
          <field name="cert_date" invisible="not cert_date"/>
        </group>
        <footer>
          <button name="action_print" type="object" string="Друк" class="btn-primary"/>
          <button special="cancel" string="Закрити" class="btn-secondary"/>
        </footer>
      </form>
    </field>
  </record>

  <record id="action_ua_income_certificate" model="ir.actions.act_window">
    <field name="name">Довідка про доходи</field>
    <field name="res_model">ua.income.certificate.wizard</field>
    <field name="view_mode">form</field>
    <field name="target">new</field>
  </record>

  <record id="action_ua_income_certificate_employee" model="ir.actions.act_window">
    <field name="name">Довідка про доходи</field>
    <field name="res_model">ua.income.certificate.wizard</field>
    <field name="view_mode">form</field>
    <field name="target">new</field>
    <field name="binding_model_id" ref="hr.model_hr_employee"/>
    <field name="binding_view_types">list,form</field>
    <field name="context">{'default_employee_id': active_id}</field>
  </record>
</odoo>
