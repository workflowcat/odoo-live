<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="view_ua_hire_notice_wizard" model="ir.ui.view">
    <field name="name">ua.hire.notice.wizard.form</field><field name="model">ua.hire.notice.wizard</field>
    <field name="arch" type="xml">
      <form string="Повідомлення про прийняття (J3001005)">
        <group><group><field name="company_id"/><field name="notice_type"/><field name="number"/></group><group><field name="fill_date"/><field name="citizenship_ua"/></group></group>
        <field name="employee_ids" widget="many2many_tags"/>
        <field name="log" invisible="not log"/>
        <footer><button name="action_generate" type="object" string="Сформувати XML" class="btn-primary"/><button string="Закрити" class="btn-secondary" special="cancel"/></footer>
      </form>
    </field>
  </record>
  <record id="action_ua_hire_notice_wizard" model="ir.actions.act_window">
    <field name="name">Повідомлення про прийняття (J3001005)</field><field name="res_model">ua.hire.notice.wizard</field><field name="view_mode">form</field><field name="target">new</field>
    <field name="binding_model_id" ref="hr.model_hr_employee"/><field name="binding_view_types">list,form</field>
  </record>
  <menuitem id="menu_ua_hire_notice" name="Повідомлення про прийняття" parent="hr.menu_hr_root" action="action_ua_hire_notice_wizard" sequence="49" groups="hr.group_hr_user"/>
</odoo>
