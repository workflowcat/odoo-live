<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="view_ua_income_certificate_register_list" model="ir.ui.view">
    <field name="name">ua.income.certificate.register.list</field>
    <field name="model">ua.income.certificate.register</field>
    <field name="arch" type="xml">
      <list create="0" edit="0" delete="0">
        <field name="name"/>
        <field name="date" options="{'numeric': True}"/>
        <field name="employee_id"/>
        <field name="date_from" options="{'numeric': True}"/>
        <field name="date_to" options="{'numeric': True}"/>
        <field name="purpose"/>
      </list>
    </field>
  </record>

  <record id="view_ua_income_certificate_register_form" model="ir.ui.view">
    <field name="name">ua.income.certificate.register.form</field>
    <field name="model">ua.income.certificate.register</field>
    <field name="arch" type="xml">
      <form string="Довідка про доходи" create="0" edit="0">
        <sheet>
          <div class="oe_title"><h1><field name="name" readonly="1"/></h1></div>
          <group>
            <group>
              <field name="date"/>
              <field name="employee_id"/>
              <field name="company_id"/>
            </group>
            <group>
              <field name="date_from"/>
              <field name="date_to"/>
              <field name="purpose"/>
            </group>
          </group>
        </sheet>
      </form>
    </field>
  </record>

  <record id="view_ua_income_certificate_register_search" model="ir.ui.view">
    <field name="name">ua.income.certificate.register.search</field>
    <field name="model">ua.income.certificate.register</field>
    <field name="arch" type="xml">
      <search string="Довідки про доходи">
        <field name="name"/>
        <field name="employee_id"/>
        <field name="purpose"/>
        <group>
          <filter name="group_employee" string="Працівник" context="{'group_by': 'employee_id'}"/>
          <filter name="group_date" string="Дата видачі" context="{'group_by': 'date'}"/>
        </group>
      </search>
    </field>
  </record>

  <record id="action_ua_income_certificate_register" model="ir.actions.act_window">
    <field name="name">Реєстр довідок про доходи</field>
    <field name="res_model">ua.income.certificate.register</field>
    <field name="view_mode">list,form</field>
    <field name="search_view_id" ref="view_ua_income_certificate_register_search"/>
  </record>
</odoo>
