<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="view_ua_income_certificate_form" model="ir.ui.view">
    <field name="name">ua.income.certificate.form</field>
    <field name="model">ua.income.certificate</field>
    <field name="arch" type="xml">
      <form string="Довідка про доходи">
        <header>
          <button name="action_refill" type="object" string="Заповнити" invisible="state != 'draft'"/>
          <button name="action_confirm" type="object" string="Видати" class="oe_highlight"
                  invisible="state != 'draft'"/>
          <button name="action_draft" type="object" string="Повернути в чернетку"
                  invisible="state != 'issued'"/>
          <button name="%(action_report_ua_income_certificate)d" type="action" string="Друк"/>
          <field name="state" widget="statusbar"/>
        </header>
        <sheet>
          <div class="oe_title"><h1><field name="name" readonly="1"/></h1></div>
          <group>
            <group>
              <field name="employee_id" readonly="state != 'draft'"/>
              <field name="date_from" readonly="state != 'draft'"/>
              <field name="date_to" readonly="state != 'draft'"/>
              <field name="purpose" placeholder="для подання до банку" readonly="state != 'draft'"/>
            </group>
            <group>
              <field name="number"/>
              <field name="date"/>
              <field name="show_net"/>
              <field name="company_id" groups="base.group_multi_company" readonly="state != 'draft'"/>
              <field name="currency_id" invisible="1"/>
            </group>
          </group>
          <notebook>
            <page string="Рядки" name="lines">
              <field name="line_ids" readonly="1">
                <list>
                  <field name="period"/>
                  <field name="gross" sum="Разом"/>
                  <field name="pdfo" sum="Разом"/>
                  <field name="vz" sum="Разом"/>
                  <field name="net" sum="Разом"/>
                  <field name="payslip_id" optional="hide"/>
                  <field name="currency_id" column_invisible="1"/>
                </list>
              </field>
              <group class="oe_subtotal_footer">
                <field name="total_gross"/>
                <field name="total_pdfo"/>
                <field name="total_vz"/>
                <field name="total_net"/>
              </group>
            </page>
            <page string="Примітка" name="note">
              <field name="note"/>
            </page>
            <page string="Перевірки" name="ua_checks">
              <field name="checks_html" readonly="1" nolabel="1"/>
            </page>
          </notebook>
        </sheet>
        <chatter/>
      </form>
    </field>
  </record>

  <record id="view_ua_income_certificate_list" model="ir.ui.view">
    <field name="name">ua.income.certificate.list</field>
    <field name="model">ua.income.certificate</field>
    <field name="arch" type="xml">
      <!-- Довідку заводять кнопкою «Новий»: працівника і період за нього не вгадати.
           Заповнення рядків - «Заповнити» на самій формі. -->
      <list>
        <field name="number"/>
        <field name="date" options="{'numeric': True}"/>
        <field name="employee_id"/>
        <field name="date_from" options="{'numeric': True}"/>
        <field name="date_to" options="{'numeric': True}"/>
        <field name="purpose"/>
        <field name="total_gross" optional="show" sum="Разом"/>
        <field name="state"/>
        <field name="currency_id" column_invisible="1"/>
      </list>
    </field>
  </record>

  <record id="view_ua_income_certificate_search" model="ir.ui.view">
    <field name="name">ua.income.certificate.search</field>
    <field name="model">ua.income.certificate</field>
    <field name="arch" type="xml">
      <search string="Довідки про доходи">
        <field name="number"/>
        <field name="employee_id"/>
        <field name="purpose"/>
        <filter string="Чернетка" name="draft" domain="[('state', '=', 'draft')]"/>
        <filter string="Видано" name="issued" domain="[('state', '=', 'issued')]"/>
        <group>
          <filter name="group_employee" string="Працівник" context="{'group_by': 'employee_id'}"/>
          <filter name="group_date" string="Дата видачі" context="{'group_by': 'date'}"/>
        </group>
      </search>
    </field>
  </record>

  <record id="action_ua_income_certificate" model="ir.actions.act_window">
    <field name="name">Довідки про доходи</field>
    <field name="res_model">ua.income.certificate</field>
    <field name="view_mode">list,form</field>
    <field name="target">current</field>
    <field name="search_view_id" ref="view_ua_income_certificate_search"/>
  </record>

  <record id="action_ua_income_certificate_employee" model="ir.actions.act_window">
    <field name="name">Довідка про доходи</field>
    <field name="res_model">ua.income.certificate</field>
    <field name="view_mode">list,form</field>
    <field name="target">current</field>
    <field name="binding_model_id" ref="hr.model_hr_employee"/>
    <field name="binding_view_types">list,form</field>
    <field name="group_ids" eval="[(4, ref('payroll.group_payroll_user'))]"/>
    <field name="context">{'default_employee_id': active_id, 'search_default_employee_id': active_id}</field>
  </record>
</odoo>
