<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <!-- Правила компанії: записи однієї компанії не видно з іншої. Той самий домен,
       що в нативних документах Odoo; рядок бере компанію в документа, на якому висить,
       а довідник із порожньою компанією спільний для всіх. -->
  <record id="rule_ua_advance_sheet_company" model="ir.rule">
    <field name="name">Авансова відомість: лише свої компанії</field>
    <field name="model_id" ref="model_ua_advance_sheet"/>
    <field name="domain_force">[('company_id', 'in', company_ids)]</field>
  </record>

  <record id="rule_ua_advance_line_company" model="ir.rule">
    <field name="name">Рядок авансової відомості: лише свої компанії</field>
    <field name="model_id" ref="model_ua_advance_line"/>
    <field name="domain_force">[('sheet_id.company_id', 'in', company_ids)]</field>
  </record>

  <record id="rule_ua_payroll_param_company" model="ir.rule">
    <field name="name">Параметр зарплати (Україна): лише свої компанії</field>
    <field name="model_id" ref="model_ua_payroll_param"/>
    <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
  </record>
</odoo>
