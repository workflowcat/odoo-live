<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="view_employee_form_ua" model="ir.ui.view">
    <field name="name">hr.employee.form.ua</field><field name="model">hr.employee</field>
    <field name="inherit_id" ref="hr.view_employee_form"/>
    <field name="arch" type="xml">
      <notebook position="inside">
        <page string="Україна" name="ua" groups="hr.group_hr_user">
          <group name="ua">
            <group string="Облік">
              <field name="ua_rnokpp"/><field name="ua_contract_kind"/><field name="ua_main_job"/><field name="ua_fte"/><field name="ua_esv_category"/>
            </group>
            <group string="Пільги">
              <field name="ua_psp"/><field name="ua_psp_children" invisible="ua_psp not in ('child', 'child150')"/><field name="ua_disability_group"/>
            </group>
            <group name="ua_leave" string="Відпустка">
              <field name="ua_vacation_days_year"/><field name="ua_vacation_accrued"/><field name="ua_vacation_used"/><field name="ua_vacation_balance"/>
              <field name="ua_vacation_opening_balance"/><field name="ua_vacation_opening_date"/>
            </group>
          </group>
        </page>
      </notebook>
    </field>
  </record>
  <record id="view_company_form_ua_vacation" model="ir.ui.view">
    <field name="name">res.company.form.ua.vacation</field><field name="model">res.company</field>
    <field name="inherit_id" ref="base.view_company_form"/>
    <field name="arch" type="xml">
      <xpath expr="//notebook" position="inside">
        <page string="Відпустки (облік)" name="ua_vacation"><group><field name="ua_vacation_opening_date"/></group></page>
      </xpath>
    </field>
  </record>
</odoo>
