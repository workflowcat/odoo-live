<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="rule_ua_repair_operation_company" model="ir.rule">
    <field name="name">Роботи ремонту: своя компанія або спільні</field>
    <field name="model_id" ref="model_ua_repair_operation"/>
    <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
  </record>
  <record id="rule_ua_repair_labour_company" model="ir.rule">
    <field name="name">Роботи в ремонті: своя компанія</field>
    <field name="model_id" ref="model_ua_repair_labour"/>
    <field name="domain_force">[('company_id', 'in', company_ids)]</field>
  </record>
</odoo>
