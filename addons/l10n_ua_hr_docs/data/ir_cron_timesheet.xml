<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <data noupdate="1">
    <record id="ir_cron_ua_ensure_timesheets" model="ir.cron">
      <field name="name">Табель поточного місяця для кожної компанії</field>
      <field name="model_id" ref="l10n_ua_hr_docs.model_ua_timesheet_sheet"/>
      <field name="state">code</field>
      <!-- та сама логіка, що й кнопка «Підготувати місяць»: без дублів,
           затвердженого табеля не чіпає -->
      <field name="code">
today = datetime.date.today()
for company in model.env["res.company"].sudo().search([]):
    model.sudo()._ua_ensure_for(company, today.year, today.month)
      </field>
      <field name="interval_number">1</field>
      <field name="interval_type">days</field>
      <field name="nextcall" eval="'2026-09-23 02:00:00'"/>
      <field name="active">True</field>
    </record>
  </data>
</odoo>
