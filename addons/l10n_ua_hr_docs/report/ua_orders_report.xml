<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="action_report_ua_order_hire" model="ir.actions.report">
    <field name="name">Наказ про прийняття на роботу (П-1)</field><field name="model">hr.version</field><field name="report_type">qweb-pdf</field>
    <field name="report_name">l10n_ua_hr_docs.report_ua_order_hire</field><field name="report_file">l10n_ua_hr_docs.report_ua_order_hire</field>
    <field name="print_report_name">'Наказ про прийняття %s' % object.employee_id.name</field>
    <field name="binding_model_id" ref="hr.model_hr_version"/><field name="binding_type">report</field><field name="paperformat_id" ref="l10n_ua_payroll_reports.paperformat_ua_a4"/>
  </record>
  <record id="action_report_ua_order_dismiss" model="ir.actions.report">
    <field name="name">Наказ про припинення трудового договору (П-4)</field><field name="model">hr.version</field><field name="report_type">qweb-pdf</field>
    <field name="report_name">l10n_ua_hr_docs.report_ua_order_dismiss</field><field name="report_file">l10n_ua_hr_docs.report_ua_order_dismiss</field>
    <field name="print_report_name">'Наказ про звільнення %s' % object.employee_id.name</field>
    <field name="binding_model_id" ref="hr.model_hr_version"/><field name="binding_type">report</field><field name="paperformat_id" ref="l10n_ua_payroll_reports.paperformat_ua_a4"/>
  </record>
  <record id="action_report_ua_order_leave" model="ir.actions.report">
    <field name="name">Наказ про надання відпустки (П-3)</field><field name="model">hr.leave</field><field name="report_type">qweb-pdf</field>
    <field name="report_name">l10n_ua_hr_docs.report_ua_order_leave</field><field name="report_file">l10n_ua_hr_docs.report_ua_order_leave</field>
    <field name="print_report_name">'Наказ про відпустку %s' % object.employee_id.name</field>
    <field name="binding_model_id" ref="hr_holidays.model_hr_leave"/><field name="binding_type">report</field><field name="paperformat_id" ref="l10n_ua_payroll_reports.paperformat_ua_a4"/>
  </record>

  <template id="ua_order_head">
    <div style="text-align:center; margin-bottom:14px;">
      <div style="font-weight:bold; font-size:13px;"><t t-out="company.name"/></div>
      <div style="font-size:10px; color:#444;">ЄДРПОУ <t t-out="company.company_registry or '-'"/> · <t t-out="', '.join(x for x in [company.zip, company.city, company.street] if x)"/></div>
      <h3 style="margin:16px 0 2px;">НАКАЗ</h3>
      <div><t t-out="(order_ref or '').replace('Наказ ', '').strip() or '№ ____ від ____________'"/></div>
    </div>
  </template>
  <template id="ua_order_foot">
    <table style="width:100%; margin-top:36px; font-size:11px;">
      <tr><td style="width:50%">Директор ____________________ <t t-out="company.ua_director_name or ''"/></td><td></td></tr>
      <tr><td style="padding-top:24px;">З наказом ознайомлений(а) ____________________ <t t-out="employee.name"/></td><td style="padding-top:24px;">«____» ____________ 20___ р.</td></tr>
    </table>
  </template>

  <template id="report_ua_order_hire">
    <t t-call="web.basic_layout"><t t-foreach="docs" t-as="v">
      <t t-set="company" t-value="v.employee_id.company_id"/><t t-set="employee" t-value="v.employee_id"/><t t-set="order_ref" t-value="v.ua_order_ref"/>
      <div class="page" style="font-family: DejaVu Sans, sans-serif; font-size: 11px;">
        <t t-call="l10n_ua_hr_docs.ua_order_head"/>
        <p style="text-align:center;"><b>Про прийняття на роботу</b></p>
        <p>ПРИЙНЯТИ на роботу <b><t t-out="employee.name"/></b> з <b><t t-out="v.contract_date_start and v.contract_date_start.strftime('%d.%m.%Y')"/></b>
          до підрозділу <b><t t-out="v.department_id.name or employee.department_id.name or '-'"/></b> на посаду <b><t t-out="v.ua_prof_name or v.job_title or employee.job_title or '-'"/></b>
          <t t-if="v.ua_kp_code">(код КП <t t-out="v.ua_kp_code"/>)</t>
          з окладом <b><t t-out="'{:,.2f}'.format(v.wage).replace(',', '&#160;').replace('.', ',')"/> грн</b> на місяць<t t-if="employee.sudo().ua_fte != '1'">, <t t-out="(employee.sudo().ua_fte or '1').replace('.', ',')"/> ставки</t>.</p>
        <p>Умови роботи: <t t-out="'основне місце роботи' if employee.sudo().ua_main_job else 'за сумісництвом'"/><t t-if="v.ua_internal_parttime">, внутрішнє сумісництво</t>;
          <t t-out="v.contract_type_id.name or 'безстроковий трудовий договір'"/><t t-if="v.contract_date_end"> до <t t-out="v.contract_date_end.strftime('%d.%m.%Y')"/></t>;
          <t t-if="v.trial_date_end">випробувальний строк до <t t-out="v.trial_date_end.strftime('%d.%m.%Y')"/>;</t> нормальна тривалість робочого часу.</p>
        <p>Підстава: заява <t t-out="employee.name"/>, трудовий договір.</p>
        <p>Повідомлення про прийняття працівника на роботу подати до ДПС до початку роботи.</p>
        <t t-call="l10n_ua_hr_docs.ua_order_foot"/>
      </div>
    </t></t>
  </template>

  <template id="report_ua_order_dismiss">
    <t t-call="web.basic_layout"><t t-foreach="docs" t-as="v">
      <t t-set="company" t-value="v.employee_id.company_id"/><t t-set="employee" t-value="v.employee_id"/><t t-set="order_ref" t-value="v.ua_end_order_ref"/>
      <t t-set="comp" t-value="v.env['hr.payslip.input'].sudo().search([('payslip_id.employee_id', '=', employee.id), ('code', '=', 'COMP_DAYS'), ('payslip_id.date_from', '&lt;=', v.contract_date_end or v.contract_date_start), ('payslip_id.date_to', '&gt;=', v.contract_date_end or v.contract_date_start)], limit=1)"/>
      <div class="page" style="font-family: DejaVu Sans, sans-serif; font-size: 11px;">
        <t t-call="l10n_ua_hr_docs.ua_order_head"/>
        <p style="text-align:center;"><b>Про припинення трудового договору</b></p>
        <p>ЗВІЛЬНИТИ <b><t t-out="employee.name"/></b>, <t t-out="v.ua_prof_name or v.job_title or employee.job_title or '-'"/> підрозділу <t t-out="v.department_id.name or employee.department_id.name or '-'"/>,
          <b><t t-out="v.contract_date_end and v.contract_date_end.strftime('%d.%m.%Y')"/></b> на підставі <b><t t-out="v.ua_dismissal_basis or '________________________'"/></b>.</p>
        <p>Бухгалтерії провести повний розрахунок у день звільнення<t t-if="comp"> і виплатити компенсацію за <t t-out="('%g' % comp.amount).replace('.', ',')"/> днів невикористаної щорічної відпустки</t>.</p>
        <p>Підстава: <t t-out="'заява працівника' if 'ст. 38' in (v.ua_dismissal_basis or '') else 'угода сторін' if 'ст. 36' in (v.ua_dismissal_basis or '') else '________________'"/>.</p>
        <t t-call="l10n_ua_hr_docs.ua_order_foot"/>
      </div>
    </t></t>
  </template>

  <template id="report_ua_order_leave">
    <t t-call="web.basic_layout"><t t-foreach="docs" t-as="lv">
      <t t-set="company" t-value="lv.employee_id.company_id"/><t t-set="employee" t-value="lv.employee_id"/><t t-set="order_ref" t-value="lv.ua_order_ref"/>
      <t t-set="code" t-value="lv.holiday_status_id.work_entry_type_id.code or ''"/>
      <div class="page" style="font-family: DejaVu Sans, sans-serif; font-size: 11px;">
        <t t-call="l10n_ua_hr_docs.ua_order_head"/>
        <p style="text-align:center;"><b>Про надання відпустки</b></p>
        <p>НАДАТИ <b><t t-out="employee.name"/></b>, <t t-out="employee.job_title or '-'"/> підрозділу <t t-out="employee.department_id.name or '-'"/>,
          <b><t t-out="{'VAC': 'щорічну основну відпустку', 'UNPAID': 'відпустку без збереження заробітної плати (ст. 26 ЗУ про відпустки)', 'MAT': 'відпустку у зв’язку з вагітністю та пологами'}.get(code, lv.holiday_status_id.name)"/></b>
          тривалістю <b><t t-out="(lv.request_date_to - lv.request_date_from).days + 1"/> календарних днів</b> з <b><t t-out="lv.request_date_from.strftime('%d.%m.%Y')"/></b> по <b><t t-out="lv.request_date_to.strftime('%d.%m.%Y')"/></b><t t-if="code == 'VAC'"> за період роботи <t t-out="lv.request_date_from.year"/> року</t>.</p>
        <t t-if="code == 'VAC'"><p>Бухгалтерії виплатити відпускні не пізніше ніж за три дні до початку відпустки (ст. 115 КЗпП).</p></t>
        <p>Підстава: заява <t t-out="employee.name"/><t t-if="code == 'MAT'">, листок непрацездатності <t t-out="lv.ua_sick_number or ''"/></t>.</p>
        <t t-call="l10n_ua_hr_docs.ua_order_foot"/>
      </div>
    </t></t>
  </template>
</odoo>
