<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="action_report_ua_pfu_claim" model="ir.actions.report">
    <field name="name">Заява-розрахунок до ПФУ</field><field name="model">ua.pfu.claim</field><field name="report_type">qweb-pdf</field>
    <field name="report_name">l10n_ua_hr_docs.report_ua_pfu_claim</field><field name="report_file">l10n_ua_hr_docs.report_ua_pfu_claim</field>
    <field name="print_report_name">object.name</field>
    <field name="paperformat_id" ref="l10n_ua_payroll_reports.paperformat_ua_a4_landscape"/>
    <field name="binding_model_id" ref="model_ua_pfu_claim"/><field name="binding_type">report</field>
  </record>
  <template id="report_ua_pfu_claim">
    <t t-call="web.basic_layout"><t t-foreach="docs" t-as="doc">
      <t t-set="co" t-value="doc.company_id"/>
      <t t-set="run" t-value="doc.payslip_run_id"/>
      <t t-set="bank" t-value="co.partner_id.bank_ids[:1]"/>
      <t t-set="kind_label" t-value="{'sick': 'Тимчасова непрацездатність', 'mat': 'Вагітність та пологи'}"/>
      <div class="page" style="font-family: DejaVu Sans, sans-serif; font-size: 10px;">
        <h3 style="margin-bottom:2px;">Заява-розрахунок</h3>
        <div>про фінансування страхувальника для надання матеріального забезпечення застрахованим особам (Постанова ПФУ). Страхувальник: <b><t t-out="co.name"/></b>, ЄДРПОУ <t t-out="co.company_registry or '-'"/>,
          рахунок для зарахування коштів <t t-out="bank.acc_number if bank else '____________________'"/>. Період: <t t-out="run.date_start.strftime('%d.%m.%Y')"/> - <t t-out="run.date_end.strftime('%d.%m.%Y')"/>.</div>
        <table class="table table-sm" style="font-size:10px; margin-top:8px;">
          <thead><tr><th>№</th><th>ПІБ</th><th>РНОКПП</th><th>Вид</th><th>№ е-ЛН</th><th>Період непрацездатності</th><th class="text-end">Днів за рахунок ПФУ</th><th class="text-end">Середньоденна, грн</th><th class="text-end">%</th><th class="text-end">Сума, грн</th></tr></thead>
          <tbody>
            <t t-foreach="doc.line_ids" t-as="r">
              <t t-set="emp" t-value="r.employee_id.sudo()"/>
              <tr><td><t t-out="r_index + 1"/></td><td><t t-out="emp.name"/></td><td><t t-out="emp.ua_rnokpp or ''"/></td><td><t t-out="kind_label.get(r.kind)"/></td><td><t t-out="r.sick_number or ''"/></td>
                <td><t t-if="r.date_from and r.date_to"><t t-out="r.date_from.strftime('%d.%m.%Y')"/> - <t t-out="r.date_to.strftime('%d.%m.%Y')"/></t></td>
                <td class="text-end"><t t-out="r.days"/></td><td class="text-end"><t t-out="'{:,.2f}'.format(r.avg_day).replace(',', '&#160;').replace('.', ',')"/></td>
                <td class="text-end"><t t-out="'%g' % r.percent"/></td><td class="text-end"><t t-out="'{:,.2f}'.format(r.amount).replace(',', '&#160;').replace('.', ',')"/></td></tr>
            </t>
            <tr style="font-weight:bold;"><td></td><td>Разом</td><td></td><td></td><td></td><td></td><td></td><td></td><td></td><td class="text-end"><t t-out="'{:,.2f}'.format(doc.total).replace(',', '&#160;').replace('.', ',')"/></td></tr>
          </tbody>
        </table>
        <table style="width:100%; margin-top:24px; font-size:10px;"><tr><td>Керівник ____________________ <t t-out="co.ua_director_name or ''"/></td><td>Головний бухгалтер ____________________ <t t-out="co.ua_accountant_name or ''"/></td></tr></table>
        <p style="font-size:9px; color:#555; margin-top:8px;">Форма для перевірки бухгалтером: офіційна Заява-розрахунок подається через портал ПФУ; цей друк відтворює її зміст.</p>
      </div>
    </t></t>
  </template>
</odoo>
