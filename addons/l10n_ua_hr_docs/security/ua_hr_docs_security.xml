<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <!-- Правила компанії: записи однієї компанії не видно з іншої. Той самий домен,
       що в нативних документах Odoo; рядок бере компанію в документа, на якому висить,
       а довідник із порожньою компанією спільний для всіх. -->
  <record id="rule_ua_pfu_claim_company" model="ir.rule">
    <field name="name">Заява-розрахунок до ПФУ: лише свої компанії</field>
    <field name="model_id" ref="model_ua_pfu_claim"/>
    <field name="domain_force">[('company_id', 'in', company_ids)]</field>
  </record>

  <record id="rule_ua_pfu_claim_line_company" model="ir.rule">
    <field name="name">Рядок заяви-розрахунку до ПФУ: лише свої компанії</field>
    <field name="model_id" ref="model_ua_pfu_claim_line"/>
    <field name="domain_force">[('claim_id.company_id', 'in', company_ids)]</field>
  </record>

  <record id="rule_ua_staff_list_company" model="ir.rule">
    <field name="name">Штатний розпис: лише свої компанії</field>
    <field name="model_id" ref="model_ua_staff_list"/>
    <field name="domain_force">[('company_id', 'in', company_ids)]</field>
  </record>

  <record id="rule_ua_staff_list_line_company" model="ir.rule">
    <field name="name">Рядок штатного розпису: лише свої компанії</field>
    <field name="model_id" ref="model_ua_staff_list_line"/>
    <field name="domain_force">[('list_id.company_id', 'in', company_ids)]</field>
  </record>

  <record id="rule_ua_timesheet_sheet_company" model="ir.rule">
    <field name="name">Табель обліку робочого часу: лише свої компанії</field>
    <field name="model_id" ref="model_ua_timesheet_sheet"/>
    <field name="domain_force">[('company_id', 'in', company_ids)]</field>
  </record>

  <record id="rule_ua_timesheet_line_company" model="ir.rule">
    <field name="name">Рядок табеля обліку робочого часу: лише свої компанії</field>
    <field name="model_id" ref="model_ua_timesheet_line"/>
    <field name="domain_force">[('sheet_id.company_id', 'in', company_ids)]</field>
  </record>
</odoo>
