<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="view_ua_claim_list" model="ir.ui.view">
    <field name="name">ua.claim.list</field>
    <field name="model">ua.claim</field>
    <field name="arch" type="xml">
      <list decoration-danger="is_overdue" decoration-muted="state in ('closed', 'cancel')">
        <field name="name"/>
        <field name="date_received"/>
        <field name="partner_id"/>
        <field name="product_id"/>
        <field name="lot_id"/>
        <field name="cause" optional="show"/>
        <field name="decision" optional="show"/>
        <field name="in_warranty" optional="hide"/>
        <field name="date_response_due" optional="hide"/>
        <field name="date_due"/>
        <field name="user_id" widget="many2one_avatar_user" optional="show"/>
        <field name="is_overdue" column_invisible="1"/>
        <field name="state" widget="badge" decoration-info="state in ('received', 'investigation')"
               decoration-warning="state == 'decided'" decoration-success="state == 'closed'"/>
      </list>
    </field>
  </record>

  <record id="view_ua_claim_pivot" model="ir.ui.view">
    <field name="name">ua.claim.pivot</field>
    <field name="model">ua.claim</field>
    <field name="arch" type="xml">
      <pivot string="Рекламації">
        <field name="product_id" type="row"/>
        <field name="cause" type="col"/>
      </pivot>
    </field>
  </record>

  <record id="view_ua_claim_search" model="ir.ui.view">
    <field name="name">ua.claim.search</field>
    <field name="model">ua.claim</field>
    <field name="arch" type="xml">
      <search>
        <field name="name"/>
        <field name="lot_id"/>
        <field name="product_id"/>
        <field name="partner_id"/>
        <field name="partner_ref"/>
        <field name="contract_id"/>
        <filter name="open" string="Відкриті" domain="[('state', 'in', ('received', 'investigation', 'decided'))]"/>
        <filter name="overdue" string="Прострочені" domain="[('is_overdue', '=', True)]"/>
        <filter name="in_warranty" string="У гарантії" domain="[('in_warranty', '=', True)]"/>
        <filter name="mine" string="Мої" domain="[('user_id', '=', uid)]"/>
        <separator/>
        <filter name="our_cause" string="Власний дефект" domain="[('cause', 'in', ('manufacturing', 'component', 'design'))]"/>
        <group>
          <filter name="by_product" string="Виріб" context="{'group_by': 'product_id'}"/>
          <filter name="by_cause" string="Причина" context="{'group_by': 'cause'}"/>
          <filter name="by_partner" string="Замовник" context="{'group_by': 'partner_id'}"/>
          <filter name="by_state" string="Стан" context="{'group_by': 'state'}"/>
        </group>
      </search>
    </field>
  </record>

  <record id="view_ua_claim_form" model="ir.ui.view">
    <field name="name">ua.claim.form</field>
    <field name="model">ua.claim</field>
    <field name="arch" type="xml">
      <form>
        <header>
          <button name="action_start" type="object" string="Розслідувати" class="btn-primary"
                  invisible="state != 'received'"/>
          <button name="action_respond" type="object" string="Відповідь надіслано"
                  invisible="date_responded or state not in ('received', 'investigation', 'decided')"/>
          <button name="action_decide" type="object" string="Прийняти рішення" class="btn-primary"
                  invisible="state != 'investigation'" groups="l10n_ua_claim.group_ua_claim_manager"/>
          <button name="action_close" type="object" string="Закрити" class="btn-primary"
                  invisible="state != 'decided'"/>
          <button name="action_create_eco" type="object" string="Повідомлення про зміну"
                  invisible="cause != 'design' or eco_id or state in ('closed', 'cancel')"/>
          <button name="action_print" type="object" string="Друк"/>
          <button name="action_reopen" type="object" string="Відкрити знову"
                  invisible="state not in ('decided', 'closed', 'cancel')"
                  groups="l10n_ua_claim.group_ua_claim_manager"/>
          <button name="action_cancel" type="object" string="Скасувати"
                  invisible="state in ('closed', 'cancel')"/>
          <field name="state" widget="statusbar" statusbar_visible="received,investigation,decided,closed"/>
        </header>
        <sheet>
          <widget name="web_ribbon" title="Прострочено" bg_color="text-bg-danger" invisible="not is_overdue"/>
          <div class="oe_title"><h1><field name="name" readonly="1"/></h1></div>
          <group>
            <group string="Що надійшло">
              <field name="lot_id" readonly="state != 'received'" options="{'no_create': True}"/>
              <field name="product_id"/>
              <field name="contract_id" options="{'no_create': True}"/>
              <field name="partner_id" options="{'no_create': True}"/>
              <field name="partner_ref"/>
              <field name="partner_date"/>
              <field name="date_received"/>
              <field name="date_failure"/>
              <field name="operating_hours"/>
            </group>
            <group string="Гарантія і строки">
              <field name="warranty_start"/>
              <field name="warranty_end"/>
              <field name="in_warranty"/>
              <field name="date_response_due"/>
              <field name="date_responded"/>
              <field name="date_due"/>
              <field name="date_closed" invisible="not date_closed"/>
              <field name="user_id" widget="many2one_avatar_user"/>
              <field name="is_overdue" invisible="1"/>
            </group>
          </group>
          <group string="Несправність">
            <field name="symptom" placeholder="Що саме не працює і як це проявилось"/>
            <field name="conditions" placeholder="Де, як і в яких умовах виріб працював"/>
          </group>
          <group string="Розслідування і рішення" invisible="state == 'received'">
            <group>
              <field name="cause"/>
              <field name="component_lot_id" options="{'no_create': True}"/>
              <field name="supplier_id" invisible="cause != 'component'" options="{'no_create': True}"/>
              <field name="repeat_count" invisible="not repeat_count"/>
            </group>
            <group>
              <field name="decision"/>
              <field name="replacement_lot_id" invisible="decision != 'replace'" options="{'no_create': True}"/>
              <field name="cost_amount"/>
              <field name="currency_id" invisible="1"/>
              <field name="eco_id" invisible="not eco_id"/>
            </group>
            <field name="root_cause" colspan="2" placeholder="Що показало розслідування"/>
            <field name="decision_note" colspan="2"
                   placeholder="Обов'язково для відмови і для рішення поза гарантією"/>
          </group>
          <group>
            <field name="company_id" groups="base.group_multi_company"/>
          </group>
        </sheet>
        <chatter/>
      </form>
    </field>
  </record>

  <record id="action_ua_claim" model="ir.actions.act_window">
    <field name="name">Рекламації</field>
    <field name="res_model">ua.claim</field>
    <field name="view_mode">list,form,pivot</field>
    <field name="context">{'search_default_open': 1}</field>
  </record>

  <menuitem id="menu_ua_claim" name="Рекламації" parent="l10n_ua_defense.menu_ua_defense_root"
            action="action_ua_claim" sequence="50" groups="l10n_ua_claim.group_ua_claim_user,mrp.group_mrp_user"/>

  <record id="view_production_lot_form_ua_claim" model="ir.ui.view">
    <field name="name">stock.lot.form.ua.claim</field>
    <field name="model">stock.lot</field>
    <field name="inherit_id" ref="stock.view_production_lot_form"/>
    <field name="arch" type="xml">
      <xpath expr="//div[@name='button_box']" position="inside">
        <button name="action_ua_claims" type="object" class="oe_stat_button" icon="fa-exclamation-triangle"
                groups="l10n_ua_claim.group_ua_claim_user">
          <field name="ua_claim_count" widget="statinfo" string="Рекламації"/>
        </button>
      </xpath>
    </field>
  </record>

  <record id="view_ua_contract_form_claim" model="ir.ui.view">
    <field name="name">ua.contract.form.claim</field>
    <field name="model">ua.contract</field>
    <field name="inherit_id" ref="l10n_ua_defense.view_ua_contract_form_defense"/>
    <field name="arch" type="xml">
      <xpath expr="//page[@name='defense']/group" position="inside">
        <group string="Рекламації, календарних днів">
          <field name="ua_claim_response_days" string="Відповідь"/>
          <field name="ua_claim_fix_days" string="Усунення"/>
        </group>
      </xpath>
    </field>
  </record>
</odoo>
