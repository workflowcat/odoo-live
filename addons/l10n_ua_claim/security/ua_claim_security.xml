<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="privilege_ua_claim" model="res.groups.privilege">
    <field name="name">Рекламації</field>
    <field name="sequence">61</field>
  </record>
  <record id="group_ua_claim_user" model="res.groups">
    <field name="name">Працівник (реєструє і розслідує)</field>
    <field name="privilege_id" ref="privilege_ua_claim"/>
    <field name="sequence">10</field>
    <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
  </record>
  <record id="group_ua_claim_manager" model="res.groups">
    <field name="name">Керівник (приймає рішення)</field>
    <field name="privilege_id" ref="privilege_ua_claim"/>
    <field name="sequence">20</field>
    <field name="implied_ids" eval="[(4, ref('group_ua_claim_user'))]"/>
    <field name="user_ids" eval="[(4, ref('base.user_admin'))]"/>
  </record>
  <record id="rule_ua_claim_company" model="ir.rule">
    <field name="name">Рекламація: своя компанія</field>
    <field name="model_id" ref="model_ua_claim"/>
    <field name="domain_force">[('company_id', 'in', company_ids)]</field>
  </record>
</odoo>
