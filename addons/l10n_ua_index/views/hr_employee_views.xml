<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="view_employee_form_ua_index" model="ir.ui.view">
    <field name="name">hr.employee.form.ua.index</field>
    <field name="model">hr.employee</field>
    <field name="inherit_id" ref="l10n_ua_payroll_rules.view_employee_form_ua"/>
    <field name="arch" type="xml">
      <xpath expr="//page[@name='ua']//group[@name='ua']" position="inside">
        <group string="Індексація">
          <field name="ua_index_base"/>
          <field name="ua_index_base_effective"/>
          <field name="ua_index_off"/>
        </group>
      </xpath>
    </field>
  </record>
</odoo>
