<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="view_ua_cpi_index_list" model="ir.ui.view">
    <field name="name">ua.cpi.index.list</field>
    <field name="model">ua.cpi.index</field>
    <field name="arch" type="xml">
      <list string="Індекси споживчих цін" editable="top" default_order="year desc, month desc">
        <field name="year"/>
        <field name="month"/>
        <field name="name"/>
        <field name="value"/>
        <field name="note"/>
      </list>
    </field>
  </record>

  <record id="view_ua_cpi_index_form" model="ir.ui.view">
    <field name="name">ua.cpi.index.form</field>
    <field name="model">ua.cpi.index</field>
    <field name="arch" type="xml">
      <form string="Індекс споживчих цін">
        <sheet>
          <group>
            <field name="year"/>
            <field name="month"/>
            <field name="value"/>
            <field name="note" placeholder="Держстат, повідомлення від ..."/>
          </group>
        </sheet>
      </form>
    </field>
  </record>

  <record id="action_ua_cpi_index" model="ir.actions.act_window">
    <field name="name">Індекси споживчих цін</field>
    <field name="res_model">ua.cpi.index</field>
    <field name="view_mode">list,form</field>
    <field name="help" type="html">
      <p class="o_view_nocontent_smiling_face">Внесіть індекси Держстату за місяцями</p>
      <p>Індекс до попереднього місяця у відсотках. За цими числами рахується індексація зарплати.</p>
    </field>
  </record>

  <menuitem id="menu_ua_cpi_index" name="Індекси споживчих цін"
            parent="payroll.payroll_menu_configuration" action="action_ua_cpi_index" sequence="5"
            groups="hr.group_hr_user"/>
</odoo>
