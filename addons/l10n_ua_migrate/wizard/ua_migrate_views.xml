<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="view_ua_migrate_form" model="ir.ui.view">
    <field name="name">ua.migrate.form</field>
    <field name="model">ua.migrate</field>
    <field name="arch" type="xml">
      <form string="Перенесення з 1С/BAS">
        <group invisible="state == 'done'">
          <group>
            <field name="import_type"/>
            <field name="data_file" filename="data_filename"/>
            <field name="data_filename" invisible="1"/>
          </group>
          <group>
            <field name="dry_run"/>
            <field name="date_opening" invisible="import_type != 'balances'"/>
            <field name="allow_unbalanced" invisible="import_type != 'balances'"/>
          </group>
        </group>
        <field name="result_html" readonly="1" invisible="state != 'done'"/>
        <field name="state" invisible="1"/>
        <footer>
          <button name="action_import" type="object" string="Перенести" class="oe_highlight"
                  invisible="state == 'done'"/>
          <button string="Закрити" class="btn-secondary" special="cancel"/>
        </footer>
      </form>
    </field>
  </record>

  <record id="action_ua_migrate" model="ir.actions.act_window">
    <field name="name">Перенесення з 1С/BAS</field>
    <field name="res_model">ua.migrate</field>
    <field name="view_mode">form</field>
    <field name="target">new</field>
  </record>
</odoo>
