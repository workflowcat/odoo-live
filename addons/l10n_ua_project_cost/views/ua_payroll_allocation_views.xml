<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="view_ua_payroll_allocation_form" model="ir.ui.view">
    <field name="name">ua.payroll.allocation.form</field><field name="model">ua.payroll.allocation</field>
    <field name="arch" type="xml">
      <form string="Розподіл зарплати за проєктами">
        <header>
          <button name="action_confirm" type="object" string="Затвердити" class="btn-primary" invisible="state != 'draft'"/>
          <button name="action_copy_previous" type="object" string="Взяти попередній місяць" invisible="state != 'draft'"/>
          <button name="action_fill_timesheets" type="object" string="Години з обліку часу" invisible="state != 'draft'"/>
          <button name="action_draft" type="object" string="У чернетку" invisible="state != 'confirmed'"/>
          <field name="state" widget="statusbar"/>
        </header>
        <sheet>
          <div class="oe_title"><h1><field name="name" readonly="1"/></h1></div>
          <group>
            <group>
              <field name="month" readonly="state != 'draft'"/>
              <field name="company_id" groups="base.group_multi_company" readonly="state != 'draft'"/>
            </group>
            <group><field name="hours_total"/></group>
          </group>
          <notebook>
            <page string="Години за проєктами" name="lines">
              <field name="line_ids" readonly="state != 'draft'">
                <list editable="bottom">
                  <field name="employee_id"/>
                  <field name="analytic_account_id"/>
                  <field name="account_id"/>
                  <field name="hours" sum="Разом"/>
                  <field name="share"/>
                </list>
              </field>
            </page>
            <page string="Перевірки" name="ua_checks">
              <field name="checks_html" readonly="1" nolabel="1"/>
            </page>
            <page string="Примітка" name="note"><field name="note" nolabel="1"/></page>
          </notebook>
        </sheet>
        <chatter/>
      </form>
    </field>
  </record>

  <record id="view_ua_payroll_allocation_list" model="ir.ui.view">
    <field name="name">ua.payroll.allocation.list</field><field name="model">ua.payroll.allocation</field>
    <field name="arch" type="xml">
      <list string="Розподіл зарплати за проєктами">
        <field name="name"/>
        <field name="company_id" groups="base.group_multi_company"/>
        <field name="hours_total"/>
        <field name="state" widget="badge" decoration-success="state == 'confirmed'"/>
      </list>
    </field>
  </record>

  <record id="action_ua_payroll_allocation" model="ir.actions.act_window">
    <field name="name">Розподіл зарплати за проєктами</field>
    <field name="res_model">ua.payroll.allocation</field>
    <field name="view_mode">list,form</field>
  </record>
</odoo>
