<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="rule_ua_payroll_allocation_company" model="ir.rule">
    <field name="name">Розподіл зарплати за проєктами: своя компанія</field>
    <field name="model_id" ref="model_ua_payroll_allocation"/>
    <field name="domain_force">[('company_id', 'in', company_ids)]</field>
  </record>
  <record id="rule_ua_ia_capitalization_company" model="ir.rule">
    <field name="name">Введення НМА в експлуатацію: своя компанія</field>
    <field name="model_id" ref="model_ua_ia_capitalization"/>
    <field name="domain_force">[('company_id', 'in', company_ids)]</field>
  </record>
  <record id="rule_ua_ia_license_split_company" model="ir.rule">
    <field name="name">Розподіл амортизації НМА на ліцензії: своя компанія</field>
    <field name="model_id" ref="model_ua_ia_license_split"/>
    <field name="domain_force">[('company_id', 'in', company_ids)]</field>
  </record>
</odoo>
