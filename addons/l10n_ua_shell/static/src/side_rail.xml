<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
  <t t-name="l10n_ua_shell.SideRail">
    <nav class="o_ua_rail" aria-label="Застосунки">
      <t t-foreach="ourApps" t-as="app" t-key="app.id">
        <button type="button" t-attf-class="o_ua_rail_app #{isActiveApp(app) ? 'active' : ''}"
                t-att-data-tooltip="app.name" data-tooltip-position="right" t-att-aria-label="app.name"
                t-on-mouseenter="() => this.onEnter(app)" t-on-mouseleave="() => this.onLeave()"
                t-on-click="() => this.openApp(app)" t-esc="short(app)"/>
      </t>
      <div class="o_ua_rail_sep" t-if="otherApps.length"/>
      <t t-foreach="otherApps" t-as="app" t-key="app.id">
        <button type="button" t-attf-class="o_ua_rail_app o_ua_rail_other #{isActiveApp(app) ? 'active' : ''}"
                t-att-data-tooltip="app.name" data-tooltip-position="right" t-att-aria-label="app.name"
                t-on-mouseenter="() => this.onEnter(app)" t-on-mouseleave="() => this.onLeave()"
                t-on-click="() => this.openApp(app)" t-esc="short(app)"/>
      </t>
    </nav>

    <div t-if="panelApp" t-attf-class="o_ua_rail_panel #{state.pinned and !state.hoverId ? 'pinned' : ''}"
         t-on-mouseenter="() => this.onPanelEnter()" t-on-mouseleave="() => this.onLeave()">
      <div class="o_ua_rail_panel_head">
        <span class="o_ua_rail_panel_title" t-esc="panelApp.name"/>
        <button type="button" class="o_ua_rail_pin" t-on-click="() => this.togglePin()"
                data-tooltip="Закріплений перелік лишається відкритим і зсуває вміст праворуч"
                t-att-aria-pressed="state.pinned ? 'true' : 'false'"
                t-esc="state.pinned ? 'відкріпити' : 'закріпити'"/>
      </div>
      <t t-foreach="sections(panelApp)" t-as="node" t-key="node.id">
        <t t-if="node.childrenTree and node.childrenTree.length">
          <div class="o_ua_rail_group" t-esc="node.name"/>
          <t t-foreach="node.childrenTree" t-as="leaf" t-key="leaf.id">
            <a href="#" class="o_ua_rail_link o_ua_rail_link_sub" t-on-click.prevent="() => this.openMenu(leaf)" t-esc="leaf.name"
               t-att-data-tooltip="pageHelp(leaf)" data-tooltip-position="right"/>
          </t>
        </t>
        <a t-else="" href="#" class="o_ua_rail_link" t-on-click.prevent="() => this.openMenu(node)" t-esc="node.name"
           t-att-data-tooltip="pageHelp(node)" data-tooltip-position="right"/>
      </t>
    </div>
  </t>
</templates>
