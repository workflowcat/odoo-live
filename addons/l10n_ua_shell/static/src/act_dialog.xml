<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

  <!-- Крок 1 «План»: діалог перед проведенням. Показується лише коли
       options.plan дав непорожній перелік. -->
  <t t-name="l10n_ua_shell.ActPlanDialog">
    <Dialog title="props.title" size="'md'" contentClass="'o_ua_act_dialog'">
      <ul class="o_ua_act_plan">
        <t t-foreach="props.lines" t-as="line" t-key="line_index">
          <li class="o_ua_act_plan_line">
            <span t-attf-class="o_ua_act_pill o_ua_act_pill_#{line.level || 'info'}" t-esc="levelWord(line.level)"/>
            <span class="o_ua_act_plan_text" t-esc="line.text"/>
          </li>
        </t>
      </ul>
      <t t-set-slot="footer">
        <button type="button" class="btn btn-primary" t-on-click="confirm" t-esc="props.confirmLabel"/>
        <button type="button" class="btn btn-secondary" t-on-click="cancel">Скасувати</button>
      </t>
    </Dialog>
  </t>

  <!-- Кроки 3-4: смуга наслідків (staged reveal) і смуга скасування (20 с),
       заякорені внизу екрана. Один постійний компонент (main_components),
       стан ділиться з сервісом через реактивний об'єкт у props. -->
  <t t-name="l10n_ua_shell.ActPanel">
    <div class="o_ua_act_dock" t-if="state.consequence or state.undo">
      <div class="o_ua_act_panel" t-if="state.consequence">
        <ul class="o_ua_act_panel_list">
          <t t-foreach="state.consequence.items" t-as="item" t-key="item.key">
            <li t-if="item_index &lt; state.consequence.revealed"
                t-attf-class="o_ua_act_panel_line #{item.target ? 'o_ua_act_line_clickable' : ''}"
                t-on-click="() => this.onLineClick(item)"
                t-esc="item.text"/>
          </t>
        </ul>
        <button type="button" class="o_ua_act_skip"
                t-if="state.consequence.revealed &lt; state.consequence.items.length"
                t-on-click="() => this.skip()">Пропустити</button>
      </div>
      <div class="o_ua_act_undo" t-if="state.undo">
        <button type="button" class="o_ua_act_undo_btn" t-on-click="() => this.runUndo()" t-esc="state.undo.label"/>
        <span class="o_ua_act_undo_count" t-esc="state.undo.secondsLeft + 'с'"/>
      </div>
    </div>
  </t>

</templates>
