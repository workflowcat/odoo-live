<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
  <t t-name="l10n_ua_period.Period" owl="1">
    <div t-attf-class="o_ua_period #{state.person ? 'o_ua_period_with_panel' : ''}">
      <t t-if="state.loading">
        <div class="text-muted p-4">Завантаження…</div>
      </t>
      <t t-elif="state.data">
        <t t-set="data" t-value="state.data"/>

        <!-- шапка: місяць, стан одним рядком, дії -->
        <div class="o_ua_pd_head o_ua_head">
          <div class="o_ua_head_title">
            <div class="o_ua_head_title_row">
              <h4 t-esc="data.period.label"/>
              <span t-attf-class="o_ua_pd_state o_ua_tone_#{data.headline.tone}" t-esc="data.headline.title"/>
            </div>
          </div>
          <!-- Одна головна дія на екран. Місяць закінчується закриттям місяця, тому воно
               і стоїть у шапці; дія самого кроку живе в тілі кроку, поруч зі своїми рядками,
               а решта - під «Ще». П'ять кнопок в один ряд не читаються. -->
          <div class="o_ua_head_actions">
            <button t-if="data.close.state === 'closed' and !data.close.hard" class="btn btn-sm btn-secondary"
                    t-att-disabled="state.busy" t-on-click="() => this.openClose()">Відкрити знову</button>
            <button t-if="data.close.state !== 'closed'" class="btn btn-sm btn-primary"
                    t-att-disabled="state.busy" t-on-click="() => this.closeMonth()"
                    data-tooltip="Показує план перед закриттям: дату блокування і перешкоди, якщо є">Закрити місяць</button>
            <Dropdown>
              <button class="btn btn-sm btn-outline-secondary">Ще</button>
              <t t-set-slot="content">
                <DropdownItem closingMode="'none'" onSelected="() => this.toggleGuide()">
                  <t t-esc="state.guide ? 'Сховати підказки' : 'Показати підказки'"/>
                </DropdownItem>
                <DropdownItem t-if="data.new_changes and data.close.state !== 'closed'" closingMode="'none'"
                    onSelected="() => this.acceptAll()">
                  Прийняти всі зміни (<t t-esc="data.new_changes"/>)
                </DropdownItem>
                <DropdownItem t-if="data.quarter.label" closingMode="'none'"
                    class="this.quarterBlocked(data) ? 'disabled' : ''"
                    attrs="this.attrsFor(this.quarterTip(data))"
                    onSelected="() => this.closeQuarter()">Закрити квартал</DropdownItem>
                <DropdownItem t-if="data.year_close.label" closingMode="'none'"
                    class="this.yearBlocked(data) ? 'disabled' : ''"
                    attrs="this.attrsFor(this.yearCloseTip(data))"
                    onSelected="() => this.closeYear()">Закрити рік остаточно</DropdownItem>
              </t>
            </Dropdown>
          </div>
        </div>

        <!-- смуга місяців: окремим рядком під шапкою -->
        <div class="o_ua_pd_period_bar">
          <button type="button" class="o_ua_pd_icon" t-on-click="() => this.shiftMonth(-1)" aria-label="Попередній місяць" data-tooltip="Попередній місяць">‹</button>
          <span class="o_ua_pd_period_now" t-esc="data.period.label"/>
          <button type="button" class="o_ua_pd_icon" t-on-click="() => this.shiftMonth(1)" aria-label="Наступний місяць" data-tooltip="Наступний місяць">›</button>
          <div class="o_ua_months">
            <span t-foreach="data.periods" t-as="p" t-key="p.label"
                  t-attf-class="o_ua_month #{p.year === data.period.year and p.month === data.period.month ? 'active' : ''}"
                  t-on-click="() => this.selectPeriod(p)" t-esc="p.label"
                  t-att-data-tooltip="'Перейти до місяця ' + p.label"/>
          </div>
        </div>

        <!-- смуга строків -->
        <div class="o_ua_pd_strip" t-if="data.deadlines.length">
          <div t-foreach="data.deadlines" t-as="d" t-key="d.date"
               t-attf-class="o_ua_pd_mark o_ua_pd_mark_#{d.state} #{d.past ? 'past' : ''}"
               t-att-data-tooltip="this.markTip(d)">
            <b><t t-esc="d.date.slice(0, 5)"/><span t-if="state.guide and d_first" class="o_ua_guide_no ms-2"
                data-tooltip="Строки платежів і подань навколо місяця. Колір позначки - стан.">1</span></b>
            <span t-esc="d.label"/>
          </div>
        </div>

        <!-- три числа місяця -->
        <div class="o_ua_pd_nums">
          <div class="o_ua_clickable" t-on-click="() => this.openTotals('gross')" data-tooltip="Сума «Усього нараховано» в листках місяця. Клік відкриває листки.">
            <span class="o_ua_num" t-esc="data.totals.gross"/><span class="o_ua_lbl">нараховано</span></div>
          <div class="o_ua_clickable" t-on-click="() => this.openTotals('net')" data-tooltip="Сума «До виплати» після ПДФО, військового збору і утримань. Клік відкриває листки.">
            <span class="o_ua_num" t-esc="data.totals.net"/><span class="o_ua_lbl">до виплати</span></div>
          <div class="o_ua_clickable" t-on-click="() => this.openTotals('esv')" data-tooltip="ЄСВ 22 % за рахунок підприємства. Клік відкриває листки.">
            <span class="o_ua_num o_ua_num_sm" t-esc="data.totals.esv"/><span class="o_ua_lbl">ЄСВ підприємства</span></div>
        </div>

        <!-- смуга кроків: дев'ять в один ряд, клік відкриває крок без перезавантаження місяця -->
        <div class="o_ua_pd_steps" role="tablist">
          <div t-foreach="data.steps" t-as="step" t-key="step.key"
               t-attf-class="o_ua_pd_step #{this.selectedKey === step.key ? 'on' : ''}"
               role="tab" t-att-aria-selected="this.selectedKey === step.key ? 'true' : 'false'"
               t-on-click="() => this.selectStep(step)" t-att-data-tooltip="step.subtitle">
            <div class="o_ua_pd_step_n" t-esc="step.n"/>
            <div class="o_ua_pd_step_name">
              <span t-attf-class="o_ua_dot o_ua_dot_#{step.mark}" t-att-data-tooltip="this.dotTip(step.mark)"/>
              <t t-esc="step.name"/>
            </div>
          </div>
        </div>

        <!-- тіло відкритого кроку: на всю ширину -->
        <div class="o_ua_pd_stepbody" t-if="this.selectedStep">
          <t t-set="step" t-value="this.selectedStep"/>
          <div class="o_ua_pd_stepbody_head o_ua_sec_head">
            <div>
              <h5 class="o_ua_pd_stepbody_title" t-esc="step.name"/>
              <div class="o_ua_lbl" t-esc="step.subtitle"/>
            </div>
            <div class="o_ua_pd_stepbody_actions">
              <!-- Дія кроку стоїть біля самого кроку, а не в шапці екрана: там уже є
                   закриття місяця, і дві головні кнопки поруч сперечалися б між собою. -->
              <button t-if="data.headline.label and step.current" class="btn btn-sm btn-primary"
                      t-att-disabled="state.busy" t-on-click="() => this.runHeadline()"
                      t-esc="data.headline.label" data-tooltip="Наступна дія цього кроку"/>
              <button class="btn btn-link btn-sm" t-att-disabled="state.busy" t-on-click="() => this.open(step)"
                      data-tooltip="Перехід до всіх записів цього кроку">
                <t t-esc="step.button or 'Відкрити перелік'"/>
              </button>
            </div>
          </div>

          <div class="o_ua_pd_help" t-if="state.guide and this.helpFor(step)">
            <t t-set="help" t-value="this.helpFor(step)"/>
            <p t-esc="help.what"/>
            <p t-esc="help.done"/>
            <p class="o_ua_lbl" t-esc="help.next"/>
          </div>

          <!-- рядки кроку: документи, проблеми, записи разом, кожен зі своїм рівнем -->
          <div class="o_ua_pd_rows" t-if="step.rows.length">
            <div t-foreach="step.rows" t-as="row" t-key="row_index"
                 t-attf-class="o_ua_pd_row #{row.action and row.target and (row.target.model or row.target.xmlid) ? 'o_ua_clickable' : ''}"
                 t-on-click="() => this.openRow(row)">
              <span t-attf-class="o_ua_dot o_ua_dot_#{row.level}" t-att-data-tooltip="this.dotTip(row.level)"/>
              <span class="o_ua_pd_row_text" t-esc="row.text"/>
              <span t-if="row.action" class="o_ua_pd_row_act" t-esc="row.action"/>
            </div>
          </div>

          <!-- крок «Розрахунок листків»: люди місяця, на всю ширину -->
          <div class="o_ua_wide" t-if="step.key === 'payslips' and state.people.length">
            <table class="o_ua_table">
              <thead>
                <tr>
                  <th>Працівник</th><th>Підрозділ</th><th class="text-end">Дні</th>
                  <th class="text-end">Нараховано</th><th class="text-end">До виплати</th>
                  <th class="text-end">ЄСВ</th><th>Листок</th><th>Виплата</th>
                </tr>
              </thead>
              <tbody>
                <tr t-foreach="state.people" t-as="row" t-key="row.employee_id"
                    t-attf-class="o_ua_clickable #{state.person and state.person.employee_id === row.employee_id ? 'active' : ''}"
                    t-on-click="() => this.openPerson(row)">
                  <td>
                    <t t-esc="row.name"/>
                    <span t-if="row.flags.length" class="o_ua_person_flag" t-esc="row.flags.join(' · ')"/>
                  </td>
                  <td class="text-muted" t-esc="row.department"/>
                  <td class="text-end" t-esc="row.days"/>
                  <td class="text-end" t-esc="row.gross"/>
                  <td class="text-end" t-esc="row.net"/>
                  <td class="text-end" t-esc="row.esv"/>
                  <td><span t-attf-class="o_ua_pill #{row.done ? 'o_ua_pill_ok' : 'o_ua_pill_warn'}" t-esc="row.state"/></td>
                  <td><span t-if="row.payment" t-attf-class="o_ua_pill #{row.paid ? 'o_ua_pill_ok' : 'o_ua_pill_warn'}"
                            t-esc="row.paid ? 'оплачено' : 'у відомості'"/></td>
                </tr>
              </tbody>
            </table>
          </div>

          <!-- єдине місце, де сказано про перешкоди закриття (spec-period-v2.md, п.3) -->
          <div class="o_ua_pd_blockline" t-if="data.close.state !== 'closed' and step.blockers.count">
            Заважає закрити місяць:
            <a href="#" t-on-click.prevent="() => this.openDocTarget(step.blockers.target)">
              <t t-esc="step.blockers.count"/> <t t-esc="step.blockers.word"/>
            </a>. <t t-esc="step.blockers.text"/>
          </div>
        </div>

        <div class="o_ua_head_subtitle" t-if="data.close.state === 'closed'">
          Місяць закрито <t t-esc="data.close.closed_date"/><t t-if="data.close.closed_by"> · <t t-esc="data.close.closed_by"/></t><t t-if="data.close.hard"> · остаточно</t>
        </div>

        <div class="o_ua_person_panel" t-if="state.person">
          <div class="o_ua_person_panel_head">
            <div>
              <div class="o_ua_person_panel_name" t-esc="state.person.name"/>
              <div class="text-muted small">
                <t t-esc="state.person.job"/><t t-if="state.person.department"> · <t t-esc="state.person.department"/></t>
              </div>
            </div>
            <button class="btn btn-sm btn-link" t-on-click="() => this.closePerson()">Закрити</button>
          </div>

          <div class="o_ua_person_panel_body">
            <div class="o_ua_person_panel_state">Листок: <t t-esc="state.person.state"/></div>
            <table class="o_ua_table">
              <tbody>
                <tr t-foreach="state.person.lines" t-as="line" t-key="line.code">
                  <td t-esc="line.name"/>
                  <td class="text-end" t-esc="line.amount"/>
                </tr>
              </tbody>
            </table>

            <div t-if="state.person.events.length">
              <h6>Події місяця</h6>
              <div t-foreach="state.person.events" t-as="event" t-key="event.model + '-' + event.id"
                   class="o_ua_period_detail" t-on-click="() => this.openRecord({model: event.model, id: event.id})">
                <span t-esc="event.title"/>
                <span class="text-muted" t-esc="event.detail"/>
              </div>
            </div>

            <div t-if="state.person.payment.batch" class="o_ua_person_panel_state">
              Виплата: <t t-esc="state.person.payment.amount"/> ·
              <t t-esc="state.person.payment.paid ? 'оплачено' : 'у відомості'"/>
            </div>
          </div>

          <div class="o_ua_person_panel_foot">
            <button class="btn btn-sm btn-secondary" t-if="state.person.slip_id"
                    t-on-click="() => this.openPersonRecord(state.person.slip_id)">Відкрити листок</button>
            <button class="btn btn-sm btn-secondary" t-on-click="() => this.openPersonRecord(false)">Картка працівника</button>
          </div>
        </div>
      </t>
    </div>
  </t>
</templates>
