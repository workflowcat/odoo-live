<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
  <t t-name="l10n_ua_period.Period" owl="1">
    <div class="o_ua_period">
      <t t-if="state.loading">
        <div class="text-muted p-4">Завантаження…</div>
      </t>
      <t t-elif="state.data">
        <t t-set="data" t-value="state.data"/>

        <div class="o_ua_period_head">
          <div>
            <h4 t-esc="data.period.label"/>
            <div class="text-muted small"><t t-esc="data.company"/></div>
          </div>
          <div class="o_ua_period_months">
            <span t-foreach="data.periods" t-as="p" t-key="p.label"
                  t-attf-class="o_ua_period_month #{p.year === data.period.year and p.month === data.period.month ? 'active' : ''}"
                  t-on-click="() => this.selectPeriod(p)" t-esc="p.label"/>
          </div>
        </div>

        <div t-attf-class="o_ua_period_headline o_ua_tone_#{data.headline.tone}">
          <div class="o_ua_period_headline_text">
            <div class="o_ua_period_headline_title" t-esc="data.headline.title"/>
            <div class="text-muted small" t-esc="data.headline.detail"/>
          </div>
          <button t-if="data.headline.label" class="btn btn-primary" t-att-disabled="state.busy"
                  t-on-click="() => this.runHeadline()" t-esc="data.headline.label"/>
        </div>

        <div class="o_ua_period_numbers">
          <div><span class="o_ua_period_num" t-esc="data.estimate.gross"/><span class="o_ua_period_lbl">нараховано</span></div>
          <div><span class="o_ua_period_num" t-esc="data.estimate.net"/><span class="o_ua_period_lbl">до виплати</span></div>
          <div><span class="o_ua_period_num" t-esc="data.estimate.employer"/><span class="o_ua_period_lbl">ЄСВ підприємства</span></div>
          <div><span class="o_ua_period_num" t-esc="data.estimate.people"/><span class="o_ua_period_lbl">працівників у розрахунку</span></div>
        </div>

        <div class="o_ua_period_section" t-if="data.exceptions.length">
          <h5>Потребує рішення</h5>
          <div class="o_ua_period_steps">
            <div t-foreach="data.exceptions" t-as="row" t-key="row.key + '-' + row.title"
                 t-attf-class="o_ua_period_step o_ua_state_#{row.level === 'danger' ? 'warn' : 'warn'}"
                 t-on-click="() => this.openException(row)">
              <span class="o_ua_period_mark">!</span>
              <span class="o_ua_period_title" t-esc="row.title"/>
              <span class="o_ua_period_fact" t-esc="row.detail"/>
              <span class="o_ua_period_open"><button class="btn btn-sm btn-link p-0">Відкрити</button></span>
            </div>
          </div>
        </div>

        <div class="o_ua_period_section" t-if="data.changes.length">
          <h5>Зміни цього місяця</h5>
          <div class="o_ua_period_changes">
            <span t-foreach="data.changes" t-as="row" t-key="row.label" class="o_ua_period_chip"
                  t-on-click="() => this.openChange(row)">
              <t t-esc="row.count"/> <t t-esc="row.label"/>
            </span>
          </div>
        </div>

        <h5 class="o_ua_period_progress_title">Хід роботи · <t t-esc="data.done"/> з <t t-esc="data.total"/></h5>
        <div class="o_ua_period_steps">
          <t t-foreach="data.steps" t-as="step" t-key="step.key">
            <div t-attf-class="o_ua_period_step o_ua_state_#{step.state}" t-on-click="() => this.toggle(step)">
              <span class="o_ua_period_mark" t-esc="step.state === 'done' ? '✓' : (step.state === 'warn' ? '!' : '·')"/>
              <span class="o_ua_period_title" t-esc="step.title"/>
              <span class="o_ua_period_fact" t-esc="step.fact"/>
              <span class="o_ua_period_open">
                <button class="btn btn-sm btn-link p-0" t-att-disabled="state.busy"
                        t-on-click.stop="() => this.open(step)">
                  <t t-esc="step.button or 'Відкрити'"/>
                </button>
              </span>
            </div>
            <div t-if="this.isOpen(step) and step.details.length" class="o_ua_period_details">
              <div t-foreach="step.details" t-as="row" t-key="row.model + '-' + row.id"
                   class="o_ua_period_detail" t-on-click="() => this.openRecord(row)">
                <span t-esc="row.title"/>
                <span class="text-muted" t-esc="row.note"/>
              </div>
            </div>
          </t>
        </div>

        <div class="o_ua_period_section" t-if="data.turnover.length">
          <h5>Обороти за період</h5>
          <table class="table table-sm o_ua_period_table">
            <thead><tr><th>Рахунок</th><th></th><th class="text-end">Дебет</th><th class="text-end">Кредит</th><th class="text-end">Сальдо Дт</th><th class="text-end">Сальдо Кт</th></tr></thead>
            <tbody>
              <tr t-foreach="data.turnover" t-as="row" t-key="row.code">
                <td t-esc="row.code"/>
                <td t-esc="row.name"/>
                <td class="text-end" t-esc="row.debit"/>
                <td class="text-end" t-esc="row.credit"/>
                <td class="text-end" t-esc="row.saldo_debit"/>
                <td class="text-end" t-esc="row.saldo_credit"/>
              </tr>
            </tbody>
          </table>
        </div>

        <div class="o_ua_period_close">
          <t t-if="data.close.state === 'closed'">
            <span class="o_ua_period_locked">Місяць закрито <t t-esc="data.close.closed_date"/><t t-if="data.close.closed_by"> · <t t-esc="data.close.closed_by"/></t><t t-if="data.close.hard"> · остаточно</t></span>
            <button class="btn btn-sm btn-secondary" t-if="!data.close.hard"
                    t-att-disabled="state.busy" t-on-click="() => this.openClose()">Відкрити знову</button>
          </t>
          <t t-else="">
            <span t-if="data.blockers.length" class="o_ua_period_blockers">
              Закрити місяць не можна: <t t-esc="data.blockers.join('; ')"/>.
            </span>
            <span t-else="" class="o_ua_period_blockers ok">Усі умови закриття виконані.</span>
            <button class="btn btn-sm btn-secondary" t-if="data.new_changes"
                    t-att-disabled="state.busy" t-on-click="() => this.acceptAll()">
              Прийняти всі зміни (<t t-esc="data.new_changes"/>)
            </button>
            <button class="btn btn-sm btn-primary" t-att-disabled="state.busy or data.blockers.length"
                    t-on-click="() => this.closeMonth()">Закрити місяць</button>
          </t>
        </div>

        <div class="o_ua_period_close" t-if="data.quarter.label">
          <span class="o_ua_period_blockers">
            <t t-if="data.quarter.closed"><t t-esc="data.quarter.label"/> закрито: податкова дата блокування стоїть.</t>
            <t t-elif="data.quarter.blockers.length"><t t-esc="data.quarter.label"/> закрити не можна: <t t-esc="data.quarter.blockers.join('; ')"/>.</t>
            <t t-else=""><t t-esc="data.quarter.label"/> готовий до закриття.</t>
          </span>
          <button class="btn btn-sm btn-secondary" t-if="!data.quarter.closed"
                  t-att-disabled="state.busy or data.quarter.blockers.length"
                  t-on-click="() => this.closeQuarter()">Закрити квартал</button>
        </div>

        <div class="o_ua_period_close" t-if="data.year_close.label">
          <span class="o_ua_period_blockers">
            <t t-if="data.year_close.closed"><t t-esc="data.year_close.label"/> закрито остаточно.</t>
            <t t-elif="data.year_close.blockers.length"><t t-esc="data.year_close.label"/> закрити не можна: <t t-esc="data.year_close.blockers.join('; ')"/>.</t>
            <t t-else=""><t t-esc="data.year_close.label"/> готовий до остаточного закриття.</t>
          </span>
          <button class="btn btn-sm btn-secondary" t-if="!data.year_close.closed"
                  t-att-disabled="state.busy or data.year_close.blockers.length"
                  t-on-click="() => this.closeYear()">Закрити рік остаточно</button>
        </div>
      </t>
    </div>
  </t>
</templates>
