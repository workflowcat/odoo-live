<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
  <t t-name="l10n_ua_period.Period" owl="1">
    <div t-attf-class="o_ua_period #{state.person ? 'o_ua_period_with_panel' : ''}">
      <t t-if="state.loading">
        <div class="text-muted p-4">Завантаження…</div>
      </t>
      <t t-elif="state.data">
        <t t-set="data" t-value="state.data"/>

        <!-- шапка: місяць, стан одним рядком, наступний крок -->
        <div class="o_ua_pd_head">
          <div class="o_ua_pd_title">
            <h4 t-esc="data.period.label"/>
            <span t-attf-class="o_ua_pd_state o_ua_tone_#{data.headline.tone}" t-esc="data.headline.title"/>
          </div>
          <div class="o_ua_months">
            <span t-foreach="data.periods" t-as="p" t-key="p.label"
                  t-attf-class="o_ua_month #{p.year === data.period.year and p.month === data.period.month ? 'active' : ''}"
                  t-on-click="() => this.selectPeriod(p)" t-esc="p.label"/>
          </div>
          <button t-if="data.headline.label and data.headline.action !== 'exceptions'" class="btn btn-sm btn-primary"
                  t-att-disabled="state.busy" t-on-click="() => this.runHeadline()" t-esc="data.headline.label"/>
        </div>

        <!-- смуга строків -->
        <div class="o_ua_pd_strip" t-if="data.deadlines.length">
          <div t-foreach="data.deadlines" t-as="d" t-key="d.date"
               t-attf-class="o_ua_pd_mark o_ua_pd_mark_#{d.state} #{d.past ? 'past' : ''}">
            <b t-esc="d.date.slice(0, 5)"/>
            <span t-esc="d.label"/>
          </div>
        </div>

        <div class="o_ua_pd_body">
          <!-- ліворуч: числа і кроки -->
          <div class="o_ua_pd_left">
            <div class="o_ua_pd_nums">
              <div class="o_ua_clickable" t-on-click="() => this.openEstimate('gross')">
                <span class="o_ua_num" t-esc="data.estimate.gross"/><span class="o_ua_lbl">нараховано</span></div>
              <div class="o_ua_clickable" t-on-click="() => this.openEstimate('net')">
                <span class="o_ua_num" t-esc="data.estimate.net"/><span class="o_ua_lbl">до виплати</span></div>
              <div class="o_ua_clickable" t-on-click="() => this.openEstimate('esv')">
                <span class="o_ua_num o_ua_num_sm" t-esc="data.estimate.employer"/><span class="o_ua_lbl">ЄСВ підприємства</span></div>
            </div>
            <div class="o_ua_pd_steps_title">Кроки · <t t-esc="data.done"/> з <t t-esc="data.total"/></div>
            <div t-foreach="data.steps" t-as="step" t-key="step.key"
                 t-attf-class="o_ua_pd_step #{this.selectedKey === step.key ? 'active' : ''}"
                 t-on-click="() => this.selectStep(step)">
              <span t-attf-class="o_ua_dot o_ua_dot_#{step.state}"/>
              <span class="o_ua_pd_step_name" t-att-title="step.title" t-esc="step.title"/>
              <span class="o_ua_pd_step_docs" t-if="this.docsFor(step).length">
                <t t-foreach="this.docsFor(step)" t-as="doc" t-key="doc_index">
                  <t t-esc="doc.kind === 'filing' ? '↗' : (doc.kind === 'file' ? '⇩' : '▤')"/>
                </t>
              </span>
            </div>
          </div>

          <!-- у центрі: вибраний крок -->
          <div class="o_ua_pd_main" t-if="this.selectedStep">
            <t t-set="step" t-value="this.selectedStep"/>
            <div class="o_ua_pd_main_head">
              <div>
                <h5 class="o_ua_pd_main_title" t-esc="step.title"/>
                <div class="o_ua_lbl" t-esc="step.fact"/>
              </div>
              <button class="btn btn-sm btn-secondary" t-att-disabled="state.busy" t-on-click="() => this.open(step)">
                <t t-esc="step.button or 'Відкрити перелік'"/>
              </button>
            </div>

            <div class="o_ua_pd_docs" t-if="this.docsFor(step).length">
              <div t-foreach="this.docsFor(step)" t-as="doc" t-key="doc_index"
                   t-attf-class="o_ua_pd_doc o_ua_pd_doc_#{doc.kind} #{this.isPreviewed(doc) ? 'active' : ''}">
                <span class="o_ua_pd_doc_icon" t-esc="doc.kind === 'filing' ? '↗' : (doc.kind === 'file' ? '⇩' : '▤')"/>
                <span class="o_ua_pd_doc_name" t-esc="doc.name"/>
                <span t-if="doc.deadline" class="o_ua_lbl">до <t t-esc="doc.deadline"/></span>
                <span t-if="doc.state" t-attf-class="o_ua_pill #{doc.state === 'створено' or doc.state === 'подано' ? 'o_ua_pill_ok' : (doc.state === 'немає' ? '' : 'o_ua_pill_warn')}" t-esc="doc.state"/>
                <span class="o_ua_pd_doc_acts">
                  <button t-if="doc.report" class="btn btn-sm btn-link p-0" t-on-click="() => this.previewDoc(doc)">Переглянути</button>
                  <button t-if="doc.report" class="btn btn-sm btn-link p-0" t-att-disabled="this.inBasket(doc)"
                          t-on-click="() => this.addToBasket(doc)" t-esc="this.inBasket(doc) ? 'у кошику' : 'До кошика'"/>
                  <button t-if="doc.target and (doc.target.model or doc.target.xmlid)" class="btn btn-sm btn-link p-0"
                          t-on-click="() => this.openDocTarget(doc)" t-esc="doc.kind === 'print' ? 'Правити дані' : 'Відкрити'"/>
                </span>
              </div>
            </div>

            <!-- перегляд документа: папір, друк браузером -->
            <div class="o_ua_pd_preview" t-if="state.preview">
              <div class="o_ua_pd_preview_bar">
                <b t-esc="state.preview.name"/>
                <span class="flex-grow-1"/>
                <button class="btn btn-sm btn-primary" t-on-click="() => this.printPreview()">Друк</button>
                <button class="btn btn-sm btn-secondary" t-on-click="() => this.addToBasket(state.preview)"
                        t-att-disabled="this.inBasket(state.preview)" t-esc="this.inBasket(state.preview) ? 'у кошику' : 'До кошика'"/>
                <button class="btn btn-sm btn-link" t-on-click="() => this.closePreview()">Закрити перегляд</button>
              </div>
              <iframe class="o_ua_pd_frame" t-att-src="state.preview.url" t-ref="previewFrame" title="Перегляд документа"/>
            </div>

            <t t-else="">
              <!-- записи кроку -->
              <div class="o_ua_wide" t-if="step.key === 'payslips' and state.people.length">
                <table class="o_ua_table">
                  <thead>
                    <tr>
                      <th>Працівник</th><th>Підрозділ</th><th class="text-end">Дні</th>
                      <th class="text-end">Нараховано</th><th class="text-end">До виплати</th>
                      <th class="text-end">ЄСВ</th><th>Листок</th><th>Виплата</th>
                    </tr>
                  </thead>
                  <tbody>
                    <tr t-foreach="state.people" t-as="row" t-key="row.employee_id"
                        t-attf-class="o_ua_clickable #{state.person and state.person.employee_id === row.employee_id ? 'active' : ''}"
                        t-on-click="() => this.openPerson(row)">
                      <td>
                        <t t-esc="row.name"/>
                        <span t-if="row.flags.length" class="o_ua_person_flag" t-esc="row.flags.join(' · ')"/>
                      </td>
                      <td class="text-muted" t-esc="row.department"/>
                      <td class="text-end" t-esc="row.days"/>
                      <td class="text-end" t-esc="row.gross"/>
                      <td class="text-end" t-esc="row.net"/>
                      <td class="text-end" t-esc="row.esv"/>
                      <td><span t-attf-class="o_ua_pill #{row.done ? 'o_ua_pill_ok' : 'o_ua_pill_warn'}" t-esc="row.state"/></td>
                      <td><span t-if="row.payment" t-attf-class="o_ua_pill #{row.paid ? 'o_ua_pill_ok' : 'o_ua_pill_warn'}"
                                t-esc="row.paid ? 'оплачено' : 'у відомості'"/></td>
                    </tr>
                  </tbody>
                </table>
              </div>
              <table class="o_ua_table" t-elif="step.details.length">
                <tbody>
                  <tr t-foreach="step.details" t-as="row" t-key="row.model + '-' + row.id"
                      class="o_ua_clickable" t-on-click="() => this.openRecord(row)">
                    <td t-esc="row.title"/>
                    <td class="text-muted" t-esc="row.note"/>
                    <td class="text-end text-muted">›</td>
                  </tr>
                </tbody>
              </table>
              <div t-else="" class="o_ua_lbl o_ua_pd_empty">Записів немає.</div>
            </t>
          </div>

          <!-- праворуч: кошик друку, увага, зміни -->
          <div class="o_ua_pd_side">
            <div class="o_ua_pd_side_block">
              <div class="o_ua_pd_side_title">Кошик друку · <t t-esc="state.basket.length"/></div>
              <div t-if="!state.basket.length" class="o_ua_lbl">Порожньо.</div>
              <div t-foreach="state.basket" t-as="item" t-key="item.r + '-' + item.ids.join(',')" class="o_ua_pd_basket_row">
                <span class="o_ua_pd_basket_name" t-esc="item.t"/>
                <button class="o_ua_pd_icon" t-att-disabled="item_index === 0" t-on-click="() => this.moveBasket(item_index, -1)" aria-label="Вище">↑</button>
                <button class="o_ua_pd_icon" t-att-disabled="item_index === state.basket.length - 1" t-on-click="() => this.moveBasket(item_index, 1)" aria-label="Нижче">↓</button>
                <button class="o_ua_pd_icon" t-on-click="() => this.removeFromBasket(item_index)" aria-label="Прибрати">×</button>
              </div>
              <div class="o_ua_pd_basket_acts" t-if="state.basket.length">
                <button class="btn btn-sm btn-secondary" t-on-click="() => this.openBundle()">Переглянути пакет</button>
                <button class="btn btn-sm btn-link" t-on-click="() => this.clearBasket()">Очистити</button>
              </div>
            </div>

            <div class="o_ua_pd_side_block" t-if="data.exceptions.length">
              <div class="o_ua_pd_side_title">Увага · <t t-esc="data.exceptions.length"/></div>
              <div t-foreach="data.exceptions" t-as="row" t-key="row.key + '-' + row.title"
                   class="o_ua_pd_attn o_ua_clickable" t-on-click="() => this.openException(row)">
                <span t-attf-class="o_ua_dot o_ua_dot_#{row.level === 'danger' ? 'crit' : 'warn'}"/>
                <span><t t-esc="row.title"/><span class="o_ua_lbl" t-esc="row.detail"/></span>
              </div>
            </div>

            <div class="o_ua_pd_side_block" t-if="data.changes.length">
              <div class="o_ua_pd_side_title">Зміни місяця</div>
              <div class="o_ua_period_changes">
                <span t-foreach="data.changes" t-as="row" t-key="row.label" class="o_ua_period_chip"
                      t-on-click="() => this.openChange(row)">
                  <t t-esc="row.count"/> <t t-esc="row.label"/>
                </span>
              </div>
            </div>
          </div>
        </div>

        <div class="o_ua_period_close">
          <t t-if="data.close.state === 'closed'">
            <span class="o_ua_period_locked">Місяць закрито <t t-esc="data.close.closed_date"/><t t-if="data.close.closed_by"> · <t t-esc="data.close.closed_by"/></t><t t-if="data.close.hard"> · остаточно</t></span>
            <button class="btn btn-sm btn-secondary" t-if="!data.close.hard"
                    t-att-disabled="state.busy" t-on-click="() => this.openClose()">Відкрити знову</button>
          </t>
          <t t-else="">
            <span t-if="data.blockers.length" class="o_ua_period_blockers">
              Закрити місяць не можна: <t t-esc="data.blockers.join('; ')"/>.
            </span>
            <span t-else="" class="o_ua_period_blockers ok">Усі умови закриття виконані.</span>
            <button class="btn btn-sm btn-secondary" t-if="data.new_changes"
                    t-att-disabled="state.busy" t-on-click="() => this.acceptAll()">
              Прийняти всі зміни (<t t-esc="data.new_changes"/>)
            </button>
            <button class="btn btn-sm btn-secondary" t-att-disabled="state.busy or data.blockers.length"
                    t-on-click="() => this.closeMonth()">Закрити місяць</button>
          </t>
        </div>

        <div class="o_ua_period_close" t-if="data.quarter.label">
          <span class="o_ua_period_blockers">
            <t t-if="data.quarter.closed"><t t-esc="data.quarter.label"/> закрито: податкова дата блокування стоїть.</t>
            <t t-elif="data.quarter.blockers.length"><t t-esc="data.quarter.label"/> закрити не можна: <t t-esc="data.quarter.blockers.join('; ')"/>.</t>
            <t t-else=""><t t-esc="data.quarter.label"/> готовий до закриття.</t>
          </span>
          <button class="btn btn-sm btn-secondary" t-if="!data.quarter.closed"
                  t-att-disabled="state.busy or data.quarter.blockers.length"
                  t-on-click="() => this.closeQuarter()">Закрити квартал</button>
        </div>

        <div class="o_ua_period_close" t-if="data.year_close.label">
          <span class="o_ua_period_blockers">
            <t t-if="data.year_close.closed"><t t-esc="data.year_close.label"/> закрито остаточно.</t>
            <t t-elif="data.year_close.blockers.length"><t t-esc="data.year_close.label"/> закрити не можна: <t t-esc="data.year_close.blockers.join('; ')"/>.</t>
            <t t-else=""><t t-esc="data.year_close.label"/> готовий до остаточного закриття.</t>
          </span>
          <button class="btn btn-sm btn-secondary" t-if="!data.year_close.closed"
                  t-att-disabled="state.busy or data.year_close.blockers.length"
                  t-on-click="() => this.closeYear()">Закрити рік остаточно</button>
        </div>
        <div class="o_ua_person_panel" t-if="state.person">
          <div class="o_ua_person_panel_head">
            <div>
              <div class="o_ua_person_panel_name" t-esc="state.person.name"/>
              <div class="text-muted small">
                <t t-esc="state.person.job"/><t t-if="state.person.department"> · <t t-esc="state.person.department"/></t>
              </div>
            </div>
            <button class="btn btn-sm btn-link" t-on-click="() => this.closePerson()">Закрити</button>
          </div>

          <div class="o_ua_person_panel_body">
            <div class="o_ua_person_panel_state">Листок: <t t-esc="state.person.state"/></div>
            <table class="o_ua_table">
              <tbody>
                <tr t-foreach="state.person.lines" t-as="line" t-key="line.code">
                  <td t-esc="line.name"/>
                  <td class="text-end" t-esc="line.amount"/>
                </tr>
              </tbody>
            </table>

            <div t-if="state.person.events.length">
              <h6>Події місяця</h6>
              <div t-foreach="state.person.events" t-as="event" t-key="event.model + '-' + event.id"
                   class="o_ua_period_detail" t-on-click="() => this.openRecord({model: event.model, id: event.id})">
                <span t-esc="event.title"/>
                <span class="text-muted" t-esc="event.detail"/>
              </div>
            </div>

            <div t-if="state.person.payment.batch" class="o_ua_person_panel_state">
              Виплата: <t t-esc="state.person.payment.amount"/> ·
              <t t-esc="state.person.payment.paid ? 'оплачено' : 'у відомості'"/>
            </div>
          </div>

          <div class="o_ua_person_panel_foot">
            <button class="btn btn-sm btn-secondary" t-if="state.person.slip_id"
                    t-on-click="() => this.openPersonRecord(state.person.slip_id)">Відкрити листок</button>
            <button class="btn btn-sm btn-secondary" t-on-click="() => this.openPersonRecord(false)">Картка працівника</button>
          </div>
        </div>
      </t>
    </div>
  </t>
</templates>
