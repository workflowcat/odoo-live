<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="view_partner_form_ua_edr" model="ir.ui.view">
    <field name="name">res.partner.form.ua.edr</field><field name="model">res.partner</field>
    <field name="inherit_id" ref="base.view_partner_form"/>
    <field name="arch" type="xml">
      <xpath expr="//sheet" position="before">
        <header><button name="action_fill_from_edr" type="object" string="Заповнити з ЄДР" class="btn-primary" invisible="not company_registry and not vat"/></header>
      </xpath>
      <xpath expr="//field[@name='vat']" position="after">
        <field name="ua_short_name" invisible="not is_company"/>
        <field name="ua_internal_name"/>
      </xpath>
      <notebook position="inside">
        <page string="ЄДР" name="ua_edr">
          <group>
            <group><field name="company_registry" string="ЄДРПОУ / РНОКПП"/><field name="ua_edr_kind"/><field name="ua_edr_full_name"/><field name="ua_edr_status"/><field name="ua_edr_registration_date"/></group>
            <group><field name="ua_kved"/><field name="ua_edr_head"/><field name="ua_edr_capital"/><field name="ua_vat_status"/><field name="ua_edr_synced_at"/></group>
          </group>
          <field name="ua_edr_checks"/>
        </page>
      </notebook>
    </field>
  </record>
  <!-- Новий контрагент з ЄДР - кнопка в шапці списку контактів: меню відкриває
       сторінку, а разовий діалог належить кнопці. -->
  <record id="view_partner_tree_ua_edr" model="ir.ui.view">
    <field name="name">res.partner.list.ua.edr</field>
    <field name="model">res.partner</field>
    <field name="inherit_id" ref="base.view_partner_tree"/>
    <field name="arch" type="xml">
      <list position="inside">
        <field name="ua_internal_name" optional="show"/>
        <header>
          <button name="action_ua_new_from_edr" type="object" display="always"
                  string="Контрагент з ЄДР" class="btn-primary"/>
        </header>
      </list>
    </field>
  </record>

  <record id="view_partner_search_ua_names" model="ir.ui.view">
    <field name="name">res.partner.search.ua.names</field><field name="model">res.partner</field>
    <field name="inherit_id" ref="base.view_res_partner_filter"/>
    <field name="arch" type="xml">
      <field name="name" position="after">
        <field name="ua_internal_name"/>
        <field name="ua_short_name"/>
      </field>
    </field>
  </record>

  <record id="action_partner_fill_edr" model="ir.actions.server">
    <field name="name">Заповнити з ЄДР</field><field name="model_id" ref="base.model_res_partner"/><field name="binding_model_id" ref="base.model_res_partner"/>
    <field name="binding_view_types">list,form</field><field name="state">code</field><field name="code">records.action_fill_from_edr()</field>
  </record>
</odoo>
