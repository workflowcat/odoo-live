<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="view_ua_employee_import_form" model="ir.ui.view">
    <field name="name">ua.employee.import.form</field>
    <field name="model">ua.employee.import</field>
    <field name="arch" type="xml">
      <form string="Імпорт працівників">
        <group invisible="state == 'done'">
          <field name="state" invisible="1"/>
          <field name="file" filename="filename" required="1"/>
          <field name="filename" invisible="1"/>
          <field name="dry_run"/>
        </group>
        <div class="text-muted" invisible="state == 'done'">
          Файл Excel або CSV. Аркуш «Працівники» - одна людина в рядку, аркуш «Заробіток» -
          РНОКПП, місяць і сума за 12 місяців для середньої. Працівник шукається за РНОКПП:
          наявну картку оновлюємо, нову створюємо.
        </div>
        <group invisible="state != 'done'">
          <field name="log" nolabel="1" readonly="1" widget="text"/>
        </group>
        <footer>
          <button name="action_import" type="object" string="Перевірити" class="btn-primary"
                  invisible="state == 'done' or not dry_run"/>
          <button name="action_import" type="object" string="Імпортувати" class="btn-primary"
                  invisible="state == 'done' or dry_run"/>
          <button name="action_template" type="object" string="Шаблон файлу" class="btn-secondary"
                  invisible="state == 'done'"/>
          <button special="cancel" string="Закрити" class="btn-secondary"/>
        </footer>
      </form>
    </field>
  </record>

  <record id="action_ua_employee_import" model="ir.actions.act_window">
    <field name="name">Імпорт працівників</field>
    <field name="res_model">ua.employee.import</field>
    <field name="view_mode">form</field>
    <field name="target">new</field>
  </record>

  <menuitem id="menu_ua_employee_import" name="Імпорт працівників"
            parent="payroll.payroll_menu_configuration" action="action_ua_employee_import"
            sequence="3" groups="hr.group_hr_user"/>
</odoo>
