<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <record id="product_template_form_view_ua_drawing" model="ir.ui.view">
    <field name="name">product.template.form.ua.drawing</field>
    <field name="model">product.template</field>
    <field name="inherit_id" ref="product.product_template_form_view"/>
    <field name="arch" type="xml">
      <xpath expr="//notebook" position="inside">
        <page string="Креслення" name="ua_drawing">
          <group>
            <field name="ua_drawing_svg" filename="ua_drawing_name"
                   string="Складальне креслення (SVG)"/>
            <field name="ua_drawing_name" invisible="1"/>
          </group>
          <p class="text-muted">
            Елемент позиції у файлі має id «bom-N», де N - порядковий номер рядка
            специфікації.
          </p>
        </page>
      </xpath>
    </field>
  </record>

</odoo>
