<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <!-- Відповіді на перевірку наряду однієї компанії не видно з іншої. -->
  <record id="rule_ua_workorder_check_company" model="ir.rule">
    <field name="name">Відповіді на перевірку наряду: лише свої компанії</field>
    <field name="model_id" ref="model_ua_workorder_check"/>
    <field name="domain_force">[('company_id', 'in', company_ids)]</field>
  </record>
</odoo>
