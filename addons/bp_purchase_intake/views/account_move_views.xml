<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_bp_intake" model="ir.ui.view">
        <field name="name">account.move.form.bp.intake</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="after">
                <div class="alert alert-warning mb-0" role="alert" invisible="not bp_supplier_unverified">
                    Постачальник не перевірений. Проведення заблоковано.
                </div>
            </xpath>
            <xpath expr="//field[@name='ref']" position="after">
                <field name="bp_intake_id" invisible="not bp_intake_id"/>
            </xpath>
        </field>
    </record>
</odoo>
