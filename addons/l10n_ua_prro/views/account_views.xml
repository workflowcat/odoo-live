<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="view_account_journal_form_ua_prro" model="ir.ui.view">
    <field name="name">account.journal.form.ua.prro</field>
    <field name="model">account.journal</field>
    <field name="inherit_id" ref="account.view_account_journal_form"/>
    <field name="arch" type="xml">
      <field name="code" position="after">
        <field name="ua_prro_register_id" invisible="type not in ('cash', 'bank')"/>
        <field name="ua_prro_payment_type" invisible="not ua_prro_register_id"/>
      </field>
    </field>
  </record>

  <record id="view_tax_form_ua_prro" model="ir.ui.view">
    <field name="name">account.tax.form.ua.prro</field>
    <field name="model">account.tax</field>
    <field name="inherit_id" ref="account.view_tax_form"/>
    <field name="arch" type="xml">
      <field name="type_tax_use" position="after">
        <field name="ua_prro_letter" invisible="type_tax_use != 'sale'"/>
      </field>
    </field>
  </record>

  <record id="view_move_form_ua_prro" model="ir.ui.view">
    <field name="name">account.move.form.ua.prro</field>
    <field name="model">account.move</field>
    <field name="inherit_id" ref="account.view_move_form"/>
    <field name="arch" type="xml">
      <div name="button_box" position="inside">
        <button name="action_ua_prro_receipts" type="object" class="oe_stat_button"
                icon="fa-ticket" invisible="not ua_prro_receipt_count">
          <field name="ua_prro_receipt_count" widget="statinfo" string="Фіскальні чеки"/>
        </button>
      </div>
    </field>
  </record>
</odoo>
