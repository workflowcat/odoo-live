<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <data noupdate="1">
    <record id="seq_ua_eco" model="ir.sequence">
      <field name="name">Повідомлення про зміну</field>
      <field name="code">ua.eco</field>
      <field name="prefix">ПЗ/%(range_year)s/</field>
      <field name="padding">4</field>
      <field name="use_date_range">True</field>
      <field name="implementation">no_gap</field>
      <field name="company_id" eval="False"/>
    </record>
  </data>
  <record id="cron_ua_eco_apply" model="ir.cron">
    <field name="name">Конструкторські зміни: застосувати погоджені з настанням дати</field>
    <field name="model_id" ref="model_ua_eco"/>
    <field name="state">code</field>
    <field name="code">model._cron_apply_due()</field>
    <field name="interval_number">1</field>
    <field name="interval_type">hours</field>
    <field name="active">True</field>
  </record>
</odoo>
