<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <!-- Правила компанії: записи однієї компанії не видно з іншої. Той самий домен,
       що в нативних документах Odoo; рядок бере компанію в документа, на якому висить,
       а довідник із порожньою компанією спільний для всіх. -->
  <record id="rule_ua_employee_child_company" model="ir.rule">
    <field name="name">Дитина працівника: лише свої компанії</field>
    <field name="model_id" ref="model_ua_employee_child"/>
    <field name="domain_force">['|', ('employee_id.company_id', '=', False), ('employee_id.company_id', 'in', company_ids)]</field>
  </record>

  <record id="rule_ua_employee_document_company" model="ir.rule">
    <field name="name">Документ працівника: лише свої компанії</field>
    <field name="model_id" ref="model_ua_employee_document"/>
    <field name="domain_force">['|', ('employee_id.company_id', '=', False), ('employee_id.company_id', 'in', company_ids)]</field>
  </record>

  <record id="rule_ua_employee_prior_job_company" model="ir.rule">
    <field name="name">Попереднє місце роботи: лише свої компанії</field>
    <field name="model_id" ref="model_ua_employee_prior_job"/>
    <field name="domain_force">['|', ('employee_id.company_id', '=', False), ('employee_id.company_id', 'in', company_ids)]</field>
  </record>
</odoo>
