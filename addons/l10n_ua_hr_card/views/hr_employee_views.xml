<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <!-- Ці дві дії - лише домен/контекст на active_id (звичний прийом кнопки з форми, напр.
       quotient-кнопки в ядрі: act_window обчислює domain/context у контексті виклику, а той
       містить active_id) - визначені РАНІШЕ форми нижче, бо кнопки форми посилаються на них
       через %(xmlid)d, а це підставляється в порядку файлу, не за списком data в маніфесті.
       Пакет документів і друк наказу лишаються поза цим файлом - обидва живуть у моделях
       l10n_ua_hr_orders, який залежить від l10n_ua_hr_card, а не навпаки. -->
  <record id="action_ua_earnings_history_employee" model="ir.actions.act_window">
    <field name="name">Історія заробітку</field>
    <field name="res_model">ua.earnings.history</field>
    <field name="view_mode">list</field>
    <field name="domain">[('employee_id', '=', active_id)]</field>
    <field name="context">{'default_employee_id': active_id}</field>
  </record>

  <record id="action_ua_new_leave_employee" model="ir.actions.act_window">
    <field name="name">Відпустка</field>
    <field name="res_model">hr.leave</field>
    <field name="view_mode">form</field>
    <field name="target">new</field>
    <field name="context">{'default_employee_id': active_id}</field>
  </record>

  <!-- Пріоритет вищий за стандартний (16), щоб застосуватись після інших українських модулів,
       які теж наслідують hr.view_employee_form: поля, що переносяться (position="move"),
       мають уже існувати у зведеному дереві вигляду.
       Примітка: position="move" працює лише коли перенесене поле - прямий нащадок вузла-специфікації
       (position="inside"/"after"/"before"), тому кожна група спершу створюється порожньою (крок 1),
       а тоді наповнюється окремим xpath position="inside" (крок 2). -->
  <record id="view_employee_form_ua_card" model="ir.ui.view">
    <field name="name">hr.employee.form.ua.card</field>
    <field name="model">hr.employee</field>
    <field name="inherit_id" ref="hr.view_employee_form"/>
    <field name="priority">20</field>
    <field name="arch" type="xml">
      <data>

        <!-- ==================== Крок 1: нові сторінки і порожні групи ==================== -->
        <xpath expr="//page[@name='work_information']" position="after">
          <page name="ua_card" string="Особова картка" groups="hr.group_hr_user">
            <button name="%(l10n_ua_hr_card.action_report_ua_p2)d" type="action" string="Друк" class="btn btn-secondary mb-2"/>
            <group name="ua_card_groups">
              <group string="Ідентифікація" name="ua_card_grp_ident"/>
              <group string="Документ, що посвідчує особу" name="ua_card_grp_iddoc"/>
              <group string="Адреси і контакти" name="ua_card_grp_addr"/>
              <group string="Сім'я" name="ua_card_grp_family"/>
              <group string="Освіта" name="ua_card_grp_edu"/>
              <group string="Пільги і особливий статус" name="ua_card_grp_benefits"/>
              <group string="Трудова книжка і стаж" name="ua_card_grp_labor"/>
            </group>
          </page>
        </xpath>

        <xpath expr="//page[@name='ua_card']" position="after">
          <page name="ua_docs" string="Документи" groups="hr.group_hr_user">
            <field name="ua_document_ids">
              <list editable="bottom" decoration-warning="state == 'to_sign'" decoration-success="state == 'signed'">
                <field name="type"/>
                <field name="name"/>
                <field name="number"/>
                <field name="date" options="{'numeric': True}"/>
                <field name="valid_until"/>
                <field name="state" widget="badge" decoration-warning="state == 'to_sign'" decoration-success="state == 'signed'" decoration-muted="state == 'not_needed'"/>
                <field name="signed_date" options="{'numeric': True}"/>
                <field name="file" filename="filename"/>
                <field name="filename" column_invisible="1"/>
                <field name="note"/>
                <button name="action_mark_signed" type="object" string="Підписано" icon="fa-check"
                        invisible="state != 'to_sign'"/>
                <button name="action_print" type="object" string="Друк" icon="fa-print"
                        invisible="not report_xmlid or not res_id"/>
              </list>
            </field>
          </page>
        </xpath>

        <!-- Документи прострочені - те саме червоне попередження, що показувала картка. -->
        <xpath expr="//page[@name='ua_docs']//field[@name='ua_document_ids']/list" position="attributes">
          <attribute name="decoration-danger">ua_doc_state == 'expired'</attribute>
        </xpath>
        <xpath expr="//page[@name='ua_docs']//field[@name='ua_document_ids']/list/field[@name='valid_until']" position="after">
          <field name="ua_doc_state" column_invisible="1"/>
        </xpath>

        <xpath expr="//page[@name='ua_docs']" position="after">
          <page name="ua_vacation" string="Відпустки" groups="hr.group_hr_user">
            <button name="%(l10n_ua_hr_card.action_ua_new_leave_employee)d" type="action"
                    string="Оформити відпустку" class="btn btn-secondary mb-2"/>
            <group name="ua_vacation_groups"/>
          </page>
        </xpath>

        <!-- ==================== Крок 2: наповнення груп (перенесені поля position="move" + нові) ==================== -->
        <xpath expr="//group[@name='ua_card_grp_ident']" position="inside">
          <field name="ua_last_name" position="move"/>
          <field name="ua_first_name" position="move"/>
          <field name="ua_middle_name" position="move"/>
          <field name="ua_rnokpp" position="move"/>
          <field name="sex" position="move"/>
          <field name="birthday" position="move"/>
          <field name="place_of_birth" position="move"/>
          <field name="country_of_birth" position="move"/>
          <field name="country_id" position="move"/>
          <field name="ua_previous_employee_id"/>
        </xpath>

        <xpath expr="//group[@name='ua_card_grp_iddoc']" position="inside">
          <field name="ua_id_doc_type"/>
          <field name="ua_id_doc_series"/>
          <field name="ua_id_doc_number"/>
          <field name="ua_id_doc_issued_by"/>
          <field name="ua_id_doc_date"/>
          <field name="ua_id_doc_unzr"/>
          <field name="passport_id" position="move"/>
        </xpath>

        <xpath expr="//group[@name='ua_card_grp_addr']" position="inside">
          <field name="private_street" position="move"/>
          <field name="private_street2" position="move"/>
          <field name="private_city" position="move"/>
          <field name="private_state_id" position="move"/>
          <field name="private_zip" position="move"/>
          <field name="private_country_id" position="move"/>
          <field name="ua_actual_address"/>
          <field name="private_phone" position="move"/>
          <field name="private_email" position="move"/>
          <field name="emergency_contact" position="move"/>
          <field name="emergency_phone" position="move"/>
        </xpath>

        <xpath expr="//group[@name='ua_card_grp_family']" position="inside">
          <field name="marital" position="move"/>
          <field name="spouse_complete_name" position="move"/>
          <field name="spouse_birthdate" position="move"/>
          <field name="ua_child_ids" colspan="2">
            <list editable="bottom">
              <field name="name"/>
              <field name="birthday" options="{'numeric': True}"/>
              <field name="note"/>
            </list>
          </field>
        </xpath>

        <xpath expr="//group[@name='ua_card_grp_edu']" position="inside">
          <field name="certificate" position="move"/>
          <field name="study_field" position="move"/>
          <field name="study_school"/>
          <field name="ua_education_year"/>
          <field name="ua_diploma_number"/>
          <field name="ua_science_degree"/>
          <field name="ua_languages"/>
        </xpath>

        <xpath expr="//group[@name='ua_card_grp_benefits']" position="inside">
          <field name="ua_disability_group" position="move"/>
          <field name="ua_chernobyl_category"/>
          <field name="ua_veteran"/>
          <field name="ua_large_family"/>
          <field name="ua_single_parent"/>
        </xpath>

        <xpath expr="//group[@name='ua_card_grp_labor']" position="inside">
          <field name="ua_labor_book_number"/>
          <field name="ua_labor_book_date"/>
          <field name="ua_electronic_labor_book"/>
          <field name="ua_insurance_years" position="move"/>
          <field name="ua_prior_job_ids" colspan="2">
            <list editable="bottom">
              <field name="company_name"/>
              <field name="job_title"/>
              <field name="date_from" options="{'numeric': True}"/>
              <field name="date_to" options="{'numeric': True}"/>
              <field name="note"/>
            </list>
          </field>
        </xpath>

        <!-- ==================== button_box: зведені показники огляду ====================
             «Документи» перевикористовує вже наявну дію action_view_ua_documents, лише показує
             ua_docs_count (усього документів) замість ua_docs_expiring (лічильник самого поля
             лишився в моделі, поле ua_docs_expiring більше ніде у виді не використовується). -->
        <xpath expr="//div[@name='button_box']" position="inside">
          <button class="oe_stat_button" icon="fa-money" disabled="1" groups="hr.group_hr_user">
            <div class="o_stat_info">
              <span class="o_stat_value"><field name="ua_current_wage"/></span>
              <span class="o_stat_text">Оклад</span>
            </div>
          </button>
          <button class="oe_stat_button" icon="fa-clock-o" disabled="1" groups="hr.group_hr_user">
            <div class="o_stat_info">
              <span class="o_stat_value"><field name="ua_insurance_years"/></span>
              <span class="o_stat_text">Стаж, років</span>
            </div>
          </button>
          <button class="oe_stat_button" icon="fa-plane" disabled="1" groups="hr.group_hr_user">
            <div class="o_stat_info">
              <span class="o_stat_value"><field name="ua_vacation_balance"/></span>
              <span class="o_stat_text">Залишок відпустки</span>
            </div>
          </button>
          <button name="action_view_ua_documents" type="object" class="oe_stat_button" icon="fa-file-text-o" groups="hr.group_hr_user">
            <div class="o_stat_info">
              <span class="o_stat_value"><field name="ua_docs_count"/></span>
              <span class="o_stat_text">Документи</span>
            </div>
          </button>
          <button class="oe_stat_button" icon="fa-building-o" disabled="1" groups="hr.group_hr_user">
            <div class="o_stat_info">
              <span class="o_stat_value"><field name="ua_days_in_company"/></span>
              <span class="o_stat_text">У компанії, днів</span>
            </div>
          </button>
          <button class="oe_stat_button" icon="fa-exclamation-triangle" disabled="1" groups="hr.group_hr_user"
                  invisible="ua_overview_alert_count == 0">
            <div class="o_stat_info">
              <span class="o_stat_value"><field name="ua_overview_alert_count"/></span>
              <span class="o_stat_text">Потребує уваги</span>
            </div>
          </button>
        </xpath>

        <!-- ==================== Зарплата (колишня «Україна»): перейменувати, додати «Виплата» ==================== -->
        <xpath expr="//page[@name='ua']" position="attributes">
          <attribute name="string">Зарплата</attribute>
        </xpath>
        <xpath expr="//group[@name='ua']" position="inside">
          <group string="Виплата" name="ua_card_grp_payout"/>
        </xpath>
        <xpath expr="//group[@name='ua_card_grp_payout']" position="inside">
          <field name="has_multiple_bank_accounts" position="move"/>
          <field name="is_trusted_bank_account" position="move"/>
          <xpath expr="//page[@name='personal_information']/group/group[1]/field[@name='bank_account_ids']" position="move"/>
          <xpath expr="//page[@name='personal_information']/group/group[1]/label[@for='bank_account_ids']" position="move"/>
          <xpath expr="//page[@name='personal_information']/group/group[1]/div[1]" position="move"/>
          <xpath expr="//page[@name='personal_information']/group/group[1]/div[1]" position="move"/>
        </xpath>

        <!-- ==================== Відпустки: винести з «Зарплата» окремою вкладкою ====================
             Обидві групи вже існують у групі «ua» (Зарплата) - «Відпустка» (щорічна, з l10n_ua_payroll_rules)
             і «Додаткові відпустки» (УБД, соціальна на дітей, особливі умови праці, з l10n_ua_average);
             переносимо цілими групами, нічого не рахуємо заново. «Лікарняні» (відсоток, стаж) лишається
             в Зарплаті - це факт оплати, не залишок відпустки. -->
        <xpath expr="//group[@name='ua_vacation_groups']" position="inside">
          <xpath expr="//page[@name='ua']//group[@name='ua_leave']" position="move"/>
          <xpath expr="//page[@name='ua']//group[@name='ua_extra_leaves']" position="move"/>
        </xpath>

        <!-- ==================== Зарплата: версії контракту (ставка, сумісництво) і історія заробітку ==================== -->
        <xpath expr="//group[@name='ua']" position="after">
          <button name="%(l10n_ua_hr_card.action_ua_earnings_history_employee)d" type="action"
                  string="Історія заробітку" class="btn btn-secondary mb-2"/>
          <group string="Версії контракту">
            <field name="version_ids" nolabel="1" colspan="2" readonly="1">
              <list create="false" default_order="contract_date_start">
                <field name="job_title"/>
                <field name="wage"/>
                <field name="ua_internal_parttime"/>
                <field name="contract_date_start" options="{'numeric': True}"/>
                <field name="contract_date_end" options="{'numeric': True}"/>
                <field name="ua_order_ref"/>
              </list>
            </field>
          </group>
        </xpath>

        <!-- ==================== Приватна інформація: сховати, дублікатів немає ==================== -->
        <xpath expr="//page[@name='personal_information']" position="attributes">
          <attribute name="invisible">1</attribute>
        </xpath>


        <!-- ==================== Огляд: перша вкладка форми (перед «Робота») ====================
             Зведений, повністю readonly знімок стану працівника: поля тут повторюють поля з інших
             вкладок (Особова картка, Військовий облік, Зарплата) - це навмисне дублювання для
             швидкого перегляду без переходів, а не наслідок помилки xpath. Порядок вкладок остаточно
             фіксує l10n_ua_payroll_ui (пріоритет 99); той модуль не займає позицію "перед work_information",
             тож ця вкладка лишається першою і після його застосування.
             Важливо: цей xpath навмисно розташований ОСТАННІМ у файлі (після кроку 2, що виконує
             position="move" для ua_rnokpp/birthday/private_city/private_phone/ua_disability_group/
             ua_insurance_years) - якби він ішов раніше, свіжо вставлені тут поля-копії з тим самим
             іменем потрапляли б у зведене дерево ПЕРЕД відповідним move і той move "переносив" би
             саме їх, а не справжній оригінал, лишаючи оригінал недоторканим і спорожняючи Огляд. -->
        <xpath expr="//page[@name='work_information']" position="before">
          <page name="ua_overview" string="Огляд" groups="hr.group_hr_user">
            <group string="Стан" name="ua_overview_grp_state">
              <field name="ua_contract_kind" widget="badge" readonly="1"/>
              <field name="ua_main_job" readonly="1"/>
              <field name="ua_fte" readonly="1"/>
              <field name="ua_esv_category" readonly="1"/>
              <field name="ua_psp" readonly="1"/>
              <field name="ua_disability_group" readonly="1"/>
              <field name="ua_mil_status" widget="badge" readonly="1"/>
              <field name="ua_mil_rank" readonly="1"/>
              <field name="ua_mil_fitness" widget="badge" readonly="1"/>
              <field name="ua_mil_reserved" readonly="1"/>
              <field name="ua_mil_last_check" readonly="1"/>
            </group>
            <group string="Ідентифікація" name="ua_overview_grp_ident">
              <field name="ua_rnokpp" readonly="1"/>
              <field name="birthday" readonly="1"/>
              <field name="ua_id_doc_type" readonly="1"/>
              <field name="ua_id_doc_number" readonly="1"/>
              <field name="ua_id_doc_unzr" readonly="1"/>
              <field name="private_city" readonly="1"/>
              <field name="ua_actual_address" readonly="1"/>
              <field name="private_phone" readonly="1"/>
            </group>
            <group string="Документи" name="ua_overview_grp_docs">
              <field name="ua_document_ids" nolabel="1" colspan="2" readonly="1">
                <list create="false" decoration-danger="ua_doc_state == 'expired'" decoration-warning="ua_doc_state == 'warning'">
                  <field name="type"/>
                  <field name="name"/>
                  <field name="number"/>
                  <field name="date" options="{'numeric': True}"/>
                  <field name="valid_until"/>
                  <field name="ua_doc_state" column_invisible="1"/>
                </list>
              </field>
            </group>
            <group string="Хроніка" name="ua_overview_grp_chronicle">
              <field name="version_ids" string="Контракти" colspan="1" readonly="1">
                <list create="false" default_order="contract_date_start">
                  <field name="contract_date_start" options="{'numeric': True}"/>
                  <field name="contract_date_end" options="{'numeric': True}"/>
                  <field name="job_title"/>
                  <field name="wage"/>
                  <field name="ua_order_ref"/>
                </list>
              </field>
              <field name="ua_mil_event_ids" string="Військові події" colspan="1" readonly="1">
                <list create="false">
                  <field name="date" options="{'numeric': True}"/>
                  <field name="kind"/>
                  <field name="note"/>
                </list>
              </field>
            </group>
          </page>
        </xpath>

        <!-- ==================== Порядок вкладок: Огляд, Робота, Особова картка, Зарплата,
             Документи, Військовий облік, Відпустки, Контракт, решта нативних. Пересувати можна
             лише сторінки, які вже існують у зведеному дереві - тому це останній крок файлу
             (як і «Огляд» вище), після того як усі сторінки цього і залежних модулів вставлені. ==================== -->
        <xpath expr="//page[@name='ua_card']" position="after">
          <xpath expr="//page[@name='ua']" position="move"/>
        </xpath>
        <xpath expr="//page[@name='ua']" position="after">
          <xpath expr="//page[@name='ua_docs']" position="move"/>
        </xpath>
        <xpath expr="//page[@name='ua_docs']" position="after">
          <xpath expr="//page[@name='ua_military']" position="move"/>
        </xpath>
        <xpath expr="//page[@name='ua_military']" position="after">
          <xpath expr="//page[@name='ua_vacation']" position="move"/>
        </xpath>
        <xpath expr="//page[@name='ua_vacation']" position="after">
          <xpath expr="//page[@name='payroll_information']" position="move"/>
        </xpath>

      </data>
    </field>
  </record>

  <!-- Список працівників: необов'язкові колонки -->
  <record id="view_employee_tree_ua_card" model="ir.ui.view">
    <field name="name">hr.employee.list.ua.card</field>
    <field name="model">hr.employee</field>
    <field name="inherit_id" ref="hr.view_employee_tree"/>
    <field name="arch" type="xml">
      <field name="name" position="after">
        <field name="ua_rnokpp" optional="hide" groups="hr.group_hr_user"/>
        <field name="job_title" optional="hide"/>
      </field>
    </field>
  </record>
</odoo>
