<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <!-- Самостійні вигляди ua.employee.document: список і форма з станом підпису, датою підпису,
       завантаженням і друком; пошук з фільтром «на підпис». Інлайн-список у формі працівника
       (hr_employee_views.xml) лишається основним місцем роботи з документами - ці вигляди
       придатні для окремого екрана (напр. «Документи на підпис» по всіх працівниках). -->
  <record id="view_ua_employee_document_list" model="ir.ui.view">
    <field name="name">ua.employee.document.list</field>
    <field name="model">ua.employee.document</field>
    <field name="arch" type="xml">
      <list decoration-warning="state == 'to_sign'" decoration-success="state == 'signed'" decoration-muted="state == 'not_needed'">
        <field name="employee_id"/>
        <field name="type"/>
        <field name="name"/>
        <field name="date"/>
        <field name="state" widget="badge"/>
        <field name="signed_date"/>
        <field name="file" filename="filename"/>
        <field name="filename" column_invisible="1"/>
        <button name="action_mark_signed" type="object" string="Підписано" icon="fa-check"
                invisible="state != 'to_sign'"/>
        <button name="action_print" type="object" string="Друк" icon="fa-print"
                invisible="not report_xmlid or not res_id"/>
      </list>
    </field>
  </record>

  <record id="view_ua_employee_document_form" model="ir.ui.view">
    <field name="name">ua.employee.document.form</field>
    <field name="model">ua.employee.document</field>
    <field name="arch" type="xml">
      <form string="Документ працівника">
        <header>
          <button name="action_mark_signed" type="object" string="Підписано" class="btn-primary"
                  invisible="state != 'to_sign'"/>
          <button name="action_print" type="object" string="Друк"
                  invisible="not report_xmlid or not res_id"/>
          <field name="state" widget="statusbar" statusbar_visible="to_sign,signed"/>
        </header>
        <sheet>
          <group>
            <group>
              <field name="employee_id"/>
              <field name="type"/>
              <field name="name"/>
              <field name="number"/>
            </group>
            <group>
              <field name="date"/>
              <field name="valid_until"/>
              <field name="signed_date" readonly="1"/>
              <field name="file" filename="filename"/>
              <field name="filename" invisible="1"/>
            </group>
          </group>
          <group>
            <field name="note"/>
          </group>
        </sheet>
      </form>
    </field>
  </record>

  <record id="view_ua_employee_document_search" model="ir.ui.view">
    <field name="name">ua.employee.document.search</field>
    <field name="model">ua.employee.document</field>
    <field name="arch" type="xml">
      <search>
        <field name="employee_id"/>
        <field name="type"/>
        <field name="name"/>
        <filter name="to_sign" string="На підпис" domain="[('state', '=', 'to_sign')]"/>
        <filter name="signed" string="Підписано" domain="[('state', '=', 'signed')]"/>
        <separator/>
        <group name="group_by">
          <filter name="group_employee" string="Працівник" context="{'group_by': 'employee_id'}"/>
          <filter name="group_type" string="Тип" context="{'group_by': 'type'}"/>
        </group>
      </search>
    </field>
  </record>

  <record id="action_ua_employee_document" model="ir.actions.act_window">
    <field name="name">Документи на підпис</field>
    <field name="res_model">ua.employee.document</field>
    <field name="view_mode">list,form</field>
    <field name="search_view_id" ref="view_ua_employee_document_search"/>
    <field name="context">{'search_default_to_sign': 1}</field>
  </record>
</odoo>
