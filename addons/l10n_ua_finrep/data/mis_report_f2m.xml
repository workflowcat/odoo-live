<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!-- Ф2-м «Звіт про фінансові результати», НП(С)БО 25.

         Рядки форми 2-м крупніші за Ф2: доходи двома рядками (2000, 2160),
         витрати двома (2050, 2165), підсумки 2280 і 2285. Чистий результат
         2350 дорівнює рядку 2350 Ф2 на тих самих даних: обидва рахують
         нетто класів 7, 8 і 9 за період.

         Клас 8 доданий окремим доданком до 2165 з тієї ж причини, що й у Ф2:
         при схемі «8 і 9» він дорівнює нулю, при схемі «лише 8» він і є
         витратами.
    -->
    <record id="report_f2m" model="mis.report">
        <field name="name">Ф2-м. Звіт про фінансові результати (НП(С)БО 25)</field>
        <field name="description">Спрощений фінансовий звіт суб'єкта малого підприємництва, форма 2-м</field>
        <field name="x_ua_finrep_form">f2m</field>
        <field name="style_id" ref="style_base" />
    </record>

    <record id="f2m_2000" model="mis.report.kpi">
        <field name="report_id" ref="report_f2m" />
        <field name="sequence">10</field>
        <field name="name">n2000</field>
        <field name="description">2000 Чистий дохід від реалізації продукції (товарів, робіт, послуг)</field>
        <field name="expression">-balp[70%]</field>
    </record>
    <record id="f2m_2160" model="mis.report.kpi">
        <field name="report_id" ref="report_f2m" />
        <field name="sequence">20</field>
        <field name="name">n2160</field>
        <field name="description">2160 Інші доходи</field>
        <field name="expression">-balp[71%,72%,73%,74%,75%,76%,999001,999997]</field>
    </record>
    <record id="f2m_2280" model="mis.report.kpi">
        <field name="report_id" ref="report_f2m" />
        <field name="sequence">30</field>
        <field name="name">n2280</field>
        <field name="description">2280 Разом доходи (2000 + 2160)</field>
        <field name="expression">n2000 + n2160</field>
        <field name="style_id" ref="style_total" />
    </record>
    <record id="f2m_2050" model="mis.report.kpi">
        <field name="report_id" ref="report_f2m" />
        <field name="sequence">40</field>
        <field name="name">n2050</field>
        <field name="description">2050 Собівартість реалізованої продукції (товарів, робіт, послуг)</field>
        <field name="expression">balp[90%]</field>
    </record>
    <record id="f2m_2165" model="mis.report.kpi">
        <field name="report_id" ref="report_f2m" />
        <field name="sequence">50</field>
        <field name="name">n2165</field>
        <field name="description">2165 Інші витрати</field>
        <field
            name="expression"
        >balp[85%,91%,92%,93%,94%,95%,96%,97%,999002,999998] + balp[80%,81%,82%,83%,84%]</field>
    </record>
    <record id="f2m_2285" model="mis.report.kpi">
        <field name="report_id" ref="report_f2m" />
        <field name="sequence">60</field>
        <field name="name">n2285</field>
        <field name="description">2285 Разом витрати (2050 + 2165)</field>
        <field name="expression">n2050 + n2165</field>
        <field name="style_id" ref="style_total" />
    </record>
    <record id="f2m_2290" model="mis.report.kpi">
        <field name="report_id" ref="report_f2m" />
        <field name="sequence">70</field>
        <field name="name">n2290</field>
        <field name="description">2290 Фінансовий результат до оподаткування (2280 - 2285)</field>
        <field name="expression">n2280 - n2285</field>
        <field name="style_id" ref="style_total" />
    </record>
    <record id="f2m_2300" model="mis.report.kpi">
        <field name="report_id" ref="report_f2m" />
        <field name="sequence">80</field>
        <field name="name">n2300</field>
        <field name="description">2300 Податок на прибуток</field>
        <field name="expression">balp[98%]</field>
    </record>
    <record id="f2m_2350" model="mis.report.kpi">
        <field name="report_id" ref="report_f2m" />
        <field name="sequence">90</field>
        <field name="name">n2350</field>
        <field name="description">2350 Чистий прибуток (збиток) (2290 - 2300)</field>
        <field name="expression">n2290 - n2300</field>
        <field name="style_id" ref="style_section" />
    </record>

    <!-- ===== Контроль ===== -->
    <record id="f2m_ctl_1420" model="mis.report.kpi">
        <field name="report_id" ref="report_f2m" />
        <field name="sequence">900</field>
        <field name="name">ctl_1420</field>
        <field name="description">Контроль: 2350 мінус зміна рядка 1420 (0, якщо не було дивідендів і закриття через 79)</field>
        <field
            name="expression"
        >n2350 + balp[44%,999999] + balp[7%,8%,90%,91%,92%,93%,94%,95%,96%,97%,98%,999001,999002,999997,999998]</field>
        <field name="style_id" ref="style_control" />
    </record>
</odoo>
