<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <data noupdate="1">
        <!-- Готові звіти на поточний рік для компанії, у якій ставиться модуль.
             noupdate: бухгалтер може змінити період або перейменувати звіт, і
             оновлення модуля цього не перезапише. Компанію не зашиваємо - її
             підставляє типове значення поля (env.company під час встановлення).

             Колонка одна: mode=relative, type=y, offset=0 - поточний
             календарний рік відносно базової дати звіту (типово сьогодні).
        -->
        <record id="instance_f1" model="mis.report.instance">
            <field name="name">Ф1. Баланс (НП(С)БО 1)</field>
            <field name="report_id" ref="report_f1" />
            <field name="sequence">10</field>
            <field name="target_move">posted</field>
            <field name="widget_show_pivot_date" eval="True" />
            <field name="widget_show_settings_button" eval="True" />
            <field
                name="period_ids"
                eval="[(0, 0, {'name': 'На кінець періоду', 'mode': 'relative', 'type': 'y', 'offset': 0, 'duration': 1, 'sequence': 1})]"
            />
        </record>
        <record id="instance_f2" model="mis.report.instance">
            <field name="name">Ф2. Звіт про фінансові результати (НП(С)БО 1)</field>
            <field name="report_id" ref="report_f2" />
            <field name="sequence">20</field>
            <field name="target_move">posted</field>
            <field name="widget_show_pivot_date" eval="True" />
            <field name="widget_show_settings_button" eval="True" />
            <field
                name="period_ids"
                eval="[(0, 0, {'name': 'За період', 'mode': 'relative', 'type': 'y', 'offset': 0, 'duration': 1, 'sequence': 1})]"
            />
        </record>
        <record id="instance_f1m" model="mis.report.instance">
            <field name="name">Ф1-м. Баланс (НП(С)БО 25)</field>
            <field name="report_id" ref="report_f1m" />
            <field name="sequence">30</field>
            <field name="target_move">posted</field>
            <field name="widget_show_pivot_date" eval="True" />
            <field name="widget_show_settings_button" eval="True" />
            <field
                name="period_ids"
                eval="[(0, 0, {'name': 'На кінець періоду', 'mode': 'relative', 'type': 'y', 'offset': 0, 'duration': 1, 'sequence': 1})]"
            />
        </record>
        <record id="instance_f2m" model="mis.report.instance">
            <field name="name">Ф2-м. Звіт про фінансові результати (НП(С)БО 25)</field>
            <field name="report_id" ref="report_f2m" />
            <field name="sequence">40</field>
            <field name="target_move">posted</field>
            <field name="widget_show_pivot_date" eval="True" />
            <field name="widget_show_settings_button" eval="True" />
            <field
                name="period_ids"
                eval="[(0, 0, {'name': 'За період', 'mode': 'relative', 'type': 'y', 'offset': 0, 'duration': 1, 'sequence': 1})]"
            />
        </record>
    </data>

    <!-- Меню: Бухгалтерія > Звітність > Фінансова звітність (НП(С)БО).
         Кожен пункт - серверна дія: бере звіт форми для поточної компанії (або
         копіює готовий звіт модуля, якщо в компанії його ще немає) і відкриває
         його одразу в режимі перегляду через preview(). Пряма дія на запис
         (act_window з res_id) не годиться: віджет mis_builder 19.0 не бачить id
         запису без active_id у контексті, і звіт однієї компанії не підходить
         іншій. -->
    <record id="action_open_f1" model="ir.actions.server">
        <field name="name">Ф1. Баланс</field>
        <field name="model_id" ref="mis_builder.model_mis_report_instance" />
        <field name="state">code</field>
        <field name="code">action = model._ua_finrep_open("f1")</field>
    </record>
    <record id="action_open_f2" model="ir.actions.server">
        <field name="name">Ф2. Звіт про фінансові результати</field>
        <field name="model_id" ref="mis_builder.model_mis_report_instance" />
        <field name="state">code</field>
        <field name="code">action = model._ua_finrep_open("f2")</field>
    </record>
    <record id="action_open_f1m" model="ir.actions.server">
        <field name="name">Ф1-м. Баланс</field>
        <field name="model_id" ref="mis_builder.model_mis_report_instance" />
        <field name="state">code</field>
        <field name="code">action = model._ua_finrep_open("f1m")</field>
    </record>
    <record id="action_open_f2m" model="ir.actions.server">
        <field name="name">Ф2-м. Звіт про фінансові результати</field>
        <field name="model_id" ref="mis_builder.model_mis_report_instance" />
        <field name="state">code</field>
        <field name="code">action = model._ua_finrep_open("f2m")</field>
    </record>

    <menuitem
        id="menu_ua_finrep_root"
        parent="account.menu_finance_reports"
        name="Фінансова звітність (НП(С)БО)"
        sequence="95"
        groups="account.group_account_readonly"
    />
    <menuitem id="menu_ua_finrep_f1" parent="menu_ua_finrep_root" name="Ф1. Баланс" action="action_open_f1" sequence="10" />
    <menuitem
        id="menu_ua_finrep_f2"
        parent="menu_ua_finrep_root"
        name="Ф2. Звіт про фінансові результати"
        action="action_open_f2"
        sequence="20"
    />
    <menuitem
        id="menu_ua_finrep_f1m"
        parent="menu_ua_finrep_root"
        name="Ф1-м. Баланс"
        action="action_open_f1m"
        sequence="30"
    />
    <menuitem
        id="menu_ua_finrep_f2m"
        parent="menu_ua_finrep_root"
        name="Ф2-м. Звіт про фінансові результати"
        action="action_open_f2m"
        sequence="40"
    />
</odoo>
