<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="rule_ua_price_order_company" model="ir.rule">
    <field name="name">Встановлення цін: лише свої компанії</field>
    <field name="model_id" ref="model_ua_price_order"/>
    <field name="domain_force">[('company_id', 'in', company_ids)]</field>
  </record>
  <record id="rule_ua_price_order_line_company" model="ir.rule">
    <field name="name">Рядок встановлення цін: лише свої компанії</field>
    <field name="model_id" ref="model_ua_price_order_line"/>
    <field name="domain_force">[('order_id.company_id', 'in', company_ids)]</field>
  </record>
</odoo>
