<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="action_report_ua_price_order" model="ir.actions.report">
    <field name="name">Наказ про встановлення цін</field>
    <field name="model">ua.price.order</field>
    <field name="report_type">qweb-pdf</field>
    <field name="report_name">l10n_ua_price_set.report_ua_price_order</field>
    <field name="report_file">l10n_ua_price_set.report_ua_price_order</field>
    <field name="binding_model_id" ref="model_ua_price_order"/>
    <field name="binding_type">report</field>
    <field name="print_report_name">'Встановлення цін %s' % object.name</field>
  </record>

  <template id="report_ua_price_order">
    <t t-call="web.html_container">
      <t t-foreach="docs" t-as="doc">
        <t t-call="web.basic_layout">
          <style>
            .ua-doc { font-size: 10.5px; color: #000; }
            .ua-doc h3 { font-size: 13px; text-align: center; margin: 4px 0; }
            .ua-doc .ua-sub { text-align: center; margin-bottom: 8px; }
            .ua-doc .ua-grid { width: 100%; border-collapse: collapse; margin-bottom: 8px; }
            .ua-doc .ua-grid th, .ua-doc .ua-grid td { border: 1px solid #000; padding: 2px 4px; vertical-align: top; }
            .ua-doc .ua-grid th { font-weight: normal; text-align: center; }
            .ua-doc .ua-num { text-align: right; white-space: nowrap; }
            .ua-doc .ua-sign { width: 100%; margin-top: 18px; }
          </style>
          <div class="ua-doc">
            <div><t t-out="doc.company_id.name"/></div>
            <h3>НАКАЗ ПРО ВСТАНОВЛЕННЯ ЦІН № <t t-out="doc.name"/></h3>
            <div class="ua-sub">Ціни діють з <t t-out="doc.ua_date(doc.date)"/><t t-if="doc.basis">; підстава: <t t-out="doc.basis"/></t></div>
            <t t-foreach="doc.pricelist_ids" t-as="pricelist">
              <t t-set="lines" t-value="doc.line_ids.filtered(lambda l: l.pricelist_id == pricelist and l.new_price)"/>
              <t t-if="lines">
                <div><strong>Тип цін: <t t-out="pricelist.name"/></strong></div>
                <table class="ua-grid">
                  <thead><tr><th>№</th><th>Код</th><th>Товар</th><th>Од.</th><th>Була ціна</th><th>Нова ціна</th><th>Зміна, %</th></tr></thead>
                  <tbody>
                    <tr t-foreach="lines" t-as="line">
                      <td t-out="line_index + 1"/>
                      <td t-out="line.product_id.default_code or ''"/>
                      <td t-out="line.product_id.name"/>
                      <td t-out="line.uom_id.name"/>
                      <td class="ua-num" t-out="'%.2f' % line.old_price"/>
                      <td class="ua-num" t-out="'%.2f' % line.new_price"/>
                      <td class="ua-num" t-out="'%.2f' % line.change if line.old_price else ''"/>
                    </tr>
                  </tbody>
                </table>
              </t>
            </t>
            <table class="ua-sign"><tr>
              <td>Керівник ______________ / ______________________</td>
              <td>Відповідальний<t t-if="doc.responsible_id"> <t t-out="doc.responsible_id.name"/></t> ______________</td>
            </tr></table>
          </div>
        </t>
      </t>
    </t>
  </template>
</odoo>
