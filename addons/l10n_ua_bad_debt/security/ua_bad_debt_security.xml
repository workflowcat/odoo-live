<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="rule_ua_bad_debt_reserve_company" model="ir.rule">
    <field name="name">Резерв сумнівних боргів: лише свої компанії</field>
    <field name="model_id" ref="model_ua_bad_debt_reserve"/>
    <field name="domain_force">[('company_id', 'in', company_ids)]</field>
  </record>
  <record id="rule_ua_bad_debt_line_company" model="ir.rule">
    <field name="name">Рядок резерву сумнівних боргів: лише свої компанії</field>
    <field name="model_id" ref="model_ua_bad_debt_line"/>
    <field name="domain_force">[('reserve_id.company_id', 'in', company_ids)]</field>
  </record>
</odoo>
