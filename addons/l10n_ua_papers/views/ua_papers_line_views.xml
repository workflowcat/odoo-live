        <field name="full_name" readonly="ua_paper_state != 'draft'"/>
        <field name="birthday" readonly="ua_paper_state != 'draft'"/>
        <field name="rnokpp" readonly="ua_paper_state != 'draft'"/>
        <field name="reg_address" readonly="ua_paper_state != 'draft'"/>
        <field name="actual_address" readonly="ua_paper_state != 'draft'"/>
        <field name="job_title" readonly="ua_paper_state != 'draft'"/>
        <field name="rank" readonly="ua_paper_state != 'draft'"/>
