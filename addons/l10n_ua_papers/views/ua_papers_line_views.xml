  <!-- Список персонального військового обліку відтворює офіційну форму (постанова КМУ
       № 1487) - звідси стільки колонок; це не 31 день табеля, а ~18 реквізитів людини,
       кожен окремо потрібний. `section` (ключ групування розділу форми) не показуємо -
       його заміняє людський `section_label`. -->
  <record id="view_ua_papers_military_list_line_list" model="ir.ui.view">
    <field name="name">l10n_ua_papers.ua.military.list.line.list</field>
    <field name="model">ua.military.list.line</field>
