<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <!-- Вузькі вигляди режиму «Дані» (task 4, spec-papers.md «Спершу дані, потім бланк»):
       список рядків документа, не форма. Форма приносила свою переписку, свої кнопки в
       шапці і свої копії полів «Рік/Місяць/Підрозділ», що вже стоять вище в «Що вказати».

       editable="bottom", create="false", delete="false": рядки складає «Перерахувати»
       (action_refill/action_fill у своїй моделі), тут лише правка того, що вже є. Кожне
       поле - readonly="ua_paper_state != 'draft'" (ua_paper_state - models/ua_paper_lines.py).
       Колонки - лише те, що бухгалтер справді дивиться і править; ua.timesheet.line без
       31 колонки днів (сітка П-5 лишається в повній формі за кнопкою «Відкрити»). -->

  <record id="view_ua_papers_timesheet_line_list" model="ir.ui.view">
    <field name="name">l10n_ua_papers.ua.timesheet.line.list</field>
    <field name="model">ua.timesheet.line</field>
    <field name="arch" type="xml">
      <list editable="bottom" create="false" delete="false">
        <field name="ua_paper_state" column_invisible="1"/>
        <!-- Прізвище і посада - те, що справді читають, тому їм місце, а числам
             рівно стільки, скільки треба на «22,00». -->
        <field name="employee_id" width="190px" readonly="ua_paper_state != 'draft'"/>
        <field name="job_title" width="130px" readonly="ua_paper_state != 'draft'"/>
        <!-- Табельний номер лишається в повній формі: тут людину впізнають за прізвищем,
             а місце потрібне дням відпустки і лікарняного. -->
        <field name="tab_number" column_invisible="1"/>
        <!-- Норма днів однакова для всіх у місяці, тому в перелік не йде: вона є в шапці
             місяця і в повній формі. Місце віддано дням відпустки, лікарняного і без оплати. -->
        <field name="norm_days" column_invisible="1"/>
        <field name="days_worked" string="Факт днів" width="85px" readonly="ua_paper_state != 'draft'"/>
        <field name="hours" string="Годин" width="75px" readonly="ua_paper_state != 'draft'"/>
        <field name="days_vac" string="Відпустка" width="90px" readonly="ua_paper_state != 'draft'"/>
        <field name="days_sick" string="Лікарняний" width="95px" readonly="ua_paper_state != 'draft'"/>
        <field name="days_unpaid" string="Без оплати" width="95px" readonly="ua_paper_state != 'draft'"/>
      </list>
    </field>
  </record>

