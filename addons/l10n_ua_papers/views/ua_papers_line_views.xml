        <field name="job_title" readonly="ua_paper_state != 'draft'"/>
        <field name="kp_code" readonly="ua_paper_state != 'draft'"/>
        <field name="units" readonly="ua_paper_state != 'draft'"/>
        <field name="wage" readonly="ua_paper_state != 'draft'"/>
