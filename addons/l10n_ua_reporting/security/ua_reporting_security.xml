<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <!-- Правила компанії: записи однієї компанії не видно з іншої. Той самий домен,
       що в нативних документах Odoo; рядок бере компанію в документа, на якому висить,
       а довідник із порожньою компанією спільний для всіх. -->
  <record id="rule_ua_report_run_company" model="ir.rule">
    <field name="name">Звітний прогін: лише свої компанії</field>
    <field name="model_id" ref="model_ua_report_run"/>
    <field name="domain_force">[('company_id', 'in', company_ids)]</field>
  </record>

  <record id="rule_ua_report_check_company" model="ir.rule">
    <field name="name">Перевірка звітного прогону: лише свої компанії</field>
    <field name="model_id" ref="model_ua_report_check"/>
    <field name="domain_force">[('run_id.company_id', 'in', company_ids)]</field>
  </record>
</odoo>
