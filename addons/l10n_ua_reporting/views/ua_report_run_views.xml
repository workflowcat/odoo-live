<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="action_ua_reporting" model="ir.actions.client">
    <field name="name">Звітність</field>
    <field name="tag">ua_reporting</field>
  </record>

  <menuitem id="menu_ua_reporting_root" name="Звітність" sequence="3" action="action_ua_reporting"/>

  <!-- ua.report.check не редагується з UI: рядки пише лише action_refresh() (див. модель).
       Форма і список тут лише на випадок технічного відкриття (напр. з developer mode) - readonly. -->
  <record id="view_ua_report_check_list" model="ir.ui.view">
    <field name="name">ua.report.check.list</field>
    <field name="model">ua.report.check</field>
    <field name="arch" type="xml">
      <list string="Перевірки" create="false" edit="false" delete="false">
        <field name="sequence" column_invisible="1"/>
        <field name="level"/>
        <field name="title"/>
        <field name="detail"/>
        <field name="value"/>
        <field name="target_model"/>
      </list>
    </field>
  </record>

  <record id="view_ua_report_check_form" model="ir.ui.view">
    <field name="name">ua.report.check.form</field>
    <field name="model">ua.report.check</field>
    <field name="arch" type="xml">
      <form string="Перевірка" create="false" edit="false" delete="false">
        <sheet>
          <group>
            <field name="code"/>
            <field name="title"/>
            <field name="level"/>
            <field name="detail"/>
            <field name="value"/>
            <field name="target_model"/>
            <field name="target_domain"/>
            <field name="target_res_id"/>
          </group>
        </sheet>
      </form>
    </field>
  </record>
</odoo>
