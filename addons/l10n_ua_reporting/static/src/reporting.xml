<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
  <t t-name="l10n_ua_reporting.Reporting" owl="1">
    <div class="o_ua_reporting">
      <t t-if="state.loading">
        <div class="o_ua_reporting_loading text-muted p-4">Завантаження…</div>
      </t>
      <t t-elif="state.data">
        <t t-set="data" t-value="state.data"/>

        <div class="o_ua_reporting_left">
          <div class="o_ua_reporting_reports">
            <div t-foreach="data.reports" t-as="r" t-key="r.code"
                 t-attf-class="o_ua_reporting_report_item #{data.run.report_code === r.code ? 'active' : ''}"
                 t-on-click="() => this.selectReport(r.code)">
              <t t-esc="r.name"/>
            </div>
          </div>
          <div class="o_ua_reporting_periods">
            <div t-foreach="data.periods" t-as="p" t-key="p.key"
                 t-attf-class="o_ua_reporting_period_item #{p.run_id === data.run.id ? 'active' : ''}"
                 t-on-click="() => this.selectPeriod(p)">
              <span t-esc="p.label"/>
              <span t-if="p.state" t-attf-class="o_ua_pill o_ua_state_#{p.state}" t-esc="this.stateLabel(p.state)"/>
            </div>
          </div>
          <div class="o_ua_reporting_history" t-if="data.history.length">
            <h6>Історія</h6>
            <div t-foreach="data.history" t-as="h" t-key="h.id" class="o_ua_reporting_history_item">
              <span t-esc="h.name"/>
              <span class="text-muted small" t-esc="this.stateLabel(h.state)"/>
            </div>
          </div>
        </div>

        <div class="o_ua_reporting_right">
          <div class="o_ua_reporting_header o_ua_head">
            <div class="o_ua_reporting_title o_ua_head_title">
              <h4 t-esc="data.run.name"/>
              <div t-if="data.run.base_run" class="o_ua_head_subtitle">
                виправляє: <t t-esc="data.run.base_run"/>
                <t t-if="data.run.corrections and data.run.corrections.length"> · коригування: <t t-esc="data.run.corrections.length"/></t>
              </div>
              <div t-elif="data.run.corrections and data.run.corrections.length" class="o_ua_head_subtitle">
                коригування: <t t-esc="data.run.corrections.length"/>
              </div>
              <div class="o_ua_reporting_steps">
                <t t-foreach="this.stateSteps" t-as="s" t-key="s">
                  <span t-attf-class="o_ua_step #{data.run.state === s ? 'active' : ''}" t-esc="this.stateLabel(s)"/>
                </t>
              </div>
            </div>
            <div class="o_ua_reporting_actions o_ua_head_actions">
              <button class="btn btn-sm btn-primary" t-on-click="generate" t-att-disabled="state.busy || this.hasErrors">Сформувати</button>
              <button class="btn btn-sm btn-secondary" t-on-click="refresh" t-att-disabled="state.busy">Перерахувати</button>
              <button class="btn btn-sm btn-secondary" t-on-click="markSubmitted" t-att-disabled="state.busy || data.run.state !== 'generated'">Позначити поданим</button>
              <Dropdown t-if="data.run.files.length or data.run.can_correct">
                <button class="btn btn-sm btn-outline-secondary">Ще</button>
                <t t-set-slot="content">
                  <DropdownItem t-if="data.run.files.length" onSelected="() => this.downloadAll()">Завантажити всі файли</DropdownItem>
                  <DropdownItem t-if="data.run.can_correct" onSelected="() => this.createCorrection('HZN')">Звітний новий</DropdownItem>
                  <DropdownItem t-if="data.run.can_correct" onSelected="() => this.createCorrection('HZU')">Уточнюючий</DropdownItem>
                </t>
              </Dropdown>
            </div>
          </div>

          <div class="o_ua_reporting_section">
            <h5>Перевірки</h5>
            <table class="o_ua_table">
              <thead><tr><th>Рівень</th><th>Перевірка</th><th class="text-end">Значення</th></tr></thead>
              <tbody>
                <tr t-foreach="data.checks" t-as="c" t-key="c.id"
                    t-attf-class="#{c.action_model ? 'o_ua_clickable' : ''}"
                    t-on-click="() => this.openCheck(c)">
                  <td><span t-attf-class="o_ua_pill #{this.levelPill(c.level)}" t-esc="this.levelLabel(c.level)"/></td>
                  <td><div t-esc="c.title"/><div class="text-muted small" t-esc="c.detail"/></td>
                  <td class="text-end" t-esc="c.value"/>
                </tr>
                <tr t-if="!data.checks.length"><td colspan="3" class="text-muted">Натисніть «Перерахувати».</td></tr>
              </tbody>
            </table>
          </div>

          <div class="o_ua_reporting_section" t-if="data.summary.rows and data.summary.rows.length">
            <h5>Дані</h5>
            <table class="o_ua_table">
              <thead>
                <tr><t t-foreach="data.summary.columns" t-as="col" t-key="col"><th t-esc="col"/></t></tr>
              </thead>
              <tbody>
                <tr t-foreach="data.summary.rows" t-as="row" t-key="row_index"
                    t-attf-class="#{this.rowTarget(row_index) ? 'o_ua_clickable' : ''}"
                    t-on-click="() => this.openSummaryRow(row_index)">
                  <t t-foreach="row" t-as="cell" t-key="cell_index"><td t-att-class="cell_index ? 'text-end tabular-nums' : ''" t-esc="this.fmt(cell, this.isMoney(cell_index))"/></t>
                </tr>
              </tbody>
              <tfoot t-if="data.summary.total">
                <tr class="o_ua_reporting_total">
                  <t t-foreach="data.summary.total" t-as="cell" t-key="cell_index"><td t-att-class="cell_index ? 'text-end tabular-nums' : ''" t-esc="this.fmt(cell, this.isMoney(cell_index))"/></t>
                </tr>
              </tfoot>
            </table>
          </div>

          <div class="o_ua_reporting_section" t-if="data.appendices.length">
            <h5>Додатки</h5>
            <table class="o_ua_table">
              <thead><tr><th>Додаток</th><th>Файл</th><th class="text-end">Рядків</th><th>Стан</th></tr></thead>
              <tbody>
                <tr t-foreach="data.appendices" t-as="a" t-key="a.attachment_id">
                  <td t-esc="a.label"/><td t-esc="a.name"/><td class="text-end" t-esc="a.rows"/><td t-esc="a.state"/>
                </tr>
              </tbody>
            </table>
          </div>

          <div class="o_ua_reporting_section" t-if="data.run.files.length or data.run.receipts.length">
            <h5>Файли</h5>
            <ul t-if="data.run.files.length" class="o_ua_reporting_files">
              <li t-foreach="data.run.files" t-as="f" t-key="f.id">
                <a t-attf-href="/web/content/#{f.id}?download=true" target="_blank" t-esc="f.name"/>
              </li>
            </ul>
            <div t-if="data.run.receipts.length" class="o_ua_reporting_receipts">
              <h6>Квитанції</h6>
              <ul class="o_ua_reporting_files">
                <li t-foreach="data.run.receipts" t-as="rcpt" t-key="rcpt.id">
                  <a t-attf-href="/web/content/#{rcpt.id}?download=true" target="_blank" t-esc="rcpt.name"/>
                </li>
              </ul>
            </div>
          </div>
        </div>
      </t>
    </div>
  </t>
</templates>
