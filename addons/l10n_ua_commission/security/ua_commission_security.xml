<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="rule_ua_commission_agreement_company" model="ir.rule">
    <field name="name">Договір комісії: своя компанія</field>
    <field name="model_id" ref="model_ua_commission_agreement"/>
    <field name="domain_force">[('company_id', 'in', company_ids)]</field>
  </record>
  <record id="rule_ua_commission_report_company" model="ir.rule">
    <field name="name">Звіт комісіонера: своя компанія</field>
    <field name="model_id" ref="model_ua_commission_report"/>
    <field name="domain_force">[('company_id', 'in', company_ids)]</field>
  </record>
</odoo>
