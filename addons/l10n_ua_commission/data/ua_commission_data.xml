<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
  <record id="seq_ua_commission_agreement" model="ir.sequence">
    <field name="name">Договір комісії</field>
    <field name="code">ua.commission.agreement</field>
    <field name="prefix">КМ/%(range_year)s/</field>
    <field name="padding">4</field>
    <field name="use_date_range">True</field>
    <field name="company_id" eval="False"/>
  </record>
  <record id="seq_ua_commission_report" model="ir.sequence">
    <field name="name">Звіт комісіонера</field>
    <field name="code">ua.commission.report</field>
    <field name="prefix">ЗК/%(range_year)s/</field>
    <field name="padding">4</field>
    <field name="use_date_range">True</field>
    <field name="company_id" eval="False"/>
  </record>
  <record id="product_commission_fee" model="product.product">
    <field name="name">Комісійна винагорода</field>
    <field name="type">service</field>
    <field name="sale_ok" eval="True"/>
    <field name="purchase_ok" eval="True"/>
    <field name="list_price">0</field>
  </record>
</odoo>
