<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="view_ua_bom_substitute_list" model="ir.ui.view">
    <field name="name">ua.bom.substitute.list</field>
    <field name="model">ua.bom.substitute</field>
    <field name="arch" type="xml">
      <list string="Аналоги компонентів" editable="bottom" decoration-muted="not approved">
        <field name="bom_line_id" options="{'no_create': True}"/>
        <field name="bom_id" optional="show"/>
        <field name="sequence" widget="handle"/>
        <field name="product_id" options="{'no_create': True}"/>
        <field name="factor"/>
        <field name="approval_ref"/>
        <field name="approved" widget="boolean"/>
        <field name="approved_by" optional="show"/>
        <field name="approved_on" optional="show"/>
        <field name="note" optional="hide"/>
        <button name="action_approve" type="object" string="Погодити" icon="fa-check"
                invisible="approved" groups="mrp.group_mrp_manager"/>
        <button name="action_revoke" type="object" string="Зняти погодження" icon="fa-times"
                invisible="not approved" groups="mrp.group_mrp_manager"/>
      </list>
    </field>
  </record>

  <record id="view_ua_bom_substitute_search" model="ir.ui.view">
    <field name="name">ua.bom.substitute.search</field>
    <field name="model">ua.bom.substitute</field>
    <field name="arch" type="xml">
      <search>
        <field name="component_id"/>
        <field name="product_id"/>
        <field name="bom_id"/>
        <filter name="not_approved" string="Не погоджені" domain="[('approved', '=', False)]"/>
        <filter name="approved" string="Погоджені" domain="[('approved', '=', True)]"/>
        <group>
          <filter name="by_component" string="Компонент" context="{'group_by': 'component_id'}"/>
        </group>
      </search>
    </field>
  </record>

  <record id="action_ua_bom_substitute" model="ir.actions.act_window">
    <field name="name">Аналоги компонентів</field>
    <field name="res_model">ua.bom.substitute</field>
    <field name="view_mode">list</field>
    <field name="help" type="html">
      <p class="o_view_nocontent_smiling_face">Аналоги компонентів</p>
      <p>Виріб, яким можна замінити компонент специфікації, з коефіцієнтом. Без погодження
        керівником виробництва аналог не використовується.</p>
    </field>
  </record>

  <record id="mrp_bom_form_view_ua_substitute" model="ir.ui.view">
    <field name="name">mrp.bom.form.ua.substitute</field>
    <field name="model">mrp.bom</field>
    <field name="inherit_id" ref="mrp.mrp_bom_form_view"/>
    <field name="arch" type="xml">
      <div name="button_box" position="inside">
        <button name="action_ua_substitutes" type="object" class="oe_stat_button" icon="fa-exchange">
          <field name="ua_substitute_count" widget="statinfo" string="Аналоги"/>
        </button>
      </div>
    </field>
  </record>

  <record id="mrp_production_form_view_ua_substitute" model="ir.ui.view">
    <field name="name">mrp.production.form.ua.substitute</field>
    <field name="model">mrp.production</field>
    <field name="inherit_id" ref="mrp.mrp_production_form_view"/>
    <field name="arch" type="xml">
      <xpath expr="//header/button[@name='action_assign']" position="after">
        <button name="action_ua_substitute" type="object" string="Замінити відсутні"
                invisible="state not in ('confirmed', 'progress', 'to_close')"/>
      </xpath>
      <xpath expr="//field[@name='move_raw_ids']/list/field[@name='product_id']" position="after">
        <field name="ua_substitute_of_id" optional="show" readonly="1"/>
      </xpath>
    </field>
  </record>

  <menuitem id="menu_ua_bom_substitute" name="Аналоги компонентів" parent="mrp.menu_mrp_bom"
            action="action_ua_bom_substitute" sequence="30"/>
</odoo>
