<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <record id="paperformat_ua_docs_a4" model="report.paperformat">
    <field name="name">Україна: первинка A4</field>
    <field name="format">A4</field>
    <field name="orientation">Portrait</field>
    <field name="margin_top">12</field>
    <field name="margin_bottom">12</field>
    <field name="margin_left">14</field>
    <field name="margin_right">10</field>
    <field name="header_line" eval="False"/>
    <field name="header_spacing">0</field>
    <field name="dpi">90</field>
  </record>

  <record id="action_report_ua_invoice_bill" model="ir.actions.report">
    <field name="name">Рахунок на оплату</field>
    <field name="model">account.move</field>
    <field name="report_type">qweb-pdf</field>
    <field name="report_name">l10n_ua_docs.report_ua_invoice_bill</field>
    <field name="report_file">l10n_ua_docs.report_ua_invoice_bill</field>
    <field name="binding_model_id" ref="account.model_account_move"/>
    <field name="binding_type">report</field>
    <field name="paperformat_id" ref="paperformat_ua_docs_a4"/>
    <field name="print_report_name">'Рахунок %s' % (object.name or '')</field>
  </record>

  <record id="action_report_ua_service_act" model="ir.actions.report">
    <field name="name">Акт наданих послуг</field>
    <field name="model">account.move</field>
    <field name="report_type">qweb-pdf</field>
    <field name="report_name">l10n_ua_docs.report_ua_service_act</field>
    <field name="report_file">l10n_ua_docs.report_ua_service_act</field>
    <field name="binding_model_id" ref="account.model_account_move"/>
    <field name="binding_type">report</field>
    <field name="paperformat_id" ref="paperformat_ua_docs_a4"/>
    <field name="print_report_name">'Акт %s' % (object.name or '')</field>
  </record>

  <record id="action_report_ua_delivery_note" model="ir.actions.report">
    <field name="name">Видаткова накладна</field>
    <field name="model">account.move</field>
    <field name="report_type">qweb-pdf</field>
    <field name="report_name">l10n_ua_docs.report_ua_delivery_note</field>
    <field name="report_file">l10n_ua_docs.report_ua_delivery_note</field>
    <field name="binding_model_id" ref="account.model_account_move"/>
    <field name="binding_type">report</field>
    <field name="paperformat_id" ref="paperformat_ua_docs_a4"/>
    <field name="print_report_name">'Видаткова накладна %s' % (object.name or '')</field>
  </record>

</odoo>
