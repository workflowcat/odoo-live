<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <!-- ======================= Спільний стиль ======================= -->
  <!-- Чистий A4, як чекає бухгалтер від BAS чи M.E.Doc: дрібний шрифт,
       тонка рамка таблиці, підсумки праворуч, підписи внизу. -->
  <template id="ua_docs_style">
    <style>
      .ua-doc { font-size: 11px; color: #000; font-family: "DejaVu Sans", sans-serif; }
      .ua-doc h3 { font-size: 14px; text-align: center; margin: 10px 0 2px 0; font-weight: bold; }
      .ua-doc .ua-sub { text-align: center; font-size: 12px; margin-bottom: 8px; }
      .ua-doc .ua-req { width: 100%; border-collapse: collapse; margin-bottom: 4px; }
      .ua-doc .ua-req td { vertical-align: top; padding: 1px 4px 1px 0; }
      .ua-doc .ua-req .ua-key { width: 105px; color: #333; }
      .ua-doc .ua-rule { border-bottom: 1px solid #000; margin: 6px 0; }
      .ua-doc .ua-grid { width: 100%; border-collapse: collapse; margin: 8px 0 4px 0; }
      .ua-doc .ua-grid th, .ua-doc .ua-grid td { border: 1px solid #000; padding: 3px 4px; }
      .ua-doc .ua-grid th { font-weight: normal; font-size: 10px; text-align: center; background: #f2f2f2; }
      .ua-doc .ua-num { text-align: right; white-space: nowrap; }
      .ua-doc .ua-mid { text-align: center; }
      .ua-doc .ua-totals { width: 100%; border-collapse: collapse; margin-top: 2px; }
      .ua-doc .ua-totals td { padding: 2px 4px; }
      .ua-doc .ua-totals .ua-label { text-align: right; }
      .ua-doc .ua-totals .ua-grand { font-weight: bold; }
      .ua-doc .ua-totals .ua-grand td { border-top: 1px solid #000; }
      .ua-doc .ua-words { margin-top: 8px; }
      .ua-doc .ua-sign { width: 100%; border-collapse: collapse; margin-top: 24px; }
      .ua-doc .ua-sign td { vertical-align: top; padding: 12px 8px 0 0; width: 50%; }
      .ua-doc .ua-fill { border-bottom: 1px solid #000; display: inline-block; min-width: 150px; }
      .ua-doc .ua-cap { font-size: 9px; color: #333; }
      .ua-doc .ua-note { margin-top: 8px; }
    </style>
  </template>

  <!-- ======================= Реквізити однієї сторони ======================= -->
  <!-- Очікує у контексті: party (словник із _ua_docs_party) і role (підпис). -->
  <template id="ua_docs_party_block">
    <table class="ua-req">
      <tr>
        <td class="ua-key"><t t-out="role"/>:</td>
        <td>
          <strong t-out="party['name']"/>
          <t t-if="party['registry']">, ЄДРПОУ/РНОКПП <t t-out="party['registry']"/></t>
          <t t-if="party['vat']">, ІПН <t t-out="party['vat']"/></t>
          <t t-else=""> (не платник ПДВ)</t>
        </td>
      </tr>
      <tr t-if="party['address']">
        <td class="ua-key">Адреса:</td>
        <td><t t-out="party['address']"/></td>
      </tr>
      <tr t-if="party['actual_address']">
        <td class="ua-key">Фактична:</td>
        <td><t t-out="party['actual_address']"/></td>
      </tr>
      <tr t-if="party['iban']">
        <td class="ua-key">Рахунок:</td>
        <td>
          IBAN <t t-out="party['iban']"/>
          <t t-if="party['bank_name']"> в <t t-out="party['bank_name']"/></t>
          <t t-if="party['mfo']">, МФО <t t-out="party['mfo']"/></t>
        </td>
      </tr>
      <tr t-if="party['phone']">
        <td class="ua-key">Телефон:</td>
        <td><t t-out="party['phone']"/></td>
      </tr>
    </table>
  </template>

  <!-- ======================= Таблиця позицій і підсумки ======================= -->
  <!-- Очікує: rows, totals, cur_label, show_uktzed. -->
  <template id="ua_docs_lines_table">
    <table class="ua-grid">
      <thead>
        <tr>
          <th style="width: 4%;">№</th>
          <th>Найменування</th>
          <th t-if="show_uktzed" style="width: 12%;">Код УКТ ЗЕД</th>
          <th style="width: 9%;">Кількість</th>
          <th style="width: 8%;">Од.</th>
          <th style="width: 13%;">Ціна без ПДВ, <t t-out="cur_label"/></th>
          <th style="width: 14%;">Сума без ПДВ, <t t-out="cur_label"/></th>
        </tr>
      </thead>
      <tbody>
        <tr t-foreach="rows" t-as="row">
          <td class="ua-mid"><t t-out="row['index']"/></td>
          <td>
            <t t-out="row['name']"/>
            <t t-if="row['code']"> (<t t-out="row['code']"/>)</t>
          </td>
          <td t-if="show_uktzed" class="ua-mid"><t t-out="row['uktzed']"/></td>
          <td class="ua-num"><t t-out="'%g' % row['quantity']"/></td>
          <td class="ua-mid"><t t-out="row['uom']"/></td>
          <td class="ua-num"><t t-out="doc._ua_docs_money_text(row['price'])"/></td>
          <td class="ua-num"><t t-out="doc._ua_docs_money_text(row['subtotal'])"/></td>
        </tr>
      </tbody>
    </table>

    <table class="ua-totals">
      <tr>
        <td class="ua-label" style="width: 78%;">Разом без ПДВ:</td>
        <td class="ua-num" style="width: 22%;"><t t-out="doc._ua_docs_money_text(totals['untaxed'])"/> <t t-out="cur_label"/></td>
      </tr>
      <tr>
        <td class="ua-label"><t t-out="totals['vat_label']"/>:</td>
        <td class="ua-num">
          <t t-if="totals['has_vat']"><t t-out="doc._ua_docs_money_text(totals['tax'])"/> <t t-out="cur_label"/></t>
          <t t-else="">без ПДВ</t>
        </td>
      </tr>
      <tr class="ua-grand">
        <td class="ua-label">Разом до сплати:</td>
        <td class="ua-num"><t t-out="doc._ua_docs_money_text(totals['total'])"/> <t t-out="cur_label"/></td>
      </tr>
    </table>

    <div class="ua-words">
      Усього найменувань <t t-out="totals['count']"/>, на суму
      <t t-out="doc._ua_docs_money_text(totals['total'])"/> <t t-out="cur_label"/>.<br/>
      <strong t-out="totals['words']"/><t t-if="not totals['has_vat']">, без ПДВ</t>.
    </div>
  </template>

  <!-- ======================= Рахунок на оплату ======================= -->
  <template id="report_ua_invoice_bill_document">
    <t t-set="cur_label" t-value="doc._ua_docs_currency_label()"/>
    <t t-set="seller" t-value="doc._ua_docs_seller()"/>
    <t t-set="buyer" t-value="doc._ua_docs_buyer()"/>
    <t t-set="rows" t-value="doc._ua_docs_lines()"/>
    <t t-set="totals" t-value="doc._ua_docs_totals()"/>
    <t t-set="doc_date" t-value="doc._ua_docs_date()"/>
    <t t-set="due_date" t-value="doc._ua_docs_due()"/>
    <div class="page ua-doc">
      <t t-call="l10n_ua_docs.ua_docs_style"/>

      <t t-set="party" t-value="seller"/>
      <t t-set="role" t-value="'Постачальник'"/>
      <t t-call="l10n_ua_docs.ua_docs_party_block"/>
      <t t-set="party" t-value="buyer"/>
      <t t-set="role" t-value="'Одержувач'"/>
      <t t-call="l10n_ua_docs.ua_docs_party_block"/>

      <div class="ua-rule"/>
      <h3>Рахунок на оплату № <t t-out="doc._ua_docs_number()"/><t t-if="doc_date"> від <t t-out="doc_date.strftime('%d.%m.%Y')"/></t></h3>
      <div class="ua-sub" t-if="doc._ua_docs_basis()">Підстава: <t t-out="doc._ua_docs_basis()"/></div>
      <div class="ua-rule"/>

      <t t-set="show_uktzed" t-value="False"/>
      <t t-call="l10n_ua_docs.ua_docs_lines_table"/>

      <div class="ua-note">
        Призначення платежу: оплата за рахунком № <t t-out="doc._ua_docs_number()"/><t t-if="doc_date"> від <t t-out="doc_date.strftime('%d.%m.%Y')"/></t>,
        <t t-if="totals['has_vat']">у т.ч. <t t-out="totals['vat_label']"/>
          <t t-out="doc._ua_docs_money_text(totals['tax'])"/> <t t-out="cur_label"/></t>
        <t t-else="">без ПДВ</t>.
      </div>
      <div class="ua-note" t-if="due_date">
        Рахунок чинний до <t t-out="due_date.strftime('%d.%m.%Y')"/>.
      </div>

      <table class="ua-sign">
        <tr>
          <td>
            Керівник <span class="ua-fill"><t t-out="seller['director']"/></span><br/>
            <span class="ua-cap">(підпис, ПІБ)</span><br/>М.П.
          </td>
          <td>
            Головний бухгалтер <span class="ua-fill"><t t-out="seller['accountant']"/></span><br/>
            <span class="ua-cap">(підпис, ПІБ)</span>
          </td>
        </tr>
      </table>
    </div>
  </template>

  <template id="report_ua_invoice_bill">
    <t t-call="web.html_container">
      <t t-foreach="docs" t-as="doc">
        <t t-set="guard" t-value="doc._ua_docs_check()"/>
        <t t-call="web.basic_layout">
          <t t-call="l10n_ua_docs.report_ua_invoice_bill_document"/>
        </t>
      </t>
    </t>
  </template>

  <!-- ======================= Акт наданих послуг ======================= -->
  <template id="report_ua_service_act_document">
    <t t-set="cur_label" t-value="doc._ua_docs_currency_label()"/>
    <t t-set="seller" t-value="doc._ua_docs_seller()"/>
    <t t-set="buyer" t-value="doc._ua_docs_buyer()"/>
    <t t-set="rows" t-value="doc._ua_docs_lines()"/>
    <t t-set="totals" t-value="doc._ua_docs_totals()"/>
    <t t-set="doc_date" t-value="doc._ua_docs_date()"/>
    <div class="page ua-doc">
      <t t-call="l10n_ua_docs.ua_docs_style"/>

      <h3>Акт № <t t-out="doc._ua_docs_number()"/><t t-if="doc_date"> від <t t-out="doc_date.strftime('%d.%m.%Y')"/></t></h3>
      <div class="ua-sub">наданих послуг (виконаних робіт)</div>

      <t t-set="party" t-value="seller"/>
      <t t-set="role" t-value="'Виконавець'"/>
      <t t-call="l10n_ua_docs.ua_docs_party_block"/>
      <t t-set="party" t-value="buyer"/>
      <t t-set="role" t-value="'Замовник'"/>
      <t t-call="l10n_ua_docs.ua_docs_party_block"/>

      <div class="ua-note" t-if="doc._ua_docs_basis()">Підстава: <t t-out="doc._ua_docs_basis()"/>.</div>
      <div class="ua-note">
        Ми, що нижче підписалися, склали цей акт про те, що Виконавець надав, а Замовник
        прийняв такі послуги (роботи):
      </div>

      <t t-set="show_uktzed" t-value="False"/>
      <t t-call="l10n_ua_docs.ua_docs_lines_table"/>

      <div class="ua-note">
        Послуги надано в повному обсязі та у строк. Сторони претензій одна до одної не мають.
      </div>

      <table class="ua-sign">
        <tr>
          <td>
            <strong>Виконавець</strong><br/>
            <t t-out="seller['name']"/><br/>
            <t t-if="seller['basis']"><span class="ua-cap">діє на підставі <t t-out="seller['basis']"/></span><br/></t>
            <span class="ua-fill"><t t-out="seller['director']"/></span><br/>
            <span class="ua-cap">(підпис, ПІБ)</span><br/>М.П.
          </td>
          <td>
            <strong>Замовник</strong><br/>
            <t t-out="buyer['name']"/><br/>
            <t t-if="buyer['basis']"><span class="ua-cap">діє на підставі <t t-out="buyer['basis']"/></span><br/></t>
            <span class="ua-fill"><t t-out="buyer['director']"/></span><br/>
            <span class="ua-cap">(підпис, ПІБ)</span><br/>М.П.
          </td>
        </tr>
      </table>
    </div>
  </template>

  <template id="report_ua_service_act">
    <t t-call="web.html_container">
      <t t-foreach="docs" t-as="doc">
        <t t-set="guard" t-value="doc._ua_docs_check()"/>
        <t t-call="web.basic_layout">
          <t t-call="l10n_ua_docs.report_ua_service_act_document"/>
        </t>
      </t>
    </t>
  </template>

  <!-- ======================= Видаткова накладна ======================= -->
  <template id="report_ua_delivery_note_document">
    <t t-set="cur_label" t-value="doc._ua_docs_currency_label()"/>
    <t t-set="seller" t-value="doc._ua_docs_seller()"/>
    <t t-set="buyer" t-value="doc._ua_docs_buyer()"/>
    <t t-set="rows" t-value="doc._ua_docs_lines()"/>
    <t t-set="totals" t-value="doc._ua_docs_totals()"/>
    <t t-set="doc_date" t-value="doc._ua_docs_date()"/>
    <t t-set="proxy" t-value="doc._ua_docs_proxy()"/>
    <div class="page ua-doc">
      <t t-call="l10n_ua_docs.ua_docs_style"/>

      <h3>Видаткова накладна № <t t-out="doc._ua_docs_number()"/><t t-if="doc_date"> від <t t-out="doc_date.strftime('%d.%m.%Y')"/></t></h3>

      <t t-set="party" t-value="seller"/>
      <t t-set="role" t-value="'Постачальник'"/>
      <t t-call="l10n_ua_docs.ua_docs_party_block"/>
      <t t-set="party" t-value="buyer"/>
      <t t-set="role" t-value="'Одержувач'"/>
      <t t-call="l10n_ua_docs.ua_docs_party_block"/>

      <div class="ua-note" t-if="doc._ua_docs_basis()">Підстава: <t t-out="doc._ua_docs_basis()"/>.</div>

      <t t-set="show_uktzed" t-value="True"/>
      <t t-call="l10n_ua_docs.ua_docs_lines_table"/>

      <div class="ua-note">
        Довіреність №
        <span class="ua-fill"><t t-out="proxy['number'] or ''"/></span>
        від
        <span class="ua-fill"><t t-out="proxy['date'].strftime('%d.%m.%Y') if proxy['date'] else ''"/></span>
        <t t-if="proxy['person']">, видана на <t t-out="proxy['person']"/></t>
      </div>

      <table class="ua-sign">
        <tr>
          <td>
            Відпустив(ла) <span class="ua-fill"><t t-out="seller['director']"/></span><br/>
            <span class="ua-cap">(посада, підпис, ПІБ)</span><br/>М.П.
          </td>
          <td>
            Отримав(ла) <span class="ua-fill"><t t-out="buyer['director']"/></span><br/>
            <span class="ua-cap">(посада, підпис, ПІБ)</span><br/>М.П.
          </td>
        </tr>
      </table>
    </div>
  </template>

  <template id="report_ua_delivery_note">
    <t t-call="web.html_container">
      <t t-foreach="docs" t-as="doc">
        <t t-set="guard" t-value="doc._ua_docs_check()"/>
        <t t-call="web.basic_layout">
          <t t-call="l10n_ua_docs.report_ua_delivery_note_document"/>
        </t>
      </t>
    </t>
  </template>

</odoo>
