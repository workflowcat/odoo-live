<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="view_ua_limit_card_list" model="ir.ui.view">
    <field name="name">ua.limit.card.list</field>
    <field name="model">ua.limit.card</field>
    <field name="arch" type="xml">
      <list decoration-muted="state == 'closed'" decoration-info="state == 'draft'"
            decoration-danger="remaining_qty &lt; 0">
        <field name="name"/>
        <field name="date_from" string="Місяць" widget="date"/>
        <field name="product_id"/>
        <field name="location_dest_id"/>
        <field name="department" optional="show"/>
        <field name="limit_qty"/>
        <field name="issued_qty"/>
        <field name="over_qty" optional="show"/>
        <field name="remaining_qty"/>
        <field name="uom_id" optional="hide"/>
        <field name="company_id" groups="base.group_multi_company" optional="hide"/>
        <field name="state" widget="badge" decoration-success="state == 'open'"/>
      </list>
    </field>
  </record>

  <record id="view_ua_limit_card_form" model="ir.ui.view">
    <field name="name">ua.limit.card.form</field>
    <field name="model">ua.limit.card</field>
    <field name="arch" type="xml">
      <form>
        <header>
          <button name="action_fill_from_productions" string="Ліміт із замовлень" type="object"
                  invisible="state == 'closed' or not production_ids"/>
          <button name="action_open" string="Відкрити" type="object" class="oe_highlight" invisible="state != 'draft'"/>
          <button name="action_close" string="Закрити" type="object" invisible="state != 'open'"/>
          <button name="action_reopen" string="Відкрити знову" type="object" invisible="state != 'closed'"
                  groups="stock.group_stock_manager"/>
          <button name="action_print" string="Друк М-8" type="object" invisible="state == 'draft'"/>
          <field name="state" widget="statusbar"/>
        </header>
        <sheet>
          <div class="oe_title">
            <h1><field name="name"/></h1>
          </div>
          <group>
            <group>
              <field name="product_id" readonly="state != 'draft'"/>
              <field name="limit_qty" readonly="state == 'closed'"/>
              <field name="uom_id"/>
              <field name="date_from" readonly="state != 'draft'"/>
              <field name="date_to"/>
            </group>
            <group>
              <field name="location_id" readonly="state != 'draft'"/>
              <field name="location_dest_id" readonly="state != 'draft'"/>
              <field name="department"/>
              <field name="purpose"/>
              <field name="company_id" groups="base.group_multi_company" readonly="state != 'draft'"/>
            </group>
          </group>
          <group>
            <group>
              <field name="issued_qty"/>
              <field name="over_qty" invisible="not over_qty"/>
              <field name="remaining_qty" decoration-danger="remaining_qty &lt; 0"/>
            </group>
          </group>
          <notebook>
            <page string="Відпуски" name="lines">
              <field name="line_ids" readonly="1">
                <list decoration-danger="over_limit" decoration-muted="quantity &lt; 0">
                  <field name="date"/>
                  <field name="quantity"/>
                  <field name="over_limit"/>
                  <field name="reason"/>
                  <field name="receiver"/>
                  <field name="user_id" widget="many2one_avatar_user"/>
                  <field name="move_id" optional="hide"/>
                </list>
              </field>
            </page>
            <page string="Планові замовлення" name="productions">
              <field name="production_ids" readonly="state == 'closed'">
                <list>
                  <field name="name"/>
                  <field name="product_id"/>
                  <field name="product_qty"/>
                  <field name="date_start"/>
                  <field name="state" widget="badge"/>
                </list>
              </field>
            </page>
          </notebook>
        </sheet>
        <chatter/>
      </form>
    </field>
  </record>

  <record id="view_ua_limit_card_search" model="ir.ui.view">
    <field name="name">ua.limit.card.search</field>
    <field name="model">ua.limit.card</field>
    <field name="arch" type="xml">
      <search>
        <field name="name"/>
        <field name="product_id"/>
        <field name="location_dest_id"/>
        <field name="department"/>
        <filter name="open_cards" string="Діють" domain="[('state', '=', 'open')]"/>
        <filter name="over" string="Є понад ліміт" domain="[('over_qty', '&gt;', 0)]"/>
        <separator/>
        <filter name="date_from" string="Місяць" date="date_from"/>
        <group>
          <filter name="by_product" string="Матеріал" context="{'group_by': 'product_id'}"/>
          <filter name="by_dest" string="Цех" context="{'group_by': 'location_dest_id'}"/>
          <filter name="by_month" string="Місяць" context="{'group_by': 'date_from:month'}"/>
        </group>
      </search>
    </field>
  </record>

  <record id="view_ua_limit_card_pivot" model="ir.ui.view">
    <field name="name">ua.limit.card.pivot</field>
    <field name="model">ua.limit.card</field>
    <field name="arch" type="xml">
      <pivot>
        <field name="product_id" type="row"/>
        <field name="date_from" interval="month" type="col"/>
        <field name="limit_qty" type="measure"/>
        <field name="issued_qty" type="measure"/>
        <field name="over_qty" type="measure"/>
      </pivot>
    </field>
  </record>

  <record id="action_ua_limit_card" model="ir.actions.act_window">
    <field name="name">Лімітно-забірні картки</field>
    <field name="res_model">ua.limit.card</field>
    <field name="view_mode">list,form,pivot</field>
    <field name="context">{'search_default_open_cards': 1}</field>
    <field name="help" type="html">
      <p class="o_view_nocontent_smiling_face">Додайте лімітно-забірну картку</p>
      <p>Один матеріал, один цех, один місяць: відпуск у межах ліміту, понад ліміт - з дозволом.</p>
    </field>
  </record>
</odoo>
