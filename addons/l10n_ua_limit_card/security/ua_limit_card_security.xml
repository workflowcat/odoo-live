<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="rule_ua_limit_card_company" model="ir.rule">
    <field name="name">Лімітно-забірна картка: лише свої компанії</field>
    <field name="model_id" ref="model_ua_limit_card"/>
    <field name="domain_force">[('company_id', 'in', company_ids)]</field>
  </record>
  <record id="rule_ua_limit_card_line_company" model="ir.rule">
    <field name="name">Відпуск за карткою: лише свої компанії</field>
    <field name="model_id" ref="model_ua_limit_card_line"/>
    <field name="domain_force">[('card_id.company_id', 'in', company_ids)]</field>
  </record>
</odoo>
