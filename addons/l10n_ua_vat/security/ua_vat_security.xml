<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <!-- Правила компанії: записи однієї компанії не видно з іншої. Той самий домен,
       що в нативних документах Odoo; рядок бере компанію в документа, на якому висить,
       а довідник із порожньою компанією спільний для всіх. -->
  <record id="rule_ua_vat_document_company" model="ir.rule">
    <field name="name">Податкова накладна / розрахунок коригування: лише свої компанії</field>
    <field name="model_id" ref="model_ua_vat_document"/>
    <field name="domain_force">[('company_id', 'in', company_ids)]</field>
  </record>

  <record id="rule_ua_vat_period_company" model="ir.rule">
    <field name="name">Зведення ПДВ за період: лише свої компанії</field>
    <field name="model_id" ref="model_ua_vat_period"/>
    <field name="domain_force">[('company_id', 'in', company_ids)]</field>
  </record>

  <record id="rule_ua_vat_compensation_company" model="ir.rule">
    <field name="name">Компенсуючі ПЗ (п.198.5 / ст.199 ПКУ): лише свої компанії</field>
    <field name="model_id" ref="model_ua_vat_compensation"/>
    <field name="domain_force">[('company_id', 'in', company_ids)]</field>
  </record>

  <record id="rule_ua_vat_compensation_line_company" model="ir.rule">
    <field name="name">Рядок компенсуючих ПЗ: лише свої компанії</field>
    <field name="model_id" ref="model_ua_vat_compensation_line"/>
    <field name="domain_force">[('comp_id.company_id', 'in', company_ids)]</field>
  </record>
</odoo>
