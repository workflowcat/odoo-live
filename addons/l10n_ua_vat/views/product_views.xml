<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="product_template_form_view_ua_vat" model="ir.ui.view">
    <field name="name">product.template.form.ua.vat</field>
    <field name="model">product.template</field>
    <field name="inherit_id" ref="product.product_template_only_form_view"/>
    <field name="arch" type="xml">
      <xpath expr="//field[@name='default_code']" position="after">
        <field name="x_uktzed" placeholder="напр. 8806100000"/>
        <field name="x_vat_treatment"/>
        <field name="x_vat_relief_id"/>
        <field name="x_vat_relief_effective_id" invisible="x_vat_treatment != 'exempt'"/>
      </xpath>
    </field>
  </record>
</odoo>
