<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="view_account_payment_form_ua_vat" model="ir.ui.view">
    <field name="name">account.payment.form.ua.vat</field>
    <field name="model">account.payment</field>
    <field name="inherit_id" ref="account.view_account_payment_form"/>
    <field name="arch" type="xml">
      <xpath expr="//sheet" position="inside">
        <group string="ПДВ: перша подія" invisible="not ua_fe_move_id">
          <field name="ua_fe_move_id" readonly="1"/>
          <field name="ua_fe_closed_amount" readonly="1"/>
          <field name="ua_fe_reversed" readonly="1"/>
        </group>
      </xpath>
    </field>
  </record>
</odoo>
