<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="view_ua_vat_compensation_list" model="ir.ui.view">
    <field name="name">ua.vat.compensation.list</field>
    <field name="model">ua.vat.compensation</field>
    <field name="arch" type="xml">
      <list string="Компенсуючі ПЗ">
        <field name="date_period"/>
        <field name="name"/>
        <field name="chv"/>
        <field name="direct_vat"/>
        <field name="dual_vat"/>
        <field name="comp_vat_total" sum="Разом"/>
        <field name="move_id"/>
        <field name="state" widget="badge"/>
        <field name="currency_id" column_invisible="1"/>
      </list>
    </field>
  </record>

  <record id="view_ua_vat_compensation_form" model="ir.ui.view">
    <field name="name">ua.vat.compensation.form</field>
    <field name="model">ua.vat.compensation</field>
    <field name="arch" type="xml">
      <form string="Компенсуючі ПЗ">
        <header>
          <button name="action_compute" type="object" string="Розрахувати"
                  invisible="state != 'draft'"/>
          <button name="action_post" type="object" string="Провести" class="oe_highlight"
                  invisible="state != 'draft'"/>
          <button name="action_annual_recalc" type="object" string="Річний перерахунок ЧВ"
                  invisible="state != 'posted'"/>
          <field name="state" widget="statusbar"/>
        </header>
        <sheet>
          <div class="oe_title"><h1><field name="name" readonly="1"/></h1></div>
          <group>
            <group>
              <field name="date_period" readonly="state != 'draft'"/>
              <field name="company_id" groups="base.group_multi_company"/>
              <field name="currency_id" invisible="1"/>
            </group>
            <group>
              <field name="chv"/>
              <field name="taxable_base"/>
              <field name="denom_base"/>
              <field name="nocomp_base"/>
            </group>
          </group>
          <group>
            <group string="Компенсуючі зобов'язання">
              <field name="direct_vat"/>
              <field name="dual_vat"/>
              <field name="comp_base_total"/>
              <field name="comp_vat_total"/>
            </group>
            <group string="Документи">
              <field name="move_id"/>
              <field name="doc_id"/>
            </group>
          </group>
          <group string="Річний перерахунок (ст.199.4 ПКУ)" invisible="not x_annual_move_id">
            <group>
              <field name="x_annual_chv"/>
              <field name="x_annual_delta"/>
            </group>
            <group>
              <field name="x_annual_move_id"/>
              <field name="x_annual_rk_ids" widget="many2many_tags"/>
            </group>
          </group>
          <notebook>
            <page string="Рядки компенсації" name="lines">
              <field name="line_ids">
                <list string="Рядки">
                  <field name="name"/>
                  <field name="product_id"/>
                  <field name="kind"/>
                  <field name="base"/>
                  <field name="vat_in"/>
                  <field name="share"/>
                  <field name="comp_base"/>
                  <field name="comp_vat" sum="Разом"/>
                  <field name="currency_id" column_invisible="1"/>
                </list>
              </field>
            </page>
          </notebook>
        </sheet>
      </form>
    </field>
  </record>

  <record id="action_ua_vat_compensation" model="ir.actions.act_window">
    <field name="name">Компенсуючі ПЗ</field>
    <field name="res_model">ua.vat.compensation</field>
    <field name="view_mode">list,form</field>
    <field name="help" type="html">
      <p class="o_view_nocontent_smiling_face">Створіть розрахунок за місяць</p>
      <p>Якщо купили з податковим кредитом, а використали у звільнених
         операціях, кредит гаситься зустрічним зобов'язанням (п.198.5 ПКУ).
         Придбання подвійного призначення компенсуються частково, за ЧВ
         (ст.199 ПКУ).</p>
    </field>
  </record>
</odoo>
