<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="view_ua_vat_period_form" model="ir.ui.view">
    <field name="name">ua.vat.period.form</field>
    <field name="model">ua.vat.period</field>
    <field name="arch" type="xml">
      <form string="Зведення ПДВ за період">
        <header>
          <button name="action_compute" type="object" string="Порахувати" class="btn-primary"/>
        </header>
        <sheet>
        <div class="oe_title"><h1><field name="name" readonly="1"/></h1></div>
        <group>
          <group>
            <field name="date_from"/>
            <field name="date_to"/>
          </group>
          <group>
            <field name="company_id" groups="base.group_multi_company"/>
            <field name="currency_id" invisible="1"/>
          </group>
        </group>
        <group>
          <group string="Разом за період">
            <field name="pz_total"/>
            <field name="pk_total"/>
            <field name="due_total"/>
          </group>
          <group string="Розділ III декларації">
            <field name="ua_r18"/>
            <field name="ua_r19"/>
          </group>
        </group>
        <notebook>
          <page string="Податкові зобов'язання" name="pz">
            <group>
              <group>
                <field name="ua_r1_base"/>
                <field name="ua_r1_vat"/>
                <field name="ua_r2_base"/>
                <field name="ua_r2_vat"/>
                <field name="ua_r3_base"/>
                <field name="ua_r3_vat"/>
              </group>
              <group>
                <field name="ua_r_export_base"/>
                <field name="ua_r_exempt_base"/>
                <field name="ua_r0_base"/>
                <field name="ua_fe_vat"/>
                <field name="ua_r41_base"/>
                <field name="ua_r41_vat"/>
                <field name="ua_r411_vat"/>
                <field name="ua_r7_base"/>
                <field name="ua_r7_vat"/>
                <field name="ua_pz_total"/>
              </group>
            </group>
          </page>
          <page string="Податковий кредит" name="pk">
            <group>
              <group>
                <field name="ua_pk1_base"/>
                <field name="ua_pk1_vat"/>
                <field name="ua_pk2_base"/>
                <field name="ua_pk2_vat"/>
                <field name="ua_pk3_base"/>
                <field name="ua_pk3_vat"/>
              </group>
              <group>
                <field name="ua_customs_vat"/>
                <field name="ua_r14_base"/>
                <field name="ua_r14_vat"/>
                <field name="ua_pk_total"/>
              </group>
            </group>
          </page>
          <page string="Що не доробили" name="problems">
            <field name="problems" nolabel="1"/>
          </page>
        </notebook>
        </sheet>
      </form>
    </field>
  </record>

  <record id="view_ua_vat_period_list" model="ir.ui.view">
    <field name="name">ua.vat.period.list</field>
    <field name="model">ua.vat.period</field>
    <field name="arch" type="xml">
      <list>
        <header>
          <button name="action_compose_month" type="object" display="always"
                  string="Створити за місяць" class="btn-primary"/>
        </header>
        <field name="name"/>
        <field name="date_from" options="{'numeric': True}"/>
        <field name="date_to" options="{'numeric': True}"/>
        <field name="pz_total" sum="Разом"/>
        <field name="pk_total" sum="Разом"/>
        <field name="due_total" sum="Разом"/>
        <field name="currency_id" column_invisible="1"/>
      </list>
    </field>
  </record>

  <record id="view_ua_vat_period_search" model="ir.ui.view">
    <field name="name">ua.vat.period.search</field>
    <field name="model">ua.vat.period</field>
    <field name="arch" type="xml">
      <search string="Зведення ПДВ">
        <field name="name"/>
        <group>
          <filter name="group_date" string="Період з" context="{'group_by': 'date_from'}"/>
        </group>
      </search>
    </field>
  </record>

  <record id="action_ua_vat_period" model="ir.actions.act_window">
    <field name="name">Зведення ПДВ за період</field>
    <field name="res_model">ua.vat.period</field>
    <field name="view_mode">list,form</field>
    <field name="search_view_id" ref="view_ua_vat_period_search"/>
  </record>
</odoo>
