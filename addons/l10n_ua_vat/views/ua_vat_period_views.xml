<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="view_ua_vat_cabinet_form" model="ir.ui.view">
    <field name="name">ua.vat.cabinet.form</field>
    <field name="model">ua.vat.cabinet</field>
    <field name="arch" type="xml">
      <form string="Зведення ПДВ за період">
        <group>
          <group>
            <field name="date_from"/>
            <field name="date_to"/>
          </group>
          <group>
            <field name="company_id" groups="base.group_multi_company"/>
            <field name="currency_id" invisible="1"/>
          </group>
        </group>
        <div class="oe_button_box" name="compute">
          <button name="action_compute" type="object" string="Порахувати" class="btn-primary"/>
        </div>
        <group>
          <group string="Разом за період">
            <field name="pz_total"/>
            <field name="pk_total"/>
            <field name="due_total"/>
          </group>
          <group string="Розділ III декларації">
            <field name="ua_r18"/>
            <field name="ua_r19"/>
          </group>
        </group>
        <notebook>
          <page string="Податкові зобов'язання" name="pz">
            <group>
              <group>
                <field name="ua_r1_base"/>
                <field name="ua_r1_vat"/>
                <field name="ua_r2_base"/>
                <field name="ua_r2_vat"/>
                <field name="ua_r3_base"/>
                <field name="ua_r3_vat"/>
              </group>
              <group>
                <field name="ua_r_export_base"/>
                <field name="ua_r_exempt_base"/>
                <field name="ua_r0_base"/>
                <field name="ua_fe_vat"/>
                <field name="ua_r41_base"/>
                <field name="ua_r41_vat"/>
                <field name="ua_r411_vat"/>
                <field name="ua_r7_base"/>
                <field name="ua_r7_vat"/>
                <field name="ua_pz_total"/>
              </group>
            </group>
          </page>
          <page string="Податковий кредит" name="pk">
            <group>
              <group>
                <field name="ua_pk1_base"/>
                <field name="ua_pk1_vat"/>
                <field name="ua_pk2_base"/>
                <field name="ua_pk2_vat"/>
                <field name="ua_pk3_base"/>
                <field name="ua_pk3_vat"/>
              </group>
              <group>
                <field name="ua_customs_vat"/>
                <field name="ua_r14_base"/>
                <field name="ua_r14_vat"/>
                <field name="ua_pk_total"/>
              </group>
            </group>
          </page>
          <page string="Що не доробили" name="problems">
            <field name="problems" nolabel="1"/>
          </page>
        </notebook>
      </form>
    </field>
  </record>

  <record id="action_ua_vat_cabinet" model="ir.actions.act_window">
    <field name="name">Зведення ПДВ за період</field>
    <field name="res_model">ua.vat.cabinet</field>
    <field name="view_mode">form</field>
    <field name="target">new</field>
  </record>
</odoo>
