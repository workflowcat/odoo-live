<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="view_ua_vat_relief_list" model="ir.ui.view">
    <field name="name">ua.vat.relief.list</field>
    <field name="model">ua.vat.relief</field>
    <field name="arch" type="xml">
      <list string="Пільги з ПДВ">
        <field name="sequence" widget="handle"/>
        <field name="name"/>
        <field name="uktzed_prefixes"/>
        <field name="basis"/>
        <field name="dps_benefit_code"/>
        <field name="date_from"/>
        <field name="date_to"/>
        <field name="no_compensation"/>
      </list>
    </field>
  </record>

  <record id="view_ua_vat_relief_form" model="ir.ui.view">
    <field name="name">ua.vat.relief.form</field>
    <field name="model">ua.vat.relief</field>
    <field name="arch" type="xml">
      <form string="Підстава звільнення від ПДВ">
        <sheet>
          <div class="oe_title"><h1><field name="name" placeholder="напр. БПЛА (безпілотні системи)"/></h1></div>
          <group>
            <group>
              <field name="basis"/>
              <field name="uktzed_prefixes" placeholder="8806, 8807"/>
              <field name="dps_benefit_code"/>
            </group>
            <group>
              <field name="date_from"/>
              <field name="date_to"/>
              <field name="no_compensation"/>
              <field name="active"/>
              <field name="sequence"/>
            </group>
          </group>
          <group string="Умови застосування">
            <field name="conditions" nolabel="1"/>
          </group>
        </sheet>
      </form>
    </field>
  </record>

  <record id="view_ua_vat_relief_search" model="ir.ui.view">
    <field name="name">ua.vat.relief.search</field>
    <field name="model">ua.vat.relief</field>
    <field name="arch" type="xml">
      <search string="Пільги з ПДВ">
        <field name="name"/>
        <field name="uktzed_prefixes"/>
        <field name="basis"/>
        <filter name="active" string="Активні" domain="[('active', '=', True)]"/>
        <filter name="no_comp" string="Без компенсації" domain="[('no_compensation', '=', True)]"/>
      </search>
    </field>
  </record>

  <record id="action_ua_vat_relief" model="ir.actions.act_window">
    <field name="name">Пільги з ПДВ</field>
    <field name="res_model">ua.vat.relief</field>
    <field name="view_mode">list,form</field>
    <field name="help" type="html">
      <p class="o_view_nocontent_smiling_face">Додайте підставу звільнення</p>
      <p>Одна підстава - це норма ПКУ і перелік початків кодів УКТ ЗЕД. Товар із
         таким кодом стає звільненим сам, а в податковій накладній отримує код
         ставки 903 і код пільги з довідника ДПС.</p>
    </field>
  </record>
</odoo>
