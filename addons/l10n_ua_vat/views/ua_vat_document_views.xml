<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="view_ua_vat_document_list" model="ir.ui.view">
    <field name="name">ua.vat.document.list</field>
    <field name="model">ua.vat.document</field>
    <field name="arch" type="xml">
      <list string="Податкові накладні і РК">
        <field name="date"/>
        <field name="name"/>
        <field name="doc_kind"/>
        <field name="partner_id"/>
        <field name="move_id"/>
        <field name="ua_pn_deadline" decoration-danger="ua_pn_overdue_days &gt; 0"/>
        <field name="ua_pn_registered_date"/>
        <field name="ua_pn_overdue_days" decoration-danger="ua_pn_overdue_days &gt; 0"/>
        <field name="ua_pn_fine_est" sum="Разом"/>
        <field name="state" widget="badge"/>
        <field name="currency_id" column_invisible="1"/>
      </list>
    </field>
  </record>

  <record id="view_ua_vat_document_form" model="ir.ui.view">
    <field name="name">ua.vat.document.form</field>
    <field name="model">ua.vat.document</field>
    <field name="arch" type="xml">
      <form string="Податковий документ">
        <header>
          <button name="action_export_xml" type="object" string="XML для ЄРПН" class="oe_highlight"/>
          <button name="action_mark_pn_registered" type="object" string="Позначити зареєстрованою"
                  invisible="ua_pn_registered_date"/>
          <field name="state" widget="statusbar"/>
        </header>
        <sheet>
          <div class="oe_title"><h1><field name="name"/></h1></div>
          <group>
            <group>
              <field name="doc_kind"/>
              <field name="move_id"/>
              <field name="partner_id"/>
              <field name="date"/>
              <field name="company_id" groups="base.group_multi_company"/>
              <field name="currency_id" invisible="1"/>
            </group>
            <group>
              <field name="ua_pn_deadline"/>
              <field name="ua_pn_registered_date"/>
              <field name="ua_pn_overdue_days"/>
              <field name="ua_pn_fine_est"/>
            </group>
          </group>
          <group string="Зведена податкова накладна" invisible="doc_kind != 'tax_invoice'">
            <field name="ua_pn_consolidated"/>
            <field name="ua_pn_reason_type" invisible="not ua_pn_consolidated"/>
          </group>
          <group string="Реквізити коригування" invisible="doc_kind != 'adjustment'">
            <group>
              <field name="ua_adj_reason_code"/>
              <field name="ua_adj_pn_document_id"/>
            </group>
            <group>
              <field name="ua_adj_direction"/>
              <field name="ua_adj_registrant"/>
            </group>
          </group>
        </sheet>
        <chatter/>
      </form>
    </field>
  </record>

  <record id="view_ua_vat_document_search" model="ir.ui.view">
    <field name="name">ua.vat.document.search</field>
    <field name="model">ua.vat.document</field>
    <field name="arch" type="xml">
      <search string="Податкові накладні і РК">
        <field name="name"/>
        <field name="partner_id"/>
        <field name="move_id"/>
        <filter name="pn" string="Податкові накладні" domain="[('doc_kind', '=', 'tax_invoice')]"/>
        <filter name="rk" string="Розрахунки коригування" domain="[('doc_kind', '=', 'adjustment')]"/>
        <separator/>
        <filter name="not_registered" string="Не зареєстровані"
                domain="[('ua_pn_registered_date', '=', False)]"/>
        <filter name="overdue" string="Прострочені"
                domain="[('ua_pn_registered_date', '=', False), ('ua_pn_deadline', '&lt;', context_today().strftime('%Y-%m-%d'))]"/>
        <separator/>
        <filter name="consolidated" string="Зведені" domain="[('ua_pn_consolidated', '=', True)]"/>
        <group>
          <filter name="group_kind" string="Тип документа" context="{'group_by': 'doc_kind'}"/>
          <filter name="group_partner" string="Контрагент" context="{'group_by': 'partner_id'}"/>
          <filter name="group_date" string="Місяць складання" context="{'group_by': 'date'}"/>
        </group>
      </search>
    </field>
  </record>

  <record id="action_ua_vat_document" model="ir.actions.act_window">
    <field name="name">Податкові накладні і РК</field>
    <field name="res_model">ua.vat.document</field>
    <field name="view_mode">list,form</field>
    <field name="help" type="html">
      <p class="o_view_nocontent_smiling_face">Тут будуть податкові накладні</p>
      <p>Накладна складається кнопкою на рахунку клієнта після першої події.
         Розрахунок коригування з'являється сам, коли проводиться повернення до
         рахунку, на який уже складено накладну.</p>
    </field>
  </record>
</odoo>
