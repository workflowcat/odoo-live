<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <!-- Одне меню «Зарплата»: Розрахунок → Звітність → Кадрові документи → Довідники -->
  <menuitem id="menu_ua_payroll_calc" name="Розрахунок" parent="payroll.payroll_menu_root" sequence="10"/>
  <menuitem id="menu_ua_payroll_reporting" name="Звітність" parent="payroll.payroll_menu_root" sequence="20"/>
  <menuitem id="menu_ua_payroll_docs" name="Кадрові документи" parent="payroll.payroll_menu_root" sequence="30"/>
  <record id="payroll.hr_payslip_run_menu" model="ir.ui.menu"><field name="parent_id" ref="menu_ua_payroll_calc"/><field name="sequence">1</field></record>
  <record id="payroll.hr_payslip_menu" model="ir.ui.menu"><field name="parent_id" ref="menu_ua_payroll_calc"/><field name="sequence">2</field></record>
  <record id="l10n_ua_payroll_rules.menu_ua_advance" model="ir.ui.menu"><field name="parent_id" ref="menu_ua_payroll_calc"/><field name="sequence">3</field></record>
  <record id="l10n_ua_payroll_reports.menu_ua_payroll_report" model="ir.ui.menu"><field name="parent_id" ref="menu_ua_payroll_reporting"/><field name="sequence">1</field><field name="name">Об'єднана звітність (ДПС, XML)</field></record>
  <record id="l10n_ua_payroll_reports.menu_ua_hire_notice" model="ir.ui.menu"><field name="parent_id" ref="menu_ua_payroll_reporting"/><field name="sequence">2</field><field name="name">Повідомлення про прийняття (ДПС, XML)</field></record>
  <record id="l10n_ua_hr_docs.menu_ua_staff_list" model="ir.ui.menu"><field name="parent_id" ref="menu_ua_payroll_docs"/><field name="sequence">1</field></record>
  <record id="l10n_ua_hr_docs.menu_ua_timesheet" model="ir.ui.menu"><field name="parent_id" ref="menu_ua_payroll_docs"/><field name="sequence">2</field></record>
  <record id="l10n_ua_payroll_rules.menu_ua_payroll_param" model="ir.ui.menu"><field name="parent_id" ref="payroll.payroll_menu_configuration"/><field name="sequence">1</field><field name="name">Параметри (МЗП, ставки)</field></record>
  <record id="l10n_ua_payroll_account.menu_ua_payroll_account_map" model="ir.ui.menu"><field name="parent_id" ref="payroll.payroll_menu_configuration"/><field name="sequence">2</field><field name="name">Карта проводок</field></record>
  <record id="l10n_ua_average.menu_ua_earnings_history" model="ir.ui.menu"><field name="parent_id" ref="payroll.payroll_menu_configuration"/><field name="sequence">3</field><field name="name">Історія заробітку</field></record>
  <record id="payroll.payroll_menu_configuration" model="ir.ui.menu"><field name="sequence">90</field></record>
</odoo>
