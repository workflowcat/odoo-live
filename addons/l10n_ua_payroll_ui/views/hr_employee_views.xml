<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <!-- порядок і назви вкладок картки працівника: Робота, Особова картка, Документи, Військовий облік, Зарплата, Контракт, Навички -->
  <record id="view_employee_form_ua_ui" model="ir.ui.view">
    <field name="name">hr.employee.form.ua.ui</field><field name="model">hr.employee</field>
    <field name="inherit_id" ref="hr.view_employee_form"/>
    <field name="priority">99</field>
    <field name="arch" type="xml">
      <xpath expr="//page[@name='work_information']" position="attributes"><attribute name="string">Робота</attribute></xpath>
      <xpath expr="//page[@name='payroll_information']" position="attributes"><attribute name="string">Контракт і оклад</attribute></xpath>
      <xpath expr="//page[@name='ua_docs']" position="after"><xpath expr="//page[@name='ua_military']" position="move"/></xpath>
      <xpath expr="//page[@name='ua_military']" position="after"><xpath expr="//page[@name='ua']" position="move"/></xpath>
      <xpath expr="//page[@name='ua']" position="after"><xpath expr="//page[@name='payroll_information']" position="move"/></xpath>
    </field>
  </record>
</odoo>
