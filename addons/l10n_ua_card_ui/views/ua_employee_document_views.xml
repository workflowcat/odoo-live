<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <!-- «Додати документ»: у l10n_ua_hr_card ua.employee.document має лише інлайн-список у вкладці
       «Документи» форми працівника - для власної форми (act_window із target=new) потрібен окремий вигляд. -->
  <record id="view_ua_employee_document_form_card" model="ir.ui.view">
    <field name="name">ua.employee.document.form.ua.card</field>
    <field name="model">ua.employee.document</field>
    <field name="arch" type="xml">
      <form string="Документ працівника">
        <group>
          <field name="employee_id" invisible="1"/>
          <field name="type"/>
          <field name="name"/>
          <field name="number"/>
          <field name="date"/>
          <field name="valid_until"/>
          <field name="file" filename="filename"/>
          <field name="filename" invisible="1"/>
          <field name="note"/>
        </group>
        <footer>
          <button string="Зберегти" special="save" class="btn btn-primary"/>
          <button string="Закрити" special="cancel" class="btn btn-secondary"/>
        </footer>
      </form>
    </field>
  </record>
</odoo>
