<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <!-- «Змінити оклад»: форма нової версії контракту. Немає готового вигляду hr.version, придатного
       для реальних записів (єдиний core-вигляд, hr.hr_contract_template_form_view, зроблений для
       шаблонів без employee_id, з обов'язковим полем "Template Name") - тож власний, мінімальний. -->
  <record id="view_hr_version_form_new" model="ir.ui.view">
    <field name="name">hr.version.form.ua.card.new</field>
    <field name="model">hr.version</field>
    <field name="arch" type="xml">
      <form string="Нова версія контракту">
        <field name="currency_id" invisible="1"/>
        <group>
          <field name="employee_id" invisible="1"/>
          <field name="contract_date_start"/>
          <field name="job_id"/>
          <field name="department_id"/>
          <field name="job_title"/>
          <field name="wage" widget="monetary"/>
          <field name="contract_type_id"/>
          <field name="ua_order_ref"/>
        </group>
        <footer>
          <button string="Зберегти" special="save" class="btn btn-primary"/>
          <button string="Скасувати" special="cancel" class="btn btn-secondary"/>
        </footer>
      </form>
    </field>
  </record>

  <!-- «Звільнити»: форма поточної версії з полями дати і підстави припинення. -->
  <record id="view_hr_version_form_dismiss" model="ir.ui.view">
    <field name="name">hr.version.form.ua.card.dismiss</field>
    <field name="model">hr.version</field>
    <field name="arch" type="xml">
      <form string="Звільнення">
        <group>
          <field name="employee_id" readonly="1"/>
          <field name="job_title" readonly="1"/>
          <field name="contract_date_end"/>
          <field name="ua_dismissal_basis"/>
          <field name="ua_end_order_ref"/>
        </group>
        <footer>
          <button string="Зберегти" special="save" class="btn btn-primary"/>
          <button string="Скасувати" special="cancel" class="btn btn-secondary"/>
        </footer>
      </form>
    </field>
  </record>
</odoo>
