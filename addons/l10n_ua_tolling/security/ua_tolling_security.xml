<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
  <record id="rule_ua_tolling_order_company" model="ir.rule">
    <field name="name">Переробка давальницької сировини: лише свої компанії</field>
    <field name="model_id" ref="model_ua_tolling_order"/>
    <field name="domain_force">[('company_id', 'in', company_ids)]</field>
  </record>
  <record id="rule_ua_tolling_order_line_company" model="ir.rule">
    <field name="name">Сировина замовлення на переробку: лише свої компанії</field>
    <field name="model_id" ref="model_ua_tolling_order_line"/>
    <field name="domain_force">[('order_id.company_id', 'in', company_ids)]</field>
  </record>
</odoo>
