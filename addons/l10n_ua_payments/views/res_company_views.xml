<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="view_company_form_ua_payments" model="ir.ui.view">
    <field name="name">res.company.form.ua.payments</field><field name="model">res.company</field>
    <field name="inherit_id" ref="base.view_company_form"/>
    <field name="arch" type="xml">
      <xpath expr="//notebook" position="inside">
        <page string="Рахунки бюджету" name="ua_budget_accounts">
          <group>
            <field name="ua_iban_pdfo" placeholder="UA..."/>
            <field name="ua_iban_vz" placeholder="UA..."/>
            <field name="ua_iban_esv" placeholder="UA..."/>
          </group>
        </page>
      </xpath>
    </field>
  </record>
</odoo>
