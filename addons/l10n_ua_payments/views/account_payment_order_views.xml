<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <!-- Зарплатна відомість - окремий вигляд доручення OCA: українські кнопки, рядки на
       працівників, перевірки. Типові вигляди account_payment_order лишаються для звичайних
       доручень постачальникам. -->
  <record id="view_ua_payment_order_form" model="ir.ui.view">
    <field name="name">account.payment.order.form.ua</field>
    <field name="model">account.payment.order</field>
    <field name="priority">32</field>
    <field name="arch" type="xml">
      <form string="Відомість на перерахування">
        <header>
          <button name="action_fill" type="object" string="Перерахувати" invisible="state != 'draft'"/>
          <button name="action_confirm" type="object" string="Затвердити" class="oe_highlight" invisible="state != 'draft'"/>
          <button name="action_export" type="object" string="Файл для банку" invisible="state == 'draft'"/>
          <button name="%(action_report_ua_payment_order)d" type="action" string="Друк" invisible="state == 'draft'"/>
          <button name="action_paid" type="object" string="Позначити оплаченою" invisible="state not in ('open', 'generated')"/>
          <button name="action_draft" type="object" string="Повернути в чернетку" invisible="state in ('draft', 'uploaded')"/>
          <button name="action_cancel" type="object" string="Скасувати" invisible="state in ('draft', 'cancel')"/>
          <field name="state" widget="statusbar" statusbar_visible="draft,open,generated,uploaded"/>
        </header>
        <sheet>
          <div class="oe_button_box" name="button_box">
            <button name="action_move_journal_line" type="object" class="oe_stat_button" icon="fa-bars"
                    invisible="move_count == 0">
              <field name="move_count" widget="statinfo" string="Проводки"/>
            </button>
          </div>
          <div class="oe_title"><h1><field name="ua_label" readonly="1"/></h1></div>
          <group>
            <group>
              <field name="ua_kind" readonly="state != 'draft'"/>
              <field name="ua_year" readonly="state != 'draft'" options="{'enable_formatting': False}"/>
              <field name="ua_month" readonly="state != 'draft'"/>
              <field name="name" string="Номер" readonly="1"/>
            </group>
            <group>
              <field name="ua_pay_date"/>
              <field name="journal_id" string="Банк" readonly="state != 'draft'" options="{'no_create': True}"/>
              <field name="payment_mode_id" readonly="1"/>
              <field name="ua_legacy" readonly="1" invisible="not ua_legacy"/>
              <field name="company_id" groups="base.group_multi_company"/>
            </group>
          </group>
          <group>
            <group>
              <field name="ua_line_count" readonly="1" string="Рядків"/>
              <field name="ua_without_account" readonly="1" decoration-danger="ua_without_account > 0"/>
            </group>
            <group>
              <field name="total_company_currency" string="Разом" readonly="1"/>
              <field name="company_currency_id" invisible="1"/>
            </group>
          </group>
          <notebook>
            <page string="Рядки" name="lines">
              <field name="payment_line_ids" readonly="state != 'draft'">
                <list editable="bottom">
                  <field name="ua_employee_id" readonly="1" column_invisible="parent.ua_kind == 'tax'"/>
                  <field name="ua_label" column_invisible="parent.ua_kind != 'tax'"/>
                  <field name="partner_id" column_invisible="parent.ua_kind != 'tax'"/>
                  <field name="partner_bank_id" string="Рахунок (IBAN)"/>
                  <field name="amount_currency" string="Сума" sum="Разом"/>
                  <field name="communication" string="Призначення" optional="show"/>
                  <field name="ua_account_id" string="Закриває рахунок" optional="hide"/>
                  <field name="currency_id" column_invisible="1"/>
                </list>
              </field>
            </page>
            <page string="Платежі" name="payments" invisible="payment_count == 0">
              <field name="payment_ids" readonly="1">
                <list>
                  <field name="date"/>
                  <field name="partner_id"/>
                  <field name="amount"/>
                  <field name="destination_account_id"/>
                  <field name="state"/>
                </list>
              </field>
              <field name="payment_count" invisible="1"/>
            </page>
            <page string="Примітка" name="note"><field name="ua_note"/></page>
            <page string="Перевірки" name="ua_checks">
              <field name="checks_html" readonly="1" nolabel="1"/>
            </page>
          </notebook>
        </sheet>
        <chatter/>
      </form>
    </field>
  </record>

  <record id="view_ua_payment_order_list" model="ir.ui.view">
    <field name="name">account.payment.order.list.ua</field>
    <field name="model">account.payment.order</field>
    <field name="priority">32</field>
    <field name="arch" type="xml">
      <list>
        <field name="ua_label"/>
        <field name="name" string="Номер" optional="show"/>
        <field name="ua_pay_date" options="{'numeric': True}"/>
        <field name="ua_line_count" string="Рядків"/>
        <field name="total_company_currency" string="Разом" sum="Разом"/>
        <field name="state" widget="badge"/>
        <field name="company_currency_id" column_invisible="1"/>
      </list>
    </field>
  </record>

  <record id="action_ua_payment_order" model="ir.actions.act_window">
    <field name="name">Відомості на перерахування</field>
    <field name="res_model">account.payment.order</field>
    <field name="view_mode">list,form</field>
    <field name="domain">[('ua_kind', '!=', False)]</field>
    <field name="context">{'default_ua_kind': 'salary'}</field>
    <field name="view_ids" eval="[(5, 0, 0),
      (0, 0, {'view_mode': 'list', 'view_id': ref('view_ua_payment_order_list')}),
      (0, 0, {'view_mode': 'form', 'view_id': ref('view_ua_payment_order_form')})]"/>
    <field name="help" type="html">
      <p class="o_view_nocontent_smiling_face">Створіть відомість на виплату</p>
      <p>Відомість збирає суми до виплати з листків або з авансу, дає файл для банку, друковану форму і проводить платежі.</p>
    </field>
  </record>
</odoo>
